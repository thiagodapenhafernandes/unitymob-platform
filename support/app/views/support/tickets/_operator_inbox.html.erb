<section aria-label="Fila de atendimento" class="ax-support-workspace ax-support-inbox-page">
  <section class="ax-support-panel">
    <div class="ax-support-toolbar"><h1>Tickets <span class="ax-support-status" data-support-total><%= @total %></span></h1><%= link_to 'Atualizar', support_tickets_path(request.query_parameters), class:'ax-btn' %></div>
    <%= form_with url:support_tickets_path, method: :get, class:'ax-support-inbox-filters', data:{turbo_frame:'support_queue', support_filter_form:true, support_preferences_url:queue_preferences_path} do %>
      <div class="ax-support-filters"><%= search_field_tag :q, params[:q], placeholder:'Buscar por #ticket, nome ou e-mail', aria:{label:'Buscar chamado'}, class:'ax-input' %><%= date_field_tag :from, params[:from], aria:{label:'Data inicial'}, class:'ax-input' %><%= date_field_tag :to, params[:to], aria:{label:'Data final'}, class:'ax-input' %><%= select_tag :account_id, options_from_collection_for_select(Support::Account.order(:name),:id,:name,params[:account_id]), include_blank:'Filtrar por conta…', aria:{label:'Conta'}, class:'ax-input' %><%= submit_tag 'Filtrar', class:'ax-btn' %></div>
      <%= hidden_field_tag :status, params[:status] %><%= hidden_field_tag :origin, params[:origin] %><%= hidden_field_tag :order, params[:order].presence || 'oldest' %><%= hidden_field_tag :mine, params[:mine] %>
      <div class="ax-support-chips">
        <% ([['','Todos']]+Support::Ticket::STATUS_LABELS.map { |v,l| [v,l] }).each do |value,label| %><button type="button" class="ax-support-chip" data-support-filter="status" data-value="<%= value %>" aria-pressed="<%= params[:status].to_s == value %>"><%= label %></button><% end %>
        <span class="ax-support-chip-divider"></span><% [['','Todos'],['ativo','Ativos'],['receptivo','Receptivos']].each do |value,label| %><button type="button" class="ax-support-chip" data-support-filter="origin" data-value="<%= value %>" aria-pressed="<%= params[:origin].to_s == value %>"><%= label %></button><% end %>
        <span class="ax-support-chip-divider"></span><button type="button" class="ax-support-chip" data-support-filter="mine" data-value="1" data-toggle="true" aria-pressed="<%= params[:mine]=='1' %>">Meus chamados</button>
        <% [['newest','Mais novos'],['oldest','Mais antigos']].each do |value,label| %><button type="button" class="ax-support-chip" data-support-filter="order" data-value="<%= value %>" aria-pressed="<%= (params[:order].presence || 'oldest') == value %>"><%= label %></button><% end %>
      </div>
    <% end %>
  </section>
  <details class="ax-support-disclosure ax-support-outreach"><summary><div>Abrir chamado ativo para cliente<small>Direciona um aviso para um usuário específico da conta cliente.</small></div><span>Mostrar</span></summary><p>Envie uma mensagem para um usuário da conta. Ele será avisado na plataforma.</p>
    <%= form_with url:outreach_path, data:{support_outreach:outreach_users_path} do %><div class="ax-support-filters"><%= select_tag :account_id, options_from_collection_for_select(Support::Account.where(active:true).order(:name),:id,:name), include_blank:'Selecione a conta', required:true, aria:{label:'Conta destino'}, class:'ax-input', data:{outreach_account:true} %><%= search_field_tag :recipient_search, nil, placeholder:'Nome ou e-mail do usuário', aria:{label:'Buscar destinatário'}, class:'ax-input', data:{outreach_search:true} %><button type="button" class="ax-btn" data-outreach-search-button>Buscar usuário</button><%= select_tag :requester_id, '', required:true, aria:{label:'Usuário destino'}, class:'ax-input', data:{outreach_user:true} %><%= select_tag :outreach_kind, options_for_select([['Informativo','informativo'],['Solicitação','solicitacao'],['Crítico','critico']],'solicitacao'), aria:{label:'Tipo'}, class:'ax-input' %></div><p data-outreach-status role="status"></p><%= text_field_tag :subject,nil, required:true, maxlength:180, placeholder:'Assunto', aria:{label:'Assunto'}, class:'ax-input' %><%= text_area_tag :body,nil, required:true, maxlength:20000, rows:3, placeholder:'Mensagem para o usuário', aria:{label:'Mensagem para o usuário'}, class:'ax-textarea' %><%= submit_tag 'Abrir chamado', class:'ax-btn ax-btn--primary' %><% end %>
  </details>
  <% if current_staff.admin? %><details class="ax-support-disclosure"><summary><div>Equipe de suporte<small>Consulte presença e histórico de administradores e suporte.</small></div><span>Mostrar</span></summary><p>Presença de administradores e suporte. <%= link_to 'Ver logins, sessões e SLA', sla_path %></p><% @operators.each do |staff| %><p><strong><%= staff.name %></strong> · <%= @presence.include?(staff.id) ? 'Online · conexão verificada' : 'Sem conexão recente' %></p><% end %></details><% end %>
  <div class="ax-support-inbox" data-support-inbox data-selected-ticket="<%= params[:selected].to_i %>" <%= 'data-conversation-open' if params[:selected].present? %>>
    <turbo-frame id="support_queue" class="ax-support-inbox__queue" data-support-queue="<%= support_tickets_path(request.query_parameters) %>">
      <div data-support-queue-total="<%= @total %>"></div>
      <% @tickets.each do |ticket| %><article class="ax-support-ticket-card">
        <%= link_to support_ticket_path(ticket), data:{turbo_frame:'support_conversation',support_ticket_link:ticket.id}, class:'ax-support-ticket' do %><div><strong>#<%= ticket.id %> · <%= ticket.requester_name %></strong><small><%= l(ticket.created_at,format: :short) %></small></div><div><span class="ax-support-status"><%= ticket.account.name %></span> <span class="ax-support-status ax-support-status--<%= ticket.status %>"><%= Support::Ticket::STATUS_LABELS[ticket.status] %></span><%= tag.small('Ativo') if ticket.origin == 'ativo' %></div><% end %>
        <%= render 'admin/shared/ui/support_label_badges', ticket: ticket, catalog: @label_catalog %>
        <%= render 'admin/shared/ui/support_assignee', ticket: ticket, operators: @assignment_operators %>
      </article><% end %>
      <% if @tickets.empty? %><p class="ax-support-empty">Nenhum chamado encontrado. Ajuste os filtros.</p><% end %>
      <div data-support-more class="ax-support-more" role="status">
        <% if @has_more %><%= link_to 'Carregar mais chamados', support_tickets_path(request.query_parameters.except('page').merge(after: @tickets.last.id)), class:'ax-btn', data:{support_more_link:true} %><% else %><span>Todos os chamados encontrados foram carregados.</span><% end %>
      </div>
    </turbo-frame>
    <turbo-frame id="support_conversation" class="ax-support-inbox__conversation" <%= "src=#{support_ticket_path(params[:selected])}" if params[:selected].to_s.match?(/\A\d+\z/) %>><div class="ax-support-inbox-empty"><h2>Escolha um chamado na lista</h2><p>Acompanhe a conversa, responda e consulte os detalhes por aqui.</p></div></turbo-frame>
  </div>
</section>
