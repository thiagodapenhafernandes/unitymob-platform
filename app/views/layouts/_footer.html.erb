<footer class="bg-gradient-to-br from-blue-three to-blue-one text-white">
  <% public_identity = @public_identity || Tenants::PublicIdentity.new(public_tenant) %>
  <% public_contact_setting = @contact_setting || ContactSetting.instance(tenant: public_tenant) %>
  <% footer_setting = @footer_setting || FooterSetting.instance(tenant: public_tenant) %>
  <% footer_links = Array(@footer_links).presence || footer_setting.footer_links.to_a.presence || Footer::QuickLinksService.call %>
  <% footer_stores = Array(@footer_stores).presence || public_tenant.stores.active.order(:id).to_a.presence || footer_setting.footer_stores.to_a %>
  <% footer_social_links = Array(@footer_social_links).presence || footer_setting.footer_social_links.where(enabled: true).to_a.presence || public_contact_setting.footer_social_links %>
  <% footer_whatsapp_value = footer_setting.whatsapp.presence || public_contact_setting.whatsapp_primary.presence %>
  <% footer_email_value = footer_setting.email.presence || public_contact_setting.email_primary.presence %>
  <% footer_phone_value = public_contact_setting.phone.presence %>
  <% footer_secondary_whatsapp_value = public_contact_setting.whatsapp_secondary.presence %>
  <% footer_whatsapp = Phones::Normalizer.call(footer_whatsapp_value) %>
  <% footer_secondary_whatsapp = Phones::Normalizer.call(footer_secondary_whatsapp_value) %>
  <% footer_phone = Phones::Normalizer.call(footer_phone_value) %>
  <div class="container-custom py-12 lg:py-16">
    
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      
      <!-- Company Info -->
      <div>
        <% if @layout_setting&.logo&.attached? %>
          <% if @layout_setting.logo.content_type == 'image/svg+xml' || @layout_setting.logo.filename.to_s.downcase.end_with?('.svg') %>
            <%= image_tag @layout_setting.logo, alt: @layout_setting.site_name, class: 'h-10 mb-4', style: 'max-width: 170px; object-fit: contain; filter: brightness(0) invert(1);' %>
          <% else %>
            <%= image_tag @layout_setting.logo.variant(resize_to_limit: [400, 100]), alt: @layout_setting.site_name, class: 'h-10 mb-4', style: 'max-width: 170px; object-fit: contain; filter: brightness(0) invert(1);' %>
          <% end %>
        <% else %>
          <div class="mb-4 leading-tight text-white">
            <span class="block text-xl font-extrabold tracking-wide uppercase"><%= public_identity.name %></span>
            <span class="block text-[10px] font-bold uppercase tracking-[0.26em] text-golden-one">Imóveis</span>
          </div>
        <% end %>
        <p class="text-white/80 mb-4">
          <%= footer_setting.about_text %>
        </p>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-bold mb-4 text-golden-one"><%= footer_setting.links_title %></h3>
        <ul class="space-y-2">
          <% if footer_links.any? %>
            <% footer_links.each do |link| %>
              <li>
                <%= link_to link.label,
                            link.url,
                            class: "text-white/80 hover:text-white transition-colors",
                            data: {
                              controller: "marketing-tracker",
                              action: "click->marketing-tracker#track",
                              marketing_tracker_event_type_value: "footer_click",
                              marketing_tracker_placement_value: "footer_quick_links",
                              marketing_tracker_label_value: link.label,
                              marketing_tracker_target_url_value: link.url
                            } %>
              </li>
            <% end %>
          <% else %>
            <li><%= link_to "Home", root_path, class: "text-white/80 hover:text-white transition-colors" %></li>
            <li><%= link_to "Buscar Imóveis", habitations_path, class: "text-white/80 hover:text-white transition-colors" %></li>
            <li><%= link_to "Contato", contato_path, class: "text-white/80 hover:text-white transition-colors" %></li>
          <% end %>
        </ul>
      </div>
      
      <!-- Store Information -->
      <div>
        <h3 class="text-lg font-bold mb-4 text-golden-one"><%= footer_setting.stores_title %></h3>
        <% if footer_stores.any? %>
          <% footer_stores.each do |store| %>
            <div class="mb-6 last:mb-0">
              <h4 class="font-bold text-white mb-1"><%= store.name %></h4>
              <ul class="space-y-1 text-sm text-white/80">
                <% if store.respond_to?(:footer_address_line) %>
                  <% if store.footer_address_line.present? %><li><%= store.footer_address_line %></li><% end %>
                  <% if store.footer_city_line.present? %><li><%= store.footer_city_line %></li><% end %>
                <% elsif store.address.present? %>
                  <li><%= store.address %></li>
                <% end %>
                <% if store.zip_code.present? %><li><strong>CEP:</strong> <%= store.zip_code %></li><% end %>
                <% if store.creci.present? %><li><strong>CRECI:</strong> <%= store.creci %></li><% end %>
                <% if store.phone.present? %>
                  <% store_phone = Phones::Normalizer.call(store.phone) %>
                  <li>
                    <strong>Tel:</strong>
                    <% if store_phone.present? %>
                      <a href="tel:+<%= store_phone %>" class="text-golden-one hover:text-white transition-colors"><%= format_phone(store.phone) %></a>
                    <% else %>
                      <%= store.phone %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <p class="text-white/60 text-sm italic">Nenhuma loja cadastrada.</p>
        <% end %>
      </div>
      
      <!-- Contact & Social -->
      <div>
        <h3 class="text-lg font-bold mb-4 text-golden-one"><%= footer_setting.contact_title %></h3>
        <ul class="space-y-3 text-white/80 mb-6 font-medium">
          <% if footer_whatsapp_value.present? %>
            <li class="flex items-center">
              <i class="bi bi-whatsapp mr-2 flex-shrink-0 text-golden-one text-lg"></i>
              <% if footer_whatsapp.present? %>
                <a href="https://wa.me/<%= footer_whatsapp %>" target="_blank" class="hover:text-white transition-colors">
                  <%= format_phone(footer_whatsapp_value) %>
                </a>
              <% else %>
                <%= footer_whatsapp_value %>
              <% end %>
            </li>
          <% end %>
          <% if footer_secondary_whatsapp_value.present? && footer_secondary_whatsapp != footer_whatsapp %>
            <li class="flex items-center">
              <i class="bi bi-whatsapp mr-2 flex-shrink-0 text-golden-one text-lg"></i>
              <% if footer_secondary_whatsapp.present? %>
                <a href="https://wa.me/<%= footer_secondary_whatsapp %>" target="_blank" class="hover:text-white transition-colors">
                  <%= format_phone(footer_secondary_whatsapp_value) %>
                </a>
              <% else %>
                <%= footer_secondary_whatsapp_value %>
              <% end %>
            </li>
          <% end %>
          <% if footer_phone_value.present? %>
            <li class="flex items-center">
              <i class="bi bi-telephone mr-2 flex-shrink-0 text-golden-one text-lg"></i>
              <% if footer_phone.present? %>
                <a href="tel:+<%= footer_phone %>" class="hover:text-white transition-colors">
                  <%= format_phone(footer_phone_value) %>
                </a>
              <% else %>
                <%= footer_phone_value %>
              <% end %>
            </li>
          <% end %>
          <% if footer_email_value.present? %>
            <li class="flex items-center">
              <i class="bi bi-envelope mr-2 flex-shrink-0 text-golden-one text-lg"></i>
              <a href="mailto:<%= footer_email_value %>" class="hover:text-white transition-colors">
                <%= footer_email_value %>
              </a>
            </li>
          <% end %>
        </ul>
        
        <!-- Social Media -->
        <% if footer_social_links.any? %>
          <h4 class="font-bold text-white mb-3"><%= footer_setting.social_title %></h4>
          <div class="flex flex-wrap gap-2">
            <% footer_social_links.each do |social| %>
              <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 hover:bg-golden-one hover:text-blue-three flex items-center justify-center transition-all" title="<%= social.platform %>" aria-label="Acessar <%= social.platform %> da #{public_identity.name}">
                <i class="bi <%= social.icon_class %>" aria-hidden="true"></i>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
      
    </div>
    
    <!-- Bottom Bar -->
    <div class="border-t border-white/20 pt-6 mt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/70 text-sm">
          <%= footer_setting.copyright_text.presence || "© #{Date.current.year} #{public_identity.name}. Todos os direitos reservados." %>
        </p>
        <div class="flex gap-4 text-sm font-medium">
          <%= link_to "Política de Privacidade", privacy_policy_path, class: "text-white/70 hover:text-white transition-colors" %>
          <span class="text-white/30">|</span>
          <%= link_to "Termos de Uso", terms_of_use_path, class: "text-white/70 hover:text-white transition-colors" %>
        </div>
      </div>
    </div>

    <div class="public-unitymob-credit mt-6 border-t border-white/10 pt-4 text-center text-xs font-semibold text-white/70">
      Developed with care by
      <a href="https://unitymob.com.br/"
         target="_blank"
         rel="noopener noreferrer"
         class="font-extrabold transition-colors hover:opacity-80"
         style="color: #65f4c7;">Unitymob</a>
    </div>
  </div>
</footer>
