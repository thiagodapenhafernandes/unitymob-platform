<%= render "layouts/header_colors", setting: @home_setting %>
<% public_header_style = @home_setting&.public_header_style %>
<header data-public-header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md transition-all duration-300"
        data-controller="navbar"
        <%= tag.attributes(style: public_header_style) if public_header_style.present? %>>
  <% public_identity = @public_identity || Tenants::PublicIdentity.new(public_tenant) %>
  <% public_contact_setting = @contact_setting || ContactSetting.instance(tenant: public_tenant) %>
  <% internal_blog = public_tenant.blog_articles.publicly_visible.exists? %>
  <% public_blog_url = internal_blog ? blog_path : public_contact_setting.blog_url %>
  <% public_phone = public_identity.phone %>
  <% menu_entries = PublicHeaderMenu.visible(@home_setting&.header_menu, blog_url: public_blog_url, youtube_url: public_contact_setting.youtube_url,
                                             context: PublicHeaderMenu::Context.new(controller_name: controller_name, params: params)) %>
  <% public_cta_label = @home_setting&.header_cta_label.presence || PublicHeaderMenu::DEFAULT_CTA_LABEL %>
  <% public_cta_url = @home_setting&.header_cta_url.presence || contato_path %>
  <div class="w-full max-w-[1600px] mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between py-3">
      
      <!-- Logo + Phone -->
      <div class="flex items-center gap-4">
        <%= link_to root_path, class: "flex items-center" do %>
          <% if @layout_setting&.logo&.attached? %>
            <span class="custom-logo flex items-center">
              <% if @layout_setting.logo.content_type == 'image/svg+xml' || @layout_setting.logo.filename.to_s.downcase.end_with?('.svg') %>
                <%= image_tag @layout_setting.logo, alt: @layout_setting.site_name, class: 'h-10', style: 'width: 170px; object-fit: contain;' %>
              <% else %>
                <%= image_tag @layout_setting.logo.variant(resize_to_limit: [400, 100]), alt: @layout_setting.site_name, class: 'h-10', style: 'width: 170px; object-fit: contain;' %>
              <% end %>
            </span>
          <% else %>
            <span class="leading-tight text-blue-three">
              <span class="block text-lg font-extrabold tracking-wide uppercase"><%= public_identity.name %></span>
              <span class="block text-[10px] font-bold uppercase tracking-[0.26em] text-golden-one">Imóveis</span>
            </span>
          <% end %>
        <% end %>
        <% if public_contact_setting.show_phone_in_header? && public_phone.present? %>
          <div class="hidden lg:flex items-center gap-2 text-sm font-semibold text-gray-700">
            <i class="bi bi-telephone"></i>
            <span><%= format_phone(public_phone) %></span>
          </div>
        <% end %>
      </div>
      
      <!-- Desktop Menu -->
      <div class="hidden xl:flex items-center gap-3 text-[13px]">
        <div data-header-part="links" class="hidden xl:flex items-center gap-1 text-gray-700">
          <% menu_entries.select(&:bar?).each do |entry| %>
            <%= link_to entry.url, class: "px-3 py-2 rounded-md font-semibold transition-colors #{entry.active? ? 'text-blue-three' : 'hover:text-blue-three'}", **public_menu_link_attrs(entry) do %><%= public_menu_label(entry) %><% end %>
          <% end %>
        </div>

        <!-- Code Search Trigger -->
        <button type="button"
                class="text-gray-500 hover:text-blue-three transition-colors p-2"
                onclick="document.dispatchEvent(new CustomEvent('open-code-search'))"
                data-header-part="search"
                title="Buscar por código"
                aria-label="Buscar imóvel por código">
          <i class="bi bi-search" aria-hidden="true"></i>
        </button>
        
        <%= link_to public_cta_label, public_cta_url, data: { header_part: "cta" }, class: "hidden lg:inline-flex items-center justify-center px-5 py-2 border border-transparent text-xs font-bold rounded-full text-white bg-blue-three hover:bg-blue-one transition-colors shadow-sm whitespace-nowrap" %>

        <!-- Hamburger for submenu -->
        <button type="button"
                class="text-blue-three p-2"
                data-header-part="toggle"
                data-action="click->navbar#toggleDesktopMenu"
                aria-label="Abrir menu principal">
          <i class="bi bi-list text-2xl" aria-hidden="true"></i>
        </button>
      </div>
      
      <!-- Mobile Menu Toggle -->
      <button type="button"
              class="lg:hidden text-blue-three p-2"
              data-header-part="toggle"
                data-action="click->navbar#toggleMobile"
              aria-label="Abrir menu principal">
        <i class="bi bi-list text-2xl" aria-hidden="true"></i>
      </button>
      
    </div>
    
    <!-- Desktop Dropdown Menu (hidden by default) -->
    <div class="hidden" data-header-part="panel" data-navbar-target="desktopMenu">
      <nav class="py-4 border-t">
        <ul class="flex flex-col gap-3">
          <% menu_entries.each do |entry| %>
            <li><%= link_to entry.url, class: "text-gray-700 hover:text-blue-three", **public_menu_link_attrs(entry) do %><%= public_menu_label(entry) %><% end %></li>
          <% end %>
        </ul>
      </nav>
    </div>
    
    <!-- Mobile Menu -->
    <div class="hidden lg:hidden" data-header-part="panel" data-navbar-target="mobileMenu">
      <nav class="py-4 border-t">
        <ul class="flex flex-col gap-3">
          <% menu_entries.each do |entry| %>
            <li><%= link_to entry.url, class: "text-gray-700 hover:text-blue-three py-2", **public_menu_link_attrs(entry) do %><%= public_menu_label(entry) %><% end %></li>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</header>
