<% tracking_setting ||= (TrackingIntegrationSetting.current if Current.tenant.present?) %>
<% if tracking_setting.present? %>
<% gtm_container_id = tracking_setting.normalized_google_tag_manager_container_id %>
<% meta_pixel_id = tracking_setting.normalized_meta_pixel_id %>
<% google_ads_conversion_id = tracking_setting.normalized_google_ads_conversion_id %>
<% google_site_verification_token = tracking_setting.normalized_google_site_verification_token %>
<% rd_station_loader_url = tracking_setting.normalized_rd_station_loader_url %>
<% has_gtm = tracking_setting.google_tag_manager_enabled? && (gtm_container_id.present? || tracking_setting.stape_enabled?) %>
<% has_meta_pixel = tracking_setting.meta_pixel_enabled? && meta_pixel_id.present? %>
<% has_google_ads = tracking_setting.google_ads_enabled? && google_ads_conversion_id.present? %>
<% has_rd_station = tracking_setting.rd_station_enabled? && rd_station_loader_url.present? %>

<% if google_site_verification_token.present? %>
  <meta name="google-site-verification" content="<%= google_site_verification_token %>">
<% end %>

<% if has_gtm || has_meta_pixel || has_google_ads || has_rd_station %>
  <script>
    (function(w,d){
      if (<%= tracking_setting.structured_events_enabled? ? "true" : "false" %> && w.UnitymobTracking) return;
      var COOKIE_KEY = "unitymob_lgpd_consent";
      var ACCEPTED_VALUE = "accepted";
      var loaded = false;
      var structuredEvents = <%= tracking_setting.structured_events_enabled? ? "true" : "false" %>;
      var lastPageContext = "";
      var initialContext = <%= raw json_escape((tracking_setting.structured_events_enabled? ? public_tracking_page_context : {}).to_json) %>;

      function pageContext() {
        var element = d.getElementById("unitymob-tracking-context");
        if (element) { try { return JSON.parse(element.textContent); } catch (_) {} }
        return initialContext;
      }

      function trackPageContext() {
        if (!structuredEvents || !consentAccepted()) return;
        var context = pageContext();
        var signature = w.location.pathname + JSON.stringify(context);
        if (lastPageContext === signature) return;
        lastPageContext = signature;
        w.dataLayer = w.dataLayer || [];
        var reset = { ecommerce: null, user_data: null, search_filters: null, results_count: null };
        ["property_id", "property_code", "property_type", "property_price", "property_bedrooms", "property_suites", "property_parking", "property_area_m2", "property_neighborhood", "property_city", "property_state"].forEach(function(key) { reset[key] = null; });
        w.dataLayer.push(reset);
        w.dataLayer.push(context);
        if (context.page_type === "property") track("view_item", context);
      }


      function consentAccepted() {
        if (w.UnitymobLgpdConsent) return w.UnitymobLgpdConsent.accepted();
        return d.cookie.split(";").some(function(cookie) { return cookie.trim() === COOKIE_KEY + "=" + ACCEPTED_VALUE; });
      }

      function loadScript(src) {
        if (d.querySelector('script[src="' + src + '"]')) return;

        var script = d.createElement("script");
        script.async = true;
        script.src = src;
        d.head.appendChild(script);
      }

      function trackingPayload(eventName, payload) {
        var data = payload || {};
        var businessTypes = <%= raw Leads::Attribution::BUSINESS_TYPE_VALUES.to_json %>;
        var businessType = data.business_type || data.negotiation_type || "general";
        var propertyCode = data.property_code || "";

        var result = {
          event: eventName,
          event_name: eventName,
          event_id: data.event_id || "",
          form_id: data.form_id || "",
          business_type: businessTypes[businessType] || businessType,
          property_id: propertyCode,
          property_code: propertyCode,
          event_category: data.event_category || "public_site",
          event_label: data.event_label || data.label || "",
          click_url: data.click_url || data.target_url || "",
          page_url: data.page_url || w.location.href,
          placement: data.placement || "",
          component: data.component || "",
          habitation_id: data.habitation_id || "",
          negotiation_type: data.negotiation_type || Object.keys(businessTypes).find(function(key) { return businessTypes[key] === businessType; }) || businessType
        };
        if (structuredEvents) {
          ["transaction_id", "lead_id", "lead_channel", "currency", "user_data", "ecommerce", "property_id", "property_type", "property_price", "property_bedrooms", "property_suites", "property_parking", "property_area_m2", "property_neighborhood", "property_city", "property_state", "page_type", "site_language"].forEach(function(key) {
            if (data[key] != null && data[key] !== "") result[key] = data[key];
          });
          Object.keys(result).forEach(function(key) { if (result[key] == null || result[key] === "") delete result[key]; });
        }
        return result;
      }

      function track(eventName, payload, options) {
        if (!consentAccepted()) return false;

        var data = trackingPayload(eventName, payload);
        w.dataLayer = w.dataLayer || [];
        var layerData = Object.assign({}, data);
        if (options && typeof options.onComplete === "function") {
          layerData.eventCallback = options.onComplete;
          layerData.eventTimeout = 500;
        }
        if (structuredEvents && eventName === "generate_lead") w.dataLayer.push({ ecommerce: null, user_data: null });
        w.dataLayer.push(layerData);

        if (typeof w.fbq === "function") {
          var pixelData = Object.assign({}, data);
          delete pixelData.user_data;
          w.fbq("trackCustom", eventName, pixelData);
        }

        return true;
      }

      function closestTrackedClick(target) {
        return target && target.closest && target.closest(
          "[data-tracking-event], [data-action*='lead-capture#open'], a[href*='wa.me/'], a[href*='api.whatsapp.com/send'], a[href^='whatsapp://send'], a[href='/contato'], a[href$='/contato']"
        );
      }

      function eventNameForClick(target) {
        if (target.dataset && target.dataset.trackingEvent) return target.dataset.trackingEvent;
        if (target.matches("[data-action*='lead-capture#open'], a[href*='wa.me/'], a[href*='api.whatsapp.com/send'], a[href^='whatsapp://send']")) return "whatsapp_click";

        var label = (target.textContent || target.getAttribute("aria-label") || target.getAttribute("title") || "").trim();
        if (target.matches("a[href='/contato'], a[href$='/contato']") || /fale\s+conosco|contato/i.test(label)) return "contact_click";

        return "";
      }

      function trackPublicClick(event) {
        var target = closestTrackedClick(event.target);
        if (!target) return;

        var eventName = eventNameForClick(target);
        if (!eventName) return;

        track(eventName, {
          event_label: target.dataset.trackingLabel || target.getAttribute("aria-label") || target.getAttribute("title") || target.textContent.trim(),
          click_url: target.href || target.dataset.trackingUrl || "",
          placement: target.dataset.trackingPlacement || "",
          component: target.dataset.trackingComponent || "",
          business_type: target.dataset.businessType || target.dataset.negotiationType || "general",
          negotiation_type: target.dataset.negotiationType || "general",
          property_code: target.dataset.propertyCode || "",
          habitation_id: target.dataset.propertyId || target.dataset.habitationId || ""
        });
      }

      function loadTracking() {
        if (loaded || !consentAccepted()) return;
        loaded = true;

        <% if has_gtm %>
          w.dataLayer = w.dataLayer || [];
          <% unless tracking_setting.stape_enabled? %>w.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });<% end %>
          <% if tracking_setting.stape_enabled? %>
            function loadStape() {
              if (!consentAccepted()) return;
              <%= render "layouts/stape_loader", tracking_setting: tracking_setting %>
            }
            fetch(<%= raw stape_cookie_path.to_json %>, { credentials: "same-origin", cache: "no-store" })
              .then(loadStape, loadStape);
          <% else %>
            loadScript("https://www.googletagmanager.com/gtm.js?id=<%= j gtm_container_id %>");
          <% end %>
        <% end %>

        <% if has_google_ads %>
          w.dataLayer = w.dataLayer || [];
          w.gtag = w.gtag || function(){ w.dataLayer.push(arguments); };
          loadScript("https://www.googletagmanager.com/gtag/js?id=<%= j google_ads_conversion_id %>");
          w.gtag("js", new Date());
          w.gtag("config", "<%= j google_ads_conversion_id %>");
        <% end %>

        <% if has_meta_pixel %>
          if (!w.fbq) {
            var fbq = w.fbq = function() {
              fbq.callMethod ? fbq.callMethod.apply(fbq, arguments) : fbq.queue.push(arguments);
            };
            if (!w._fbq) w._fbq = fbq;
            fbq.push = fbq;
            fbq.loaded = true;
            fbq.version = "2.0";
            fbq.queue = [];
          }
          loadScript("https://connect.facebook.net/en_US/fbevents.js");
          w.fbq("init", "<%= j meta_pixel_id %>");
          w.fbq("track", "PageView");
        <% end %>

        <% if has_rd_station %>
          loadScript("<%= j rd_station_loader_url %>");
        <% end %>
      }

      w.UnitymobTracking = { load: loadTracking, track: track };
      trackPageContext();
      d.addEventListener("turbo:load", trackPageContext);
      w.addEventListener("unitymob:lgpd-consent-accepted", trackPageContext);
      w.addEventListener("unitymob:lgpd-consent-rejected", function() { lastPageContext = ""; });
      loadTracking();
      d.addEventListener("click", trackPublicClick, true);
      w.addEventListener("unitymob:lgpd-consent-accepted", loadTracking);
      <% if tracking_setting.stape_enabled? %>
        function clearStapeCookie() {
          fetch(<%= raw stape_cookie_path.to_json %>, { credentials: "same-origin", cache: "no-store", keepalive: true }).catch(function() {});
        }
        w.addEventListener("unitymob:lgpd-consent-rejected", clearStapeCookie);
        if (!consentAccepted() && d.cookie.split(";").some(function(cookie) { return cookie.trim().indexOf("si_uid=") === 0; })) clearStapeCookie();
      <% end %>
    })(window, document);
  </script>
<% end %>
<% end %>
