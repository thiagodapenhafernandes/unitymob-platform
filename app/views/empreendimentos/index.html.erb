<%
  variant = theme_variant
  filters_active = [params[:q], @selected_phase, @selected_city].any?(&:present?) || params[:ordem].present?
  total = @empreendimentos.total_entries
  page_title = @strategic_landing&.dig(:title).presence || "Empreendimentos"
  listing_seo = current_public_seo_setting
%>

<div class="public-theme-developments public-theme-developments--<%= variant %> public-header-offset mt-[72px]">
  <div class="container-custom public-theme-developments__container">
    <%= render "public_theme/components/page_head",
          eyebrow: "Lançamentos, obras e prontos",
          title: page_title,
          lead: "Conheça os projetos disponíveis, compare fases e regiões e veja as unidades de cada empreendimento.",
          variant: variant %>

    <%# Busca e filtros numa linha (GET): nome com sugestões nativas, fase, cidade e ordem. %>
    <%= form_with url: request.path, method: :get, local: true, class: "public-theme-developments__toolbar", role: "search" do %>
      <label class="public-theme-developments__field public-theme-developments__field--search">
        <span class="public-theme-developments__label">Nome</span>
        <span class="public-theme-developments__input-wrap">
          <i class="bi bi-search" aria-hidden="true"></i>
          <%= search_field_tag :q, params[:q], placeholder: "Nome do empreendimento", list: "development-names", autocomplete: "off", class: "public-theme-developments__input" %>
        </span>
        <datalist id="development-names">
          <% @development_names.each do |name| %><option value="<%= name %>"></option><% end %>
        </datalist>
      </label>
      <label class="public-theme-developments__field">
        <span class="public-theme-developments__label">Fase</span>
        <%= select_tag :fase, options_for_select([["Todas as fases", ""]] + EmpreendimentosController::DEVELOPMENT_PHASES.invert.to_a, @selected_phase), class: "public-theme-developments__input" %>
      </label>
      <label class="public-theme-developments__field">
        <span class="public-theme-developments__label">Cidade</span>
        <%= select_tag :cidade, options_for_select([["Todas as cidades", ""]] + @development_city_options.map { [_1, _1] }, @selected_city), class: "public-theme-developments__input" %>
      </label>
      <label class="public-theme-developments__field">
        <span class="public-theme-developments__label">Ordenar</span>
        <%= select_tag :ordem, options_for_select(EmpreendimentosController::DEVELOPMENT_SORTS.invert.to_a, @selected_sort), class: "public-theme-developments__input" %>
      </label>
      <div class="public-theme-developments__actions">
        <button type="submit" class="public-theme-developments__submit"><i class="bi bi-search" aria-hidden="true"></i>Buscar</button>
        <% if filters_active %>
          <%= link_to "Limpar", request.path, class: "public-theme-developments__clear" %>
        <% end %>
      </div>
    <% end %>

    <% if @empreendimentos.any? %>
      <p class="public-theme-developments__count">
        <strong><%= total %></strong> <%= total == 1 ? "empreendimento" : "empreendimentos" %><%= " encontrados" if filters_active %>
      </p>

      <div class="public-theme-developments__grid">
        <% @empreendimentos.each do |empreendimento| %>
          <% unit_count = @unit_counts[empreendimento.codigo].to_i %>
          <% unit_metric = @unit_metrics[empreendimento.codigo] %>
          <% cache ["public-development-listing-card-v3", public_tenant.id, variant, empreendimento.cache_key_with_version, unit_count, unit_metric], expires_in: 15.minutes do %>
            <%= render "shared/tailwind/development_card", development: empreendimento, unit_count: unit_count, unit_metric: unit_metric %>
          <% end %>
        <% end %>
      </div>

      <%= theme_component(:pagination, collection: @empreendimentos,
            path_helper: ->(page) { url_for(request.query_parameters.merge(page: page).compact_blank.merge(only_path: true)) }) %>
    <% else %>
      <div class="public-theme-developments__empty">
        <i class="bi bi-building-slash" aria-hidden="true"></i>
        <h2>Nenhum empreendimento encontrado</h2>
        <p><%= filters_active ? "Tente outra combinação de nome, fase ou cidade." : "Não há empreendimentos disponíveis no momento." %></p>
        <% if filters_active %><%= link_to "Ver todos os empreendimentos", empreendimentos_path, class: "public-theme-developments__submit" %><% end %>
      </div>
    <% end %>

    <%# Texto de SEO e buscas relacionadas depois da grade: o cliente vê os
        empreendimentos primeiro; o texto continua indexável (só recolhido). %>
    <% if listing_seo&.public_applicable? && listing_seo.intro_text.present? %>
      <section class="public-theme-developments__about public-collapsible-text"
               data-controller="collapsible-text" data-collapsible-text-collapsed-height-value="120">
        <div id="empreendimentos-sobre" class="public-collapsible-text__content" data-collapsible-text-target="content">
          <%= simple_format(listing_seo.intro_text) %>
        </div>
        <button type="button" class="public-collapsible-text__toggle" data-collapsible-text-target="toggle"
                data-action="collapsible-text#toggle" aria-controls="empreendimentos-sobre" aria-expanded="false" hidden>
          <span data-collapsible-text-label>Ler mais</span>
          <i class="public-collapsible-text__icon bi bi-chevron-down" aria-hidden="true"></i>
        </button>
      </section>
    <% end %>

    <% related_links = Seo::StrategicLanding.available_development_links %>
    <% if related_links.any? %>
      <nav class="public-theme-developments__related" aria-label="Buscas relacionadas de empreendimentos">
        <span class="public-theme-developments__label">Buscas relacionadas</span>
        <div class="public-theme-developments__related-links">
          <% related_links.each do |link| %>
            <%= link_to link[:label], link[:path], class: "public-theme-developments__related-link" %>
          <% end %>
        </div>
      </nav>
    <% end %>
  </div>
</div>

<script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "ItemList",
    "name" => @page_title.presence || "Empreendimentos #{@layout_setting&.site_name.presence || 'Unitymob'}",
    "numberOfItems" => @empreendimentos.size,
    "itemListElement" => @empreendimentos.each_with_index.map do |empreendimento, index|
      image = empreendimento.primary_image_url
      item = {
        "@type" => "ListItem",
        "position" => index + 1,
        "url" => empreendimento_details_url(empreendimento),
        "name" => empreendimento.nome_empreendimento.presence || empreendimento.display_title
      }
      item["image"] = image if image.present?
      item
    end
  }.to_json) %>
</script>
