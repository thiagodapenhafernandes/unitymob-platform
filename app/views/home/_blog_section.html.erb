<section class="home-deferred-section py-16 <%= bg_class %>" data-public-home-section="<%= section.id %>" data-public-home-section-type="blog" data-public-home-section-title="<%= section.title %>">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h2 class="text-3xl lg:text-4xl font-bold text-blue-three mb-2"><%= section.title %></h2>
      <% if section.subtitle.present? %><p class="text-gray-500"><%= section.subtitle %></p><% end %>
    </div>
    <div class="blog-grid"><%= render partial: "blog/card", collection: articles, as: :article %></div>
    <div class="text-center mt-8">
      <%= link_to "Ver todos os artigos", blog_path, class: "inline-block px-10 py-4 bg-blue-three text-white font-bold rounded-lg hover:bg-golden-one hover:text-blue-three transition-all duration-300", data: { public_home_section_id: section.id, public_home_section_type: "blog", public_home_section_title: section.title } %>
    </div>
  </div>
</section>
