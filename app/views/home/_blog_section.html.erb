<section class="home-deferred-section public-theme-home-section--<%= theme_variant %> <%= bg_class %>" data-public-home-section="<%= section.id %>" data-public-home-section-type="blog" data-public-home-section-title="<%= section.title %>">
  <div class="container-custom">
    <%= render "public_theme/components/section_head", title: section.title, lead: section.subtitle, variant: theme_variant %>
    <div class="blog-grid"><%= render partial: "blog/card", collection: articles, as: :article %></div>
    <div class="public-theme-section__actions">
      <%= link_to "Ver todos os artigos", blog_path, class: "public-theme-section__cta public-theme-section__cta--#{theme_variant}", data: { public_home_section_id: section.id, public_home_section_type: "blog", public_home_section_title: section.title } %>
    </div>
  </div>
</section>
