<%
  manual_video_items = section.home_section_items.active.video_items.ordered.filter_map do |item|
    video = home_section_item_video_payload(item)
    next if video.blank?

    location = item.location.presence || "Vídeo em destaque"
    city_key = I18n.transliterate(location.to_s).downcase.squish
    {
      video: video,
      poster: video[:poster_url],
      path: nil,
      city: location,
      city_key: city_key,
      location: location,
      title: item.title,
      price: item.price_label.presence || "Preço sob consulta",
      badges: Array(item.badges).first(2)
    }
  end

  property_video_items = properties.filter_map do |property|
    video = home_property_video_payload(property)
    next if video.blank?

    city = property.address&.cidade.presence || property.cidade.presence || "Outras cidades"
    city_key = I18n.transliterate(city.to_s).downcase.squish

    {
      property: property,
      video: video,
      poster: home_property_video_poster(property, video),
      path: public_habitation_detail_path(property),
      city: city,
      city_key: city_key,
      location: property.public_location_label.presence || property.cidade.presence,
      title: property.display_title,
      price: home_video_price_label(property),
      badges: property.display_badges.first(2).map { |badge| badge[:text] }
    }
  end
  video_items = manual_video_items + property_video_items
  cities = video_items.each_with_object({}) { |item, options| options[item[:city_key]] ||= item[:city] }
%>

<% if video_items.present? %>
  <section class="home-video-section home-video-section--<%= theme_variant %> public-theme-home-section--<%= theme_variant %> <%= bg_class %>"
           data-controller="home-video-showcase"
           data-public-home-section="<%= section.id %>"
           data-public-home-section-type="<%= section.section_type %>"
           data-public-home-section-title="<%= section.title %>">
    <div class="container-custom">
      <div class="home-video-section__header">
        <%= render "public_theme/components/section_head", title: section.title, lead: section.subtitle, variant: theme_variant %>

        <% if cities.any? %>
          <div class="home-video-section__chips" aria-label="Filtrar vídeos por cidade">
            <button type="button"
                    class="home-video-section__chip is-active"
                    data-home-video-showcase-target="chip"
                    data-home-video-showcase-city-param=""
                    data-action="home-video-showcase#filter">
              Todas as cidades
            </button>
            <% cities.each do |city| %>
              <button type="button"
                      class="home-video-section__chip"
                      data-home-video-showcase-target="chip"
                      data-home-video-showcase-city-param="<%= city.first %>"
                      data-action="home-video-showcase#filter">
                <%= city.last %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="home-video-section__rail" aria-label="Vídeos de imóveis em destaque">
        <% video_items.each_with_index do |item, index| %>
          <% video = item[:video] %>
          <article class="home-video-card"
                   data-home-video-showcase-target="card"
                   data-city="<%= item[:city_key] %>">
            <button type="button"
                    class="home-video-card__trigger"
                    aria-label="Assistir vídeo de <%= item[:title] %>"
                    data-action="home-video-showcase#open"
                    data-home-video-showcase-index-param="<%= index %>"
                    data-title="<%= item[:title] %>"
                    data-location="<%= item[:location] %>"
                    data-price="<%= item[:price] %>"
                    data-property-url="<%= item[:path] %>"
                    data-poster="<%= item[:poster] %>"
                    data-provider="<%= video[:provider] %>"
                    data-embed-url="<%= video[:embed_url] %>"
                    data-direct-url="<%= video[:direct_url] %>"
                    data-content-type="<%= video[:content_type] %>">
              <% if item[:poster].present? %>
                <%= image_tag item[:poster],
                      alt: item[:title],
                      width: 360,
                      height: 560,
                      loading: "lazy",
                      decoding: "async",
                      class: "home-video-card__image" %>
              <% else %>
                <span class="home-video-card__empty" aria-hidden="true"><i class="bi bi-camera-video"></i></span>
              <% end %>

              <span class="home-video-card__shade" aria-hidden="true"></span>
              <% if item[:badges].any? %>
                <span class="home-video-card__badges" aria-hidden="true">
                  <% item[:badges].each do |badge| %>
                    <span class="home-video-card__badge"><%= badge %></span>
                  <% end %>
                </span>
              <% end %>
              <span class="home-video-card__play" aria-hidden="true"><i class="bi bi-play-fill"></i></span>
              <span class="home-video-card__copy">
                <% if item[:location].present? %>
                  <span class="home-video-card__location"><i class="home-video-card__location-icon bi bi-geo-alt-fill" aria-hidden="true"></i><span class="home-video-card__location-text"><%= item[:location] %></span></span>
                <% end %>
                <span class="home-video-card__title"><%= item[:title] %></span>
                <span class="home-video-card__price"><%= item[:price] %></span>
              </span>
            </button>
          </article>
        <% end %>
      </div>
    </div>

    <dialog class="home-video-modal" data-home-video-showcase-target="dialog" aria-labelledby="home-video-modal-title-<%= section.id %>">
      <form method="dialog">
        <button type="submit" class="home-video-modal__close" aria-label="Fechar vídeo">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </form>

      <button type="button" class="home-video-modal__nav home-video-modal__nav--prev" data-action="home-video-showcase#previous" aria-label="Vídeo anterior">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
      </button>

      <article class="home-video-modal__phone">
        <div class="home-video-modal__progress" data-home-video-showcase-target="progress" aria-hidden="true"></div>
        <div class="home-video-modal__media" data-home-video-showcase-target="media"></div>
        <div class="home-video-modal__info">
          <small data-home-video-showcase-target="location"></small>
          <h3 id="home-video-modal-title-<%= section.id %>" data-home-video-showcase-target="title"></h3>
          <strong data-home-video-showcase-target="price"></strong>
          <a href="#" class="home-video-modal__cta" data-home-video-showcase-target="propertyLink">
            Ver imóvel <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </article>

      <button type="button" class="home-video-modal__nav home-video-modal__nav--next" data-action="home-video-showcase#next" aria-label="Próximo vídeo">
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </button>
    </dialog>
  </section>

  <style>
    /* Título pelo contrato public-theme-section__head; aqui só o espaço até os chips. */
    .home-video-section__header {
      display: grid;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .home-video-section__header .public-theme-section__head { margin-bottom: 0; }

    .home-video-section__chips {
      display: flex;
      justify-content: safe center;
      gap: .65rem;
      overflow-x: auto;
      padding-bottom: .25rem;
      scrollbar-width: none;
    }

    .home-video-section__chips::-webkit-scrollbar {
      display: none;
    }

    .home-video-section__chip {
      flex: 0 0 auto;
      border: 1px solid var(--public-theme-border, color-mix(in srgb, var(--blue-three, var(--public-theme-primary, var(--color-primary, #022b3a))) 16%, #e5e7eb));
      border-radius: 999px;
      padding: .7rem 1.35rem;
      background: var(--public-theme-surface, #fff);
      color: var(--blue-three, var(--public-theme-primary, var(--color-primary, #022b3a)));
      font-size: .9rem;
      font-weight: 600;
      white-space: nowrap;
      box-shadow: 0 6px 16px rgba(15, 23, 42, .05);
      transition: background-color .25s ease, border-color .25s ease, color .25s ease;
    }

    .home-video-section__chip:hover {
      border-color: var(--blue-three, var(--public-theme-primary, var(--color-primary, #022b3a)));
    }

    .home-video-section__chip.is-active {
      border-color: var(--blue-three, var(--public-theme-primary, var(--color-primary, #022b3a)));
      background: var(--blue-three, var(--public-theme-primary, var(--color-primary, #022b3a)));
      color: #fff;
    }

    /* Trilho rolável: o fim some num degradê em vez de cortar o card seco. */
    .home-video-section__rail {
      display: flex;
      gap: 1.25rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding: .5rem 0 1.5rem;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 64px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 64px), transparent);
    }

    .home-video-section__rail::-webkit-scrollbar {
      display: none;
    }

    .home-video-card {
      flex: 0 0 min(78vw, 19.5rem);
      scroll-snap-align: start;
    }

    .home-video-card[hidden] {
      display: none;
    }

    .home-video-card__trigger {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 9 / 13.5;
      overflow: hidden;
      border: 0;
      border-radius: 16px;
      background: #111827;
      color: #fff;
      text-align: left;
      cursor: pointer;
      box-shadow: 0 14px 32px rgba(15, 23, 42, .12);
      transition: transform .35s ease, box-shadow .35s ease;
    }

    .home-video-card__trigger:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 50px rgba(15, 23, 42, .2);
    }

    .home-video-card__trigger:focus-visible,
    .home-video-section__chip:focus-visible,
    .home-video-modal button:focus-visible,
    .home-video-modal a:focus-visible {
      outline: 3px solid var(--golden-one, var(--public-theme-accent, var(--color-accent, #bfab25)));
      outline-offset: 3px;
    }

    .home-video-card__image,
    .home-video-card__empty {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .home-video-card__image {
      transition: transform .7s ease;
    }

    .home-video-card__trigger:hover .home-video-card__image {
      transform: scale(1.05);
    }

    .home-video-card__empty {
      display: grid;
      place-items: center;
      color: rgba(255, 255, 255, .72);
      font-size: 3rem;
    }

    .home-video-card__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, .28) 0%, rgba(0, 0, 0, 0) 24%, rgba(0, 0, 0, 0) 46%, rgba(0, 0, 0, .55) 70%, rgba(0, 0, 0, .88) 100%);
    }

    .home-video-card__badges {
      position: absolute;
      top: .9rem;
      right: .9rem;
      left: .9rem;
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      max-height: 1.75rem;
      overflow: hidden;
    }

    .home-video-card__badge {
      border: 1px solid rgba(255, 255, 255, .22);
      border-radius: 999px;
      padding: .3rem .65rem;
      background: rgba(0, 0, 0, .34);
      color: #fff;
      font-size: .66rem;
      font-weight: 700;
      letter-spacing: .12em;
      line-height: 1.1;
      text-transform: uppercase;
      white-space: nowrap;
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }

    .home-video-card__play {
      position: absolute;
      top: 50%;
      left: 50%;
      display: grid;
      place-items: center;
      width: 3.4rem;
      height: 3.4rem;
      border: 1px solid rgba(255, 255, 255, .55);
      border-radius: 999px;
      background: rgba(255, 255, 255, .18);
      color: #fff;
      font-size: 1.75rem;
      transform: translate(-50%, -50%);
      box-shadow: 0 12px 30px rgba(0, 0, 0, .22);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      transition: transform .35s ease, background-color .35s ease, color .35s ease;
    }

    .home-video-card__play .bi {
      margin-left: .15rem;
    }

    .home-video-card__trigger:hover .home-video-card__play {
      background: #fff;
      color: #111827;
      transform: translate(-50%, -50%) scale(1.08);
    }

    .home-video-card__copy {
      position: absolute;
      right: 1.1rem;
      bottom: 1.1rem;
      left: 1.1rem;
      display: grid;
      gap: .4rem;
    }

    .home-video-card__location {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: .35rem;
      color: rgba(255, 255, 255, .82);
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .home-video-card__location-icon {
      flex: none;
      color: var(--golden-one, var(--public-theme-accent, var(--color-accent, #bfab25)));
    }

    .home-video-card__location-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-video-card__title {
      display: -webkit-box;
      overflow: hidden;
      color: #fff;
      font-size: 1.1rem;
      font-weight: 600;
      line-height: 1.25;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .home-video-card__price {
      margin-top: .2rem;
      padding-top: .6rem;
      border-top: 1px solid rgba(255, 255, 255, .22);
      color: #fff;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: .01em;
    }

    @media (prefers-reduced-motion: reduce) {
      .home-video-card__trigger,
      .home-video-card__image,
      .home-video-card__play {
        transition: none;
      }
    }

    .home-video-modal {
      width: min(92vw, 46rem);
      max-width: none;
      padding: 0;
      border: 0;
      background: transparent;
      overflow: visible;
    }

    .home-video-modal::backdrop {
      background: rgba(17, 24, 39, .78);
      backdrop-filter: blur(10px);
    }

    .home-video-modal__phone {
      position: relative;
      width: min(78vw, 31.5rem);
      aspect-ratio: 9 / 16;
      margin: 0 auto;
      overflow: hidden;
      border-radius: 14px;
      background: #111827;
      color: #fff;
      box-shadow: 0 30px 80px rgba(0, 0, 0, .38);
    }

    .home-video-modal__media,
    .home-video-modal__media iframe,
    .home-video-modal__media video,
    .home-video-modal__poster {
      width: 100%;
      height: 100%;
    }

    .home-video-modal__media {
      position: relative;
    }

    .home-video-modal__media iframe,
    .home-video-modal__media video,
    .home-video-modal__poster {
      position: absolute;
      inset: 0;
      display: block;
      border: 0;
      object-fit: cover;
    }

    .home-video-modal__media iframe,
    .home-video-modal__media video {
      z-index: 1;
    }

    .home-video-modal__progress {
      position: absolute;
      top: .9rem;
      right: .9rem;
      left: .9rem;
      z-index: 5;
      display: flex;
      gap: .35rem;
    }

    .home-video-modal__progress span {
      flex: 1 1 0;
      height: 3px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, .34);
    }

    .home-video-modal__progress i {
      display: block;
      width: var(--progress, 0%);
      height: 100%;
      border-radius: inherit;
      background: rgba(255, 255, 255, .92);
    }

    .home-video-modal__progress span.is-complete i {
      --progress: 100%;
    }

    .home-video-modal__info {
      position: absolute;
      right: 1.4rem;
      bottom: 1.4rem;
      left: 1.4rem;
      display: grid;
      gap: .3rem;
      pointer-events: none;
    }

    .home-video-modal__info::before {
      content: "";
      position: absolute;
      inset: -5rem -1.4rem -1.4rem;
      z-index: -1;
      background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .72));
    }

    .home-video-modal__info small {
      color: rgba(255, 255, 255, .78);
      font-weight: 700;
    }

    .home-video-modal__info h3 {
      margin: 0;
      color: #fff;
      font-size: 1.25rem;
      font-weight: 850;
      letter-spacing: 0;
    }

    .home-video-modal__info strong {
      color: #fff;
      font-size: 1.1rem;
    }

    .home-video-modal__cta {
      pointer-events: auto;
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      margin-top: .8rem;
      border-radius: 999px;
      padding: .82rem 1.25rem;
      background: var(--golden-one, var(--public-theme-accent, var(--color-accent, #bfab25)));
      color: var(--color-hero-button-text, #fff);
      font-weight: 850;
      text-decoration: none;
    }

    .home-video-modal__close,
    .home-video-modal__nav {
      position: absolute;
      z-index: 4;
      display: grid;
      place-items: center;
      width: 3.1rem;
      height: 3.1rem;
      border: 1px solid rgba(255, 255, 255, .18);
      border-radius: 999px;
      background: rgba(15, 23, 42, .62);
      color: #fff;
      backdrop-filter: blur(10px);
    }

    .home-video-modal__close {
      top: -4rem;
      right: 0;
    }

    .home-video-modal__nav {
      top: 50%;
      transform: translateY(-50%);
    }

    .home-video-modal__nav--prev {
      left: .25rem;
    }

    .home-video-modal__nav--next {
      right: .25rem;
    }

    @media (min-width: 768px) {
      .home-video-section__header {
        align-items: end;
        grid-template-columns: minmax(0, 1fr);
      }

      .home-video-modal__nav--prev {
        left: calc(50% - min(39vw, 15.75rem) - 4.75rem);
      }

      .home-video-modal__nav--next {
        right: calc(50% - min(39vw, 15.75rem) - 4.75rem);
      }
    }

    @media (max-width: 640px) {
      .home-video-modal {
        width: 100vw;
      }

      .home-video-modal__phone {
        width: min(92vw, 27rem);
      }

      .home-video-modal__close {
        top: -3.5rem;
        right: 1rem;
      }
    }
  </style>
<% end %>
