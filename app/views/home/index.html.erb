<% content_for :head do %>
  <%= json_ld_tag(real_estate_agent_schema) %>
  <%= stylesheet_link_tag "blog" if @home_sections.any?(&:blog?) %>
<% end %>

<!-- Hero Section -->
<%= theme_component(:hero) %>

<!-- Banner Após Hero -->
<%= display_banner('home_after_hero') %>

<!-- Dynamic Home Sections (ordered by order_position) -->
<% @home_sections.each_with_index do |section, index| %>
  <%# Fundo alternado pelo tema (contrato public-theme-home-section--alt). %>
  <% bg_class = index.odd? ? 'public-theme-home-section public-theme-home-section--alt' : 'public-theme-home-section' %>
  <% payload = @home_section_payloads[section.id] || {} %>
  
  <% case payload[:kind] %>
  <% when 'blog' %>
    <%= render 'home/blog_section', section: section, articles: payload[:records], bg_class: bg_class if payload[:records].present? %>
  <% when 'city_links' %>
    <% if payload[:records].present? %>
      <section class="home-deferred-section public-theme-home-section--<%= theme_variant %> <%= bg_class %>"
               data-public-home-section="<%= section.id %>"
               data-public-home-section-type="<%= section.section_type %>"
               data-public-home-section-title="<%= section.title %>">
        <div class="container-custom">
          <%= render "public_theme/components/section_head", title: section.title, lead: section.subtitle, variant: theme_variant %>
          <%= render "public_theme/components/property_city_links", groups: payload[:records], variant: theme_variant,
                title: nil, class_name: "public-theme-city-links--home" %>
        </div>
      </section>
    <% end %>
  <% when 'properties' %>
    <% properties = payload[:records] || [] %>
    <% if properties.present? %>
      <% cache ['home_section_properties_v7', public_tenant.public_site_theme_key, section.id, section.updated_at.to_i, properties.map(&:id), properties.map(&:updated_at).max] do %>
        <section class="home-deferred-section public-theme-home-section--<%= theme_variant %> <%= bg_class %>"
                 data-public-home-section="<%= section.id %>"
                 data-public-home-section-type="<%= section.section_type %>"
                 data-public-home-section-title="<%= section.title %>">
          <div class="container-custom">
            <%= render "public_theme/components/section_head", title: section.title, lead: section.subtitle, variant: theme_variant %>

<%= render 'shared/property_carousel', properties: properties, card_partial: theme_component_path(:property_card), variant: theme_variant %>

            <div class="public-theme-section__actions">
              <%= link_to payload[:cta_path] || habitations_path,
                    class: "public-theme-section__cta public-theme-section__cta--#{theme_variant}",
                    data: {
                      public_home_section_id: section.id,
                      public_home_section_type: section.section_type,
                      public_home_section_title: section.title
                    } do %>
                <%= payload[:cta_label] || "Ver Todos os Imóveis" %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>

      <% if payload[:corporate_records].present? %>
        <%= render 'shared/corporate_showcase', properties: payload[:corporate_records] %>
      <% end %>
    <% end %>

  <% when 'property_videos' %>
    <% properties = payload[:records] || [] %>
    <% if properties.present? || section.home_section_items.active.video_items.exists? %>
      <% cache ['home_section_property_videos_v5', public_tenant.public_site_theme_key, section.id, section.updated_at.to_i, properties.map(&:id), properties.map(&:updated_at).max] do %>
        <%= render 'home/video_properties_section', section: section, properties: properties, bg_class: bg_class %>
      <% end %>
    <% end %>
    
  <% when 'developments' %>
    <% developments = payload[:records] || [] %>
    <% if developments.present? %>
      <% cache ['home_section_developments_v6', public_tenant.public_site_theme_key, section.id, section.updated_at.to_i, developments.map(&:id), developments.map(&:updated_at).max, payload[:unit_counts], payload[:unit_metrics]] do %>
        <section class="home-deferred-section public-theme-home-section--<%= theme_variant %> <%= bg_class %>"
                 data-public-home-section="<%= section.id %>"
                 data-public-home-section-type="<%= section.section_type %>"
                 data-public-home-section-title="<%= section.title %>">
          <div class="container-custom">
            <%= render "public_theme/components/section_head", title: section.title, lead: section.subtitle, variant: theme_variant %>

            <%= render 'shared/development_carousel', developments: developments, unit_counts: payload[:unit_counts], unit_metrics: payload[:unit_metrics] %>

            <div class="public-theme-section__actions">
              <%= link_to payload[:cta_path] || empreendimentos_path,
                    class: "public-theme-section__cta public-theme-section__cta--#{theme_variant}",
                    data: {
                      public_home_section_id: section.id,
                      public_home_section_type: section.section_type,
                      public_home_section_title: section.title
                    } do %>
                <%= payload[:cta_label] || "Ver Todos os Empreendimentos" %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>
    
  <% else %>
    <% case section.section_type %>
    <% when 'services' %>
    <!-- Custom Services Section (if implemented) -->
    
    <% when 'why_choose_us' %>
    <!-- Custom Why Choose Us Section (if implemented) -->
    
    <% when 'cta_contact' %>
    <!-- CTA Contact Section -->
    <section class="home-deferred-section py-20 bg-blue-three text-white"
             data-public-home-section="<%= section.id %>"
             data-public-home-section-type="<%= section.section_type %>"
             data-public-home-section-title="<%= section.title %>">
      <div class="container-custom text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">
          <%= section.title %>
        </h2>
        <% if section.subtitle.present? %>
          <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
            <%= section.subtitle %>
          </p>
        <% end %>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <%= link_to contato_path,
                class: "px-8 py-3 bg-golden-one text-blue-three font-bold rounded-lg hover:bg-golden-two transition-colors",
                data: {
                  public_home_section_id: section.id,
                  public_home_section_type: section.section_type,
                  public_home_section_title: section.title
                } do %>
            Fale Conosco
          <% end %>

          <% if @announce_property_form.present? %>
            <%= public_form_modal(
                  @announce_property_form,
                  trigger_label: "Anuncie seu imóvel",
                  trigger_class: "px-8 py-3 bg-white text-blue-three font-bold rounded-lg hover:bg-golden-one transition-colors inline-flex items-center justify-center gap-2"
                ) %>
          <% end %>
          
          <%# WhatsApp real da conta (antes era um número fixo de exemplo). Sem número, o botão some. %>
          <% cta_contact = @contact_setting || ContactSetting.instance(tenant: public_tenant) %>
          <% cta_whatsapp = Phones::Normalizer.call(cta_contact.whatsapp_primary.presence) %>
          <% if cta_whatsapp.present? %>
            <%= link_to "https://wa.me/#{cta_whatsapp}", target: "_blank", rel: "noopener",
                  class: "px-8 py-3 border-2 border-white text-white font-bold rounded-lg hover:bg-white hover:text-blue-three transition-colors inline-flex items-center justify-center gap-2",
                  data: {
                    public_home_section_id: section.id,
                    public_home_section_type: section.section_type,
                    public_home_section_title: section.title
                  } do %>
              <i class="bi bi-whatsapp" aria-hidden="true"></i> WhatsApp
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
    <% end %>
  <% end %>
<% end %>

<!-- Banner Antes do Rodapé -->
<%= display_banner('home_before_footer') %>
