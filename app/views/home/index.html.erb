<% content_for :head do %>
  <%= json_ld_tag(real_estate_agent_schema) %>
<% end %>

<!-- Hero Section -->
<%= render 'hero' %>

<!-- Banner Após Hero -->
<%= display_banner('home_after_hero') %>

<!-- Dynamic Home Sections (ordered by order_position) -->
<% @home_sections.each_with_index do |section, index| %>
  <% bg_class = index.even? ? 'bg-white' : 'bg-gray-50' %>
  <% payload = @home_section_payloads[section.id] || {} %>
  
  <% case payload[:kind] %>
  <% when 'properties' %>
    <% properties = payload[:records] || [] %>
    <% if properties.present? %>
      <% cache ['home_section_properties_v1', section.id, section.updated_at.to_i, properties.map(&:id), properties.map(&:updated_at).max] do %>
        <section class="home-deferred-section py-16 <%= bg_class %>">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl lg:text-4xl font-bold text-blue-three mb-2">
                <%= section.title %>
              </h2>
              <% if section.subtitle.present? %>
                <p class="text-gray-500">
                  <%= section.subtitle %>
                </p>
              <% end %>
            </div>

            <%= render 'shared/property_carousel', properties: properties %>

            <div class="text-center mt-8">
              <%= link_to payload[:cta_path] || habitations_path, class: "inline-block px-10 py-4 bg-blue-three text-white font-bold rounded-lg hover:bg-golden-one hover:text-blue-three transition-all duration-300 shadow-md hover:shadow-xl transform hover:-translate-y-0.5" do %>
                <%= payload[:cta_label] || "Ver Todos os Imóveis" %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>

      <% if payload[:corporate_records].present? %>
        <%= render 'shared/corporate_showcase', properties: payload[:corporate_records] %>
      <% end %>
    <% end %>
    
  <% when 'developments' %>
    <% developments = payload[:records] || [] %>
    <% if developments.present? %>
      <% cache ['home_section_developments_v1', section.id, section.updated_at.to_i, developments.map(&:id), developments.map(&:updated_at).max, payload[:unit_counts], payload[:unit_metrics]] do %>
        <section class="home-deferred-section py-16 <%= bg_class %>">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl lg:text-4xl font-bold text-blue-three mb-2">
                <%= section.title %>
              </h2>
              <% if section.subtitle.present? %>
                <p class="text-gray-500">
                  <%= section.subtitle %>
                </p>
              <% end %>
            </div>

            <%= render 'shared/development_carousel', developments: developments, unit_counts: payload[:unit_counts], unit_metrics: payload[:unit_metrics] %>

            <div class="text-center mt-8">
              <%= link_to payload[:cta_path] || empreendimentos_path, class: "inline-block px-10 py-4 bg-blue-three text-white font-bold rounded-lg hover:bg-golden-one hover:text-blue-three transition-all duration-300 shadow-md hover:shadow-xl transform hover:-translate-y-0.5" do %>
                <%= payload[:cta_label] || "Ver Todos os Empreendimentos" %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>
    
  <% else %>
    <% case section.section_type %>
    <% when 'services' %>
    <!-- Custom Services Section (if implemented) -->
    
    <% when 'why_choose_us' %>
    <!-- Custom Why Choose Us Section (if implemented) -->
    
    <% when 'cta_contact' %>
    <!-- CTA Contact Section -->
    <section class="home-deferred-section py-20 bg-blue-three text-white">
      <div class="container-custom text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">
          <%= section.title %>
        </h2>
        <% if section.subtitle.present? %>
          <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
            <%= section.subtitle %>
          </p>
        <% end %>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <%= link_to contato_path, class: "px-8 py-3 bg-golden-one text-blue-three font-bold rounded-lg hover:bg-golden-two transition-colors" do %>
            Fale Conosco
          <% end %>

          <% if @announce_property_form.present? %>
            <%= public_form_modal(
                  @announce_property_form,
                  trigger_label: "Anuncie seu imóvel",
                  trigger_class: "px-8 py-3 bg-white text-blue-three font-bold rounded-lg hover:bg-golden-one transition-colors inline-flex items-center justify-center gap-2"
                ) %>
          <% end %>
          
          <%= link_to "tel:+5547999999999", class: "px-8 py-3 border-2 border-white text-white font-bold rounded-lg hover:bg-white hover:text-blue-three transition-colors" do %>
            WhatsApp
          <% end %>
        </div>
      </div>
    </section>
    <% end %>
  <% end %>
<% end %>

<!-- Banner Antes do Rodapé -->
<%= display_banner('home_before_footer') %>
