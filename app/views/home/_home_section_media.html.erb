<%# Mídia pesada da seção (carrossel/vídeo). Usada inline pela primeira
    seção pesada (SEO/LCP) e via turbo-frame pelas demais — mesmo markup. %>
<% case part %>
<% when "properties" %>
  <% properties = Array(payload[:records]) %>
  <% cache ['home_section_media_v10', public_tenant.public_site_theme_key, section.id, section.updated_at.to_i, properties.map(&:id), home_cards_stamp(properties)] do %>
    <% prepare_home_cards(properties) %>
    <%= render 'shared/property_carousel', properties: properties, card_partial: theme_component_path(:property_card), variant: theme_variant %>
  <% end %>
<% when "property_videos" %>
  <% properties = Array(payload[:records]) %>
  <% cache ['home_section_videos_v9', public_tenant.public_site_theme_key, section.id, section.updated_at.to_i, properties.map(&:id), home_cards_stamp(properties)] do %>
    <% prepare_home_cards(properties) %>
    <%= render 'home/video_properties_section', section: section, properties: properties, bg_class: bg_class %>
  <% end %>
<% when "developments" %>
  <% developments = Array(payload[:records]) %>
  <% cache ['home_section_developments_v9', public_tenant.public_site_theme_key, section.id, section.updated_at.to_i, developments.map(&:id), home_cards_stamp(developments), payload[:unit_counts], payload[:unit_metrics]] do %>
    <% prepare_home_cards(developments) %>
    <%= render 'shared/development_carousel', developments: developments, unit_counts: payload[:unit_counts], unit_metrics: payload[:unit_metrics] %>
  <% end %>
<% end %>
