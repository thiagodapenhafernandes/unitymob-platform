<% content_for :mobile_detail_header do %>
  <%= render "admin/shared/ui/mobile_detail_header", title: "Fluxo de revisão", subtitle: "Configurações de imóveis", back_path: edit_admin_property_setting_path, icon: "diagram-3" %>
<% end %>


<%
  selected_checks = @selected_rule.active_broker_capture_checks
  selected_sections = @selected_rule.active_returnable_intake_edit_sections
  approval_on = @selected_rule.broker_capture_layer_enabled ? true : false
  specific = @review_result.specific?
  applicable = @review_result.applicable_checks
  ignored = @review_result.ignored_checks
  context_label = [
    PropertyReviewPolicy.registration_label(@review_registration_type),
    (@review_selected_categories.size > 1 ? "#{@review_selected_categories.size} categorias" : @review_category),
    PropertyReviewPolicy.modality_label(@review_modality)
  ].compact_blank.join(" · ")
  notifications = [("no sistema" if @review_policy.notify_internal_review_events), ("por e-mail" if @review_policy.notify_email_review_events)].compact
  check_areas = [
    { title: "Proprietário e localização", icon: "geo-alt", tone: "blue", keys: %w[proprietario proprietario_cidade endereco empreendimento unidade] },
    { title: "Anúncio", icon: "card-heading", tone: "violet", keys: %w[definicoes titulo titulo_categoria descricao] },
    { title: "Características", icon: "house-gear", tone: "teal", keys: %w[area vagas tipo_vaga box situacao ocupacao caracteristicas infraestrutura] },
    { title: "Negociação", icon: "cash-coin", tone: "green", keys: %w[valor_negociacao financeiro admin_locacao garantia_locaticia permuta parcelamento] },
    { title: "Mídia e visitas", icon: "camera", tone: "amber", keys: %w[fotos autorizacao chaves visitas] }
  ]
  ignored_keys = ignored.map { |item| item.key.to_s }
  studio_items = [
    { id: "review-tab-capture", icon: "clipboard-check", label: "Captação", hint: pluralize(selected_checks.size, "validação ativa", "validações ativas") },
    { id: "review-tab-review", icon: "person-check", label: "Revisão", hint: approval_on ? "Aprovação administrativa · #{pluralize(selected_sections.size, 'bloco devolvível', 'blocos devolvíveis')}" : "Sem aprovação administrativa" },
    { id: "review-tab-notify", icon: "bell", label: "Avisos", hint: notifications.any? ? "Avisa #{notifications.to_sentence}" : "Sem avisos" },
    { id: "review-tab-publish", icon: "globe2", label: "Publicação", hint: "Sempre manual" }
  ]
%>
<div class="public-site-workspace rvw-workspace" data-approval="<%= approval_on ? "on" : "off" %>"
     data-controller="live-preview"
     data-action="input->live-preview#sync change->live-preview#sync focusin->live-preview#focus ax:tab-shown->live-preview#focus">
  <%= ax_workspace_heading(
        eyebrow: "Configurações de imóveis · Fluxo de revisão",
        icon: "diagram-3",
        title: "Fluxo de revisão",
        pills: [@review_result.source_label],
        subtitle: "Do cadastro pelo corretor até a publicação no site. Escolha o cenário, ajuste cada etapa e acompanhe o caminho ao lado.",
        actions: ax_button("Config. de imóveis", edit_admin_property_setting_path, variant: :secondary, icon: "arrow-left")
      ) %>

  <%# ===== Cenário: para quem vale esta regra ===== %>
  <section class="rvw-scenario" aria-labelledby="rvw-scenario-title">
    <header class="rvw-scenario__head">
      <div>
        <h2 id="rvw-scenario-title">Para qual cenário é esta regra?</h2>
        <p>Cada combinação de tipo, categoria e modalidade pode ter a sua. Sem regra própria, vale a padrão da conta.</p>
      </div>
      <%= ax_badge(specific ? "Regra própria" : "Regra padrão", tone: specific ? :green : :gray, dot: true) %>
    </header>
    <%= form_with url: review_workflow_admin_property_setting_path, method: :get, local: true,
          class: "ax-field-grid ax-field-grid--12 rvw-scenario__form",
          data: { controller: "auto-submit review-policy-context", review_policy_context_categories_by_type_value: PropertyReviewPolicy::CATEGORIES_BY_REGISTRATION_TYPE.to_json } do |sf| %>
      <div class="ax-span-4">
        <%= ax_autocomplete_select_field(form: sf, method: :registration_type, label: "Tipo de cadastro", choices: @review_registration_types,
              select_options: { selected: @review_registration_type },
              html_options: { data: { review_policy_context_target: "registrationType", action: "change->review-policy-context#sync change->auto-submit#submit" } }) %>
      </div>
      <div class="ax-span-5">
        <%= ax_multiselect_field(form: sf, method: :category, label: "Categoria relacionada", choices: @review_categories.map { |category| [category, category] },
              selected: @review_selected_categories, id: "review_workflow_category", placeholder: "Selecione uma ou mais categorias",
              data: { review_policy_context_target: "category", action: "change->auto-submit#submit", tom_select_tags_value: false, tom_select_options_value: { plugins: ["remove_button"] } }) %>
      </div>
      <div class="ax-span-3">
        <%= ax_autocomplete_select_field(form: sf, method: :modality, label: "Modalidade", choices: @review_modalities, select_options: { selected: @review_modality },
              html_options: { data: { action: "change->auto-submit#submit" } }) %>
      </div>
      <noscript><%= sf.submit "Aplicar", class: "ax-btn ax-btn--sm ax-btn--primary" %></noscript>
    <% end %>
    <p class="rvw-scenario__note">
      <i class="bi bi-<%= specific ? "check-circle" : "info-circle" %>" aria-hidden="true"></i>
      <span><strong><%= context_label %></strong>.
      <% if specific %>
        Este cenário tem regra própria: a captação, a revisão e a publicação reais usam o que está abaixo.
      <% else %>
        Ainda usa a regra padrão da conta. Salvar abaixo cria uma regra própria, sem alterar os outros cenários.
      <% end %>
      <% if @review_selected_categories.size > 1 %>
        Ao salvar, a mesma regra vale para as <strong><%= @review_selected_categories.size %> categorias selecionadas</strong> (o resumo usa <%= @review_category %> como referência).
      <% end %></span>
    </p>
  </section>

  <%= form_with model: @review_policy,
        url: review_workflow_admin_property_setting_path(registration_type: @review_registration_type, category: @review_selected_categories, modality: @review_modality),
        method: :patch, local: true, html: { id: "review_workflow_form", data: { controller: "ax-dirty-form", action: "input->ax-dirty-form#mark change->ax-dirty-form#mark" } } do |f| %>
    <%= ax_error_summary(@review_policy) if @review_policy.errors.any? %>

    <div class="ax-studio">
      <div class="ax-studio__nav">
        <%= ax_studio_nav(items: studio_items, panels_selector: "#review-studio-sections", label: "Etapas do fluxo de revisão") %>
      </div>

      <div class="ax-studio__stage" id="review-studio-sections">
        <%# ===== Captação ===== %>
        <%= ax_studio_section(id: "review-tab-capture", icon: "clipboard-check", active: true, data: { live_focus: "capture" },
                              title: "Captação",
                              subtitle: "O corretor cadastra o imóvel. Estas validações precisam estar em ordem para ele conseguir enviar.") do %>
          <%= ax_studio_group(title: "Validações que bloqueiam o envio",
                              subtitle: "Marque o que o corretor precisa preencher para enviar. A aplicabilidade final ainda respeita categoria e modalidade. Ex.: garantia locatícia só bloqueia locação.",
                              actions: ax_badge("#{applicable.size} de #{selected_checks.size} valem neste cenário", tone: applicable.any? ? :blue : :amber)) do %>
            <%= hidden_field_tag "property_review_policy[required_broker_intake_checks][]", "", id: nil %>
            <div class="rvw-areas">
              <% check_areas.each do |area| %>
                <% area_checks = area[:keys].select { |key| PropertySetting::BROKER_INTAKE_CHECK_OPTIONS.key?(key) } %>
                <section class="rvw-area" style="--tone: var(--ax-accent-<%= area[:tone] %>)">
                  <header class="rvw-area__head">
                    <span class="rvw-area__icon"><i class="bi bi-<%= area[:icon] %>"></i></span>
                    <strong><%= area[:title] %></strong>
                    <span class="rvw-area__count"><%= (area_checks & selected_checks.map(&:to_s)).size %>/<%= area_checks.size %></span>
                  </header>
                  <div class="ax-chip-grid ax-chip-grid--calm ax-chip-grid--rows">
                    <% area_checks.each do |key| %>
                      <%= ax_toggle_chip(label: PropertySetting::BROKER_INTAKE_CHECK_OPTIONS[key], name: "property_review_policy[required_broker_intake_checks][]",
                                         checked_value: key, checked: selected_checks.map(&:to_s).include?(key), include_hidden: false,
                                         id: "property_review_policy_required_broker_intake_checks_#{key}",
                                         class_name: ("is-ignored" if ignored_keys.include?(key))) %>
                    <% end %>
                  </div>
                </section>
              <% end %>
            </div>
            <% if applicable.empty? %>
              <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle", compact: true, body: "Nenhuma validação aplicável neste cenário. O corretor poderá enviar sem checklist.") %>
            <% end %>
          <% end %>

          <% if ignored.any? %>
            <%= ax_studio_group(title: "Não se aplica neste cenário", subtitle: "Marcadas na regra, mas ignoradas por categoria ou modalidade.", actions: ax_badge(pluralize(ignored.size, "item", "itens"), tone: :amber)) do %>
              <dl class="rvw-ignored">
                <% ignored.each do |item| %>
                  <div><dt><i class="bi bi-slash-circle"></i><%= item.label %></dt><dd><%= item.reason %></dd></div>
                <% end %>
              </dl>
            <% end %>
          <% end %>
        <% end %>

        <%# ===== Revisão ===== %>
        <%= ax_studio_section(id: "review-tab-review", icon: "person-check", data: { live_focus: "review" },
                              title: "Revisão",
                              subtitle: "Depois do checklist, alguém confere? E se algo estiver errado, o que o corretor pode corrigir?") do %>
          <%= ax_studio_group(title: "Aprovação administrativa", subtitle: "Ligada, a captação espera a revisão antes de seguir. Desligada, vai direto para Publicar Site (a publicação continua manual).") do %>
            <%= ax_switch_field(form: f, method: :broker_capture_layer_enabled, label: "Exigir aprovação administrativa antes de publicar",
                                description: "Um revisor confere a captação antes de ela seguir para Publicar Site.",
                                checked_value: "true", unchecked_value: "false", class_name: "ax-switch--card", input_html: { data: { live_attr: "approval" } }) %>
          <% end %>

          <%= ax_studio_group(title: "Se devolver ao corretor", subtitle: "Estes blocos reabrem para edição quando o administrativo devolve a captação. O restante continua protegido.",
                              class_name: "rvw-returnable") do %>
            <%= ax_check_group(form: f, method: :returnable_intake_edit_sections, choices: PropertySetting::RETURNABLE_INTAKE_EDIT_SECTION_OPTIONS.to_a, selected: selected_sections, class_name: "ax-chip-grid--calm") %>
          <% end %>
        <% end %>

        <%# ===== Avisos ===== %>
        <%= ax_studio_section(id: "review-tab-notify", icon: "bell", data: { live_focus: "review" },
                              title: "Avisos",
                              subtitle: "Quem fica sabendo quando a captação é enviada, aprovada, devolvida ou publicada.") do %>
          <%= ax_studio_group(title: "Como avisar") do %>
            <div class="ax-studio-switches ax-studio-switches--2">
              <%= ax_switch_field(form: f, method: :notify_internal_review_events, label: "Avisar admins e revisores dentro do sistema",
                                  description: "Notificação no painel a cada envio, aprovação, devolução ou publicação.",
                                  checked_value: "true", unchecked_value: "false", class_name: "ax-switch--card") %>
              <%= ax_switch_field(form: f, method: :notify_email_review_events, label: "Enviar e-mail também",
                                  description: "Mesmo aviso, por e-mail, para quem está na lista abaixo.",
                                  checked_value: "true", unchecked_value: "false", class_name: "ax-switch--card") %>
            </div>
          <% end %>
          <%= ax_studio_group(title: "Quem recebe e-mail de acompanhamento", subtitle: "Além dos administradores e revisores ativos, que sempre recebem o aviso no sistema.") do %>
            <%= ax_text_field(form: f, method: :review_notification_emails, type: :textarea, rows: 3, label: "E-mails", placeholder: "admin1@empresa.com, admin2@empresa.com",
                              hint: "Use vírgula, ponto e vírgula ou uma linha por e-mail.") %>
          <% end %>
        <% end %>

        <%# ===== Publicação ===== %>
        <%= ax_studio_section(id: "review-tab-publish", icon: "globe2", data: { live_focus: "publish" },
                              title: "Publicação",
                              subtitle: "Nada a configurar aqui: é o resultado das etapas anteriores.") do %>
          <%= ax_studio_group(title: "O que acontece ao final") do %>
            <dl class="rvw-outcome">
              <div>
                <dt>Depois do checklist</dt>
                <dd>
                  <strong class="rvw-outcome__on">Revisão administrativa</strong>
                  <strong class="rvw-outcome__off">Publicar Site</strong>
                </dd>
              </div>
              <div><dt>Publicação no site</dt><dd><%= ax_badge("Sempre manual", tone: :amber) %></dd></div>
              <div><dt>Origem da regra</dt><dd><%= ax_badge(@review_result.source_label, tone: specific ? :green : :gray) %></dd></div>
            </dl>
          <% end %>
          <%= ax_inline_notice(tone: :info, icon: "shield-check", compact: true, body: "Nenhuma captação é publicada sozinha, com ou sem revisão administrativa. A regra salva vale para a operação real.") %>
        <% end %>
      </div>

      <aside class="ax-studio__aside" aria-label="Caminho da captação neste cenário">
        <div class="rvw-flow">
          <div class="rvw-flow__label"><span class="rvw-flow__live"></span> Caminho da captação</div>
          <p class="rvw-flow__scope"><%= context_label %></p>
          <ol class="rvw-flow__steps">
            <li class="rvw-step" data-step="capture" data-live-focus-target="capture">
              <span class="rvw-step__dot"><i class="bi bi-pencil-square"></i></span>
              <div><strong>Corretor cadastra</strong><small><%= applicable.any? ? "#{pluralize(applicable.size, 'validação', 'validações')} para poder enviar" : "Sem validações obrigatórias" %></small></div>
            </li>
            <li class="rvw-step rvw-step--review" data-step="review" data-live-focus-target="review">
              <span class="rvw-step__dot"><i class="bi bi-person-check"></i></span>
              <div><strong>Revisão administrativa</strong><small>Aprova ou devolve<%= selected_sections.any? ? " (o corretor corrige #{pluralize(selected_sections.size, 'bloco', 'blocos')})" : "" %></small></div>
            </li>
            <li class="rvw-step rvw-step--skip" data-step="review">
              <span class="rvw-step__dot"><i class="bi bi-skip-forward"></i></span>
              <div><strong>Sem revisão</strong><small>Segue direto para Publicar Site</small></div>
            </li>
            <li class="rvw-step" data-step="publish" data-live-focus-target="publish">
              <span class="rvw-step__dot"><i class="bi bi-globe2"></i></span>
              <div><strong>Publicação no site</strong><small>Sempre manual</small></div>
            </li>
          </ol>
          <p class="rvw-flow__note"><%= notifications.any? ? "Cada passo avisa #{notifications.to_sentence}." : "Os avisos estão desligados." %></p>
        </div>
      </aside>
    </div>

    <%= ax_studio_savebar(form: f, cancel_path: edit_admin_property_setting_path, submit_label: "Salvar regra deste cenário") %>
  <% end %>
</div>
