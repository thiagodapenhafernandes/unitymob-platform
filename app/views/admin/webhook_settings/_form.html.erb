<%= form_with(model: [:admin, webhook_setting], data: { controller: "ax-dirty-form", action: "input->ax-dirty-form#mark change->ax-dirty-form#mark" }) do |f| %>
  <%= ax_error_summary(webhook_setting) %>
  <div class="webhook-settings-main-stack">
    <%= ax_operational_panel(eyebrow: "01 · Destino", title: "Identificação e envio", actions: ax_badge(webhook_setting.enabled? ? "ativo" : "inativo", tone: webhook_setting.enabled? ? :green : :gray)) do %>
      <%= ax_studio_group(title: "Para onde enviar", subtitle: "Uma configuração por integração. Os eventos selecionados são enviados por POST em JSON.") do %>
        <%= ax_text_field(form: f, method: :description, label: "Descrição / Identificação", placeholder: "Ex.: Conversões · GTM Server") %>
        <%= ax_field_grid do %>
          <div class="ax-span-6">
            <%= f.label :webhook_url, "URL do Webhook (Padrão)", class: "ax-label" %>
            <%= ax_input_group(prefix: tag.i(class: "bi bi-globe")) do %>
              <%= f.url_field :webhook_url, class: "ax-control", placeholder: "https://seu-servidor.com/webhook" %>
            <% end %>
          </div>
          <div class="ax-span-6">
            <%= f.label :whatsapp_webhook_url, "URL alternativa (WhatsApp/Leads)", class: "ax-label" %>
            <%= ax_input_group(prefix: tag.i(class: "bi bi-whatsapp")) do %>
              <%= f.url_field :whatsapp_webhook_url, class: "ax-control", placeholder: "https://seu-servidor.com/webhook/leads" %>
            <% end %>
          </div>
        <% end %>
        <p class="ax-field__hint">Se a URL alternativa estiver preenchida, ela recebe os envios desta configuração no lugar da URL padrão.</p>
      <% end %>
      <%= ax_studio_group(title: "Conversões Google do funil", subtitle: "Ative somente no destino GTM - STAPE desta conta. Os eventos de entrada continuam separados.") do %>
        <%= ax_switch_field(form: f, method: :google_conversions_enabled, label: "Receber conversões Google por etapa", description: "Um único destino por conta, usando a URL alternativa quando preenchida.") %>
        <%= ax_text_field(form: f, method: :webhook_secret, type: :password, label: "Segredo", value: nil, autocomplete: "new-password", placeholder: "Em branco mantém o segredo atual") %>
        <p class="ax-field__hint">O segredo é enviado em X-Webhook-Secret. Mapear Lead qualificado em uma etapa desmarca Lead marcado como qualificado neste destino para usar uma única origem.</p>
      <% end %>
      <%= ax_studio_group(title: "Ativação e captura", subtitle: "A captura abre o modal no site. A seleção de eventos abaixo controla o envio externo.") do %>
        <%= ax_field_grid do %>
          <div class="ax-span-6"><%= ax_switch_field(form: f, method: :enabled, label: "Habilitar webhook", id: "webhook_enabled", class_name: "ax-switch--card", description: "Desativado, nenhum evento novo é enviado por esta configuração.") %></div>
          <div class="ax-span-6"><%= ax_switch_field(form: f, method: :lead_capture_enabled, label: "Captura de Leads (Modal)", id: "lead_capture_enabled", class_name: "ax-switch--card", description: "Participa da ativação do formulário de contato antes de abrir o WhatsApp.") %></div>
        <% end %>
      <% end %>
    <% end %>

    <%= ax_operational_panel(eyebrow: "02 · Gatilhos", title: "Eventos e filtros") do %>
      <%= ax_studio_group(title: "Quando enviar", subtitle: "Selecione os acontecimentos que esta integração deve receber. Alterações no CRM são opcionais e não dependem do modal do site.") do %>
        <%= ax_check_group(form: f, method: :subscribed_events, legend: "Eventos enviados", choices: WebhookSetting::EVENTS.to_a) %>
        <p class="ax-field__hint">“Lead capturado” é a criação pelo site. “Qualificado” ocorre quando corretor ou gestor muda sua avaliação para Qualificado; não é inferido pelo nome da etapa.</p>
        <p class="ax-field__hint">Se marcar “Qualificação alterada” e “Lead marcado como qualificado”, a mesma mudança pode gerar dois eventos distintos.</p>
      <% end %>
      <%= ax_studio_group(title: "Quais formulários", subtitle: "Este filtro vale para capturas e formulários do site. Eventos de etapa e qualificação seguem a conta inteira.") do %>
        <div data-controller="conditional-reveal" data-conditional-reveal-kind-value="select">
          <%= ax_select_field(form: f, method: :form_delivery_scope, label: "Escopo dos formulários do site",
                choices: WebhookSetting::FORM_DELIVERY_SCOPES.map { |value, label| [label, value] },
                html_options: { data: { conditional_reveal_target: "trigger", action: "change->conditional-reveal#sync" } }) %>
          <div data-conditional-reveal-target="panel" data-conditional-reveal-values="categories" <%= "hidden" unless webhook_setting.form_delivery_scope == "categories" %>>
            <%= ax_check_group(form: f, method: :form_categories, legend: "Categorias atendidas", choices: PublicForm::CATEGORIES.to_a) %>
          </div>
          <div data-conditional-reveal-target="panel" data-conditional-reveal-values="forms" <%= "hidden" unless webhook_setting.form_delivery_scope == "forms" %>>
            <%= ax_check_group(form: f, method: :public_form_ids, legend: "Formulários específicos", choices: Array(@public_forms).map { |form| [form.id, form.name] }) %>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render "admin/webhook_settings/payload_reference" %>
    <div class="webhook-editor-actions">
      <%= link_to "Cancelar", admin_webhook_settings_path, class: "ax-btn ax-btn--ghost" %>
      <%= f.submit "Salvar webhook", class: "ax-btn ax-btn--primary" %>
    </div>
  </div>
<% end %>
