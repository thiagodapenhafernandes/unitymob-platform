<%= turbo_frame_tag "lead_pwa_section", target: "_top" do %>
  <%
    lead_query_params = lead_base_query_params
    lead_active_filter_count = lead_filter_labels_list.size
    lead_queue_path = distribution_queue_admin_leads_path
  %>
  <section class="lead-pwa-screen <%= 'lead-pwa-screen--kanban' if @view_mode == 'kanban' %>"
           aria-label="Leads no PWA"
           data-controller="<%= 'lead-pwa-kanban' if @view_mode == 'kanban' %>">
    <%
      pwa_kanban_active = @view_mode == "kanban"
      pwa_toggle_path = admin_leads_path(lead_query_params.merge(view: (pwa_kanban_active ? "list" : "kanban"), mobile_tab: (pwa_kanban_active ? @pwa_lead_tab : "all"), page: nil).compact)
      pwa_toggle_icon = pwa_kanban_active ? "list-ul" : "kanban"
      pwa_toggle_label = pwa_kanban_active ? "Ver em lista" : "Ver em Kanban"
      hide_pwa_kanban_toggle = !pwa_kanban_active
    %>
    <div class="lead-pwa-sticky-head">
      <div class="lead-pwa-topbar <%= 'lead-pwa-topbar--no-view-toggle' if hide_pwa_kanban_toggle %> <%= 'lead-pwa-topbar--has-clear' if lead_active_filter_count.positive? %>">
        <%= link_to lead_queue_path, class: "lead-pwa-queue", title: "Ver minhas filas de distribuição" do %>
          <strong><%= @pwa_queue_position.present? ? "#{@pwa_queue_position}º" : "-" %></strong>
          <span>na fila</span>
        <% end %>

        <%= form_with url: admin_leads_path, method: :get, class: "lead-pwa-search", local: true do |f| %>
          <i class="bi bi-search" aria-hidden="true"></i>
          <%= f.hidden_field :view, value: @view_mode %>
          <%= f.hidden_field :mobile_tab, value: @pwa_lead_tab %>
          <%= f.search_field :q, value: @q, placeholder: "Busque por nome, telefone...", autocomplete: "off", aria: { label: "Buscar leads" } %>
        <% end %>

        <button type="button"
                class="lead-pwa-filter"
                data-lead-pwa-filter-target="trigger"
                data-action="lead-pwa-filter#open"
                aria-expanded="false"
                aria-label="Abrir filtros detalhados"
                title="Filtros detalhados">
          <i class="bi bi-funnel"></i>
          <% if lead_active_filter_count.positive? %>
            <span class="lead-pwa-filter__badge"><%= lead_active_filter_count %></span>
          <% end %>
        </button>

        <% if lead_active_filter_count.positive? %>
          <%= link_to admin_leads_path(view: @view_mode, mobile_tab: @pwa_lead_tab),
                      class: "lead-pwa-clear-filter",
                      aria: { label: "Limpar filtros" },
                      title: "Limpar filtros" do %>
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          <% end %>
        <% end %>

        <% unless hide_pwa_kanban_toggle %>
          <%= link_to pwa_toggle_path,
                      class: "lead-pwa-view-toggle #{'is-active' if pwa_kanban_active}",
                      aria: { label: pwa_toggle_label },
                      title: pwa_toggle_label do %>
            <i class="bi bi-<%= pwa_toggle_icon %>" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>

      <nav class="lead-pwa-tabs <%= 'lead-pwa-tabs--kanban' if pwa_kanban_active %>" aria-label="<%= pwa_kanban_active ? 'Etapas do funil' : 'Abas de leads' %>">
        <% if pwa_kanban_active %>
          <% @pwa_kanban_statuses.each do |status| %>
            <%
              status_anchor = "pwa-kanban-status-#{status.to_s.parameterize}"
              status_color = @lead_stage_color_by_status&.[](status)
              status_style = status_color.present? ? "--lead-pwa-stage-color: #{status_color};" : nil
            %>
            <button type="button"
                    class="lead-pwa-tab"
                    style="<%= status_style %>"
                    data-action="lead-pwa-kanban#focusColumn"
                    data-lead-pwa-kanban-column-id="<%= status_anchor %>">
              <i class="bi bi-circle" aria-hidden="true"></i>
              <small>
                <span class="lead-pwa-tab__label"><%= status %></span>
                <span class="lead-pwa-tab__count"><%= number_with_delimiter(@pwa_kanban_counts_by_status.fetch(status, 0)) %></span>
              </small>
            </button>
          <% end %>
        <% else %>
          <%
            pwa_tab_items = lead_navigation_tabs(mobile: true)
          %>
          <% pwa_tab_items.each do |key, label, icon, tooltip| %>
            <% tab_path = admin_leads_path(lead_query_params.merge(view: (key == "archived" ? "list" : @view_mode), lead_tab: key, mobile_tab: key, page: nil).compact) %>
            <%
              filtered_count = @pwa_tab_counts.fetch(key, 0)
              original_count = @pwa_tab_original_counts&.fetch(key, filtered_count) || filtered_count
              count_label = if lead_active_filter_count.positive? && @pwa_lead_tab == key && filtered_count != original_count
                "#{number_with_delimiter(filtered_count)}/#{number_with_delimiter(original_count)}"
              else
                number_with_delimiter(original_count)
              end
            %>
            <%= link_to tab_path,
                        class: "lead-pwa-tab #{'is-active' if @pwa_lead_tab == key}",
                        data: { controller: "ax-tooltip", ax_tooltip_text_value: tooltip },
                        aria: { label: "#{label}. #{tooltip}", current: (@pwa_lead_tab == key ? "page" : nil) } do %>
              <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
              <small>
                <span class="lead-pwa-tab__label"><%= label %></span>
                <span class="lead-pwa-tab__count"><%= count_label %></span>
              </small>
            <% end %>
          <% end %>
        <% end %>
      </nav>
    </div>

    <% if pwa_kanban_active %>
      <div class="lead-pwa-kanban" aria-label="Kanban dos meus leads">
        <div class="lead-pwa-kanban__summary">
          <strong>Kanban dos leads</strong>
          <span><%= number_with_delimiter(@pwa_kanban_total_count.to_i) %> no funil</span>
        </div>

        <% if @pwa_kanban_statuses.any? %>
          <div class="lead-pwa-kanban__columns"
               role="list"
               data-lead-pwa-kanban-target="columns"
               data-action="scroll->lead-pwa-kanban#syncActiveFromScroll">
            <% @pwa_kanban_statuses.each do |status| %>
              <%
                column_leads = @pwa_kanban_leads_by_status.fetch(status, [])
                column_total = @pwa_kanban_counts_by_status.fetch(status, column_leads.size)
                column_anchor = "pwa-kanban-status-#{status.to_s.parameterize}"
                column_color = @lead_stage_color_by_status&.[](status)
                column_style = column_color.present? ? "--lead-pwa-stage-color: #{column_color};" : nil
              %>
              <section id="<%= column_anchor %>"
                       class="lead-pwa-kanban-column"
                       style="<%= column_style %>"
                       role="listitem"
                       data-lead-status="<%= status %>"
                       aria-label="Etapa <%= status %>">
                <header class="lead-pwa-kanban-column__head">
                  <strong><%= status %></strong>
                  <span class="lead-pwa-kanban-column__count"><%= number_with_delimiter(column_total) %></span>
                </header>
                <div class="lead-pwa-kanban-column__cards" role="list">
                  <% if column_leads.any? %>
                    <%= render partial: "admin/leads/pwa_lead_card", collection: column_leads, as: :lead, locals: { pwa_kanban_card: true } %>
                    <% if column_total > column_leads.size %>
                      <div class="lead-pwa-kanban__more">
                        Mostrando <%= column_leads.size %> de <%= number_with_delimiter(column_total) %>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="lead-pwa-kanban__empty">Sem leads nesta etapa</div>
                  <% end %>
                </div>
              </section>
            <% end %>
          </div>

          <div class="lead-pwa-kanban-sheet"
               hidden
               data-lead-pwa-kanban-target="sheet"
               data-action="click->lead-pwa-kanban#closeSheetFromBackdrop">
            <div class="lead-pwa-kanban-sheet__panel" role="dialog" aria-modal="true" aria-label="Ações rápidas do lead">
              <div class="lead-pwa-kanban-sheet__handle" aria-hidden="true"></div>
              <header class="lead-pwa-kanban-sheet__head">
                <div>
                  <strong data-lead-pwa-kanban-target="sheetName">Lead</strong>
                  <span data-lead-pwa-kanban-target="sheetMeta">Ações rápidas</span>
                </div>
                <button type="button" class="lead-pwa-kanban-sheet__close" data-action="lead-pwa-kanban#closeSheet" aria-label="Fechar">
                  <i class="bi bi-x-lg"></i>
                </button>
              </header>

              <div class="lead-pwa-kanban-sheet__section">
                <div class="lead-pwa-kanban-sheet__section-title">
                  <i class="bi bi-lightning-charge"></i><span>Ações rápidas</span>
                </div>
                <div class="lead-pwa-kanban-sheet__actions">
                  <a href="#" class="lead-pwa-kanban-sheet__action" data-lead-pwa-kanban-target="sheetOpenLink">
                    <i class="bi bi-box-arrow-up-right"></i><span>Abrir lead</span>
                  </a>
                  <% if can?(:view, :whatsapp_inbox) %>
                    <form method="post" class="tw-contents" data-lead-pwa-kanban-target="sheetWhatsappForm" data-action="submit->lead-pwa-kanban#openConversation">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <button type="submit" class="lead-pwa-kanban-sheet__action lead-pwa-kanban-sheet__action--primary w-100">
                        <i class="bi bi-whatsapp"></i><span>Conversar</span>
                      </button>
                    </form>
                  <% end %>
                </div>
              </div>

              <div class="lead-pwa-kanban-sheet__section">
                <div class="lead-pwa-kanban-sheet__section-title">
                  <i class="bi bi-kanban"></i><span>Etapa do funil</span>
                </div>
                <form method="post" class="lead-pwa-kanban-sheet__form lead-pwa-kanban-sheet__form--inline" data-lead-pwa-kanban-target="sheetStatusForm">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <input type="hidden" name="_method" value="patch">
                  <select id="lead_pwa_quick_status" name="lead[status]" aria-label="Mudar etapa" data-lead-pwa-kanban-target="sheetStatusSelect">
                    <% @pwa_kanban_statuses.each do |status| %>
                      <option value="<%= status %>"><%= status %></option>
                    <% end %>
                  </select>
                  <button type="submit" class="lead-pwa-kanban-sheet__submit lead-pwa-kanban-sheet__submit--icon" aria-label="Salvar etapa">
                    <i class="bi bi-check-lg"></i>
                  </button>
                </form>
              </div>

              <% if can?(:manage, :comercial) %>
                <div class="lead-pwa-kanban-sheet__section">
                  <div class="lead-pwa-kanban-sheet__section-title">
                    <i class="bi bi-calendar-check"></i><span>Próximas ações</span>
                  </div>
                  <div class="lead-pwa-kanban-sheet__quick-grid">
                    <form method="post" action="<%= admin_tasks_path %>" class="lead-pwa-kanban-sheet__form">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <input type="hidden" name="task[lead_id]" data-lead-pwa-kanban-target="sheetTaskLeadId">
                      <label for="lead_pwa_quick_task_title">Tarefa</label>
                      <input id="lead_pwa_quick_task_title" name="task[title]" required placeholder="Ex.: ligar">
                      <input type="datetime-local" name="task[due_at]">
                      <button type="submit" class="lead-pwa-kanban-sheet__submit">
                        <i class="bi bi-plus-lg"></i><span>Criar</span>
                      </button>
                    </form>

                    <form method="post" class="lead-pwa-kanban-sheet__form" data-lead-pwa-kanban-target="sheetScheduleForm">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <input type="hidden" name="activity_kind" value="return">
                      <label for="lead_pwa_quick_schedule_at">Retorno</label>
                      <input id="lead_pwa_quick_schedule_at" type="datetime-local" name="due_at" required>
                      <textarea name="notes" rows="2" placeholder="Observação"></textarea>
                      <button type="submit" class="lead-pwa-kanban-sheet__submit">
                        <i class="bi bi-calendar-plus"></i><span>Agendar</span>
                      </button>
                    </form>
                  </div>
                </div>
              <% end %>

              <div class="lead-pwa-kanban-sheet__section">
                <div class="lead-pwa-kanban-sheet__section-title">
                  <i class="bi bi-pencil-square"></i><span>Anotação</span>
                </div>
                <form method="post" class="lead-pwa-kanban-sheet__form" data-lead-pwa-kanban-target="sheetNoteForm">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <input type="hidden" name="contact_kind" value="nota">
                  <textarea id="lead_pwa_quick_note" name="body" rows="3" required aria-label="Anotação rápida" placeholder="Resumo da conversa, combinado ou próxima ação"></textarea>
                  <button type="submit" class="lead-pwa-kanban-sheet__submit">
                    <i class="bi bi-check2-circle"></i><span>Salvar anotação</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% else %>
          <div class="lead-pwa-empty">
            <strong>Nenhum lead no Kanban</strong>
            <span>Ajuste os filtros ou volte em Todos para ver sua carteira completa.</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="lead-pwa-list"
           role="list"
           data-controller="lead-pwa-infinite-scroll"
           data-lead-pwa-infinite-scroll-url-value="<%= pwa_leads_page_admin_leads_path(lead_query_params.merge(view: "list", mobile_tab: @pwa_lead_tab, page: nil).compact) %>">
        <% if @pwa_leads.any? %>
          <%= render partial: "admin/leads/pwa_lead_card", collection: @pwa_leads, as: :lead %>
          <%
            pwa_loaded_count = @pwa_leads.size
            pwa_total_count = @pwa_tab_counts.fetch(@pwa_lead_tab, pwa_loaded_count)
            pwa_has_more = pwa_loaded_count < pwa_total_count
          %>
          <%= tag.div(
                class: "lead-pwa-list__loader",
                hidden: !pwa_has_more,
                data: {
                  lead_pwa_infinite_scroll_target: "loader",
                  offset: pwa_loaded_count,
                  has_more: pwa_has_more
                }
              ) do %>
            <span class="lead-pwa-list__loader-pill">
              <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
              Carregando mais leads
            </span>
          <% end %>
        <% else %>
          <div class="lead-pwa-empty">
            <% if @pwa_lead_tab == "favorites" %>
              <strong>Nenhum favorito ainda</strong>
              <span>Abra um lead e toque na estrela para manter ele nesta aba.</span>
            <% else %>
              <strong>Nenhum lead nesta aba</strong>
              <span>Ajuste os filtros ou volte em Todos para ver sua carteira completa.</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= link_to new_admin_lead_path, class: "ax-pwa-action-fab lead-pwa-fab" do %>
      <i class="bi bi-plus" aria-hidden="true"></i>
      <span>Novo lead</span>
    <% end %>

  </section>
<% end %>
