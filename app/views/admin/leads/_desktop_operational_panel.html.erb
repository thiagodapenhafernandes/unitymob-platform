    <div id="<%= dom_id(lead, :desktop_operational_panel) %>" class="ax-card lead-next-action-card tw-mb-4">
      <div class="ax-card__header">
        <span class="ax-card__title"><i class="bi bi-flag-fill ax-ico"></i> Ações do lead</span>
      </div>
      <div class="ax-card__body">
        <div class="lead-operational-row tw-mb-3">
          <span class="lead-operational-row__body">
            <strong>Tentativas sem resposta</strong>
            <span>Conta contatos operacionais desde a última resposta do cliente nesta etapa.</span>
          </span>
          <span class="ax-badge ax-badge--amber"><%= lead_unsuccessful_attempt_count(lead) %></span>
        </div>
        <div class="lead-action-hub">
          <%= render "admin/leads/action_hub",
                namespace: "Desktop#{lead.id}",
                anchor_prefix: "lead-desktop",
                lead: lead,
                open_tasks: open_tasks,
                appointments: appointments,
                scheduled_tasks: scheduled_tasks,
                proposals: proposals,
                labels_count: lead.labels_for(current_admin_user).size,
                next_task: next_task,
                new_proposal: new_proposal,
                proposal_habitations: proposal_habitations,
                archive_reason_options: archive_reason_options,
                show_tasks: false,
                close_deal_form_id: "lead_close_deal_desktop_#{lead.id}" %>
        </div>

        <%= render "admin/leads/operational_sections",
              lead: lead,
              anchor_prefix: "lead-desktop",
              namespace: "DesktopSection#{lead.id}",
              divider_class: "lead-view-divider",
              schedule_modal_id: "scheduleActivitySection#{lead.id}",
              edit_appointment_modal_prefix: "editAppointmentLead",
              new_task_modal_id: "newTaskLeadSection#{lead.id}",
              edit_task_modal_prefix: "editTaskLead",
              new_proposal_modal_id: "newProposalLeadSection#{lead.id}",
              edit_proposal_modal_prefix: "editProposal",
              open_tasks: open_tasks,
              completed_tasks: completed_tasks,
              next_task: next_task,
              appointments: appointments,
              scheduled_tasks: scheduled_tasks,
              proposals: proposals,
              lead_labels: lead.labels_for(current_admin_user),
              contact_history_activities: contact_history_activities,
              contact_history_modal_id: "leadLogContactHistoryDesktopSection#{lead.id}",
              new_proposal: new_proposal,
              proposal_habitations: proposal_habitations %>

      </div>
    </div>

