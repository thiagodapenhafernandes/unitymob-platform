    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 999px;
    background: #fff;
    color: var(--ab-ink, #202a37);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
