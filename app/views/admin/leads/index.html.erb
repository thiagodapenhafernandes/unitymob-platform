    font-size: 10px;
    font-weight: 800;
  }

  .lead-desktop-queue:hover {
    border-color: color-mix(in srgb, var(--admin-primary, #365f8f) 42%, var(--ab-line, #d8dee8));
    color: var(--admin-primary, #365f8f);
    text-decoration: none;
  }

  .lead-desktop-search {
    position: relative;
    min-width: 0;
  }

  .lead-desktop-search i {
    position: absolute;
    top: 50%;
    left: 13px;
    color: #7b8797;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .lead-desktop-search input {
    width: 100%;
    min-height: 42px;
    padding: 0 14px 0 38px;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 10px;
    background: #fff;
    color: var(--ab-ink, #202a37);
    font-size: 14px;
    font-weight: 750;
    outline: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .05);
  }

  .lead-desktop-search input:focus {
    border-color: var(--admin-primary, #365f8f);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--admin-primary, #365f8f) 16%, transparent);
  }

  .lead-desktop-header__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
  }

  .lead-desktop-view-toggle {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 10px;
    background: #f8fafc;
  }

  .lead-desktop-view-toggle__item,
  .lead-desktop-header__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    padding: 0 13px;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 10px;
    background: #fff;
    color: var(--ab-ink, #202a37);
    font-size: 13px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .lead-desktop-view-toggle__item {
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .lead-desktop-view-toggle__item.is-active,
  .lead-desktop-header__button.is-primary {
    background: var(--admin-primary, #365f8f);
    color: #fff;
  }

  .lead-desktop-header__button:hover,
  .lead-desktop-view-toggle__item:hover {
    color: var(--admin-primary, #365f8f);
    text-decoration: none;
  }

  .lead-desktop-view-toggle__item.is-active:hover,
  .lead-desktop-header__button.is-primary:hover {
    color: #fff;
  }

  .lead-desktop-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(96px, 1fr));
    border-top: 1px solid var(--ab-line-soft, #e7ebf2);
  }

  .lead-desktop-tab {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 4px;
    min-width: 0;
    padding: 13px 8px 11px;
    color: var(--ab-muted, #657386);
    font-size: 13px;
    font-weight: 850;
    text-align: center;
    text-decoration: none;
  }

  .lead-desktop-tab::after {
    position: absolute;
    right: 12px;
    bottom: 0;
    left: 12px;
    height: 3px;
    border-radius: 999px 999px 0 0;
    background: transparent;
    content: "";
  }

  .lead-desktop-tab i {
    color: currentColor;
    font-size: 23px;
    line-height: 1;
  }

  .lead-desktop-tab strong,
  .lead-desktop-tab span {
    display: block;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lead-desktop-tab small {
    color: currentColor;
    font-size: 12px;
    font-weight: 850;
    opacity: .88;
  }

  .lead-desktop-tab.is-active,
  .lead-desktop-tab:hover {
    color: var(--admin-primary, #365f8f);
    text-decoration: none;
  }

  .lead-desktop-tab.is-active::after {
    background: var(--admin-primary, #365f8f);
  }

  .lead-desktop-filter-modal .ax-quick-modal__panel {
    max-width: min(1040px, calc(100vw - 44px));
    max-height: min(86vh, 820px);
    overflow: hidden;
  }

  .lead-desktop-filter-modal .ax-quick-modal__body {
    overflow-y: auto;
    padding: 0;
  }

  .lead-desktop-filter-modal .ax-leads-filters {
    display: flex;
    flex-direction: column;
    border: 0;
    box-shadow: none;
  }

  .lead-desktop-filter-modal .ax-filter-form__fields {
    display: block;
  }

  .lead-desktop-filter-modal .ax-filter-form__actions {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 14px 24px;
    border-top: 1px solid var(--ab-line-soft, #e7ebf2);
    background: color-mix(in srgb, #fff 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .lead-desktop-filter-modal .ax-filter-form__actions .ax-btn {
    min-width: 92px;
  }

  .lead-filter-form-body {
    display: grid;
    gap: 18px;
    padding: 20px 24px 8px;
  }

  .lead-filter-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lead-filter-quick__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 999px;
    background: #fff;
    color: var(--ab-ink, #202a37);
    font-size: 13px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
  }

  .lead-filter-quick__chip:hover {
    border-color: var(--admin-primary, #365f8f);
    color: var(--admin-primary, #365f8f);
    text-decoration: none;
  }

  .lead-filter-form-section {
    display: grid;
    gap: 10px;
  }

  .lead-filter-form-section__title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ab-ink, #202a37);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .lead-filter-form-section__title::after {
    flex: 1 1 auto;
    height: 1px;
    background: var(--ab-line-soft, #e7ebf2);
    content: "";
  }

  .lead-desktop-filter-modal .ax-field-grid {
    row-gap: 14px;
  }

  .lead-filter-date-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .lead-desktop-filter-modal .ax-field__label {
    display: block;
    margin: 0 0 6px;
    color: var(--ab-muted, #657386);
    font-size: 12px;
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }

  .lead-desktop-filter-modal label.ax-field__label {
    text-transform: none;
  }

  .lead-desktop-filter-modal .ax-control,
  .lead-desktop-filter-modal input:not([type="checkbox"]):not([type="radio"]),
  .lead-desktop-filter-modal select,
  .lead-desktop-filter-modal textarea {
    min-height: 40px;
    border-radius: 8px;
    font-size: 14px;
  }

  .lead-filter-active {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 2px;
  }

  .lead-filter-active__chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 26px;
    padding: 0 9px;
    border-radius: 999px;
    background: var(--admin-primary-soft, #edf4ff);
    color: var(--admin-primary, #365f8f);
    font-size: 12px;
    font-weight: 850;
  }

  .ax-leads-filter-overlay .ax-leads-filters {
    grid-template-columns: 1fr;
  }

  .ax-leads-filter-overlay .ax-filter-form__fields {
    grid-template-columns: 1fr;
  }

  .ax-leads-filter-overlay .lead-filter-quick,
  .ax-leads-filter-overlay .ax-field-grid {
    grid-column: 1 / -1;
  }

  .ax-leads-filter-overlay .lead-filter-quick {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 2px;
  }

  .ax-leads-filter-overlay .lead-filter-quick__chip {
    min-height: 34px;
    width: 100%;
    border-radius: 8px;
    font-size: 12px;
  }

  .ax-leads-filter-overlay .ax-filter-form__actions {
    justify-content: stretch;
  }

  .ax-leads-filter-overlay .ax-filter-form__actions .ax-btn {
    flex: 1 1 0;
    justify-content: center;
  }

  .lead-pwa-filter-panel {
    display: none;
  }

  .lead-pwa-filter-overlay[hidden] {
    display: none !important;
  }

  .lead-pwa-filter-empty-option {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 0 11px;
    border: 1px dashed var(--lead-pwa-line);
    border-radius: 10px;
    color: var(--lead-pwa-muted);
    font-size: 13px;
    font-weight: 750;
  }

  .lead-desktop-filter-panel {
    display: none;
  }

  .ax-leads-board .ax-board__column {
    max-height: calc(100vh - 222px);
    min-height: min(520px, calc(100vh - 222px));
  }

  .ax-leads-board .ax-board__col-body {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding-bottom: 88px;
  }

  .lead-kanban-loader {
    display: flex;
    justify-content: center;
    padding: 6px 0 2px;
  }

  .lead-kanban-loader[hidden] {
    display: none;
  }

  .lead-kanban-loader__pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    padding: 6px 10px;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 999px;
    background: #fff;
    color: var(--admin-muted, #64748b);
    font-size: 12px;
    font-weight: 800;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
  }

  @media (max-width: 991.98px) {
    .lead-desktop-header__bar {
      grid-template-columns: 1fr;
    }

    .lead-desktop-header__actions {
      justify-content: flex-start;
    }

    .lead-desktop-tabs {
      overflow-x: auto;
      grid-template-columns: repeat(5, minmax(132px, 1fr));
    }

    .lead-desktop-filter-modal .ax-quick-modal__panel {
      max-width: calc(100vw - 24px);
      max-height: calc(100vh - 24px);
    }

    .lead-filter-form-body {
      padding: 16px;
    }

    .lead-desktop-filter-modal .ax-span-3,
    .lead-desktop-filter-modal .ax-span-4,
    .lead-desktop-filter-modal .ax-span-6 {
      grid-column: span 6;
    }

    .lead-filter-date-pair {
      grid-template-columns: 1fr;
    }

    .lead-desktop-filter-modal .ax-filter-form__actions {
      padding: 12px 16px;
    }

    .lead-desktop-filter-panel {
      display: none !important;
    }

    .lead-list-row {
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
      gap: 10px;
      padding: 13px;
    }

    .lead-list-row__avatar {
      flex-basis: 34px;
      width: 34px;
      height: 34px;
      font-size: 14px;
    }

    .lead-list-row__topline {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }

    .lead-list-row__name,
    .lead-list-row__meta span,
    .lead-list-row__origin span,
    .lead-list-row__property span {
      white-space: normal;
    }

    .lead-list-row__context,
    .lead-list-row__actions {
      padding-left: 44px;
    }

    .lead-list-row__actions {
      justify-content: stretch;
    }

    .lead-list-row__actions .ax-btn {
      flex: 1 1 0;
    }

    .lead-list-row__actions .ax-icon-btn {
      flex: 0 0 30px;
    }
  }

  @media (max-width: 767.98px) {
    body.ax-app .ax-navbar,
    body.ax-app .ax-sidebar,
    body.ax-app .ax-sidebar-shell,
    body.ax-app .ax-sidebar-contextbar,
    body.ax-app .ax-contextbar {
      display: none !important;
    }

    body.ax-app > .ax-main {
      min-height: 100dvh !important;
      margin: 0 !important;
      padding: 0 !important;
      background: var(--admin-workspace-bg, #f6f8fb) !important;
    }

    html[data-admin-theme="dark"] body.ax-app > .ax-main {
      background: var(--ax-dark-workspace, #0f1726) !important;
    }

    .lead-pwa-screen {
      --lead-pwa-bg: var(--admin-workspace-bg, #f6f8fb);
      --lead-pwa-surface: var(--admin-surface, #fff);
      --lead-pwa-surface-soft: var(--admin-surface-header, #eef2f7);
      --lead-pwa-ink: var(--admin-ink, #0f172a);
      --lead-pwa-muted: var(--ab-muted, #64748b);
      --lead-pwa-line: var(--ab-line, #dfe5ed);
      --lead-pwa-line-soft: var(--ab-line-soft, #e5eaf1);
      --lead-pwa-primary: var(--admin-primary, #2478e8);
      --lead-pwa-primary-soft: color-mix(in srgb, var(--admin-primary, #2478e8) 14%, var(--admin-surface, #fff));
      --lead-pwa-head-height: calc(91px + env(safe-area-inset-top, 0px));
      display: grid !important;
      align-content: start;
      gap: 6px;
      min-height: 100dvh;
      margin: 0;
      padding: var(--lead-pwa-head-height) 8px calc(76px + env(safe-area-inset-bottom, 0px));
      background: var(--lead-pwa-bg);
    }

    .lead-pwa-screen--kanban {
      --lead-pwa-head-height: calc(101px + env(safe-area-inset-top, 0px));
    }

    html[data-admin-theme="dark"] .lead-pwa-screen {
      --lead-pwa-bg: var(--ax-dark-workspace, #0f1726);
      --lead-pwa-surface: var(--ax-dark-surface, #172238);
      --lead-pwa-surface-soft: var(--ax-dark-surface-raised, #202d43);
      --lead-pwa-ink: var(--ax-dark-text, #e8eef7);
      --lead-pwa-muted: var(--ax-dark-text-muted, #9eabc0);
      --lead-pwa-line: var(--ax-dark-border, #3b4d68);
      --lead-pwa-line-soft: var(--ax-dark-border-soft, #33445d);
      --lead-pwa-primary: var(--ax-dark-link, #9bc5ef);
