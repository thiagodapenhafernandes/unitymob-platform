<%
  status_heading = @status_filters.present? ? @status_filters.join(", ") : "Todos"
  leads_heading_pills = [@selected_pipeline&.name || "Todos os leads", status_heading]
  lead_filter_labels = []
  lead_filter_labels << "Funil" if params[:lead_pipeline_id].present?
  lead_filter_labels << "Busca" if @q.present?
  lead_filter_labels << "Status" if @status_filters.present?
  lead_filter_labels << "Etapa de funil" if @lead_pipeline_stage_id.present?
  lead_filter_labels << "Origem" if @origin.present?
  lead_filter_labels << "Canal" if @attribution_channel.present?
  lead_filter_labels << "Tags" if @tags.present?
  lead_filter_labels << (@only_mine ? "Meus leads" : "Corretor") if @broker_id.present?
  lead_filter_labels << "Imóvel" if @property_filter.present? || @property_q.present?
  lead_filter_labels << "Contato" if @contact_filter.present?
  lead_filter_labels << "Atenção operacional" if @attention_filter.present?
  lead_filter_labels << "Natureza" if @business_filters.present?
  if @activity_filters.present?
    lead_filter_labels << (@activity_filters.include?("qualification_divergence") ? "Divergência" : "Atividade")
  end
  lead_filter_labels << "Canal de origem" if @channel_filters.present?
  lead_filter_labels << "Bot" if @bot_attended
  lead_filter_labels << "Preço" if @price_min.present? || @price_max.present?
  lead_filter_labels << "Motivo de arquivamento" if @archive_reason_id.present?
  leads_can_manage_statuses = defined?(can?) && can?(:manage, :catalogos)
  leads_can_export_report = defined?(can?) && can?(:view, :lead_reports)
  lead_filter_labels << "Captações no relatório" if leads_can_export_report && @include_captacoes
  format_lead_filter_date = ->(value) do
    next if value.blank?

    begin
      l(Date.iso8601(value.to_s))
    rescue ArgumentError
      value.to_s
    end
  end
  lead_filter_period_label = ->(label, start_value, end_value) do
    formatted_start = format_lead_filter_date.call(start_value)
    formatted_end = format_lead_filter_date.call(end_value)

    if formatted_start.present? && formatted_end.present?
      "#{label}: #{formatted_start} a #{formatted_end}"
    elsif formatted_start.present?
      "#{label}: desde #{formatted_start}"
    elsif formatted_end.present?
      "#{label}: até #{formatted_end}"
    end
  end
  lead_filter_labels << lead_filter_period_label.call("Entrada", @start_date, @end_date)
  lead_filter_labels << lead_filter_period_label.call("Fechado", @closed_start_date, @closed_end_date)
  lead_filter_labels.compact!
  lead_active_filter_count = lead_filter_labels.size
  leads_heading_pills << "#{lead_active_filter_count} filtro(s)" if lead_active_filter_count.positive?

  lead_quick_base_params = lead_query_params.except("page", :page)
  lead_desktop_tab_items = [
    ["todo", "A fazer", "house-door"],
    ["visits", "Visitas", "bullseye"],
    ["future", "Futuras", "clock"],
    ["favorites", "Favoritos", "star"],
    ["all", "Todos", "archive"]
  ]
  lead_queue_path = distribution_queue_admin_leads_path
  business_filter_options = [["Compra", "sale"], ["Aluguel", "rental"], ["Indefinido", "undefined"], ["Lançamento", "launch"], ["Captação", "capture"]]
  status_filter_options = Array(@status_options).filter_map do |option|
    label, value = option.is_a?(Array) ? option : [option, option]
    next if label.blank? || value.blank?

    [label.to_s, value.to_s]
  end
  situation_filter_options = [["Precisa de ação", "requires_action"], ["Parado", "stalled"], ["Sem corretor", "unassigned"], ["Em espera", "holding"], ["Sem primeiro contato", "no_first_contact"], ["SLA atrasado", "sla_overdue"], ["Com oportunidade", "with_opportunity"], ["Com tentativa sem sucesso", "unsuccessful_attempts"], ["Elegível para redistribuição", "eligible_redistribution"], ["Segunda tentativa", "second_attempt"], ["Arquivado sem sucesso", "archived_unsuccessful"]]
  activity_filter_options = [["Primeiro contato", "first_contact"], ["Agendar atividade", "schedule_activity"], ["Retornar para o cliente", "return_customer"], ["Visita agendada", "scheduled_visit"], ["Divergência de qualificação", "qualification_divergence"]]
  channel_filter_options = [["Showroom", "showroom"], ["Telefone", "phone"], ["Rede Social", "social"], ["WhatsApp", "whatsapp"], ["Internet", "internet"]]
  desktop_search_hidden_params = lead_query_params.except("q", :q, "page", :page)
%>

<% leads_filter_form = capture do %>
    <%= ax_filter_form(url: admin_leads_path,
                       reset_path: admin_leads_path(view: @view_mode, lead_tab: @desktop_lead_tab),
                       submit_label: "Filtrar",
                       class_name: "ax-leads-filters") do |f| %>
      <%= f.hidden_field :view, value: @view_mode %>
      <%= f.hidden_field :lead_tab, value: @desktop_lead_tab %>
      <div class="lead-filter-form-body">
        <div class="lead-filter-quick" aria-label="Atalhos de filtro">
          <%= link_to admin_leads_path(lead_quick_base_params.merge(start_date: Date.current.iso8601, end_date: Date.current.iso8601)),
                      class: "lead-filter-quick__chip" do %>
            <i class="bi bi-calendar-day"></i><span>Hoje</span>
          <% end %>
