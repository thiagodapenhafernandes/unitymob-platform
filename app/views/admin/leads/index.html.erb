    .lead-pwa-topbar {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr) 36px 36px;
      gap: 7px;
      align-items: center;
    }

    .lead-pwa-topbar--no-view-toggle {
      grid-template-columns: 36px minmax(0, 1fr) 36px;
    }

    .lead-pwa-topbar--has-clear {
      grid-template-columns: 36px minmax(0, 1fr) 36px 36px 36px;
    }

    .lead-pwa-topbar--no-view-toggle.lead-pwa-topbar--has-clear {
      grid-template-columns: 36px minmax(0, 1fr) 36px 36px;
    }

    .lead-pwa-queue {
      display: grid;
      place-items: center;
      min-height: 30px;
      color: var(--lead-pwa-ink);
      line-height: 1;
      text-decoration: none;
    }

    .lead-pwa-queue strong {
      color: var(--lead-pwa-primary);
      font-size: 16px;
      font-weight: 400;
      letter-spacing: 0;
    }

    .lead-pwa-queue span {
      margin-top: 2px;
      color: var(--lead-pwa-muted);
      font-size: 10px;
      font-weight: 500;
    }

    .lead-pwa-search {
      display: grid;
      grid-template-columns: 24px minmax(0, 1fr);
      align-items: center;
      min-height: 36px;
      padding: 0 10px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 13px;
      background: var(--lead-pwa-surface);
      box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

    .lead-pwa-search i {
      color: var(--lead-pwa-muted);
      font-size: 16px;
    }

    .lead-pwa-search input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      color: var(--lead-pwa-ink);
      font-size: 13px;
      font-weight: 300;
      background: transparent;
      color-scheme: light dark;
    }

    .lead-pwa-search input::placeholder {
      color: var(--lead-pwa-muted);
      opacity: .72;
    }

    .lead-pwa-filter,
    .lead-pwa-clear-filter,
    .lead-pwa-view-toggle {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 13px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-muted);
      font-size: 16px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

    .lead-pwa-clear-filter {
      border-color: color-mix(in srgb, #ef4444 36%, var(--lead-pwa-line));
      background: color-mix(in srgb, #ef4444 8%, var(--lead-pwa-surface));
      color: #dc2626;
      text-decoration: none;
    }

    .lead-pwa-view-toggle {
      text-decoration: none;
    }

    .lead-pwa-view-toggle.is-active {
      border-color: color-mix(in srgb, var(--lead-pwa-primary) 48%, var(--lead-pwa-line));
      background: var(--lead-pwa-primary-soft);
      color: var(--lead-pwa-primary);
    }

    .lead-pwa-filter__badge {
      position: absolute;
      top: -5px;
      right: -5px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 17px;
      height: 17px;
      padding: 0 4px;
      border: 2px solid var(--lead-pwa-bg);
      border-radius: 999px;
      background: var(--lead-pwa-primary);
      color: #fff;
      font-size: 10px;
      font-weight: 900;
      line-height: 1;
    }

    .lead-pwa-tabs {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(64px, 1fr);
      gap: 0;
      overflow-x: auto;
      margin: 0 -8px;
      padding: 0;
      border-bottom: 0;
      scrollbar-width: none;
    }

    .lead-pwa-tabs::-webkit-scrollbar { display: none; }

    .lead-pwa-tabs--kanban {
      grid-auto-columns: minmax(76px, 88px);
    }

    .lead-pwa-tab {
      position: relative;
      display: grid;
      place-items: center;
      align-content: center;
      gap: 1px;
      min-height: 44px;
      padding: 2px 3px 5px;
      border: 0;
      background: transparent;
      color: var(--lead-pwa-muted);
      font-size: 10px;
      font-weight: 800;
      text-align: center;
      text-decoration: none;
      white-space: nowrap;
    }

    .lead-pwa-tabs--kanban .lead-pwa-tab {
      min-height: 52px;
      padding-right: 2px;
      padding-left: 2px;
    }

    .lead-pwa-tabs--kanban .lead-pwa-tab i {
      color: var(--lead-pwa-stage-color, var(--lead-pwa-primary));
    }

    .lead-pwa-tabs--kanban .lead-pwa-tab.is-active {
      color: color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 72%, var(--lead-pwa-ink));
    }

    .lead-pwa-tabs--kanban .lead-pwa-tab.is-active i {
      border-radius: 999px;
      background: var(--lead-pwa-stage-color, var(--lead-pwa-primary));
      color: var(--lead-pwa-stage-color, var(--lead-pwa-primary));
    }

    .lead-pwa-tab i {
      color: var(--lead-pwa-muted);
      font-size: 18px;
      line-height: 1;
    }

    .lead-pwa-tab small {
      display: grid;
      justify-items: center;
      min-width: 0;
      max-width: 100%;
    }

    .lead-pwa-tab__label,
    .lead-pwa-tab__count {
      display: block;
      color: inherit;
      line-height: 1.05;
    }

    .lead-pwa-tabs--kanban .lead-pwa-tab__label {
      display: -webkit-box;
      overflow: hidden;
      max-width: 72px;
      min-height: 20px;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-height: 1.05;
      text-overflow: ellipsis;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .lead-pwa-tab__label {
      font-size: 10px;
      font-weight: 850;
    }

    .lead-pwa-tabs--kanban .lead-pwa-tab__label {
      font-size: 9px;
    }

    .lead-pwa-tab__count {
      color: color-mix(in srgb, currentColor 74%, var(--lead-pwa-muted));
      font-size: 9px;
      font-weight: 800;
    }

    .lead-pwa-tab.is-active {
      color: var(--lead-pwa-primary);
    }

    .lead-pwa-tab.is-active i {
      color: var(--lead-pwa-primary);
    }

    .lead-pwa-tab.is-active::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: -1px;
      left: 0;
      height: 3px;
      border-radius: 3px 3px 0 0;
      background: var(--lead-pwa-primary);
    }

    .lead-pwa-list {
      display: grid;
      gap: 8px;
      padding-top: 12px;
    }

    .lead-pwa-list__loader {
      display: flex;
      justify-content: center;
      padding: 6px 0 2px;
    }

    .lead-pwa-list__loader[hidden] {
      display: none;
    }

    .lead-pwa-list__loader-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 32px;
      padding: 6px 12px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 999px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-muted);
      font-size: 12px;
      font-weight: 800;
      box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

    .lead-pwa-kanban {
      display: grid;
      gap: 8px;
      min-width: 0;
      padding-top: 10px;
    }

    .lead-pwa-kanban__summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 0 2px;
      color: var(--lead-pwa-muted);
      font-size: 11px;
      font-weight: 800;
    }

    .lead-pwa-kanban__summary strong {
      overflow: hidden;
      color: var(--lead-pwa-ink);
      font-size: 15px;
      font-weight: 950;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pwa-kanban__columns {
      --lead-pwa-kanban-column-width: min(84vw, 340px);
      display: flex;
      gap: 9px;
      overflow-x: auto;
      margin: 0 -8px;
      padding: 0 max(8px, calc((100vw - var(--lead-pwa-kanban-column-width)) / 2)) 8px;
      scroll-padding-inline: max(8px, calc((100vw - var(--lead-pwa-kanban-column-width)) / 2));
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      scroll-behavior: smooth;
    }

    .lead-pwa-kanban__columns::-webkit-scrollbar {
      display: none;
    }

    .lead-pwa-kanban-column {
      display: grid;
      align-content: start;
      flex: 0 0 var(--lead-pwa-kanban-column-width);
      gap: 8px;
      min-width: 0;
      min-height: 174px;
      padding: 9px;
      border: 1px solid color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-line)) 30%, var(--lead-pwa-line));
      border-top-width: 4px;
      border-radius: 12px;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 8%, var(--lead-pwa-surface)) 0%,
        color-mix(in srgb, var(--lead-pwa-surface-soft) 76%, var(--lead-pwa-surface)) 42%
      );
      scroll-snap-align: center;
    }

    .lead-pwa-kanban-column__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      min-height: 28px;
    }

    .lead-pwa-kanban-column.is-active {
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 24%, transparent), 0 8px 18px rgba(15, 23, 42, .07);
    }

    .lead-pwa-kanban-column__head strong {
      overflow: hidden;
      color: color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-ink)) 32%, var(--lead-pwa-ink));
      font-size: 13px;
      font-weight: 950;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pwa-kanban-column__count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 26px;
      height: 22px;
      padding: 0 8px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 12%, var(--lead-pwa-surface));
      color: color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-muted)) 52%, var(--lead-pwa-muted));
      font-size: 11px;
      font-weight: 900;
    }

    .lead-pwa-kanban-column__cards {
      display: grid;
      gap: 8px;
    }

    .lead-pwa-kanban .lead-pwa-card {
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, .045);
      cursor: grab;
      touch-action: pan-y;
      transform-origin: 50% 50%;
      transition: transform .16s ease, box-shadow .16s ease, opacity .16s ease;
      user-select: none;
      -webkit-touch-callout: none;
      -webkit-user-drag: none;
      -webkit-user-select: none;
    }

    html.lead-pwa-card-dragging,
    html.lead-pwa-card-dragging body {
      overscroll-behavior: none;
    }

    html.lead-pwa-card-dragging .lead-pwa-kanban__columns,
    html.lead-pwa-card-dragging .lead-pwa-kanban .lead-pwa-card {
      touch-action: none;
    }

    .lead-pwa-kanban .lead-pwa-card.is-pressing {
      transform: scale(.992) rotate(-.35deg);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--lead-pwa-primary) 18%, transparent), 0 8px 22px rgba(15, 23, 42, .12);
    }

    .lead-pwa-kanban .lead-pwa-card.is-drag-ready {
      transform: rotate(-2.2deg) scale(1.018);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 28%, transparent), 0 18px 34px rgba(15, 23, 42, .22);
    }

    .lead-pwa-kanban .lead-pwa-card.is-dragging {
      opacity: .62;
      cursor: grabbing;
    }

    .lead-pwa-card--restored {
      outline: 3px solid color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 42%, transparent);
      outline-offset: 2px;
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 12%, transparent), 0 8px 20px rgba(15, 23, 42, .12);
    }

    .lead-pwa-kanban .lead-pwa-card__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .lead-pwa-kanban .lead-pwa-card__deal {
      display: none;
    }

    .lead-pwa-kanban__more,
    .lead-pwa-kanban__empty {
      display: grid;
      place-items: center;
      min-height: 72px;
      padding: 8px 10px;
      border: 1px dashed var(--lead-pwa-line);
      border-radius: 10px;
      background: color-mix(in srgb, var(--lead-pwa-surface) 70%, transparent);
      color: var(--lead-pwa-muted);
      font-size: 11px;
      font-weight: 800;
      text-align: center;
      text-decoration: none;
    }

    .lead-pwa-drag-ghost {
      position: fixed;
      z-index: 4300;
      width: min(76vw, 310px);
      pointer-events: none;
      transform: translate(-50%, -50%) rotate(-2.2deg) scale(1.02);
      opacity: .96;
      box-shadow: 0 18px 42px rgba(15, 23, 42, .26);
    }

    .lead-pwa-kanban-column.is-drop-target {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--lead-pwa-stage-color, var(--lead-pwa-primary)) 34%, transparent), 0 12px 26px rgba(15, 23, 42, .10);
    }

    .lead-pwa-kanban-sheet {
      position: fixed;
      inset: 0;
      z-index: 4200;
      display: grid;
      align-items: end;
      background: rgba(15, 23, 42, .34);
      opacity: 1;
      transition: opacity .18s ease;
    }

    .lead-pwa-kanban-sheet[hidden] {
      display: none;
    }

    .lead-pwa-kanban-sheet__panel {
      display: grid;
      gap: 14px;
      max-height: min(82vh, 780px);
      padding: 10px 14px calc(16px + env(safe-area-inset-bottom, 0px));
      border-radius: 24px 24px 0 0;
      background: color-mix(in srgb, var(--lead-pwa-surface) 96%, #fff);
      box-shadow: 0 -18px 42px rgba(15, 23, 42, .24);
      overflow-y: auto;
    }

    .lead-pwa-kanban-sheet__handle {
      justify-self: center;
      width: 42px;
      height: 5px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--lead-pwa-muted) 36%, transparent);
    }

    .lead-pwa-kanban-sheet__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 42px;
      gap: 12px;
      align-items: start;
    }

    .lead-pwa-kanban-sheet__head strong {
      display: block;
      overflow: hidden;
      color: var(--lead-pwa-ink);
      font-size: 19px;
      font-weight: 950;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pwa-kanban-sheet__head span {
      display: block;
      color: var(--lead-pwa-muted);
      font-size: 12px;
      font-weight: 750;
    }

    .lead-pwa-kanban-sheet__close {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 14px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-ink);
    }

    .lead-pwa-kanban-sheet__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .lead-pwa-kanban-sheet__action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 14px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-ink);
      font-size: 13px;
      font-weight: 900;
      text-decoration: none;
    }

    .lead-pwa-kanban-sheet__action--primary {
      border-color: color-mix(in srgb, var(--lead-pwa-primary) 54%, var(--lead-pwa-line));
      background: var(--lead-pwa-primary);
      color: #fff;
    }

    .lead-pwa-kanban-sheet__section {
      display: grid;
      gap: 8px;
    }

    .lead-pwa-kanban-sheet__section-title {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--lead-pwa-muted);
      font-size: 11px;
      font-weight: 950;
      letter-spacing: .02em;
      text-transform: uppercase;
    }

    .lead-pwa-kanban-sheet__quick-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .lead-pwa-kanban-sheet__form {
      display: grid;
      gap: 8px;
      padding: 10px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 16px;
      background: color-mix(in srgb, var(--lead-pwa-surface-soft) 58%, var(--lead-pwa-surface));
    }

    .lead-pwa-kanban-sheet__form--inline {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      padding: 8px;
    }

    .lead-pwa-kanban-sheet__form label {
      color: var(--lead-pwa-muted);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .lead-pwa-kanban-sheet__form input,
    .lead-pwa-kanban-sheet__form select,
    .lead-pwa-kanban-sheet__form textarea {
      width: 100%;
      min-height: 38px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 12px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-ink);
      font: inherit;
      font-size: 13px;
      padding: 8px 10px;
    }

    .lead-pwa-kanban-sheet__form textarea {
      min-height: 68px;
      resize: vertical;
    }

    .lead-pwa-kanban-sheet__submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 38px;
      padding: 0 12px;
      border: 0;
      border-radius: 12px;
      background: var(--lead-pwa-primary);
      color: #fff;
      font-size: 13px;
      font-weight: 900;
    }

    .lead-pwa-kanban-sheet__submit--icon {
      width: 42px;
      padding: 0;
    }

    @media (max-width: 380px) {
      .lead-pwa-kanban-sheet__quick-grid {
        grid-template-columns: 1fr;
      }
    }

    .lead-pwa-card {
      position: relative;
      display: grid;
      overflow: hidden;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 9px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-ink);
      text-decoration: none;
      box-shadow: 0 4px 12px rgba(15, 23, 42, .055);
    }

    .lead-pwa-card--attention::before {
      content: none;
    }

    .lead-pwa-card--attention {
      border-color: color-mix(in srgb, #ff8500 38%, var(--lead-pwa-line));
    }

    .lead-pwa-card__head,
    .lead-pwa-card__body,
    .lead-pwa-card__foot {
      display: grid;
      gap: 5px;
      min-width: 0;
      padding: 9px 11px;
    }

    .lead-pwa-card__head {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 6px;
      padding-bottom: 2px;
    }

    .lead-pwa-card__body {
      padding-top: 3px;
      padding-bottom: 7px;
    }

    .lead-pwa-card__name {
      min-width: 0;
      overflow: hidden;
      color: var(--lead-pwa-ink);
      font-size: 15px;
      font-weight: 950;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pwa-card__badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 23px;
      padding: 0 8px;
      border: 1px solid #ef4444;
      border-radius: 999px;
      color: #ef4444;
      font-size: 11px;
      font-weight: 400;
      white-space: nowrap;
    }

    .lead-pwa-card__badge--blue {
      border-color: var(--lead-pwa-primary);
      color: var(--lead-pwa-primary);
    }

    .lead-pwa-card__deal {
      display: inline-flex;
      align-items: center;
