    .lead-pwa-sticky-head {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 1070;
      display: grid;
      gap: 5px;
      min-height: var(--lead-pwa-head-height);
      margin: 0;
      padding: max(6px, env(safe-area-inset-top, 0px)) 8px 0;
      border-bottom: 1px solid var(--lead-pwa-line);
      background: color-mix(in srgb, var(--lead-pwa-bg) 96%, transparent);
      box-shadow: 0 10px 22px color-mix(in srgb, #000 8%, transparent);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    html[data-admin-theme="dark"] .lead-pwa-sticky-head {
      background: color-mix(in srgb, var(--lead-pwa-bg) 94%, transparent);
      box-shadow: 0 12px 28px rgba(0, 0, 0, .18);
