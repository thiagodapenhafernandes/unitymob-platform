                color var(--ax-motion-fast, 140ms) var(--ax-motion-ease, ease);
  }

  .lead-filter-quick__chip span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lead-filter-quick__chip:hover {
    background: var(--admin-primary-softer, #f3f7fb);
    border-color: var(--admin-primary-ring, #b7c6da);
    color: var(--admin-primary, #365f8f);
    text-decoration: none;
  }

  .lead-filter-active {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .lead-filter-active__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--admin-primary-soft, #edf4ff);
    color: var(--admin-primary, #365f8f);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
  }

  .lead-desktop-header {
    display: grid;
    gap: 12px;
    overflow: hidden;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .05);
  }

  .lead-desktop-header__bar {
    display: grid;
    grid-template-columns: auto minmax(280px, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 12px 14px 4px;
  }

  .lead-desktop-queue {
    display: inline-grid;
    place-items: center;
    min-width: 74px;
    min-height: 42px;
    padding: 4px 10px;
    border: 1px solid var(--ab-line, #d8dee8);
    border-radius: 10px;
    background: #fff;
    color: var(--ab-muted, #657386);
    line-height: 1;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .05);
  }

