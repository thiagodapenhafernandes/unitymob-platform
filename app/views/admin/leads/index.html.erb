            </div>
            <div class="ax-span-3">
              <%= ax_select_field(form: f, method: :origin, label: "Fonte",
                                  choices: @origin_options,
                                  select_options: { include_blank: "Todas as fontes", selected: @origin }) %>
            </div>
            <div class="ax-span-3">
              <%= ax_field_label(nil, nil, text: "Atividade") %>
              <%= select_tag "activity_filter[]",
                             options_for_select(activity_filter_options, @activity_filters.first),
                             include_blank: "Todas as atividades",
                             class: "ax-control" %>
            </div>
            <div class="ax-span-3">
              <%= ax_select_field(form: f, method: :archive_reason_id, label: "Motivo de arquivamento",
                                  choices: @lead_archive_reason_options,
                                  select_options: { include_blank: "Todos os motivos", selected: @archive_reason_id }) %>
            </div>
            <% if team_available?(:leads) %>
              <div class="ax-span-6">
                <%= ax_field_label(nil, nil, text: "Abrangência") %>
                <%= ax_team_toggle(:leads) %>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="lead-filter-form-section">
          <div class="lead-filter-form-section__title">Funil e busca</div>
          <%= ax_field_grid do %>
            <div class="ax-span-4">
              <%= ax_select_field(form: f, method: :lead_pipeline_id, label: "Funil",
                                  choices: @pipeline_options,
                                  select_options: { include_blank: "Todos os funis", selected: @selected_pipeline&.id }) %>
            </div>
            <div class="ax-span-4">
              <%= ax_select_field(form: f, method: :lead_pipeline_stage_id, label: "Etapa de funil",
                                  choices: @lead_pipeline_stage_options,
                                  select_options: { include_blank: "Todas as etapas", selected: @lead_pipeline_stage_id }) %>
            </div>
            <div class="ax-span-4">
              <%= ax_text_field(form: f, method: :q, label: "Buscar",
                                value: params[:q],
                                placeholder: "Nome, e-mail, telefone, origem ou produto...") %>
            </div>
            <div class="ax-span-12">
              <%= ax_autocomplete_select_field(
                    form: f,
                    method: :tags,
                    label: "Tags",
                    choices: @tag_options.map { |tag| [tag, tag] },
                    select_options: { selected: @tags },
                    multiple: true,
                    tags: true,
                    create: true,
                    placeholder: "Filtrar por uma ou mais tags..."
                  ) %>
            </div>
          <% end %>
        </div>

        <div class="lead-filter-form-section">
          <div class="lead-filter-form-section__title">Imóvel e contato</div>
          <%= ax_field_grid do %>
            <div class="ax-span-3">
              <%= ax_select_field(form: f, method: :property_filter, label: "Vínculo com imóvel",
                                  choices: [["Com imóvel vinculado", "with_property"], ["Contato geral", "general"], ["Imóvel indisponível", "unavailable_property"]],
                                  select_options: { include_blank: "Todos", selected: @property_filter }) %>
            </div>
            <div class="ax-span-3">
              <%= ax_text_field(form: f, method: :property_q, label: "Imóvel",
                                value: @property_q,
                                placeholder: "Código, título ou empreendimento...") %>
            </div>
            <div class="ax-span-3">
              <%= ax_select_field(form: f, method: :contact_filter, label: "Contato",
                                  choices: [["Com telefone", "with_phone"], ["Com e-mail", "with_email"], ["Sem telefone/e-mail", "missing_contact"]],
                                  select_options: { include_blank: "Todos", selected: @contact_filter }) %>
            </div>
            <div class="ax-span-3">
              <%= ax_text_field(form: f, method: :price_min, label: "Preço mínimo", value: @price_min, inputmode: "decimal", placeholder: "R$ mínimo") %>
            </div>
            <div class="ax-span-3">
              <%= ax_text_field(form: f, method: :price_max, label: "Preço máximo", value: @price_max, inputmode: "decimal", placeholder: "R$ máximo") %>
            </div>
          <% end %>
        </div>

        <div class="lead-filter-form-section">
          <div class="lead-filter-form-section__title">Período do lead</div>
          <%= ax_field_grid do %>
            <div class="ax-span-6 lead-filter-date-pair">
              <%= ax_date_field(form: f, method: :start_date, label: "Entrada de", value: @start_date) %>
              <%= ax_date_field(form: f, method: :end_date, label: "Entrada até", value: @end_date) %>
            </div>
            <div class="ax-span-6 lead-filter-date-pair">
              <%= ax_date_field(form: f, method: :closed_start_date, label: "Fechado de", value: @closed_start_date) %>
              <%= ax_date_field(form: f, method: :closed_end_date, label: "Fechado até", value: @closed_end_date) %>
            </div>
            <% if leads_can_export_report %>
              <div class="ax-span-6">
                <%= ax_field_label(nil, nil, text: "Relatório") %>
                <label class="ax-toggle-chip">
                  <%= check_box_tag "include_captacoes", "1", @include_captacoes, class: "ax-toggle-chip__input" %>
                  <span class="ax-toggle-chip__box" aria-hidden="true"><i class="bi bi-house-add"></i></span>
                  <span class="ax-toggle-chip__label">Incluir captações</span>
                </label>
              </div>
            <% end %>
          <% end %>
        </div>
      <% if lead_active_filter_count.positive? %>
        <div class="lead-filter-active" aria-label="Filtros ativos">
          <% lead_filter_labels.each do |label| %>
            <span class="lead-filter-active__chip"><i class="bi bi-check2"></i><%= label %></span>
          <% end %>
        </div>
      <% end %>
      </div>
    <% end %>
  <% end %>

  <% pwa_filter_form = capture do %>
    <% pwa_price_filter_count = [@price_min, @price_max].count(&:present?) %>
    <% pwa_date_filter_count = [@start_date, @end_date, @closed_start_date, @closed_end_date].count(&:present?) %>
    <% pwa_origin_filter_count = @channel_filters.size + (@origin.present? ? 1 : 0) %>
    <section class="lead-pwa-filter-panel" aria-label="Minha visualização dos leads">
      <div class="lead-pwa-filter-panel__head">
        <button type="button"
                class="lead-pwa-filter-panel__close"
                data-action="lead-pwa-filter#close"
                aria-expanded="false"
                aria-label="Voltar">
          <i class="bi bi-chevron-left"></i>
        </button>
        <div class="lead-pwa-filter-panel__heading">
          <strong class="lead-pwa-filter-panel__title">Minha visualização dos leads</strong>
          <% if lead_active_filter_count.positive? %>
            <span class="lead-pwa-filter-panel__subtitle"><%= lead_active_filter_count %> filtro<%= lead_active_filter_count > 1 ? "s" : "" %> aplicado<%= lead_active_filter_count > 1 ? "s" : "" %></span>
          <% end %>
        </div>
        <%= link_to admin_leads_path(view: @view_mode, mobile_tab: @pwa_lead_tab), class: "lead-pwa-filter-panel__reset", aria: { label: "Limpar filtros" } do %>
          <i class="bi bi-arrow-counterclockwise"></i>
        <% end %>
      </div>

      <%= form_with url: admin_leads_path, method: :get, local: true, class: "lead-pwa-filter-panel__form" do |f| %>
        <%= f.hidden_field :view, value: @view_mode %>
        <%= f.hidden_field :mobile_tab, value: @pwa_lead_tab %>
        <%= f.hidden_field :q, value: @q if @q.present? %>
        <%= f.hidden_field :lead_pipeline_id, value: @selected_pipeline&.id if @selected_pipeline.present? %>

        <% if @broker_options.size > 1 || @broker_id.present? %>
          <%= ax_filter_section(title: "Meus leads", open: true) do %>
            <div class="lead-pwa-filter-box__row">
              <span>
                <strong>Ver apenas meus leads</strong>
                <span>Quando desligado, mantém a abrangência permitida pelo seu perfil.</span>
              </span>
              <%= ax_switch_field(name: "only_mine", value: "1", checked: @only_mine, input_html: { "aria-label": "Ver apenas meus leads" }) %>
            </div>
          <% end %>
        <% end %>

        <%= ax_filter_section(title: "Etiquetas", count: @tags.size, open: true) do %>
          <% if @tag_options.any? %>
            <select class="ax-control" name="tags[]" multiple size="<%= [@tag_options.size, 4].min %>" aria-label="Selecionar etiquetas">
              <% @tag_options.each do |tag| %>
                <option value="<%= tag %>" <%= "selected" if @tags.include?(tag.to_s) %>><%= tag %></option>
              <% end %>
            </select>
          <% else %>
            <div class="lead-pwa-filter-empty-option">Nenhuma etiqueta criada</div>
          <% end %>
        <% end %>

        <%= ax_filter_section(title: "Natureza de negociação", count: @business_filters.size, open: true) do %>
          <div class="ax-filter-checks">
            <% business_filter_options.each do |label, value| %>
              <%= ax_filter_check(name: "business_filter[]", value: value, checked: @business_filters.include?(value), label: label, id: "pwa_business_#{value}") %>
            <% end %>
          </div>
        <% end %>

        <%= ax_filter_section(title: "Status do lead", count: @status_filters.size, open: true) do %>
          <div class="ax-filter-checks">
            <% status_filter_options.each do |label, value| %>
              <%= ax_filter_check(name: "status[]", value: value, checked: @status_filters.include?(value), label: label, id: "pwa_status_#{value.parameterize}") %>
            <% end %>
          </div>
        <% end %>

        <%= ax_filter_section(title: "Atividade atual do lead", count: @activity_filters.size, open: true) do %>
          <div class="ax-filter-checks">
            <% activity_filter_options.each do |label, value| %>
              <%= ax_filter_check(name: "activity_filter[]", value: value, checked: @activity_filters.include?(value), label: label, id: "pwa_activity_#{value}") %>
            <% end %>
          </div>
        <% end %>

        <%= ax_filter_section(title: "Origem", count: pwa_origin_filter_count, open: true) do %>
          <div class="lead-pwa-filter-box__label">Canal</div>
          <div class="ax-filter-checks">
            <% channel_filter_options.each do |label, value| %>
              <%= ax_filter_check(name: "channel_filter[]", value: value, checked: @channel_filters.include?(value), label: label, id: "pwa_channel_#{value}") %>
            <% end %>
          </div>
          <div class="lead-pwa-filter-divider"></div>
          <%= ax_select_field(form: f, method: :origin, label: "Fonte principal",
                              choices: @origin_options,
                              select_options: { include_blank: "Todas as fontes", selected: @origin }) %>
        <% end %>

        <%= ax_filter_section(title: "Equipes", count: (@broker_id.present? ? 1 : 0), open: true) do %>
          <%= ax_select_field(form: f, method: :broker_id, label: "Corretor ou responsável",
                              choices: [["Sem corretor", "unassigned"]] + @broker_options,
                              select_options: { include_blank: "Todos permitidos", selected: @broker_id }) %>
        <% end %>

        <%= ax_filter_section(title: "Faixa de preço", count: pwa_price_filter_count, open: true) do %>
          <div class="lead-pwa-filter-grid">
            <%= ax_text_field(form: f, method: :price_min, label: "Preço mínimo", value: @price_min, inputmode: "decimal", placeholder: "R$ Mínimo") %>
            <%= ax_text_field(form: f, method: :price_max, label: "Preço máximo", value: @price_max, inputmode: "decimal", placeholder: "R$ Máximo") %>
          </div>
        <% end %>

        <%= ax_filter_section(title: "Datas", count: pwa_date_filter_count, open: true) do %>
          <div class="lead-pwa-filter-box__label">Data de recebimento do lead</div>
          <div class="lead-pwa-filter-grid">
            <%= ax_date_field(form: f, method: :start_date, label: "Recebido de", value: @start_date) %>
            <%= ax_date_field(form: f, method: :end_date, label: "Recebido até", value: @end_date) %>
          </div>
          <div class="lead-pwa-filter-divider"></div>
          <div class="lead-pwa-filter-box__label">Data do negócio fechado</div>
          <div class="lead-pwa-filter-grid">
            <%= ax_date_field(form: f, method: :closed_start_date, label: "Fechado de", value: @closed_start_date) %>
            <%= ax_date_field(form: f, method: :closed_end_date, label: "Fechado até", value: @closed_end_date) %>
          </div>
        <% end %>

        <% if leads_can_export_report %>
          <%= ax_filter_section(title: "Relatório", count: (@include_captacoes ? 1 : 0), open: false) do %>
            <%= ax_filter_check(name: "include_captacoes", value: "1", checked: @include_captacoes, label: "Incluir captações no relatório", id: "pwa_include_captacoes") %>
          <% end %>
        <% end %>

        <div class="lead-pwa-filter-actions">
          <button type="submit">
            Aplicar
            <% if lead_active_filter_count.positive? %>
              <span class="lead-pwa-filter-actions__count">(<%= lead_active_filter_count %>)</span>
            <% end %>
          </button>
        </div>
      <% end %>
    </section>
  <% end %>

  <% lead_desktop_header = capture do %>
    <section class="lead-desktop-header" aria-label="Navegação e filtros de leads">
      <div class="lead-desktop-header__bar">
        <%= link_to lead_queue_path, class: "lead-desktop-queue", title: "Ver minhas filas de distribuição" do %>
          <strong><%= @pwa_queue_position.present? ? "#{@pwa_queue_position}º" : "-" %></strong>
          <span>na fila</span>
        <% end %>

        <%= form_with url: admin_leads_path, method: :get, local: true, class: "lead-desktop-search" do |f| %>
          <i class="bi bi-search" aria-hidden="true"></i>
          <% desktop_search_hidden_params.each do |key, value| %>
            <% Array(value).each do |item| %>
              <%= hidden_field_tag(value.is_a?(Array) ? "#{key}[]" : key, item) %>
            <% end %>
          <% end %>
          <%= f.search_field :q,
                             value: @q,
                             placeholder: "Buscar por produto, nome, telefone, e-mail...",
                             autocomplete: "off",
                             aria: { label: "Buscar leads" } %>
        <% end %>

        <div class="lead-desktop-header__actions">
          <% if leads_can_manage_statuses %>
            <button type="button"
                    class="lead-desktop-header__button"
                    data-ax-modal-open="#leadPipelineCreateModal"
                    title="Criar novo funil">
              <i class="bi bi-diagram-3"></i><span>Novo funil</span>
            </button>
            <button type="button"
                    class="lead-desktop-header__button"
                    data-ax-modal-open="#leadStatusBoardModal"
                    title="Editar funil e etapas">
              <i class="bi bi-gear"></i><span>Etapas</span>
            </button>
          <% end %>
          <div class="lead-desktop-view-toggle" aria-label="Alternar visualização">
            <%= link_to(admin_leads_path(kanban_params.merge(lead_tab: @desktop_lead_tab)),
                        class: "lead-desktop-view-toggle__item #{'is-active' if @view_mode == 'kanban'}",
                        title: "Visualizar em kanban") do %>
              <i class="bi bi-kanban"></i><span>Kanban</span>
            <% end %>
            <%= link_to(admin_leads_path(list_params.merge(lead_tab: @desktop_lead_tab)),
                        class: "lead-desktop-view-toggle__item #{'is-active' if @view_mode == 'list'}",
                        title: "Visualizar em lista") do %>
              <i class="bi bi-list-ul"></i><span>Lista</span>
            <% end %>
          </div>
          <button type="button"
                  class="lead-desktop-header__button is-primary"
                  data-ax-modal-open="#leadDesktopFilterModal"
                  aria-label="Abrir filtros detalhados">
            <i class="bi bi-funnel"></i>
            <span>Filtros</span>
            <% if lead_active_filter_count.positive? %>
              <strong><%= lead_active_filter_count %></strong>
            <% end %>
          </button>
          <% if leads_can_export_report %>
            <%= link_to report_admin_leads_path(lead_query_params.merge(include_captacoes: (@include_captacoes ? "1" : nil), format: :xlsx).compact),
                        class: "lead-desktop-header__button",
                        title: "Exportar relatório de leads em Excel" do %>
              <i class="bi bi-filetype-xlsx"></i><span>Relatório</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <nav class="lead-desktop-tabs" aria-label="Abas de leads">
        <% lead_desktop_tab_items.each do |key, label, icon| %>
          <% tab_path = admin_leads_path(lead_query_params.merge(view: @view_mode, lead_tab: key, page: nil).compact) %>
          <%= link_to(tab_path, class: "lead-desktop-tab #{'is-active' if @desktop_lead_tab == key}") do %>
            <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
            <strong><%= label %></strong>
            <small><%= number_with_delimiter(@desktop_tab_counts.fetch(key, 0)) %></small>
          <% end %>
        <% end %>
      </nav>
    </section>
  <% end %>

<div class="ax-leads-mobile-shell tw-flex tw-flex-col tw-gap-3"
     data-controller="lead-pwa-filter">
  <section class="lead-pwa-screen <%= 'lead-pwa-screen--kanban' if @view_mode == 'kanban' %>"
           aria-label="Leads no PWA"
           data-controller="<%= 'lead-pwa-kanban' if @view_mode == 'kanban' %>">
    <%
      pwa_kanban_active = @view_mode == "kanban"
      pwa_toggle_path = admin_leads_path(lead_query_params.merge(view: (pwa_kanban_active ? "list" : "kanban"), mobile_tab: (pwa_kanban_active ? @pwa_lead_tab : "all"), page: nil).compact)
      pwa_toggle_icon = pwa_kanban_active ? "list-ul" : "kanban"
      pwa_toggle_label = pwa_kanban_active ? "Ver em lista" : "Ver em Kanban"
      hide_pwa_kanban_toggle = !pwa_kanban_active
    %>
    <div class="lead-pwa-sticky-head">
      <div class="lead-pwa-topbar <%= 'lead-pwa-topbar--no-view-toggle' if hide_pwa_kanban_toggle %> <%= 'lead-pwa-topbar--has-clear' if lead_active_filter_count.positive? %>">
        <%= link_to lead_queue_path, class: "lead-pwa-queue", title: "Ver minhas filas de distribuição" do %>
          <strong><%= @pwa_queue_position.present? ? "#{@pwa_queue_position}º" : "-" %></strong>
          <span>na fila</span>
        <% end %>

        <%= form_with url: admin_leads_path, method: :get, class: "lead-pwa-search", local: true do |f| %>
          <i class="bi bi-search" aria-hidden="true"></i>
          <%= f.hidden_field :view, value: @view_mode %>
          <%= f.hidden_field :mobile_tab, value: @pwa_lead_tab %>
          <%= f.search_field :q, value: @q, placeholder: "Busque por nome, telefone...", autocomplete: "off", aria: { label: "Buscar leads" } %>
        <% end %>

        <button type="button"
                class="lead-pwa-filter"
                data-lead-pwa-filter-target="trigger"
                data-action="lead-pwa-filter#open"
                aria-expanded="false"
                aria-label="Abrir filtros detalhados"
                title="Filtros detalhados">
          <i class="bi bi-funnel"></i>
          <% if lead_active_filter_count.positive? %>
            <span class="lead-pwa-filter__badge"><%= lead_active_filter_count %></span>
          <% end %>
        </button>

        <% if lead_active_filter_count.positive? %>
          <%= link_to admin_leads_path(view: @view_mode, mobile_tab: @pwa_lead_tab),
                      class: "lead-pwa-clear-filter",
                      aria: { label: "Limpar filtros" },
                      title: "Limpar filtros" do %>
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          <% end %>
        <% end %>

        <% unless hide_pwa_kanban_toggle %>
          <%= link_to pwa_toggle_path,
                      class: "lead-pwa-view-toggle #{'is-active' if pwa_kanban_active}",
                      aria: { label: pwa_toggle_label },
                      title: pwa_toggle_label do %>
            <i class="bi bi-<%= pwa_toggle_icon %>" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>

      <nav class="lead-pwa-tabs <%= 'lead-pwa-tabs--kanban' if pwa_kanban_active %>" aria-label="<%= pwa_kanban_active ? 'Etapas do funil' : 'Abas de leads' %>">
        <% if pwa_kanban_active %>
          <% @pwa_kanban_statuses.each do |status| %>
            <%
              status_anchor = "pwa-kanban-status-#{status.to_s.parameterize}"
              status_color = @lead_stage_color_by_status&.[](status)
              status_style = status_color.present? ? "--lead-pwa-stage-color: #{status_color};" : nil
            %>
            <button type="button"
                    class="lead-pwa-tab"
                    style="<%= status_style %>"
                    data-action="lead-pwa-kanban#focusColumn"
                    data-lead-pwa-kanban-column-id="<%= status_anchor %>">
              <i class="bi bi-circle" aria-hidden="true"></i>
              <small>
                <span class="lead-pwa-tab__label"><%= status %></span>
                <span class="lead-pwa-tab__count"><%= number_with_delimiter(@pwa_kanban_counts_by_status.fetch(status, 0)) %></span>
              </small>
            </button>
          <% end %>
        <% else %>
          <%
            pwa_tab_items = [
              ["todo", "A fazer", "house-door"],
              ["visits", "Visitas", "bullseye"],
              ["future", "Futuras", "clock"],
              ["favorites", "Favoritos", "star"],
              ["all", "Todos", "archive"]
            ]
          %>
          <% pwa_tab_items.each do |key, label, icon| %>
            <% tab_path = admin_leads_path(lead_query_params.merge(view: @view_mode, mobile_tab: key, page: nil).compact) %>
            <%
              filtered_count = @pwa_tab_counts.fetch(key, 0)
              original_count = @pwa_tab_original_counts&.fetch(key, filtered_count) || filtered_count
              count_label = if lead_active_filter_count.positive? && @pwa_lead_tab == key && filtered_count != original_count
                "#{number_with_delimiter(filtered_count)}/#{number_with_delimiter(original_count)}"
              else
                number_with_delimiter(original_count)
              end
            %>
            <%= link_to tab_path, class: "lead-pwa-tab #{'is-active' if @pwa_lead_tab == key}" do %>
              <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
              <small>
                <span class="lead-pwa-tab__label"><%= label %></span>
                <span class="lead-pwa-tab__count"><%= count_label %></span>
              </small>
            <% end %>
          <% end %>
        <% end %>
      </nav>
    </div>

    <% if pwa_kanban_active %>
      <div class="lead-pwa-kanban" aria-label="Kanban dos meus leads">
        <div class="lead-pwa-kanban__summary">
          <strong>Kanban dos leads</strong>
          <span><%= number_with_delimiter(@pwa_kanban_total_count.to_i) %> no funil</span>
        </div>

        <% if @pwa_kanban_statuses.any? %>
          <div class="lead-pwa-kanban__columns"
               role="list"
               data-lead-pwa-kanban-target="columns"
               data-action="scroll->lead-pwa-kanban#syncActiveFromScroll">
            <% @pwa_kanban_statuses.each do |status| %>
              <%
                column_leads = @pwa_kanban_leads_by_status.fetch(status, [])
                column_total = @pwa_kanban_counts_by_status.fetch(status, column_leads.size)
                column_anchor = "pwa-kanban-status-#{status.to_s.parameterize}"
                column_color = @lead_stage_color_by_status&.[](status)
                column_style = column_color.present? ? "--lead-pwa-stage-color: #{column_color};" : nil
              %>
              <section id="<%= column_anchor %>"
                       class="lead-pwa-kanban-column"
                       style="<%= column_style %>"
                       role="listitem"
                       data-lead-status="<%= status %>"
                       aria-label="Etapa <%= status %>">
                <header class="lead-pwa-kanban-column__head">
                  <strong><%= status %></strong>
                  <span class="lead-pwa-kanban-column__count"><%= number_with_delimiter(column_total) %></span>
                </header>
                <div class="lead-pwa-kanban-column__cards" role="list">
                  <% if column_leads.any? %>
                    <%= render partial: "admin/leads/pwa_lead_card", collection: column_leads, as: :lead, locals: { pwa_kanban_card: true } %>
                    <% if column_total > column_leads.size %>
                      <div class="lead-pwa-kanban__more">
                        Mostrando <%= column_leads.size %> de <%= number_with_delimiter(column_total) %>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="lead-pwa-kanban__empty">Sem leads nesta etapa</div>
                  <% end %>
                </div>
              </section>
            <% end %>
          </div>

          <div class="lead-pwa-kanban-sheet"
               hidden
               data-lead-pwa-kanban-target="sheet"
               data-action="click->lead-pwa-kanban#closeSheetFromBackdrop">
            <div class="lead-pwa-kanban-sheet__panel" role="dialog" aria-modal="true" aria-label="Ações rápidas do lead">
              <div class="lead-pwa-kanban-sheet__handle" aria-hidden="true"></div>
              <header class="lead-pwa-kanban-sheet__head">
                <div>
                  <strong data-lead-pwa-kanban-target="sheetName">Lead</strong>
                  <span data-lead-pwa-kanban-target="sheetMeta">Ações rápidas</span>
                </div>
                <button type="button" class="lead-pwa-kanban-sheet__close" data-action="lead-pwa-kanban#closeSheet" aria-label="Fechar">
                  <i class="bi bi-x-lg"></i>
                </button>
              </header>

              <div class="lead-pwa-kanban-sheet__section">
                <div class="lead-pwa-kanban-sheet__section-title">
                  <i class="bi bi-lightning-charge"></i><span>Ações rápidas</span>
                </div>
                <div class="lead-pwa-kanban-sheet__actions">
                  <a href="#" class="lead-pwa-kanban-sheet__action" data-lead-pwa-kanban-target="sheetOpenLink">
                    <i class="bi bi-box-arrow-up-right"></i><span>Abrir lead</span>
                  </a>
                  <% if can?(:view, :whatsapp_inbox) %>
                    <form method="post" class="tw-contents" data-lead-pwa-kanban-target="sheetWhatsappForm" data-action="submit->lead-pwa-kanban#openConversation">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <button type="submit" class="lead-pwa-kanban-sheet__action lead-pwa-kanban-sheet__action--primary w-100">
                        <i class="bi bi-whatsapp"></i><span>Conversar</span>
                      </button>
                    </form>
                  <% end %>
                </div>
              </div>

              <div class="lead-pwa-kanban-sheet__section">
                <div class="lead-pwa-kanban-sheet__section-title">
                  <i class="bi bi-kanban"></i><span>Etapa do funil</span>
                </div>
                <form method="post" class="lead-pwa-kanban-sheet__form lead-pwa-kanban-sheet__form--inline" data-lead-pwa-kanban-target="sheetStatusForm">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <input type="hidden" name="_method" value="patch">
                  <select id="lead_pwa_quick_status" name="lead[status]" aria-label="Mudar etapa" data-lead-pwa-kanban-target="sheetStatusSelect">
                    <% @pwa_kanban_statuses.each do |status| %>
                      <option value="<%= status %>"><%= status %></option>
                    <% end %>
                  </select>
                  <button type="submit" class="lead-pwa-kanban-sheet__submit lead-pwa-kanban-sheet__submit--icon" aria-label="Salvar etapa">
                    <i class="bi bi-check-lg"></i>
                  </button>
                </form>
              </div>

              <% if can?(:manage, :comercial) %>
                <div class="lead-pwa-kanban-sheet__section">
                  <div class="lead-pwa-kanban-sheet__section-title">
                    <i class="bi bi-calendar-check"></i><span>Próximas ações</span>
                  </div>
                  <div class="lead-pwa-kanban-sheet__quick-grid">
                    <form method="post" action="<%= admin_tasks_path %>" class="lead-pwa-kanban-sheet__form">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <input type="hidden" name="task[lead_id]" data-lead-pwa-kanban-target="sheetTaskLeadId">
                      <label for="lead_pwa_quick_task_title">Tarefa</label>
                      <input id="lead_pwa_quick_task_title" name="task[title]" required placeholder="Ex.: ligar">
                      <input type="datetime-local" name="task[due_at]">
                      <button type="submit" class="lead-pwa-kanban-sheet__submit">
                        <i class="bi bi-plus-lg"></i><span>Criar</span>
                      </button>
                    </form>

                    <form method="post" class="lead-pwa-kanban-sheet__form" data-lead-pwa-kanban-target="sheetScheduleForm">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <input type="hidden" name="activity_kind" value="return">
                      <label for="lead_pwa_quick_schedule_at">Retorno</label>
                      <input id="lead_pwa_quick_schedule_at" type="datetime-local" name="due_at" required>
                      <textarea name="notes" rows="2" placeholder="Observação"></textarea>
                      <button type="submit" class="lead-pwa-kanban-sheet__submit">
                        <i class="bi bi-calendar-plus"></i><span>Agendar</span>
                      </button>
                    </form>
                  </div>
                </div>
              <% end %>

              <div class="lead-pwa-kanban-sheet__section">
                <div class="lead-pwa-kanban-sheet__section-title">
                  <i class="bi bi-pencil-square"></i><span>Anotação</span>
                </div>
                <form method="post" class="lead-pwa-kanban-sheet__form" data-lead-pwa-kanban-target="sheetNoteForm">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <input type="hidden" name="contact_kind" value="nota">
                  <textarea id="lead_pwa_quick_note" name="body" rows="3" required aria-label="Anotação rápida" placeholder="Resumo da conversa, combinado ou próxima ação"></textarea>
                  <button type="submit" class="lead-pwa-kanban-sheet__submit">
                    <i class="bi bi-check2-circle"></i><span>Salvar anotação</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% else %>
          <div class="lead-pwa-empty">
            <strong>Nenhum lead no Kanban</strong>
            <span>Ajuste os filtros ou volte em Todos para ver sua carteira completa.</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="lead-pwa-list"
           role="list"
           data-controller="lead-pwa-infinite-scroll"
           data-lead-pwa-infinite-scroll-url-value="<%= pwa_leads_page_admin_leads_path(lead_query_params.merge(view: "list", mobile_tab: @pwa_lead_tab, page: nil).compact) %>">
        <% if @pwa_leads.any? %>
          <%= render partial: "admin/leads/pwa_lead_card", collection: @pwa_leads, as: :lead %>
          <%
            pwa_loaded_count = @pwa_leads.size
            pwa_total_count = @pwa_tab_counts.fetch(@pwa_lead_tab, pwa_loaded_count)
            pwa_has_more = pwa_loaded_count < pwa_total_count
          %>
          <%= tag.div(
                class: "lead-pwa-list__loader",
                hidden: !pwa_has_more,
                data: {
                  lead_pwa_infinite_scroll_target: "loader",
                  offset: pwa_loaded_count,
                  has_more: pwa_has_more
                }
              ) do %>
            <span class="lead-pwa-list__loader-pill">
              <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
              Carregando mais leads
            </span>
          <% end %>
        <% else %>
          <div class="lead-pwa-empty">
            <% if @pwa_lead_tab == "favorites" %>
              <strong>Nenhum favorito ainda</strong>
              <span>Abra um lead e toque na estrela para manter ele nesta aba.</span>
            <% else %>
              <strong>Nenhum lead nesta aba</strong>
              <span>Ajuste os filtros ou volte em Todos para ver sua carteira completa.</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= link_to new_admin_lead_path, class: "ax-pwa-action-fab lead-pwa-fab" do %>
      <i class="bi bi-plus" aria-hidden="true"></i>
      <span>Novo lead</span>
    <% end %>

  </section>

  <%= lead_desktop_header %>

  <%= ax_quick_modal(id: "leadDesktopFilterModal",
                     title: "Filtros",
                     size: :lg,
                     class_name: "lead-desktop-filter-modal") do %>
    <div class="lead-desktop-filter-panel">
      <%= leads_filter_form %>
    </div>
  <% end %>

  <div class="ax-leads-filter-overlay lead-pwa-filter-overlay"
       aria-label="Minha visualização dos leads"
       data-lead-pwa-filter-target="panel"
       data-action="keydown@window->lead-pwa-filter#closeOnEscape"
       hidden>
    <%= pwa_filter_form %>
  </div>

  <button type="button"
          class="ax-leads-mobile-filter-button"
          data-lead-pwa-filter-target="trigger"
          data-action="lead-pwa-filter#open"
          aria-expanded="false"
          aria-label="Abrir filtros do funil">
    <i class="bi bi-funnel"></i>
    <span>Filtros do funil</span>
    <% if lead_active_filter_count.positive? %>
      <strong><%= lead_active_filter_count %></strong>
    <% end %>
  </button>

  <% if @view_mode == "kanban" %>
    <%= ax_board(class_name: "ax-leads-board", data: { controller: "lead-kanban" }) do %>
      <% @lead_statuses.each do |status| %>
        <% stage_color = @lead_stage_color_by_status&.[](status) %>
        <%= ax_board_column(
              title: status,
              eyebrow: "Status do lead",
              count: @lead_counts_by_status[status].to_i,
              count_data: { lead_kanban_count: status },
              body_data: { lead_kanban_target: "column", lead_kanban_status: status },
              class_name: "ax-leads-board__column",
              style: (stage_color.present? ? "--ax-board-column-color: #{stage_color};" : nil),
              empty_text: "Sem leads aqui. Verifique outros status ou ajuste os filtros."
            ) do %>
          <% column_leads = @leads_by_status[status].to_a %>
          <% column_leads.each do |lead| %>
            <%= render "admin/leads/kanban_card",
                       lead: lead,
                       property: (@properties_by_id[lead.property_id] if lead.property_id.present?),
                       status_tone: ax_status_tone,
                       return_to_path: request.fullpath %>
          <% end %>
          <%
            loaded_count = column_leads.size
            total_count = @lead_counts_by_status[status].to_i
            has_more = loaded_count < total_count
            loader_params = lead_query_params.merge(
              view: "kanban",
              lead_tab: @desktop_lead_tab,
              status: status,
              offset: loaded_count,
              return_to: request.fullpath,
              page: nil
            ).compact
          %>
          <%= tag.div(
                class: "lead-kanban-loader",
                hidden: !has_more,
                data: {
                  lead_kanban_target: "loader",
                  lead_kanban_url: kanban_column_admin_leads_path(loader_params),
                  lead_kanban_offset: loaded_count,
                  lead_kanban_status: status,
                  lead_kanban_has_more: has_more
                }
              ) do %>
            <span class="lead-kanban-loader__pill">
              <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
              Carregando mais leads
            </span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <% if @leads.any? %>
      <div class="lead-list-workspace">
        <div class="lead-list" role="list">
          <% @leads.each do |lead| %>
            <%
              lead_return_to_path = "#{request.fullpath}#lead_#{lead.id}"
              property = @properties_by_id[lead.property_id] if lead.property_id.present?
              display_name = lead.display_name.presence || lead.name
              contact_parts = [lead.display_email, lead.display_phone].compact_blank
              phone_digits = lead.display_phone.to_s.gsub(/[^0-9+]/, "")
              conversion = lead_conversion_summary(lead)
            %>
            <article id="lead_<%= lead.id %>" class="lead-list-row" role="listitem">
              <div class="lead-list-row__identity">
                <div class="lead-list-row__avatar" aria-hidden="true">
                  <%= display_name.to_s.first.to_s.upcase.presence || "L" %>
                </div>
                <div class="lead-list-row__contact">
                  <div class="lead-list-row__topline">
                    <%= link_to display_name, admin_lead_path(lead, return_to: lead_return_to_path), class: "lead-list-row__name" %>
                    <%= ax_badge(lead.status.presence || Lead.default_status, tone: ax_status_tone.call(lead.status), class_name: "lead-list-row__status") %>
                  </div>
                  <div class="lead-list-row__meta">
                    <% if contact_parts.any? %>
                      <span><i class="bi bi-person-lines-fill"></i><%= contact_parts.join(" · ") %></span>
                    <% else %>
                      <span><i class="bi bi-person-lines-fill"></i>Contato sem telefone/e-mail</span>
                    <% end %>
                    <span><i class="bi bi-clock"></i><%= l(lead.created_at, format: "%d/%m/%Y %H:%M") %></span>
                  </div>
                  <% row_labels = lead.preloaded_labels_for(current_admin_user) %>
                  <% if row_labels.any? %>
                    <div class="lead-list-row__labels">
                      <%= render "admin/lead_labels/chips", lead: lead, labels: row_labels %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="lead-list-row__context">
                <div class="lead-list-row__origin">
                  <%= ax_badge(conversion[:channel_label], tone: conversion[:color].to_sym) %>
                  <span><i class="bi bi-person-badge"></i><%= lead.admin_user&.name.presence || "Sem corretor atribuído" %></span>
                </div>
                <div class="lead-list-row__property">
                  <% if property.present? %>
                    <i class="bi bi-house-door"></i>
                    <span>
                      <%= link_to property.display_title, admin_habitation_path_with_query(admin_habitation_path(property.id), admin_habitation_flat_return_params(lead_return_to_path)) %>
                      <small><%= property.codigo %></small>
                    </span>
                  <% elsif lead.property_id.present? %>
                    <i class="bi bi-exclamation-circle"></i>
                    <span>Imóvel indisponível</span>
                  <% else %>
                    <i class="bi bi-megaphone"></i>
                    <span>Contato geral</span>
                  <% end %>
                </div>
              </div>

              <div class="lead-list-row__actions">
                <% if whatsapp_inbox_attendance? && lead.whatsapp_recipient.present? %>
                  <%= button_to open_whatsapp_conversation_admin_lead_path(lead),
                                method: :post,
                                form: { class: "tw-contents" },
                                class: "ax-btn ax-btn--sm lead-list-row__primary-action" do %>
                    <i class="bi bi-whatsapp ax-ico"></i><span>WhatsApp</span>
                  <% end %>
                <% elsif lead.direct_whatsapp_url.present? %>
                  <%= link_to lead.direct_whatsapp_url, target: "_blank", rel: "noopener", class: "ax-btn ax-btn--sm lead-list-row__primary-action" do %>
                    <i class="bi bi-whatsapp ax-ico"></i><span>WhatsApp</span>
                  <% end %>
                <% end %>
                <% if phone_digits.present? %>
                  <%= link_to "tel:#{phone_digits}", class: "ax-btn ax-btn--sm" do %>
                    <i class="bi bi-telephone ax-ico"></i><span>Ligar</span>
                  <% end %>
                <% end %>
                <%= render "admin/lead_labels/button", lead: lead, trigger_label: "Etiquetas", trigger_class: "ax-btn ax-btn--sm" %>
                <%= link_to admin_lead_path(lead, return_to: lead_return_to_path), class: "ax-btn ax-btn--sm ax-btn--primary" do %>
                  <i class="bi bi-eye ax-ico"></i><span>Atender</span>
                <% end %>
                <% if can_destroy_lead? %>
                  <%= form_with url: admin_lead_path(lead), method: :delete,
                                id: "delete_lead_#{lead.id}", class: "tw-hidden" do %><% end %>
                  <%= ax_confirm_submit(
                        form_id: "delete_lead_#{lead.id}",
                        message: "Excluir este lead?",
                        confirm_label: "Excluir"
                      ) do %>
                    <%= ax_icon_button label: "Excluir", icon: "trash", variant: :danger,
                                       data: { action: "click->ax-confirm-submit#request" } %>
                  <% end %>
                <% end %>
              </div>
            </article>
            <% end %>
        </div>
      </div>

      <% if @leads.total_pages > 1 %>
        <div class="ax-leads-pagination">
          <%= ax_pagination @leads, params: request.query_parameters %>
        </div>
      <% end %>
    <% else %>
      <%= ax_empty_state title: "Nenhum lead encontrado",
                         description: "Ajuste os filtros de busca, status ou origem para ver mais resultados.",
                         icon: "megaphone" %>
    <% end %>
  <% end %>
</div>

<% if leads_can_manage_statuses %>
  <%= render "admin/leads/pipeline_create_modal" %>
  <%= render "admin/leads/status_board_modal" %>
<% end %>
