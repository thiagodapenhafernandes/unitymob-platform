<%
  stage_id = local_assigns[:id].presence
  stage_options = Array(local_assigns[:stage_options])
  archive_reason_options = Array(local_assigns[:archive_reason_options])
  distribution_rule_options = Array(local_assigns[:distribution_rule_options])
  automations = Array(local_assigns[:automations])
  policy = local_assigns[:policy]
  transitions = Array(local_assigns[:transitions])
  active = local_assigns.fetch(:active, true)
  stage_color = local_assigns[:color].presence || LeadPipelineStage::DEFAULT_COLORS[local_assigns[:position].to_i % LeadPipelineStage::DEFAULT_COLORS.size]
  visible_roles = Array(policy&.visible_to_roles.presence || LeadPipelineStagePolicy::DEFAULT_VISIBLE_ROLES)
  qualification_options = Array(policy&.qualification_options.presence || LeadPipelineStagePolicy::DEFAULT_QUALIFICATION_OPTIONS)
  allowed_archive_reason_ids = Array(policy&.allowed_archive_reason_ids).map(&:to_s)
  selected_next_stage_ids = transitions.map(&:next_stage_id).map(&:to_s)
  summary_parts = []
  summary_parts << "Visível para #{visible_roles.filter_map { |role| LeadPipelineStagePolicy::VISIBLE_ROLES[role] }.to_sentence}" if visible_roles.any?
  summary_parts << "#{selected_next_stage_ids.size} próxima(s) etapa(s)" if selected_next_stage_ids.any?
  first_archive_automation = automations.find { |automation| automation.respond_to?(:action_type) && automation.action_type == "archive_lead" && automation.active? }
  summary_parts << "Arquiva em #{first_archive_automation.after_amount} #{LeadPipelineStageAutomation::UNITS[first_archive_automation.after_unit]}" if first_archive_automation
  active_automations_count = automations.count { |automation| automation.respond_to?(:active?) && automation.active? }
  automation_summary = if automations.any?
                         "#{active_automations_count} ativa(s) · #{automations.size} regra(s)"
                       else
                         "Nenhuma automação configurada"
                       end
  distribution_mode_labels = {
    "rotary" => "Rodízio",
    "performance" => "Performance",
    "shark_tank" => "Shark Tank"
  }
  distribution_rule_label = lambda do |rule|
    mode = distribution_mode_labels.fetch(rule.distribution_mode.to_s, rule.distribution_mode.to_s.humanize)
    agents_count = rule.distribution_rule_agents.size
    agents_label = "#{agents_count} corretor#{'es' if agents_count != 1}"
    "#{rule.name} · #{mode} · #{agents_label}"
  end
  trigger_tooltips = {
    "stage_duration" => "Tempo na etapa\n1. O lead entra ou permanece nesta etapa.\n2. A regra precisa estar ativa.\n3. O tempo configurado precisa vencer.\n4. Exemplo: Tempo na etapa + 2 dias executa a ação final se o lead permanecer 2 dias nesta etapa.",
    "general_inactivity" => "Inatividade geral\n1. A contagem começa na entrada da etapa.\n2. Qualquer atividade relevante do cliente ou da equipe reinicia a contagem.\n3. Se não houver atividade até o prazo vencer, executa a ação final.",
    "customer_inactivity" => "Sem interação do cliente\n1. A contagem começa na entrada da etapa.\n2. Considera respostas no WhatsApp e interações em propostas.\n3. Se o cliente não interagir no prazo, executa a ação final.",
    "team_inactivity" => "Sem ação do responsável\n1. A contagem começa na entrada da etapa.\n2. Considera ações da equipe: nota, tarefa, agenda, proposta, WhatsApp enviado ou mudança de status.\n3. Se ninguém atuar no prazo, executa a ação final.",
    "no_stage_change" => "Sem avanço de etapa\n1. A contagem começa na última entrada na etapa.\n2. O lead precisa continuar nesta mesma etapa.\n3. Quando o prazo vencer sem avanço, executa a ação final."
  }
  unit_tooltips = {
    "minutes" => "Minutos\nUsa o tempo informado como minutos.\nIndicado para automações operacionais de resposta rápida.",
    "hours" => "Horas\nUsa o tempo informado como horas.\nIndicado para follow-up no mesmo dia ou no próximo turno.",
    "days" => "Dias\nUsa o tempo informado como dias corridos.\nIndicado para SLA de etapa, retomada e arquivamento."
  }
  action_tooltips = {
    "move_stage" => "Mover para etapa\n1. O gatilho precisa vencer.\n2. O lead muda para a etapa destino escolhida.\n3. O histórico recebe uma atividade de mudança de status feita pela automação.",
    "archive_lead" => "Arquivar lead\n1. O gatilho precisa vencer.\n2. O lead é arquivado com o motivo configurado.\n3. Se não houver motivo configurado, usa o primeiro motivo permitido da etapa.\n4. O histórico registra o arquivamento automático.",
    "redistribute_lead" => "Redistribuir na fila\n1. O gatilho precisa vencer.\n2. O lead entra na fila escolhida.\n3. Se nenhuma fila for escolhida, mantém a fila atual do lead.\n4. Se não houver fila, remove o responsável e deixa o lead aguardando aceite.",
    "make_available_for_automation" => "Disponibilizar para automação\n1. O gatilho precisa vencer.\n2. O lead fica sem responsável.\n3. Ele pode ser capturado por uma régua, fila ou rotina operacional.\n4. O histórico registra essa liberação automática.",
    "create_task" => "Criar tarefa\n1. O lead precisa estar naquela etapa.\n2. A regra precisa estar ativa.\n3. O gatilho precisa vencer, por exemplo: Tempo na etapa + 2 dias.\n4. Quando vencer, o sistema cria uma Task vinculada ao próprio lead.\n5. A tarefa fica atribuída ao corretor responsável pelo lead.\n6. Se o lead estiver sem responsável, usa o primeiro admin ativo do tenant como fallback.\n7. Também registra uma atividade no histórico do lead com kind: task_created.",
    "add_note" => "Registrar nota\n1. O gatilho precisa vencer.\n2. O sistema registra uma nota automática no histórico do lead.\n3. Usa o texto informado ou uma mensagem padrão."
  }

  automation_row = lambda do |automation, new_record: false|
    automation_id = automation.respond_to?(:id) ? automation.id : nil
    trigger = automation.respond_to?(:trigger) ? automation.trigger : "stage_duration"
    after_amount = automation.respond_to?(:after_amount) ? automation.after_amount : nil
    after_unit = automation.respond_to?(:after_unit) ? automation.after_unit : "days"
    destination_id = automation.respond_to?(:auto_advance_to_stage_id) ? automation.auto_advance_to_stage_id : nil
    action_type = automation.respond_to?(:action_type) ? automation.action_type : "move_stage"
    action_config = automation.respond_to?(:action_config) ? automation.action_config.to_h : {}
    active = automation.respond_to?(:active?) ? automation.active? : true
    row_attrs = new_record ? "data-new-record=\"true\"" : "data-automation-id=\"#{automation_id}\""
%>
    <div class="lead-status-row__automation-rule" <%= row_attrs.html_safe %>>
      <label class="lead-status-row__automation-toggle">
        <input type="checkbox"
               data-lead-status-automation-field="active"
               <%= "checked" if active %>>
        <span>Ativa</span>
      </label>

      <select class="ax-control ax-control--sm"
              data-lead-status-automation-field="trigger"
              data-controller="ax-tooltip"
              data-ax-tooltip-text-value="Condição que inicia a contagem da automação."
              data-ax-tooltip-option-texts-value="<%= json_escape(trigger_tooltips.to_json) %>"
              aria-label="Condição da automação da etapa">
        <% LeadPipelineStageAutomation::TRIGGERS.each do |value, label| %>
          <option value="<%= value %>" <%= "selected" if trigger == value %>><%= label %></option>
        <% end %>
      </select>

      <input type="number"
             min="1"
             step="1"
             class="ax-control ax-control--sm"
             data-lead-status-automation-field="after_amount"
             data-controller="ax-tooltip"
             data-ax-tooltip-text-value="Quantidade de tempo antes da ação final ser executada."
             value="<%= after_amount %>"
             placeholder="Tempo"
             aria-label="Tempo da automação da etapa">

      <select class="ax-control ax-control--sm"
              data-lead-status-automation-field="after_unit"
              data-controller="ax-tooltip"
              data-ax-tooltip-text-value="Unidade usada para contar o tempo da automação."
              data-ax-tooltip-option-texts-value="<%= json_escape(unit_tooltips.to_json) %>"
              aria-label="Unidade do tempo da automação da etapa">
        <% LeadPipelineStageAutomation::UNITS.each do |value, label| %>
          <option value="<%= value %>" <%= "selected" if after_unit == value %>><%= label %></option>
        <% end %>
      </select>

      <select class="ax-control ax-control--sm"
              data-lead-status-automation-field="auto_advance_to_stage_id"
              data-action-config-panel="move_stage"
              data-controller="ax-tooltip"
              data-ax-tooltip-text-value="Etapa de destino usada quando a ação final for mover o lead."
              aria-label="Etapa de destino da automação">
        <option value="">Mover para...</option>
        <% stage_options.each do |stage| %>
          <% next if stage_id.present? && stage.id.to_s == stage_id.to_s %>
          <option value="<%= stage.id %>" <%= "selected" if destination_id.to_s == stage.id.to_s %>>
            <%= stage.lead_pipeline.name %> · <%= stage.name %>
          </option>
        <% end %>
      </select>

      <select class="ax-control ax-control--sm"
              data-lead-status-automation-field="action_type"
              data-action="lead-status-board#changeAutomationAction"
              data-controller="ax-tooltip"
              data-ax-tooltip-text-value="O que o sistema executa ao final da automação."
              data-ax-tooltip-option-texts-value="<%= json_escape(action_tooltips.to_json) %>"
              aria-label="Ação final da automação">
        <% LeadPipelineStageAutomation::ACTION_TYPES.each do |value, label| %>
          <option value="<%= value %>" <%= "selected" if action_type == value %>><%= label %></option>
        <% end %>
      </select>

      <div class="lead-status-row__automation-config" data-action-config-panel="archive_lead" <%= "hidden" unless action_type == "archive_lead" %>>
        <select class="ax-control ax-control--sm"
                data-lead-status-automation-config-field="archive_reason_id"
                data-controller="ax-tooltip"
                data-ax-tooltip-text-value="Motivo registrado quando a automação arquivar o lead."
                aria-label="Motivo do arquivamento automático">
          <option value="">Motivo padrão</option>
          <% archive_reason_options.each do |reason| %>
            <option value="<%= reason.id %>" <%= "selected" if action_config["archive_reason_id"].to_s == reason.id.to_s %>><%= reason.name %></option>
          <% end %>
        </select>
      </div>

      <div class="lead-status-row__automation-config" data-action-config-panel="redistribute_lead" <%= "hidden" unless action_type == "redistribute_lead" %>>
        <select class="ax-control ax-control--sm"
                data-lead-status-automation-config-field="distribution_rule_id"
                data-controller="ax-tooltip"
                data-ax-tooltip-text-value="Fila usada para redistribuir o lead. Em branco, mantém a fila atual do próprio lead."
                aria-label="Fila de redistribuição">
          <option value="">Manter fila atual do lead</option>
          <% distribution_rule_options.each do |rule| %>
            <option value="<%= rule.id %>" <%= "selected" if action_config["distribution_rule_id"].to_s == rule.id.to_s %>>
              <%= distribution_rule_label.call(rule) %>
            </option>
          <% end %>
          <% if distribution_rule_options.blank? %>
            <option value="" disabled>Nenhuma fila ativa cadastrada</option>
          <% end %>
        </select>
      </div>

      <div class="lead-status-row__automation-config lead-status-row__automation-config--wide" data-action-config-panel="create_task" <%= "hidden" unless action_type == "create_task" %>>
        <input type="text"
               class="ax-control ax-control--sm"
               data-lead-status-automation-config-field="task_title"
               data-controller="ax-tooltip"
               data-ax-tooltip-text-value="Título da tarefa que será criada dentro do lead quando o gatilho vencer. Se ficar vazio, o sistema usa Follow-up automático."
               value="<%= action_config["task_title"] %>"
               placeholder="Título da tarefa">
        <input type="number"
               min="1"
               step="1"
               class="ax-control ax-control--sm"
               data-lead-status-automation-config-field="due_in_days"
               data-controller="ax-tooltip"
               data-ax-tooltip-text-value="Prazo da tarefa após a execução da automação. Exemplo: 2 cria a tarefa com vencimento para daqui a 2 dias. Se ficar vazio, usa 1 dia."
               value="<%= action_config["due_in_days"] %>"
               placeholder="Vence em dias">
      </div>

      <input type="text"
             class="ax-control ax-control--sm"
             data-lead-status-automation-config-field="note"
             data-controller="ax-tooltip"
             data-ax-tooltip-text-value="Observação registrada junto com a ação automática. Em Criar tarefa, também entra como descrição da tarefa vinculada ao lead."
             value="<%= action_config["note"] %>"
             placeholder="Nota opcional"
             aria-label="Nota opcional da ação final">

      <button type="button"
              class="ax-icon-btn lead-status-row__automation-remove"
              data-action="lead-status-board#removeAutomation"
              aria-label="Remover automação"
              title="Remover automação">
        <i class="bi bi-trash"></i>
      </button>
    </div>
<%
  end
%>

<div class="lead-status-row" data-id="<%= local_assigns[:id] %>">
  <button type="button" class="lead-status-row__handle" aria-label="Reordenar" title="Arraste para reordenar" tabindex="-1">
    <i class="bi bi-grip-vertical"></i>
  </button>
  <div class="lead-status-row__content">
  <button type="button"
          class="lead-status-row__summary"
          data-action="lead-status-board#toggleDetails"
          aria-expanded="false">
    <span>
      <strong data-lead-status-summary-name>
        <span class="lead-status-row__color-dot" style="--lead-stage-row-color: <%= stage_color %>"></span>
        <%= local_assigns[:name].presence || "Nova etapa" %>
      </strong>
      <small data-lead-status-summary-details><%= summary_parts.presence&.join(" · ") || "Sem regras avançadas" %></small>
    </span>
    <span class="lead-status-row__summary-badges">
      <%= ax_badge(LeadPipelineStage::STAGE_TYPES[local_assigns[:stage_type].presence || "open"], tone: :blue) %>
      <%= ax_badge(active ? "Ativa" : "Inativa", tone: active ? :green : :gray) %>
      <i class="bi bi-chevron-down"></i>
    </span>
  </button>

  <div class="lead-status-row__details" hidden>
    <div class="lead-status-row__section">
      <div class="lead-status-row__section-title">
        <%= ax_field_label(nil, nil, text: "Identificação", tooltip: "Dados básicos da etapa exibidos no funil e nos cards de lead.") %>
      </div>
      <div class="lead-status-row__fields">
        <input type="text"
               class="ax-control ax-control--sm"
               data-lead-status-field="name"
               data-controller="ax-tooltip"
               data-ax-tooltip-text-value="Nome exibido no funil e nos cards de lead."
               value="<%= local_assigns[:name] %>"
               placeholder="Nome da etapa"
               aria-label="Nome da etapa">
        <input type="text"
               class="ax-control ax-control--sm"
               data-lead-status-field="description"
               data-controller="ax-tooltip"
               data-ax-tooltip-text-value="Texto curto opcional para orientar o uso da etapa."
               value="<%= local_assigns[:description] %>"
               placeholder="Subtítulo (opcional)"
               aria-label="Subtítulo do status">
        <select class="ax-control ax-control--sm"
                data-lead-status-field="stage_type"
                data-controller="ax-tooltip"
                data-ax-tooltip-text-value="Define o comportamento operacional da etapa: aberta, ganha, perdida ou arquivada."
                aria-label="Tipo da etapa">
          <% LeadPipelineStage::STAGE_TYPES.each do |value, label| %>
            <option value="<%= value %>" <%= "selected" if local_assigns[:stage_type].presence == value %>><%= label %></option>
          <% end %>
        </select>
        <div class="lead-status-row__color-field"
             data-controller="ax-tooltip"
             data-ax-tooltip-text-value="Cor usada para identificar visualmente esta etapa no funil.">
          <input type="color"
                 class="lead-status-row__color-swatch"
                 data-lead-status-field="color"
                 value="<%= stage_color %>"
                 aria-label="Cor da etapa">
        </div>
        <label class="lead-status-row__automation-toggle"
               data-controller="ax-tooltip"
               data-ax-tooltip-text-value="Etapas inativas deixam de aparecer para uso operacional, sem apagar histórico.">
          <input type="checkbox"
                 data-lead-status-field="active"
                 <%= "checked" if active %>>
          <span>Ativa</span>
        </label>
      </div>
    </div>

    <div class="lead-status-row__section">
      <div class="lead-status-row__section-title">
        <%= ax_field_label(nil, nil, text: "Acesso", tooltip: "Define quem pode ver ou usar esta etapa antes de configurar o fluxo operacional.") %>
      </div>
      <div class="lead-status-row__visibility">
        <% LeadPipelineStagePolicy::VISIBLE_ROLES.each do |value, label| %>
          <label class="ax-toggle-chip"
                 data-controller="ax-tooltip"
                 data-ax-tooltip-text-value="Permite que este perfil visualize e use a etapa.">
            <input type="checkbox"
                   class="ax-toggle-chip__input"
                   data-lead-status-policy-array-field="visible_to_roles"
                   value="<%= value %>"
                   <%= "checked" if visible_roles.include?(value) %>>
            <span class="ax-toggle-chip__box" aria-hidden="true"><i class="bi bi-eye"></i></span>
            <span class="ax-toggle-chip__label"><%= label %></span>
          </label>
        <% end %>
        <label class="lead-status-row__automation-toggle"
               data-controller="ax-tooltip"
               data-ax-tooltip-text-value="Permite sinalizar divergência entre a qualificação do gestor e do corretor nesta etapa.">
          <input type="checkbox"
                 data-lead-status-policy-field="divergence_queue_enabled"
                 <%= "checked" if policy&.divergence_queue_enabled %>>
          <span>Fila divergência</span>
        </label>
      </div>
    </div>

    <div class="lead-status-row__section">
      <div class="lead-status-row__section-title">
        <%= ax_field_label(nil, nil, text: "Fluxo", tooltip: "Define para onde o lead pode seguir e quais motivos podem encerrar ou desqualificar o atendimento nesta etapa.") %>
      </div>
      <div class="lead-status-row__ops-grid">
        <div>
          <%= ax_field_label(nil, nil,
                             text: "Próximas etapas",
                             tooltip: "Define para quais etapas o lead pode avançar a partir desta etapa. Se ficar vazio, não restringe o fluxo.",
                             class_name: "ax-label lead-status-row__field-label") %>
          <select class="ax-control ax-control--sm lead-status-row__multiselect"
                  multiple
                  data-controller="tom-select"
                  data-placeholder="Selecione as próximas etapas..."
                  data-tom-select-open-on-initialize-value="true"
                  data-tom-select-tags-value="false"
                  data-tom-select-options-value='{"wrapperClass":"ts-wrapper p-0 ax-autocomplete-select--multi lead-status-row__multiselect-wrapper","dropdownParent":null,"openOnFocus":false,"maxOptions":null,"hideSelected":false,"closeAfterSelect":false}'
                  data-lead-status-transition-field="next_stage_id"
                  aria-label="Próximas etapas permitidas">
            <% stage_options.each do |stage| %>
              <% next if stage_id.present? && stage.id.to_s == stage_id.to_s %>
              <option value="<%= stage.id %>" <%= "selected" if selected_next_stage_ids.include?(stage.id.to_s) %>>
                <%= stage.name %>
              </option>
            <% end %>
          </select>
        </div>

        <div>
          <%= ax_field_label(nil, nil,
                             text: "Motivos permitidos",
                             tooltip: "Limita os motivos aceitos para arquivamento ou desqualificação nesta etapa. Se ficar vazio, não restringe os motivos.",
                             class_name: "ax-label lead-status-row__field-label") %>
          <select class="ax-control ax-control--sm lead-status-row__multiselect"
                  multiple
                  data-controller="tom-select"
                  data-placeholder="Selecione os motivos permitidos..."
                  data-tom-select-open-on-initialize-value="true"
                  data-tom-select-tags-value="false"
                  data-tom-select-options-value='{"wrapperClass":"ts-wrapper p-0 ax-autocomplete-select--multi lead-status-row__multiselect-wrapper","dropdownParent":null,"openOnFocus":false,"maxOptions":null,"hideSelected":false,"closeAfterSelect":false}'
                  data-lead-status-policy-array-field="allowed_archive_reason_ids"
                  aria-label="Motivos permitidos para arquivamento ou desqualificação">
            <% archive_reason_options.each do |reason| %>
              <option value="<%= reason.id %>" <%= "selected" if allowed_archive_reason_ids.include?(reason.id.to_s) %>>
                <%= reason.name %>
              </option>
            <% end %>
          </select>
        </div>
      </div>
    </div>

    <div class="lead-status-row__section">
      <div class="lead-status-row__section-title">
        <%= ax_field_label(nil, nil, text: "Atendimento", tooltip: "Configura o que o corretor pode registrar ou agendar enquanto o lead estiver nesta etapa.") %>
      </div>
      <div class="lead-status-row__ops-grid lead-status-row__ops-grid--attention">
        <div>
          <%= ax_field_label(nil, nil,
                             text: "Agenda futura",
                             tooltip: "Número máximo de dias no futuro para criar agenda nesta etapa. Em branco, não aplica limite.",
                             class_name: "ax-label lead-status-row__field-label") %>
          <input type="number"
                 min="1"
                 step="1"
                 class="ax-control ax-control--sm"
                 data-lead-status-policy-field="future_activity_limit_days"
                 value="<%= policy&.future_activity_limit_days %>"
                 placeholder="Limite em dias">
        </div>

        <div>
          <div class="lead-status-row__inline-help-label">
            <%= ax_field_label(nil, nil,
                               text: "Qualificação no card",
                               tooltip: "Quando ligado, o card do lead pode exibir controle de qualificação nesta etapa.") %>
          </div>
          <label class="lead-status-row__automation-toggle">
            <input type="checkbox"
                   data-lead-status-policy-field="qualification_enabled"
                   <%= "checked" if policy&.qualification_enabled %>>
            <span>Exibir no card</span>
          </label>
          <div class="lead-status-row__chip-list lead-status-row__chip-list--inline">
            <% LeadPipelineStagePolicy::QUALIFICATION_OPTIONS.each do |value, label| %>
              <label class="ax-toggle-chip"
                     data-controller="ax-tooltip"
                     data-ax-tooltip-text-value="Opção de qualificação disponível no card quando a qualificação estiver ligada.">
                <input type="checkbox"
                       class="ax-toggle-chip__input"
                       data-lead-status-policy-array-field="qualification_options"
                       value="<%= value %>"
                       <%= "checked" if qualification_options.include?(value) %>>
                <span class="ax-toggle-chip__label"><%= label %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <details class="lead-status-row__automations">
      <summary class="lead-status-row__automations-summary">
        <span>
          <%= ax_field_label(nil, nil,
                             text: "Automações",
                             tooltip: "Regras executadas automaticamente quando o lead atende uma condição pelo tempo configurado.",
                             class_name: "lead-status-row__automation-title") %>
          <small><%= automation_summary %></small>
        </span>
        <i class="bi bi-chevron-down"></i>
      </summary>

      <div class="lead-status-row__automations-body">
        <div class="lead-status-row__automations-actions">
          <button type="button"
                  class="ax-btn ax-btn--sm"
                  data-action="lead-status-board#addAutomation">
            <i class="bi bi-plus-lg"></i> Adicionar automação
          </button>
        </div>

        <div class="lead-status-row__automation-list">
          <% automations.each do |automation| %>
            <% automation_row.call(automation) %>
          <% end %>
        </div>

        <template class="lead-status-row__automation-template">
          <% automation_row.call(nil, new_record: true) %>
        </template>
      </div>
    </details>
  </div>
  </div>
  <button type="button"
