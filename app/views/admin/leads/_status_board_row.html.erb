<%
  stage_id = local_assigns[:id].presence
  stage_options = Array(local_assigns[:stage_options])
  replacement_stage_source = Array(local_assigns[:replacement_stage_options].presence || stage_options)
  archive_reason_options = Array(local_assigns[:archive_reason_options])
  distribution_rule_options = Array(local_assigns[:distribution_rule_options])
  automations = Array(local_assigns[:automations])
  policy = local_assigns[:policy]
  transitions = Array(local_assigns[:transitions])
  active = local_assigns.fetch(:active, true)
  stage_color = local_assigns[:color].presence || LeadPipelineStage::DEFAULT_COLORS[local_assigns[:position].to_i % LeadPipelineStage::DEFAULT_COLORS.size]
  visible_roles = Array(policy&.visible_to_roles.presence || LeadPipelineStagePolicy::DEFAULT_VISIBLE_ROLES)
  qualification_options = Array(policy&.qualification_options.presence || LeadPipelineStagePolicy::DEFAULT_QUALIFICATION_OPTIONS)
  allowed_archive_reason_ids = Array(policy&.allowed_archive_reason_ids).map(&:to_s)
  selected_next_stage_ids = transitions.map(&:next_stage_id).map(&:to_s)
  replacement_stage_options = replacement_stage_source.select { |stage| stage_id.blank? || stage.id.to_s != stage_id.to_s }
  summary_parts = []
  summary_parts << "Visível para #{visible_roles.filter_map { |role| LeadPipelineStagePolicy::VISIBLE_ROLES[role] }.to_sentence}" if visible_roles.any?
  summary_parts << "#{selected_next_stage_ids.size} próxima(s) etapa(s)" if selected_next_stage_ids.any?
  first_archive_automation = automations.find { |automation| automation.respond_to?(:action_type) && automation.action_type == "archive_lead" && automation.active? }
  if first_archive_automation
    attempt_limit = first_archive_automation.action_config.to_h["unsuccessful_attempt_limit"].to_i
    archive_reason_id = first_archive_automation.action_config.to_h["archive_reason_id"].to_s
    archive_reason = archive_reason_options.find { |reason| reason.id.to_s == archive_reason_id }
    archive_summary = "Arquiva em #{first_archive_automation.after_amount} #{LeadPipelineStageAutomation::UNITS[first_archive_automation.after_unit]}"
    archive_summary += " para #{archive_reason.name}" if archive_reason
    archive_summary += " ou #{attempt_limit} tentativa(s)" if attempt_limit.positive?
    summary_parts << archive_summary
  end
  active_automations_count = automations.count { |automation| automation.respond_to?(:active?) && automation.active? }
  automation_summary = if automations.any?
                         "#{active_automations_count} ativa(s) · #{automations.size} regra(s)"
                       else
                         "Nenhuma automação configurada"
                       end
  distribution_mode_labels = {
    "rotary" => "Rodízio",
    "performance" => "Performance",
    "shark_tank" => "Shark Tank",
    "attendance" => "Atendimento"
  }
  distribution_rule_label = lambda do |rule|
    mode = distribution_mode_labels.fetch(rule.distribution_mode.to_s, rule.distribution_mode.to_s.humanize)
    agents_count = rule.distribution_rule_agents.size
    agents_label = "#{agents_count} corretor#{'es' if agents_count != 1}"
    "#{rule.name} · #{mode} · #{agents_label}"
  end
  trigger_tooltips = {
    "stage_duration" => "Tempo na etapa\n1. O lead entra ou permanece nesta etapa.\n2. A regra precisa estar ativa.\n3. O tempo configurado precisa vencer.\n4. Exemplo: Tempo na etapa + 2 dias executa a ação final se o lead permanecer 2 dias nesta etapa.",
    "general_inactivity" => "Inatividade geral\n1. A contagem começa na entrada da etapa.\n2. Qualquer atividade relevante do cliente ou da equipe reinicia a contagem.\n3. Se não houver atividade até o prazo vencer, executa a ação final.",
    "customer_inactivity" => "Sem interação do cliente\n1. A contagem começa na entrada da etapa.\n2. Considera respostas no WhatsApp e interações em propostas.\n3. Se o cliente não interagir no prazo, executa a ação final.",
    "team_inactivity" => "Sem ação do responsável\n1. A contagem começa na entrada da etapa.\n2. Considera ações da equipe: nota, tarefa, agenda, proposta, WhatsApp enviado ou mudança de status.\n3. Se ninguém atuar no prazo, executa a ação final.",
    "no_stage_change" => "Sem avanço de etapa\n1. A contagem começa na última entrada na etapa.\n2. O lead precisa continuar nesta mesma etapa.\n3. Quando o prazo vencer sem avanço, executa a ação final."
  }
  unit_tooltips = {
    "minutes" => "Minutos\nUsa o tempo informado como minutos.\nIndicado para automações operacionais de resposta rápida.",
    "hours" => "Horas\nUsa o tempo informado como horas.\nIndicado para follow-up no mesmo dia ou no próximo turno.",
    "days" => "Dias\nUsa o tempo informado como dias corridos.\nIndicado para SLA de etapa, retomada e arquivamento."
  }
  action_tooltips = {
    "move_stage" => "Mover para etapa\n1. O gatilho precisa vencer.\n2. O lead muda para a etapa destino escolhida.\n3. O histórico recebe uma atividade de mudança de status feita pela automação.",
    "archive_lead" => "Arquivar lead\n1. O gatilho precisa vencer.\n2. O lead é arquivado direto com o destino/motivo configurado.\n3. Se não houver destino configurado, usa o primeiro motivo permitido da etapa.\n4. O histórico registra o arquivamento automático.",
    "redistribute_lead" => "Redistribuir na fila\n1. O gatilho precisa vencer.\n2. O lead entra na fila escolhida.\n3. Se nenhuma fila for escolhida, mantém a fila atual do lead.\n4. Se não houver fila, remove o responsável e deixa o lead aguardando aceite.",
    "make_available_for_automation" => "Disponibilizar para automação\n1. O gatilho precisa vencer.\n2. O lead fica sem responsável.\n3. Ele pode ser capturado por uma régua, fila ou rotina operacional.\n4. O histórico registra essa liberação automática.",
    "create_task" => "Criar tarefa\n1. O lead precisa estar naquela etapa.\n2. A regra precisa estar ativa.\n3. O gatilho precisa vencer, por exemplo: Tempo na etapa + 2 dias.\n4. Quando vencer, o sistema cria uma Task vinculada ao próprio lead.\n5. A tarefa fica atribuída ao corretor responsável pelo lead.\n6. Se o lead estiver sem responsável, usa o primeiro admin ativo do tenant como fallback.\n7. Também registra uma atividade no histórico do lead com kind: task_created.",
    "add_note" => "Registrar nota\n1. O gatilho precisa vencer.\n2. O sistema registra uma nota automática no histórico do lead.\n3. Usa o texto informado ou uma mensagem padrão."
  }

  field_prefix = "lead-stage-#{stage_id || 'new'}"
  automation_row = lambda do |automation|
    automation_id = automation.respond_to?(:id) ? automation.id : nil
    trigger = automation.respond_to?(:trigger) ? automation.trigger : "stage_duration"
    after_amount = automation.respond_to?(:after_amount) ? automation.after_amount : nil
    after_unit = automation.respond_to?(:after_unit) ? automation.after_unit : "days"
    destination_id = automation.respond_to?(:auto_advance_to_stage_id) ? automation.auto_advance_to_stage_id : nil
    action_type = automation.respond_to?(:action_type) ? automation.action_type : "move_stage"
    action_config = automation.respond_to?(:action_config) ? automation.action_config.to_h : {}
    automation_active = automation.respond_to?(:active?) ? automation.active? : true
    automation_prefix = "#{field_prefix}-automation-#{automation_id || 'new'}"
%>
    <div class="lead-status-row__automation-rule" data-automation-id="<%= automation_id %>">
      <div class="lead-status-row__automation-header">
        <%= ax_switch_field(label: "Automação ativa", name: nil, id: "#{automation_prefix}-active", checked: automation_active,
                            input_html: { data: { lead_status_automation_field: "active" } }) %>
        <%= ax_button("Remover", variant: :ghost, size: :sm, icon: "trash", data: { action: "lead-status-board#removeAutomation" }) %>
      </div>
      <div class="lead-status-row__automation-body">
        <div class="lead-status-row__automation-condition">
          <span class="lead-status-row__rule-word">Quando</span>
          <%= ax_standalone_select_field(name: nil, id: "#{automation_prefix}-trigger", label: "Condição", selected: trigger,
                choices: LeadPipelineStageAutomation::TRIGGERS.map { |value, label| [label, value] },
                data: { lead_status_automation_field: "trigger", controller: "ax-tooltip", ax_tooltip_text_value: "Condição que inicia a contagem da automação.", ax_tooltip_option_texts_value: trigger_tooltips }) %>
          <%= ax_standalone_field(name: nil, id: "#{automation_prefix}-amount", label: "Tempo", type: :number, value: after_amount, min: 1, step: 1,
                data: { lead_status_automation_field: "after_amount", controller: "ax-tooltip", ax_tooltip_text_value: "Quantidade de tempo antes da ação final ser executada." }) %>
          <%= ax_standalone_select_field(name: nil, id: "#{automation_prefix}-unit", label: "Unidade", selected: after_unit,
                choices: LeadPipelineStageAutomation::UNITS.map { |value, label| [label, value] },
                data: { lead_status_automation_field: "after_unit", controller: "ax-tooltip", ax_tooltip_text_value: "Unidade usada para contar o tempo da automação.", ax_tooltip_option_texts_value: unit_tooltips }) %>
          <%= ax_standalone_field(name: nil, id: "#{automation_prefix}-attempts", label: "Tentativas", type: :number, value: action_config["unsuccessful_attempt_limit"], min: 1, step: 1, placeholder: "Opcional",
                data: { lead_status_automation_config_field: "unsuccessful_attempt_limit", controller: "ax-tooltip", ax_tooltip_text_value: "Executa a mesma ação quando o lead atingir esta quantidade de tentativas sem resposta na etapa atual. Em branco, usa só o tempo." }) %>
        </div>
        <div class="lead-status-row__automation-action">
          <span class="lead-status-row__rule-word">Então</span>
          <%= ax_standalone_select_field(name: nil, id: "#{automation_prefix}-action", label: "Ação", selected: action_type,
                choices: LeadPipelineStageAutomation::ACTION_TYPES.map { |value, label| [label, value] },
                data: { lead_status_automation_field: "action_type", action: "lead-status-board#changeAutomationAction", controller: "ax-tooltip", ax_tooltip_text_value: "O que o sistema executa ao final da automação.", ax_tooltip_option_texts_value: action_tooltips }) %>
          <div data-action-config-panel="move_stage" <%= "hidden" unless action_type == "move_stage" %>>
            <%= ax_standalone_select_field(name: nil, id: "#{automation_prefix}-destination", label: "Etapa de destino", selected: destination_id,
                  include_blank: "Mover para...", choices: stage_options.reject { |stage| stage.id.to_s == stage_id.to_s }.map { |stage| ["#{stage.lead_pipeline.name} · #{stage.name}", stage.id] },
                  data: { lead_status_automation_field: "auto_advance_to_stage_id", lead_status_stage_options: "qualified", controller: "ax-tooltip", ax_tooltip_text_value: "Etapa de destino usada quando a ação final for mover o lead." }) %>
          </div>
          <div data-action-config-panel="archive_lead" <%= "hidden" unless action_type == "archive_lead" %>>
            <%= ax_standalone_select_field(name: nil, id: "#{automation_prefix}-archive", label: "Destino do arquivamento", selected: action_config["archive_reason_id"],
                  include_blank: "Destino padrão", choices: archive_reason_options.map { |reason| [reason.name, reason.id] },
                  data: { lead_status_automation_config_field: "archive_reason_id", controller: "ax-tooltip", ax_tooltip_text_value: "Destino/motivo final registrado quando a automação arquivar o lead, sem etapa intermediária." }) %>
          </div>
          <div data-action-config-panel="redistribute_lead" <%= "hidden" unless action_type == "redistribute_lead" %>>
            <%= ax_standalone_select_field(name: nil, id: "#{automation_prefix}-queue", label: "Fila de redistribuição", selected: action_config["distribution_rule_id"],
                  include_blank: "Manter fila atual do lead", choices: distribution_rule_options.map { |rule| [distribution_rule_label.call(rule), rule.id] },
                  hint: ("Nenhuma fila ativa cadastrada" if distribution_rule_options.empty?),
                  data: { lead_status_automation_config_field: "distribution_rule_id", controller: "ax-tooltip", ax_tooltip_text_value: "Fila usada para redistribuir o lead. Em branco, mantém a fila atual do próprio lead." }) %>
          </div>
          <div class="lead-status-row__task-config" data-action-config-panel="create_task" <%= "hidden" unless action_type == "create_task" %>>
            <%= ax_standalone_field(name: nil, id: "#{automation_prefix}-task", label: "Título da tarefa", value: action_config["task_title"], placeholder: "Follow-up automático",
                  data: { lead_status_automation_config_field: "task_title", controller: "ax-tooltip", ax_tooltip_text_value: "Título da tarefa criada no lead. Em branco, usa Follow-up automático." }) %>
            <%= ax_standalone_field(name: nil, id: "#{automation_prefix}-due", label: "Vence em dias", type: :number, value: action_config["due_in_days"], min: 1, step: 1,
                  data: { lead_status_automation_config_field: "due_in_days", controller: "ax-tooltip", ax_tooltip_text_value: "Prazo da tarefa após a execução. Em branco, usa 1 dia." }) %>
          </div>
        </div>
        <%= ax_standalone_field(name: nil, id: "#{automation_prefix}-note", label: "Nota (opcional)", value: action_config["note"], placeholder: "Observação registrada junto com a ação",
              data: { lead_status_automation_config_field: "note", controller: "ax-tooltip", ax_tooltip_text_value: "Observação registrada junto com a ação automática. Em Criar tarefa, também entra como descrição da tarefa vinculada ao lead." }) %>
      </div>
    </div>
<% end %>

<div class="lead-status-row" data-id="<%= stage_id %>" hidden
     data-action="input->lead-status-board#updateStage change->lead-status-board#updateStage">
  <div class="lead-status-row__editor-heading">
    <%= ax_workspace_heading(plain: true, title: tag.span(local_assigns[:name].presence || "Nova etapa", data: { lead_status_summary_name: true }),
          eyebrow: tag.span("Etapa", data: { lead_status_position: true }),
          subtitle: tag.span(summary_parts.join(" · "), data: { lead_status_summary_details: true }),
          actions: capture do %>
      <span data-lead-status-type-badge><%= ax_badge(LeadPipelineStage::STAGE_TYPES[local_assigns[:stage_type].presence || "open"], tone: :blue) %></span>
      <%= ax_switch_field(label: "Ativa", name: nil, id: "#{field_prefix}-active", checked: active,
            input_html: { data: { lead_status_field: "active", controller: "ax-tooltip", ax_tooltip_text_value: "Etapas inativas deixam de aparecer para uso operacional, sem apagar histórico." } }) %>
    <% end) %>
  </div>
  <div class="lead-status-row__details">
    <%= ax_operational_panel(title: "Identificação") do %>
      <%= ax_field_grid do %>
        <div class="ax-span-7">
          <%= ax_standalone_field(name: nil, id: "#{field_prefix}-name", label: "Nome da etapa", value: local_assigns[:name], placeholder: "Nome da etapa",
                data: { lead_status_field: "name", controller: "ax-tooltip", ax_tooltip_text_value: "Nome exibido no funil e nos cards de lead." }) %>
        </div>
        <div class="ax-span-4">
          <%= ax_standalone_select_field(name: nil, id: "#{field_prefix}-type", label: "Tipo da etapa", selected: local_assigns[:stage_type].presence || "open",
                choices: LeadPipelineStage::STAGE_TYPES.map { |value, label| [label, value] },
                data: { lead_status_field: "stage_type", controller: "ax-tooltip", ax_tooltip_text_value: "Define o comportamento operacional da etapa: aberta, ganha, perdida ou arquivada." }) %>
        </div>
        <div class="ax-span-1">
          <%= ax_standalone_field(name: nil, id: "#{field_prefix}-color", label: "Cor", type: :color, value: stage_color,
                data: { lead_status_field: "color", controller: "ax-tooltip", ax_tooltip_text_value: "Cor usada para identificar visualmente esta etapa no funil." }) %>
        </div>
        <div class="ax-span-12">
          <%= ax_standalone_field(name: nil, id: "#{field_prefix}-description", label: "Subtítulo (opcional)", value: local_assigns[:description], placeholder: "Orientação curta sobre o uso desta etapa",
                data: { lead_status_field: "description", controller: "ax-tooltip", ax_tooltip_text_value: "Texto curto opcional para orientar o uso da etapa." }) %>
        </div>
      <% end %>
    <% end %>

    <div class="lead-status-row__access-attention">
      <%= ax_operational_panel(title: "Acesso", eyebrow: "Quem pode visualizar e usar esta etapa") do %>
        <div class="lead-status-row__visibility">
          <% LeadPipelineStagePolicy::VISIBLE_ROLES.each do |value, label| %>
            <%= ax_toggle_chip(label: label, name: nil, id: "#{field_prefix}-role-#{value}", checked_value: value, include_hidden: false, checked: visible_roles.include?(value),
                  input_data: { lead_status_policy_array_field: "visible_to_roles", controller: "ax-tooltip", ax_tooltip_text_value: "Permite que este perfil visualize e use a etapa." }) %>
          <% end %>
        </div>
        <%= ax_switch_field(label: "Fila divergência", name: nil, id: "#{field_prefix}-divergence", checked: policy&.divergence_queue_enabled,
              description: "Sinaliza divergência entre gestor e corretor.",
              input_html: { data: { lead_status_policy_field: "divergence_queue_enabled" } }) %>
      <% end %>
      <%= ax_operational_panel(title: "Atendimento", eyebrow: "Agenda e qualificação dos leads") do %>
        <%= ax_standalone_field(name: nil, id: "#{field_prefix}-agenda", label: "Agenda futura", type: :number, value: policy&.future_activity_limit_days, min: 1, step: 1, placeholder: "Limite em dias", hint: "Em branco, sem limite para agendar.",
              data: { lead_status_policy_field: "future_activity_limit_days" }) %>
        <%= ax_switch_field(label: "Exibir qualificação no card", name: nil, id: "#{field_prefix}-qualification", checked: policy&.qualification_enabled,
              input_html: { data: { lead_status_policy_field: "qualification_enabled" } }) %>
        <div class="lead-status-row__chip-list" data-lead-status-qualification-options <%= "hidden" unless policy&.qualification_enabled %>>
          <% LeadPipelineStagePolicy::QUALIFICATION_OPTIONS.each do |value, label| %>
            <%= ax_toggle_chip(label: label, name: nil, id: "#{field_prefix}-qualification-#{value}", checked_value: value, include_hidden: false, checked: qualification_options.include?(value),
                  input_data: { lead_status_policy_array_field: "qualification_options", controller: "ax-tooltip", ax_tooltip_text_value: "Opção de qualificação disponível no card quando a qualificação estiver ligada." }) %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= ax_operational_panel(title: "Fluxo", eyebrow: "Destinos e motivos permitidos nesta etapa") do %>
      <%= ax_field_grid do %>
        <div class="ax-span-6">
          <%= ax_multiselect_field(name: "next_stage_ids[]", id: "#{field_prefix}-transitions", label: "Próximas etapas", selected: selected_next_stage_ids,
                choices: stage_options.reject { |stage| stage.id.to_s == stage_id.to_s }.map { |stage| [stage.name, stage.id] },
                placeholder: "Selecione as próximas etapas...", tooltip: "Define para quais etapas o lead pode avançar. Se ficar vazio, não restringe o fluxo.",
                data: { lead_status_transition_field: "next_stage_id", lead_status_stage_options: "plain", tom_select_tags_value: false,
                        tom_select_options_value: { dropdownParent: nil, openOnFocus: false, maxOptions: nil, hideSelected: false, closeAfterSelect: false } }) %>
          <p class="ax-field__hint">Sem seleção, o fluxo não é restringido.</p>
        </div>
        <div class="ax-span-6">
          <%= ax_multiselect_field(name: "allowed_archive_reason_ids[]", id: "#{field_prefix}-reasons", label: "Motivos permitidos", selected: allowed_archive_reason_ids,
                choices: archive_reason_options.map { |reason| [reason.name, reason.id] },
                placeholder: "Selecione os motivos permitidos...", tooltip: "Limita os motivos aceitos para arquivamento ou desqualificação. Se ficar vazio, não restringe os motivos.",
                data: { lead_status_policy_array_field: "allowed_archive_reason_ids", tom_select_tags_value: false,
                        tom_select_options_value: { dropdownParent: nil, openOnFocus: false, maxOptions: nil, hideSelected: false, closeAfterSelect: false } }) %>
          <p class="ax-field__hint">Sem seleção, os motivos não são restringidos.</p>
        </div>
      <% end %>
    <% end %>

    <%= ax_operational_panel(title: "Automações", eyebrow: tag.span(automation_summary, data: { lead_status_automation_summary: true }),
          actions: ax_button("Adicionar automação", size: :sm, icon: "plus-lg", data: { action: "lead-status-board#addAutomation" })) do %>
      <div class="lead-status-row__automation-list">
        <% automations.each do |automation| %><% automation_row.call(automation) %><% end %>
      </div>
      <p class="ax-field__hint" data-lead-status-automation-empty <%= "hidden" if automations.any? %>>Adicione uma regra para configurar quando e como agir nesta etapa.</p>
      <template class="lead-status-row__automation-template"><% automation_row.call(nil) %></template>
    <% end %>

    <%= ax_operational_panel(title: "Integrações") do %>
      <%= ax_standalone_select_field(name: nil, id: "#{field_prefix}-meta", label: "Evento Meta", selected: local_assigns[:meta_conversion_event],
            include_blank: "Evento Meta: nenhum", choices: LeadPipelineStage::META_CONVERSION_EVENTS.map { |value, label| ["#{label} (#{value})", value] },
            hint: "Enviado ao entrar nesta etapa, para leads do Meta Ads com conversões ativas.",
            data: { lead_status_field: "meta_conversion_event", controller: "ax-tooltip", ax_tooltip_text_value: "Evento enviado à Meta quando o lead entra nesta etapa (só leads do Meta Ads, com conversões ativas). Em branco, não envia." }) %>
      <p class="ax-field__hint">Os eventos informam à Meta o avanço do lead para medir conversões e apoiar a otimização dos anúncios. Eles não sincronizam as colunas da Central de Leads.</p>
      <%= ax_button("Entenda os eventos da Meta", documentation_admin_lead_statuses_path(anchor: "evento-meta"), variant: :ghost, size: :sm, icon: "box-arrow-up-right", target: "_blank", rel: "noopener noreferrer", aria: { label: "Entenda os eventos da Meta (abre em nova aba)" }) %>
    <% end %>

    <div class="lead-status-row__editor-actions">
      <div class="tw-flex tw-gap-2">
        <%= ax_button("Subir etapa", size: :sm, icon: "arrow-up", data: { action: "lead-status-board#moveStage", direction: "-1" }) %>
        <%= ax_button("Descer etapa", size: :sm, icon: "arrow-down", data: { action: "lead-status-board#moveStage", direction: "1" }) %>
      </div>
      <%= ax_button(tag.span("Remover etapa", data: { lead_status_remove_label: true }), variant: :ghost, size: :sm, icon: "trash", class_name: "lead-status-row__remove", data: { action: "lead-status-board#removeRow" }) %>
    </div>
    <% if stage_id.present? %>
      <div data-lead-status-destroy-panel hidden>
        <%= ax_operational_panel(title: "Remover etapa") do %>
          <%= ax_standalone_select_field(name: nil, id: "#{field_prefix}-replacement", label: "Enviar leads para", include_blank: "Escolha uma etapa", selected: nil, disabled: true,
                choices: replacement_stage_options.map { |stage| [stage.name, stage.id] },
                hint: "Os leads atuais serão movidos para a etapa escolhida ao salvar. O histórico será preservado.",
                data: { lead_status_destroy_field: "replacement_stage_id", lead_status_stage_options: "plain" }) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
