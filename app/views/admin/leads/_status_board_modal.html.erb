<%
  selected_pipeline = @selected_pipeline || LeadPipeline.ensure_default!(tenant: current_tenant)
  selected_pipeline_stages = selected_pipeline.stages.ordered.to_a
  automation_stage_options = current_tenant.lead_pipeline_stages.includes(:lead_pipeline).ordered.to_a
  archive_reason_options = current_tenant.attribute_options.for_context("lead").for_category("archive_reason").ordered.to_a
  distribution_rule_options = current_tenant.distribution_rules.active.includes(:distribution_rule_agents).order(:name).to_a

  modal_body = capture do %>
    <%= ax_inline_notice(tone: :neutral, icon: "info-circle") do %>
      <div class="tw-flex tw-flex-wrap tw-items-center tw-justify-between tw-gap-2">
        <span>Cada funil tem suas próprias etapas. Renomear ou remover uma etapa ajusta automaticamente os leads deste funil.</span>
        <span class="tw-flex tw-flex-wrap tw-gap-2">
          <%= ax_button("Auditoria",
                        automation_executions_admin_lead_statuses_path,
                        variant: :ghost,
                        size: :sm,
                        icon: "clock-history") %>
          <%= ax_button("Guia do funil e etapas",
                        documentation_admin_lead_statuses_path,
                        variant: :ghost,
                        size: :sm,
                        icon: "box-arrow-up-right",
                        target: "_blank",
                        rel: "noopener") %>
        </span>
      </div>
    <% end %>

    <%= render "admin/leads/operational_pipeline_preset_diagram" %>

    <div class="tw-grid tw-gap-3">
      <%= form_with model: [:admin, selected_pipeline], url: admin_lead_pipeline_path(selected_pipeline), method: :patch, local: true, class: "tw-grid tw-gap-2" do |f| %>
        <%= hidden_field_tag :view, @view_mode %>
        <%= ax_field_grid do %>
          <div class="ax-span-6">
            <%= ax_text_field(form: f, method: :name, label: "Nome do funil",
                              tooltip: "Nome usado para identificar este grupo de etapas na tela de Leads.",
                              value: selected_pipeline.name) %>
          </div>
          <div class="ax-span-6">
            <%= ax_select_field(form: f, method: :kind, label: "Tipo de funil",
                                tooltip: "Define a operação do funil e qual fluxo será usado automaticamente para novos leads.",
                                choices: LeadPipeline::KINDS.map { |value, label| [label, value] },
                                select_options: { selected: selected_pipeline.kind }) %>
          </div>
        <% end %>
        <div class="tw-flex tw-justify-end">
          <%= f.submit "Atualizar funil", class: "ax-btn ax-btn--sm" %>
        </div>
      <% end %>

    </div>

    <%= render "admin/leads/pipeline_stage_grid_header" %>

    <div class="lead-status-board lead-stage-grid" data-lead-status-board-target="list">
      <% selected_pipeline_stages.each do |stage| %>
        <%= render "admin/leads/status_board_row",
                   id: stage.id,
                   name: stage.name,
                   description: stage.description,
                   stage_type: stage.stage_type,
                   color: stage.display_color,
                   position: stage.position,
                   active: stage.active?,
                   policy: stage.policy_or_default,
                   transitions: stage.transitions.ordered,
                   automations: stage.automations.ordered,
                   stage_options: automation_stage_options,
                   archive_reason_options: archive_reason_options,
                   distribution_rule_options: distribution_rule_options %>
      <% end %>
    </div>

    <button type="button" class="ax-btn ax-btn--sm lead-status-board__add" data-action="lead-status-board#addRow">
      <i class="bi bi-plus-lg"></i> Adicionar etapa
    </button>

    <div class="ax-quick-modal__error" data-lead-status-board-target="error" hidden></div>

    <template data-lead-status-board-target="template">
      <%= render "admin/leads/status_board_row",
                 id: nil,
                 name: "",
                 description: "",
                 stage_type: "open",
                 color: LeadPipelineStage::DEFAULT_COLORS.first,
                 position: selected_pipeline_stages.size,
                 active: true,
                 policy: nil,
                 transitions: [],
                 automations: [],
                 stage_options: automation_stage_options,
                 archive_reason_options: archive_reason_options,
                 distribution_rule_options: distribution_rule_options %>
    </template>
  <% end

  modal_footer = capture do %>
    <button type="button" class="ax-btn" data-action="ax-modal#close">Cancelar</button>
    <button type="button"
            class="ax-btn ax-btn--primary"
            data-action="lead-status-board#save"
            data-lead-status-board-target="submit">
      Salvar
    </button>
  <% end
%>

<%# O controller fica na raiz do modal (mesclado com ax-modal pelo helper), para
    que o botão Salvar do footer também esteja no escopo do Stimulus. %>
<%= ax_quick_modal(
      id: "leadStatusBoardModal",
      title: "Editar funil e etapas",
      size: :xl,
      class_name: "ax-quick-modal--fullscreen lead-status-board-modal",
      body: modal_body,
      footer: modal_footer,
      data: {
        controller: "lead-status-board",
        lead_status_board_url_value: bulk_update_admin_lead_statuses_path,
        lead_status_board_pipeline_id_value: selected_pipeline.id
      }
    ) %>
