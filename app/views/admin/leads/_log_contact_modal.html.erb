<%# locals: lead, modal_id (optional), trigger_label (optional), trigger_class (optional), trigger_icon (optional), trigger_title (optional) %>
<% modal_id = local_assigns[:modal_id].presence || "leadLogContactModal" %>
<% form_id = "#{modal_id}Form" %>
<% trigger_label = local_assigns.key?(:trigger_label) ? local_assigns[:trigger_label] : "Registrar contato" %>
<% trigger_class = local_assigns.fetch(:trigger_class, "ax-btn ax-btn--sm") %>
<% trigger_icon = local_assigns.fetch(:trigger_icon, "pencil-square") %>
<% trigger_title = local_assigns[:trigger_title].presence || "Registrar contato" %>

<% lead_log_contact_body = capture do %>
  <%= form_with url: log_contact_admin_lead_path(lead), method: :post, id: form_id, local: true, data: { turbo: false, controller: "lead-contact-form" } do %>
    <div class="tw-grid tw-gap-3">
      <div>
        <%= ax_field_label(nil, nil, text: "Tipo de contato") %>
        <%= select_tag "contact_kind",
              options_for_select([
                ["Ligação", "ligacao"],
                ["WhatsApp", "whatsapp"],
                ["E-mail", "email"],
                ["Visita", "visita"],
                ["Nota interna", "nota"]
              ], "ligacao"),
              class: "ax-select",
              data: { lead_contact_form_target: "kind", action: "lead-contact-form#sync" } %>
      </div>
      <div data-lead-contact-form-target="resultField">
        <%= ax_field_label(nil, nil, text: "Resultado") %>
        <%= select_tag "contact_result",
              options_for_select([
                ["Não respondeu", "nao_respondeu"],
                ["Falou com cliente", "falou_com_cliente"],
                ["Retornar depois", "retornar_depois"],
                ["Sem interesse", "sem_interesse"]
              ]),
              include_blank: "Selecione o resultado...",
              class: "ax-select",
              required: true,
              data: { lead_contact_form_target: "result" } %>
      </div>
      <div>
        <%= ax_field_label(nil, nil, text: "O que aconteceu?") %>
        <%= text_area_tag "body", nil, class: "ax-textarea", rows: 3, required: true,
              placeholder: "Resumo da conversa, próximos passos..." %>
      </div>
    </div>
  <% end %>
<% end %>

<% lead_log_contact_footer = capture do %>
  <button type="button" class="ax-btn ax-btn--sm" data-action="ax-modal#close">Cancelar</button>
  <button type="submit" class="ax-btn ax-btn--sm ax-btn--primary" form="<%= form_id %>">Registrar</button>
<% end %>

<button type="button"
        class="<%= trigger_class %>"
        data-ax-modal-open="#<%= modal_id %>"
        title="<%= trigger_title %>"
        aria-label="<%= trigger_title %>">
  <i class="bi bi-<%= trigger_icon %> ax-ico" aria-hidden="true"></i>
  <% if trigger_label.present? %><span><%= trigger_label %></span><% end %>
</button>

<%= ax_quick_modal(
      id: modal_id,
      title: "Registrar contato",
      body: lead_log_contact_body,
      footer: lead_log_contact_footer
    ) %>
