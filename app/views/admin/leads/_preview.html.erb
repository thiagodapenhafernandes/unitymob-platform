<%# locals: lead, status_tone %>
<%= turbo_frame_tag "lead_preview_frame" do %>
  <%
    status_value = lead.status.presence || Lead.default_status
    tone = status_tone.call(lead.status)
    conversion = lead_conversion_summary(lead)
    preview_property = @preview_property
  %>
  <div class="lead-preview">
    <div class="lead-preview__head">
      <h4 class="ax-board__card-title"><%= lead.name %></h4>
      <span class="ax-badge ax-badge--<%= tone %>"><%= status_value %></span>
    </div>

    <div class="ax-board__card-lines">
      <% if lead.phone.present? %>
        <div class="ax-board__card-line">
          <i class="bi bi-telephone"></i>
          <span><%= link_to format_phone(lead.phone), "tel:#{lead.phone.to_s.gsub(/\D/, '')}", class: "ax-board__card-link" %></span>
        </div>
      <% end %>
      <% if lead.email.present? %>
        <div class="ax-board__card-line">
          <i class="bi bi-envelope"></i>
          <span><%= link_to lead.email, "mailto:#{lead.email}", class: "ax-board__card-link" %></span>
        </div>
      <% end %>
      <div class="ax-board__card-line ax-board__card-line--origin"><i class="bi <%= conversion[:icon] %>"></i><span><%= lead_tracking_origin_text(conversion) %></span></div>
      <div class="ax-board__card-line"><i class="bi bi-person-badge"></i><span><%= lead.admin_user&.name.present? ? "Corretor: #{lead.admin_user.name}" : "Sem corretor atribuído" %></span></div>
    </div>

    <% if preview_property.present? %>
      <div class="ax-board__card-section ax-board__card-section--property">
        <%= link_to preview_property.display_title, admin_habitation_path(preview_property.id), class: "ax-board__card-link" %>
        <div class="ax-board__card-subtle"><%= preview_property.codigo %></div>
      </div>
    <% elsif lead.property_id.present? %>
      <div class="ax-board__card-section ax-board__card-section--property ax-board__card-section--muted">Imóvel indisponível</div>
    <% else %>
      <div class="ax-board__card-section ax-board__card-section--property ax-board__card-section--muted">Contato geral</div>
    <% end %>

    <div class="lead-preview__activities">
      <h5 class="lead-preview__subtitle">Últimas atividades</h5>
      <% if @preview_activities.any? %>
        <ul class="lead-preview__activity-list">
          <% @preview_activities.each do |activity| %>
            <% activity_meta = activity.metadata.to_h %>
            <li>
              <strong><%= LeadActivity::CONTACT_KIND_LABELS[activity_meta["contact_kind"].presence || activity.kind] || activity.kind.to_s.humanize %></strong>
              <% if activity_meta["contact_result"].present? %>
                <span>· <%= LeadActivity::CONTACT_RESULT_LABELS[activity_meta["contact_result"]] || activity_meta["contact_result"] %></span>
              <% end %>
              <% if activity_meta["body"].present? %>
                <span class="lead-preview__activity-body">— <%= truncate(activity_meta["body"].to_s, length: 120) %></span>
              <% end %>
              <small><%= activity_meta["by"].presence || "Sistema" %> · <%= l(activity.created_at, format: "%d/%m %H:%M") %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="ax-board__card-section--muted">Nenhuma atividade registrada.</p>
      <% end %>
    </div>

    <div class="lead-preview__actions">
      <%= ax_button "Abrir lead", @preview_open_path, variant: :primary %>
    </div>
  </div>
<% end %>
