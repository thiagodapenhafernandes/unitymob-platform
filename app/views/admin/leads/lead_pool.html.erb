<% content_for :admin_contextbar_breadcrumb do %>
  <%= link_to "Leads", @return_to_path %>
  <i class="bi bi-chevron-right" aria-hidden="true"></i>
  <strong>Bolsão</strong>
<% end %>

<% content_for :admin_contextbar_actions do %>
  <%= link_to @return_to_path, class: "ax-btn ax-btn--sm" do %>
    <i class="bi bi-arrow-left ax-ico" aria-hidden="true"></i><span>Voltar</span>
  <% end %>
<% end %>

<style>
  .lead-pool-page {
    --pool-bg: var(--admin-workspace-bg, #eef3f9);
    --pool-surface: var(--admin-surface, #fff);
    --pool-ink: var(--admin-ink, #202a37);
    --pool-muted: var(--ab-muted, #64748b);
    --pool-line: var(--ab-line, #d8dee8);
    --pool-primary: var(--admin-primary, #365f8f);
    display: grid;
    gap: 12px;
    overflow-anchor: none;
  }

  .lead-pool-mobile-top {
    display: none;
  }

  .lead-pool-command,
  .lead-pool-empty,
  .lead-pool-list {
    border: 1px solid var(--pool-line);
    border-radius: 10px;
    background: var(--pool-surface);
    box-shadow: 0 1px 2px rgba(15, 23, 42, .05);
  }

  .lead-pool-command {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
  }

  .lead-pool-command__copy {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .lead-pool-command__copy span {
    color: var(--pool-muted);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .lead-pool-command__copy h1 {
    margin: 0;
    color: var(--pool-ink);
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .lead-pool-command__copy p {
    margin: 0;
    color: var(--pool-muted);
    font-size: 13px;
    font-weight: 750;
  }

  .lead-pool-command__count {
    display: inline-grid;
    place-items: center;
    min-width: 72px;
    min-height: 50px;
    padding: 5px 10px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--pool-primary) 10%, #fff);
    color: var(--pool-primary);
    text-align: center;
  }

  .lead-pool-command__count strong {
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
  }

  .lead-pool-command__count span {
    margin-top: 3px;
    color: var(--pool-muted);
    font-size: 10px;
    font-weight: 850;
  }

  .lead-pool-list {
    display: grid;
    overflow: hidden;
  }

  .lead-pool-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid var(--pool-line);
  }

  .lead-pool-item:last-child {
    border-bottom: 0;
  }

  .lead-pool-item.is-focused {
    background: color-mix(in srgb, var(--pool-primary) 8%, #fff);
    box-shadow: inset 3px 0 0 var(--pool-primary);
  }

  .lead-pool-item__copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .lead-pool-item__title {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    min-width: 0;
  }

  .lead-pool-item__title strong {
    color: var(--pool-ink);
    font-size: 15px;
    font-weight: 900;
    line-height: 1.2;
  }

  .lead-pool-badge {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    background: #ecfdf3;
    color: #027a48;
    font-size: 11px;
    font-weight: 850;
    white-space: nowrap;
  }

  .lead-pool-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    color: var(--pool-muted);
    font-size: 12px;
    font-weight: 750;
  }

  .lead-pool-item__meta span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .lead-pool-empty {
    padding: 28px 18px;
    text-align: center;
  }

  .lead-pool-empty strong {
    display: block;
    color: var(--pool-ink);
    font-size: 16px;
    font-weight: 900;
  }

  .lead-pool-empty p {
    margin: 6px auto 0;
    max-width: 460px;
    color: var(--pool-muted);
    font-size: 13px;
    font-weight: 750;
  }

  @media (max-width: 767.98px) {
    body.ax-app .ax-navbar,
    body.ax-app .ax-sidebar-contextbar,
    body.ax-app .ax-contextbar {
      display: none !important;
    }

    body.ax-pwa-bottom-nav-body > .ax-main {
      min-height: 100dvh !important;
      margin: 0 !important;
      padding: 0 !important;
      background: var(--pool-bg) !important;
    }

    .lead-pool-page {
      min-height: 100dvh;
      padding: calc(72px + env(safe-area-inset-top, 0px)) 10px calc(78px + env(safe-area-inset-bottom, 0px));
      background: var(--pool-bg);
    }

    .lead-pool-mobile-top {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      gap: 8px;
      align-items: center;
      min-height: calc(60px + env(safe-area-inset-top, 0px));
      padding: max(8px, env(safe-area-inset-top, 0px)) 10px 8px;
      border-bottom: 1px solid var(--pool-line);
      background: color-mix(in srgb, var(--pool-bg) 90%, #fff);
      box-shadow: 0 1px 3px rgba(15, 23, 42, .08);
      backdrop-filter: blur(14px);
    }

    .lead-pool-mobile-top__button,
    .lead-pool-mobile-top__count {
      display: inline-grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--pool-line);
      border-radius: 12px;
      background: var(--pool-surface);
      color: var(--pool-ink);
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(15, 23, 42, .05);
    }

    .lead-pool-mobile-top__button {
      font-size: 20px;
    }

    .lead-pool-mobile-top__count {
      color: var(--pool-primary);
      font-size: 13px;
      font-weight: 950;
    }

    .lead-pool-mobile-top__title {
      min-width: 0;
      text-align: center;
    }

    .lead-pool-mobile-top__title strong {
      display: block;
      overflow: hidden;
      color: var(--pool-ink);
      font-size: 17px;
      font-weight: 950;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pool-mobile-top__title span {
      display: block;
      margin-top: 2px;
      overflow: hidden;
      color: var(--pool-muted);
      font-size: 12px;
      font-weight: 800;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pool-command,
    .lead-pool-empty,
    .lead-pool-list {
      border-radius: 14px;
    }

    .lead-pool-command {
      padding: 12px;
    }

    .lead-pool-command__copy h1 {
      font-size: 20px;
    }

    .lead-pool-item {
      grid-template-columns: 1fr;
      padding: 13px;
    }

    .lead-pool-item .ax-btn {
      justify-self: stretch;
    }
  }
</style>

<div class="lead-pool-page">
  <header class="lead-pool-mobile-top" aria-label="Navegação do bolsão">
    <%= link_to @return_to_path, class: "lead-pool-mobile-top__button", aria: { label: "Voltar para leads" } do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>
    <div class="lead-pool-mobile-top__title">
      <strong>Bolsão</strong>
      <span><%= @pool_leads.size %> lead<%= "s" if @pool_leads.size != 1 %> <%= @pool_leads.size == 1 ? "disponível" : "disponíveis" %></span>
    </div>
    <span class="lead-pool-mobile-top__count" aria-label="Leads disponíveis no bolsão">
      <%= @pool_leads.size %>
    </span>
  </header>

  <header class="lead-pool-command">
    <div class="lead-pool-command__copy">
      <span>Distribuição de leads</span>
      <h1>Bolsão</h1>
      <p>Leads que não foram atendidos no prazo e estão disponíveis para atendimento.</p>
    </div>

    <div class="lead-pool-command__count" aria-label="Leads disponíveis no bolsão">
      <strong><%= @pool_leads.size %></strong>
      <span>lead<%= "s" if @pool_leads.size != 1 %></span>
    </div>
  </header>

  <% if @pool_leads.any? %>
    <section class="lead-pool-list" aria-label="Leads disponíveis no bolsão">
      <% @pool_leads.each do |lead| %>
        <%
          pool_activity = @latest_pool_activity_by_lead_id[lead.id]
          expired_activity = @latest_pocket_expired_activity_by_lead_id[lead.id]
          previous_broker = expired_activity&.meta("previous_admin_user_name").presence || pool_activity&.meta("previous_admin_user_name").presence
          available_at = pool_activity&.created_at || lead.created_at
          source_label = [lead.origin.presence, lead.product.presence].compact.join(" · ").presence
        %>
        <article class="lead-pool-item <%= 'is-focused' if lead.id == @focused_pool_lead_id %>" id="lead-<%= lead.id %>">
          <div class="lead-pool-item__copy">
            <div class="lead-pool-item__title">
              <strong><%= lead.display_name %></strong>
              <span class="lead-pool-badge">Disponível</span>
            </div>
            <div class="lead-pool-item__meta">
              <span><%= source_label || "Lead sem origem detalhada" %></span>
              <span>Regra: <%= lead.distribution_rule&.name.presence || "sem regra" %></span>
              <span>No bolsão há <%= time_ago_in_words(available_at) %></span>
              <% if previous_broker.present? %>
                <span>Corretor anterior: <%= previous_broker %></span>
              <% end %>
            </div>
          </div>

          <%= link_to attend_admin_lead_path(lead), class: "ax-btn ax-btn--primary ax-btn--sm", data: { turbo: false } do %>
            <i class="bi bi-hand-index-thumb ax-ico" aria-hidden="true"></i><span>Atender</span>
          <% end %>
        </article>
      <% end %>
    </section>
  <% else %>
    <div class="lead-pool-empty">
      <strong>Nenhum lead disponível no bolsão.</strong>
      <p>Quando um corretor não atender dentro do prazo, o lead aparecerá aqui.</p>
    </div>
  <% end %>
</div>

<script>
  (() => {
    const resetPoolScroll = () => {
      if (!document.querySelector(".lead-pool-page")) return;

      if ("scrollRestoration" in window.history) {
        window.history.scrollRestoration = "manual";
      }

      const scrollTop = () => {
        window.scrollTo({ top: 0, left: 0, behavior: "auto" });
        document.scrollingElement?.scrollTo?.({ top: 0, left: 0, behavior: "auto" });
        document.querySelector(".ax-main")?.scrollTo?.({ top: 0, left: 0, behavior: "auto" });
      };

      scrollTop();
      window.requestAnimationFrame(scrollTop);
      window.setTimeout(scrollTop, 120);
    };

    resetPoolScroll();
    window.addEventListener("pageshow", resetPoolScroll, { once: true });
    document.addEventListener("turbo:load", resetPoolScroll, { once: true });
  })();
</script>
