%>

<section class="lead-pwa-detail" aria-label="Detalhe do lead no PWA">
  <div class="lead-pwa-detail__top">
    <%= link_to @return_to_path.presence || admin_leads_path(view: "list", mobile_tab: "todo"), class: "lead-pwa-detail__icon-btn", aria: { label: "Voltar" } do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>
    <div class="lead-pwa-detail__title">
      <strong>Lead</strong>
      <span><%= @lead.admin_user&.name.presence || "Sem corretor" %></span>
    </div>
    <div class="lead-pwa-detail__top-actions">
      <% if can_transfer_lead?(@lead) %>
        <%= render "admin/leads/transfer_modal", lead: @lead, broker_options: transfer_broker_options(@lead) %>
      <% end %>
      <%= button_to toggle_favorite_admin_lead_path(@lead),
                    method: :patch,
                    form_class: "lead-pwa-detail__favorite-form",
                    class: "lead-pwa-detail__favorite #{'is-active' if @lead_favorited}",
                    title: (@lead_favorited ? "Remover dos favoritos" : "Adicionar aos favoritos"),
                    aria: { label: (@lead_favorited ? "Remover dos favoritos" : "Adicionar aos favoritos") } do %>
        <i class="bi bi-<%= @lead_favorited ? 'star-fill' : 'star' %>"></i>
      <% end %>
    </div>
  </div>

  <article class="lead-pwa-detail__hero">
    <div class="lead-pwa-detail__hero-head">
      <h3 class="lead-pwa-detail__name"><%= @lead.display_name %></h3>
      <span class="lead-pwa-detail__badge">
        <% if @lead_favorited %><i class="bi bi-star-fill" aria-hidden="true"></i><% end %>
        <%= @lead.status.presence || Lead.default_status %>
      </span>
    </div>
    <div class="lead-pwa-detail__meta">
      <% if @lead.display_phone.present? %>
        <span><i class="bi bi-telephone"></i><b><%= @lead.display_phone %></b></span>
      <% end %>
      <% if @lead.display_email.present? %>
        <span><i class="bi bi-envelope"></i><b><%= @lead.display_email %></b></span>
      <% end %>
      <span><i class="bi bi-megaphone"></i><b><%= @lead.origin.presence || detail_conversion[:channel_label] %></b></span>
      <span><i class="bi bi-clock"></i><b>Entrada em <%= l(@lead.created_at, format: "%d/%m/%Y %H:%M") %></b></span>
    </div>
    <div class="lead-pwa-detail__actions">
      <% if detail_whatsapp_url.present? %>
        <%= link_to detail_whatsapp_url, target: "_blank", rel: "noopener", class: "lead-pwa-detail__action lead-pwa-detail__action--whatsapp" do %>
          <i class="bi bi-whatsapp"></i><span>WhatsApp</span>
        <% end %>
      <% elsif can?(:view, :whatsapp_inbox) && @lead.whatsapp_recipient.present? %>
        <%= link_to admin_lead_path(@lead, anchor: "whatsapp"), class: "lead-pwa-detail__action lead-pwa-detail__action--whatsapp" do %>
          <i class="bi bi-whatsapp"></i><span>WhatsApp</span>
        <% end %>
      <% end %>
      <% if detail_phone.present? %>
        <%= link_to "tel:#{detail_phone}", class: "lead-pwa-detail__action" do %>
          <i class="bi bi-telephone"></i><span>Ligar</span>
        <% end %>
      <% end %>
    </div>
  </article>

  <section class="lead-pwa-detail__panel">
    <div class="lead-pwa-detail__section-title">
      <span>Funil</span>
      <small><%= sla[:label] %></small>
    </div>
    <div class="lead-pwa-detail__funnel">
      <% funnel_progress(@lead, @funnel_statuses).each do |step| %>
        <%= button_to admin_lead_path(@lead, lead: { status: step[:status] }),
              method: :patch,
              form_class: "tw-inline-flex",
              class: "lead-pwa-detail__step #{'lead-pwa-detail__step--current' if step[:state] == :current}" do %>
          <i class="bi <%= step[:state] == :done ? 'bi-check-circle-fill' : (step[:state] == :current ? 'bi-record-circle-fill' : 'bi-circle') %>"></i>
          <%= step[:status] %>
        <% end %>
      <% end %>
    </div>
  </section>

  <%= render "admin/leads/pwa_operational_panel", lead: @lead %>

  <section class="lead-pwa-detail__panel lead-pwa-origin-panel">
    <div class="lead-pwa-detail__section-title">
      <span>Imóvel de origem</span>
      <small><%= @property ? @property.codigo : "geral" %></small>
    </div>
    <% if @property %>
      <div class="lead-pwa-detail__record">
        <strong><%= @property.display_title %></strong>
        <span><%= [@property.bairro, @property.cidade].compact_blank.join(", ") %></span>
      </div>
    <% elsif @lead.property_id.present? %>
      <div class="lead-pwa-origin-state">
        <i class="bi bi-house-slash"></i>
        <span>
          <strong>Imóvel indisponível</strong>
          <span>Referência fora do catálogo atual.</span>
        </span>
      </div>
    <% else %>
      <div class="lead-pwa-origin-state">
        <i class="bi bi-house-add"></i>
        <span>
          <strong>Lead sem imóvel específico.</strong>
          <span>Use os interesses abaixo para montar a seleção.</span>
        </span>
      </div>
    <% end %>

    <div class="lead-pwa-detail__subsection lead-pwa-mobile-interests">
      <div class="lead-pwa-detail__section-title">
        <span>Imóveis de interesse</span>
        <small><%= @lead.property_interests.size %></small>
      </div>
      <%= render "admin/whatsapp_inbox/thread_property_interests",
            lead: @lead,
            show_empty: false,
            share_url: share_properties_admin_lead_path(@lead),
            suggest_url: suggest_properties_admin_lead_path(@lead),
            internal_send_enabled: @whatsapp_conversation.present? && can?(:manage, :whatsapp_inbox),
            shared_property_ids: @shared_interest_property_ids,
            shared_property_statuses: @shared_interest_property_statuses,
            share_expires_in_days: PropertySetting.instance(tenant: current_tenant).ai_property_search_share_expiration_days %>
    </div>

    <% if @property_share_collections.present? %>
      <div class="lead-pwa-detail__subsection lead-pwa-share-history">
        <div class="lead-pwa-detail__section-title">
          <span>Links gerados</span>
          <small><%= @property_share_collections.size %></small>
        </div>
        <% @property_share_collections.each do |collection| %>
          <%= link_to ai_property_share_collection_path(collection.token),
                target: "_blank",
                rel: "noopener",
                class: "lead-pwa-share-history__item" do %>
            <span>
              <strong><%= pluralize(collection.habitations.size, "imóvel", "imóveis") %></strong>
              <span><%= l(collection.created_at, format: :short) %> por <%= collection.admin_user&.name || "corretor removido" %></span>
            </span>
            <i class="bi bi-box-arrow-up-right"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="lead-pwa-detail__panel lead-pwa-interest-intelligence">
    <div class="lead-pwa-detail__section-title">
      <span>Inteligência de Interesse</span>
      <small>lazy</small>
    </div>
    <% if detail_interest_intelligence_locals %>
      <%= render "admin/leads/interest_intelligence", **detail_interest_intelligence_locals %>
    <% else %>
      <%= turbo_frame_tag dom_id(@lead, :pwa_interest_intelligence),
            src: interest_intelligence_admin_lead_path(@lead),
            loading: "lazy" do %>
        <div class="lead-interest-empty">
          <i class="bi bi-stars"></i>
          <div>
            <strong>Carregando sinais</strong>
            <p>A inteligência será calculada sem travar a abertura do lead.</p>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="lead-pwa-detail__panel lead-pwa-detail__notes-panel">
    <div class="lead-pwa-detail__section-title lead-pwa-detail__notes-head">
      <span class="lead-pwa-detail__notes-title">
        <i class="bi bi-journal-text"></i>
        <span>Histórico de contatos</span>
      </span>
      <span class="lead-pwa-detail__notes-count"><%= @contact_history_activities.size %></span>
    </div>
    <%= render "admin/leads/log_contact_modal",
          lead: @lead,
          modal_id: "leadLogContactHistoryPwa#{@lead.id}",
          trigger_label: "Registrar contato",
          trigger_class: "lead-pwa-detail__note-toggle",
          trigger_icon: "plus-lg",
          trigger_title: "Registrar contato" %>

    <% if @contact_history_activities.any? %>
      <div class="lead-pwa-detail__notes-timeline">
        <% @contact_history_activities.each_with_index do |note, index| %>
          <% body = note.meta("body").to_s.strip.presence %>
          <div class="lead-pwa-detail__note-item">
            <div class="lead-pwa-detail__note-line">
              <span class="lead-pwa-detail__note-dot"><i class="bi bi-pencil-square"></i></span>
              <% unless index == @contact_history_activities.size - 1 %><span class="lead-pwa-detail__note-rail"></span><% end %>
            </div>
            <article class="lead-pwa-detail__note-card">
              <div class="lead-pwa-detail__note-meta">
                <span><i class="bi bi-clock"></i><%= l(note.created_at, format: "%d/%m/%Y %H:%M") %></span>
                <span><%= lead_contact_kind_label(note) %></span>
              </div>
              <div class="lead-pwa-detail__note-body">
                <%= simple_format(body || "Contato sem descrição registrada.") %>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="lead-pwa-detail__empty lead-pwa-detail__notes-empty">Nenhum contato registrado.</p>
    <% end %>
  </section>

  <% if current_admin_user&.admin? %>
    <section class="lead-pwa-detail__panel">
      <div class="lead-pwa-detail__section-title">
        <span>Parecer</span>
        <small>admin</small>
      </div>
      <%= form_with model: @lead, url: admin_lead_path(@lead), method: :patch, local: true, class: "lead-pwa-detail__parecer-form" do |f| %>
        <%= f.text_area :parecer, rows: 3, class: "ax-control", placeholder: "Parecer interno — visível só para administradores." %>
        <button type="submit" class="ax-btn ax-btn--sm ax-btn--primary lead-pwa-detail__parecer-save">Salvar parecer</button>
      <% end %>
    </section>
  <% end %>

</section>

<% @lead_heading_actions = capture do %>
    <%= link_to @return_to_path.presence || admin_leads_path, class: "ax-btn ax-btn--sm" do %>
      <i class="bi bi-arrow-left ax-ico"></i><span>Voltar</span>
    <% end %>
    <% if can_transfer_lead?(@lead) %>
      <%= render "admin/leads/transfer_modal",
                 lead: @lead,
                 broker_options: transfer_broker_options(@lead),
                 trigger_class: "ax-btn ax-btn--sm",
                 trigger_label: "Transferir" %>
    <% end %>
    <%= button_to toggle_favorite_admin_lead_path(@lead),
                  method: :patch,
                  form_class: "tw-inline-block tw-m-0",
                  class: "ax-btn ax-btn--sm #{'ax-btn--primary' if @lead_favorited}",
                  title: (@lead_favorited ? "Remover dos favoritos" : "Adicionar aos favoritos"),
                  aria: { label: (@lead_favorited ? "Remover dos favoritos" : "Adicionar aos favoritos") } do %>
      <i class="bi bi-<%= @lead_favorited ? 'star-fill' : 'star' %> ax-ico"></i>
      <span><%= @lead_favorited ? "Favorito" : "Favoritar" %></span>
    <% end %>
    <button type="button" class="ax-btn ax-btn--sm" data-ax-modal-open="#leadAuditHistoryModal">
      <i class="bi bi-clock-history ax-ico"></i><span>Histórico</span>
    </button>
  <% end %>

<%
  lead_heading_subtitle = [
    @lead.display_email.presence,
    @lead.display_phone.presence,
    @lead.admin_user&.name.presence
  ].compact.join(" · ")
%>

<%= ax_workspace_heading(
      title: @lead.display_name,
      eyebrow: "Contato",
      icon: "person",
      subtitle: lead_heading_subtitle,
      pills: [sla[:label], @lead.status.presence || Lead.default_status],
      actions: @lead_heading_actions
    ) %>

<%= render "admin/leads/origin_line", lead: @lead %>

<%# ===== Barra de funil (bate o olho e entende a etapa) ===== %>
<div class="ax-card tw-mb-3">
  <div class="ax-card__body">
    <div class="tw-flex tw-items-center tw-gap-1 tw-overflow-x-auto tw-pb-1 tw-whitespace-nowrap">
      <% funnel_progress(@lead, @funnel_statuses).each_with_index do |step, i| %>
        <% if i > 0 %>
          <span class="lead-funnel-step-separator lead-funnel-step-separator--<%= step[:state] %>"></span>
        <% end %>
        <%= button_to admin_lead_path(@lead, lead: { status: step[:status] }), method: :patch,
              form_class: "tw-inline-flex", class: "lead-funnel-step lead-funnel-step--#{step[:state]}" do %>
          <i class="bi <%= step[:state] == :done ? 'bi-check-circle-fill' : (step[:state] == :current ? 'bi-record-circle-fill' : 'bi-circle') %>"></i>
          <%= step[:status] %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<%
  # Timeline: mensagens cruas de WhatsApp ficam fora do padrão (já vivem no
  # painel de conversa acima); aqui entram só os marcos.
  wa_timeline_kinds = %w[whatsapp_in whatsapp_out]
  timeline_milestones = @timeline.reject do |act|
    wa_timeline_kinds.include?(act.kind.to_s) ||
      # "Lead atribuído" (automação) é espelho do "Distribuído" — não duplicar
      (act.kind.to_s == "automation_event" && act.metadata.to_h["event"].to_s == "lead_assigned")
  end
  timeline_wa_events = @timeline.select { |act| wa_timeline_kinds.include?(act.kind.to_s) }
  timeline_visible = timeline_milestones.first(15)
  timeline_rest = timeline_milestones.drop(15)
%>

<div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-[minmax(0,1fr)_380px] tw-gap-4">
  <%# ===== Coluna esquerda ===== %>
  <div>
    <%# Imóvel de interesse: pin principal + vínculos de interesse (add/remover). %>
    <div class="ax-card tw-mb-4 lead-property-card">
      <div class="ax-card__header"><span class="ax-card__title"><i class="bi bi-house ax-ico"></i> Imóvel de interesse</span></div>
      <div class="ax-card__body">
        <% if @property %>
          <%
            property_facts = [
              ["cash-coin", "Preço", @property.preco_principal],
              ["rulers", "Área", @property.card_area_text],
              ["door-open", "Dorm.", @property.card_dormitorios_text],
              ["badge-wc", "Suítes", @property.card_suites_text],
              ["car-front", "Vagas", @property.card_vagas_text],
              ["hash", "Código", @property.codigo]
            ].select { |_icon, _label, value| value.present? }
          %>
          <div class="lead-property-summary">
            <% property_image_url = catalog_property_image_urls(@property, limit: 1).first %>
            <% if property_image_url.present? %>
              <div class="lead-property-summary__media">
                <%= image_tag property_image_url,
                      class: "lead-property-image",
                      alt: "Imagem principal do imóvel",
                      loading: "lazy" %>
              </div>
            <% end %>
            <div class="lead-property-summary__content">
              <div class="lead-property-summary__main">
                <div class="ax-strong"><%= @property.display_title %></div>
                <div class="ax-page-subtitle"><%= @property.bairro %>, <%= @property.cidade %></div>
                <div class="lead-property-summary__meta">
                  <% [@property.categoria, @property.status].compact_blank.each do |item| %>
                    <span><%= item %></span>
                  <% end %>
                </div>
                <% if property_facts.any? %>
                  <div class="lead-property-summary__facts">
                    <% property_facts.each do |icon, label, value| %>
                      <span>
                        <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
                        <small><%= label %></small>
                        <strong><%= value %></strong>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="lead-property-summary__actions">
                <%= link_to admin_habitation_path_with_query(admin_habitation_path(@property.id), admin_habitation_flat_return_params(request.fullpath)), class: "ax-btn ax-btn--sm" do %>
                  <i class="bi bi-pencil-square ax-ico" aria-hidden="true"></i><span>Gerenciar</span>
                <% end %>
                <%= link_to habitation_path(@property), target: "_blank", rel: "noopener", class: "ax-btn ax-btn--sm ax-btn--ghost" do %>
                  <i class="bi bi-box-arrow-up-right ax-ico" aria-hidden="true"></i><span>Ver no site</span>
                <% end %>
              </div>
            </div>
          </div>
        <% elsif @lead.property_id.present? %>
          <div class="lead-property-empty">
            <i class="bi bi-house-slash"></i>
            <div>
              <strong>Imóvel não disponível</strong>
              <p>Este lead possui referência de imóvel, mas o cadastro não está acessível no catálogo atual.</p>
            </div>
          </div>
        <% else %>
          <div class="lead-property-empty">
            <i class="bi bi-megaphone"></i>
            <div>
              <strong>Lead sem imóvel específico</strong>
              <p>Este contato veio de uma origem geral, campanha, webhook ou atendimento sem propriedade atrelada.</p>
            </div>
          </div>
        <% end %>

        <div class="lead-view-divider"></div>
        <div class="ax-stat-label tw-mb-2">Imóveis de interesse</div>
        <%= render "admin/whatsapp_inbox/thread_property_interests",
              lead: @lead,
              show_empty: false,
              share_url: share_properties_admin_lead_path(@lead),
              suggest_url: suggest_properties_admin_lead_path(@lead),
              internal_send_enabled: @whatsapp_conversation.present? && can?(:manage, :whatsapp_inbox),
              shared_property_ids: @shared_interest_property_ids,
              shared_property_statuses: @shared_interest_property_statuses,
              share_expires_in_days: PropertySetting.instance(tenant: current_tenant).ai_property_search_share_expiration_days %>
        <% if @property_share_collections.present? %>
          <div class="lead-property-share-history">
            <div class="ax-stat-label">Links gerados</div>
            <% @property_share_collections.each do |collection| %>
              <div class="lead-property-share-history__item">
                <div>
                  <strong><%= pluralize(collection.habitations.size, "imóvel", "imóveis") %></strong>
                  <span><%= l(collection.created_at, format: :short) %> por <%= collection.admin_user&.name || "corretor removido" %></span>
                </div>
                <%= link_to "Abrir", ai_property_share_collection_path(collection.token), target: "_blank", rel: "noopener" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @lead_whatsapp_panel_enabled && can?(:view, :whatsapp_inbox) %>
      <%= render "admin/shared/ui/lead_whatsapp_panel",
            lead: @lead,
            conversation: @whatsapp_conversation,
            templates: @whatsapp_templates,
            summary: @whatsapp_summary,
            thread_context_locals: @whatsapp_thread_context_locals,
            messages: @whatsapp_messages,
            return_to: request.fullpath,
            notice: @lead_whatsapp_notice,
            notice_detail: @lead_whatsapp_notice_detail %>
    <% end %>

    <% if can_destroy_lead? %>
      <% delete_form_id = "delete_lead_permanently_#{@lead.id}" %>
      <section class="ax-card tw-mb-3 lead-permanent-delete-card">
        <header class="ax-card__header">
          <h2 class="ax-card__title">
            <i class="bi bi-trash3 ax-ico"></i>
            Remover permanentemente
          </h2>
        </header>
        <div class="ax-card__body lead-permanent-delete-card__body">
          <p class="tw-m-0 tw-text-sm tw-font-semibold tw-text-slate-500">
            Ação restrita ao admin da conta. Remove este lead definitivamente.
          </p>
          <%= form_with url: admin_lead_path(@lead), method: :delete,
                        id: delete_form_id, class: "tw-hidden", data: { turbo: false } do %><% end %>
          <%= ax_confirm_submit(
                form_id: delete_form_id,
                message: "Remover permanentemente este lead? Esta ação não pode ser desfeita.",
                confirm_label: "Remover permanentemente",
                class_name: "lead-permanent-delete-card__confirm"
              ) do %>
            <button type="button" class="ax-btn ax-btn--sm ax-btn--danger" data-action="click->ax-confirm-submit#request">
              <i class="bi bi-trash3 ax-ico"></i><span>Remover lead</span>
            </button>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Linha do tempo aberta por padrão para manter o histórico visível no lead. %>
    <%= ax_collapsible_card(
          title: "Linha do tempo",
          icon: "activity",
          badge: "#{timeline_milestones.size} atividade#{'s' if timeline_milestones.size != 1}",
          collapsed: false,
          collapse_id: "leadTimelineSection",
          class_name: "lead-timeline-card"
        ) do %>
      <% if timeline_milestones.any? %>
        <%= render "admin/leads/timeline_entries", entries: timeline_visible %>

        <% if timeline_rest.any? %>
          <div data-controller="ax-disclosure" data-ax-disclosure-open-value="false">
            <div hidden data-ax-disclosure-target="content">
              <%= render "admin/leads/timeline_entries", entries: timeline_rest %>
            </div>
            <button type="button" class="ax-btn ax-btn--sm ax-btn--ghost"
                    data-action="ax-disclosure#toggle" data-ax-disclosure-target="trigger" aria-expanded="false">
              <i class="bi bi-chevron-expand ax-ico"></i><span>Ver mais (<%= timeline_rest.size %>)</span>
            </button>
          </div>
        <% end %>
      <% else %>
        <%= ax_empty_state(
              title: "Sem atividades ainda",
              description: "Registre um contato, crie uma tarefa ou envie uma proposta — tudo aparece aqui.",
              icon: "activity"
            ) %>
      <% end %>

      <% if timeline_wa_events.any? %>
        <div class="ax-disclosure-divider tw-mt-2" data-controller="ax-disclosure" data-ax-disclosure-open-value="false">
          <button type="button" class="ax-btn ax-btn--sm ax-btn--ghost"
                  data-action="ax-disclosure#toggle" data-ax-disclosure-target="trigger" aria-expanded="false">
            <i class="bi bi-whatsapp ax-ico"></i><span>Mostrar mensagens do WhatsApp (<%= timeline_wa_events.size %>)</span>
          </button>
          <div hidden data-ax-disclosure-target="content" class="tw-mt-3">
            <%= render "admin/leads/timeline_entries", entries: timeline_wa_events %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# ===== Coluna direita ===== %>
  <div>
    <%# ===== Blocos ax-card: próxima ação, corretor e inteligência ===== %>
    <%
      interest_enabled = @interest_settings&.enabled?
      interest_badge = if !interest_enabled
        "Desativada"
      else
        "Carregando"
      end
    %>
    <%# ===== Bloco: Operação do lead ===== %>
    <div class="ax-card lead-next-action-card tw-mb-4">
      <div class="ax-card__header">
        <span class="ax-card__title"><i class="bi bi-flag-fill ax-ico"></i> Ações do lead</span>
      </div>
      <div class="ax-card__body">
        <div class="lead-action-hub">
          <%= render "admin/leads/action_hub",
                namespace: "Desktop#{@lead.id}",
                anchor_prefix: "lead-desktop",
                lead: @lead,
                open_tasks: open_tasks,
                appointments: @appointments,
                proposals: @proposals,
                labels_count: @lead.labels_for(current_admin_user).size,
                next_task: @next_task,
                new_proposal: @new_proposal,
                proposal_habitations: @proposal_habitations,
                archive_reason_options: @archive_reason_options,
                show_tasks: false,
                close_deal_form_id: "lead_close_deal_desktop_#{@lead.id}" %>
        </div>

        <div class="lead-view-divider"></div>

        <section id="lead-desktop-agenda" class="lead-operational-section lead-operational-section--agenda">
          <div class="lead-operational-section__header">
            <span class="lead-operational-section__title"><i class="bi bi-calendar-event ax-ico"></i> Agenda</span>
            <span class="lead-operational-section__actions">
              <span class="ax-badge ax-badge--gray"><%= @appointments.size %></span>
              <% if can?(:manage, :comercial) %>
                <%= render "admin/leads/schedule_activity_modal",
                      lead: @lead,
                      modal_id: "scheduleActivitySection#{@lead.id}",
                      trigger_label: nil,
                      trigger_class: "ax-ico-btn",
                      trigger_icon: "plus-lg",
                      trigger_title: "Agendar atividade" %>
              <% end %>
            </span>
          </div>
          <div class="tw-grid tw-gap-2">
            <% if @appointments.any? %>
              <% @appointments.first(6).each do |a| %>
                <div class="lead-operational-row">
                  <span class="lead-operational-row__body">
                    <strong><%= a.title %></strong>
                    <span><%= a.kind_label %> · <%= l(a.starts_at, format: :short) %><%= " · #{a.location}" if a.location.present? %></span>
                  </span>
                  <% if can?(:manage, :comercial) %>
                    <%= render "admin/appointments/form_modal",
                          appointment: a,
                          lead: @lead,
                          modal_id: "editAppointmentLead#{a.id}",
                          trigger_label: nil,
                          trigger_class: "ax-ico-btn",
                          trigger_icon: "pencil",
                          trigger_title: "Editar agenda" %>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <p class="ax-page-subtitle tw-m-0">Nada agendado.</p>
            <% end %>
          </div>
        </section>

        <div class="lead-view-divider"></div>

        <section id="lead-desktop-tarefas" class="lead-operational-section lead-operational-section--tasks">
          <div class="lead-operational-section__header">
            <span class="lead-operational-section__title"><i class="bi bi-check2-square ax-ico"></i> Tarefas</span>
            <span class="lead-operational-section__actions">
              <span class="ax-badge ax-badge--gray"><%= open_tasks.size %></span>
              <% if can?(:manage, :comercial) %>
                <%= render "admin/tasks/form_modal",
                      modal_id: "newTaskLeadSection#{@lead.id}",
                      lead: @lead,
                      trigger_label: nil,
                      trigger_class: "ax-ico-btn",
                      trigger_title: "Nova tarefa" %>
              <% end %>
            </span>
          </div>
          <div class="lead-detail-task-stack">
            <% if open_tasks.any? %>
              <% open_tasks.first(6).each do |t| %>
                <% b = task_badge(t) %>
                <div class="lead-detail-task-row<%= " lead-detail-task-row--next" if @next_task && t.id == @next_task.id %><%= " lead-detail-task-row--alert" if b[:color] == "red" %>">
                  <% if can?(:manage, :comercial) && t.pendente? %>
                    <%= button_to complete_admin_task_path(t), method: :patch, form_class: "tw-inline", class: "ax-ico-btn", title: "Concluir", aria: { label: "Concluir tarefa #{t.title}" } do %>
                      <i class="bi bi-circle" aria-hidden="true"></i>
                    <% end %>
                  <% else %>
                    <span></span>
                  <% end %>
                  <span class="lead-detail-task-row__body">
                    <strong><%= t.title %></strong>
                    <span>
                      <%= t.kind_label %>
                      <% if t.due_at.present? %>
                        · <%= l(t.due_at, format: :short) %>
                      <% end %>
                    </span>
                  </span>
                  <span class="tw-inline-flex tw-items-center tw-gap-1">
                    <span class="ax-badge ax-badge--<%= b[:color] %>"><%= b[:label] %></span>
                    <% if can?(:manage, :comercial) %>
                      <%= render "admin/tasks/form_modal",
                            modal_id: "editTaskLead#{t.id}",
                            lead: @lead,
                            task: t,
                            trigger_label: nil,
                            trigger_class: "ax-ico-btn",
                            trigger_title: "Editar tarefa" %>
                    <% end %>
                  </span>
                </div>
              <% end %>
            <% else %>
              <p class="ax-page-subtitle tw-m-0">Nenhuma tarefa pendente.</p>
            <% end %>
          </div>
        </section>

        <div class="lead-view-divider"></div>

        <section id="lead-desktop-etiquetas" class="lead-operational-section lead-operational-section--labels">
          <div class="lead-operational-section__header">
            <span class="lead-operational-section__title"><i class="bi bi-tags ax-ico"></i> Etiquetas</span>
            <span class="lead-operational-section__actions">
              <% lead_labels = @lead.labels_for(current_admin_user) %>
              <span class="ax-badge ax-badge--gray"><%= lead_labels.size %></span>
              <%= render "admin/lead_labels/button", lead: @lead, trigger_label: nil, trigger_class: "ax-ico-btn", trigger_icon: "plus-lg", icon_only: true %>
            </span>
          </div>
          <% if lead_labels.any? %>
            <%= render "admin/lead_labels/chips", lead: @lead, labels: lead_labels %>
          <% else %>
            <p class="ax-page-subtitle tw-m-0">Nenhuma etiqueta aplicada.</p>
          <% end %>
        </section>

        <div class="lead-view-divider"></div>

        <section id="lead-desktop-propostas" class="lead-operational-section lead-operational-section--proposals">
          <div class="lead-operational-section__header">
            <span class="lead-operational-section__title"><i class="bi bi-file-earmark-text ax-ico"></i> Propostas</span>
            <span class="lead-operational-section__actions">
              <span class="ax-badge ax-badge--gray"><%= @proposals.size %></span>
              <% if can?(:manage, :comercial) %>
                <%= render "admin/proposals/form_modal",
                      modal_id: "newProposalLeadSection#{@lead.id}",
                      proposal: @new_proposal,
                      lead: @lead,
                      habitations: @proposal_habitations,
                      trigger_label: nil,
                      trigger_class: "ax-ico-btn",
                      trigger_icon: "plus-lg",
                      trigger_title: "Nova proposta" %>
              <% end %>
            </span>
          </div>
          <div class="tw-grid tw-gap-2">
            <% if @proposals.any? %>
              <% @proposals.each do |p| %>
                <div class="lead-proposal-item">
                  <div class="tw-min-w-0">
                    <div class="ax-strong tw-truncate">R$ <%= number_with_precision(p.valor, precision: 2, delimiter: ".", separator: ",") %></div>
                    <div><span class="ax-badge ax-badge--<%= proposal_badge_color(p) %>"><%= p.status_label %></span></div>
                  </div>
                  <div class="tw-flex tw-gap-1">
                    <% if can?(:manage, :comercial) %>
                      <%= render "admin/proposals/form_modal",
                            modal_id: "editProposal#{p.id}",
                            proposal: p,
                            lead: @lead,
                            habitations: @proposal_habitations,
                            trigger_label: nil,
                            trigger_class: "ax-ico-btn",
                            trigger_icon: "pencil",
                            trigger_title: "Editar proposta" %>
                    <% end %>
                    <%= link_to public_proposal_path(p.public_token), target: "_blank", class: "ax-ico-btn", title: "Abrir link" do %><i class="bi bi-box-arrow-up-right"></i><% end %>
                    <%= link_to pdf_admin_proposal_path(p), target: "_blank", class: "ax-ico-btn", title: "PDF" do %><i class="bi bi-filetype-pdf"></i><% end %>
                    <% if can?(:manage, :comercial) && p.status == "rascunho" %>
                      <%= button_to send_proposal_admin_proposal_path(p), method: :patch, form_class: "tw-inline", class: "ax-ico-btn", title: "Marcar enviada" do %><i class="bi bi-send"></i><% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="ax-page-subtitle tw-m-0">Nenhuma proposta.</p>
            <% end %>
          </div>
        </section>

      </div>
    </div>

    <div class="ax-card lead-next-action-card tw-mb-4">
      <div class="ax-card__header tw-flex tw-items-center tw-justify-between">
        <span class="ax-card__title"><i class="bi bi-journal-text ax-ico"></i> Histórico de contatos</span>
        <span class="ax-badge ax-badge--gray"><%= @contact_history_activities.size %></span>
      </div>
      <div class="ax-card__body">
        <div class="tw-mb-3">
          <%= render "admin/leads/log_contact_modal",
                lead: @lead,
                modal_id: "leadLogContactHistoryDesktop#{@lead.id}",
                trigger_label: "Registrar contato",
                trigger_class: "ax-btn ax-btn--sm",
                trigger_icon: "plus-lg",
                trigger_title: "Registrar contato" %>
        </div>
        <% if @contact_history_activities.any? %>
          <div class="tw-grid tw-gap-2">
            <% @contact_history_activities.first(6).each do |note| %>
              <% body = note.meta("body").to_s.strip.presence %>
              <div class="lead-operational-row">
                <span class="lead-operational-row__body">
                  <strong><%= lead_contact_kind_label(note) %> · <%= l(note.created_at, format: :short) %></strong>
                  <span><%= truncate(body || "Contato sem descrição registrada.", length: 120) %></span>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="ax-page-subtitle tw-m-0">Nenhum contato registrado.</p>
        <% end %>
      </div>
    </div>

    <%# ===== Bloco: Corretor & observações ===== %>
    <div class="ax-card lead-next-action-card tw-mb-4">
      <div class="ax-card__header">
        <span class="ax-card__title"><i class="bi bi-person-badge ax-ico"></i> Corretor</span>
      </div>
      <div class="ax-card__body">
        <%= form_with(model: [:admin, @lead], local: true) do |f| %>
          <div class="mb-3">
            <%= f.label :notes, "Observações internas", class: "ax-label" %>
            <%= f.text_area :notes, rows: 3, class: "ax-textarea", placeholder: "Histórico de conversas, preferências do cliente..." %>
          </div>
          <div class="tw-grid tw-gap-3">
            <%# Status sai daqui: o funil no topo da página já troca a etapa. %>
            <% if can_transfer_lead?(@lead) %>
              <div>
                <label class="ax-label">Corretor</label>
                <%= f.select :admin_user_id, transfer_broker_options(@lead), { include_blank: "Sem corretor" }, class: "ax-select" %>
              </div>
            <% else %>
              <div>
                <span class="ax-label">Corretor</span>
                <div class="lead-readonly-field"><%= @lead.admin_user&.name.presence || "Sem corretor" %></div>
              </div>
            <% end %>
            <div class="tw-flex tw-justify-end">
              <%= f.submit "Salvar", class: "ax-btn ax-btn--sm ax-btn--primary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ===== Bloco: Inteligência de Interesse + Imóveis compatíveis ===== %>
    <div class="ax-card lead-next-action-card">
      <div class="ax-card__header tw-flex tw-items-center tw-justify-between">
        <span class="ax-card__title"><i class="bi bi-graph-up-arrow ax-ico"></i> Inteligência de Interesse</span>
        <span class="ax-badge ax-badge--gray"><%= interest_badge %></span>
      </div>
      <div class="ax-card__body">
        <% if detail_interest_intelligence_locals %>
          <%= render "admin/leads/interest_intelligence", **detail_interest_intelligence_locals %>
        <% else %>
          <%= turbo_frame_tag dom_id(@lead, :interest_intelligence),
                src: interest_intelligence_admin_lead_path(@lead),
                loading: "lazy" do %>
            <div class="lead-interest-card">
              <div class="lead-interest-empty">
                <i class="bi bi-hourglass-split"></i>
                <div>
                  <strong>Carregando sinais</strong>
                  <p>A tela do lead já pode ser usada enquanto a inteligência calcula em segundo plano.</p>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render "admin/shared/attribute_manager_modal", modal_id: "attributeManagerModalLead" %>
<%= render "admin/leads/audit_history_modal", lead: @lead, audit_logs: @lead_audit_logs %>
</div>
