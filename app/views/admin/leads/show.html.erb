<% content_for :admin_contextbar_breadcrumb do %>
  <%= link_to "Leads", @return_to_path.presence || admin_leads_path %>
  <i class="bi bi-chevron-right"></i>
  <strong><%= @lead.display_name %></strong>
<% end %>

<style>
  .lead-pwa-detail { display: none; }

  .lead-detail-task-stack {
    display: grid;
    gap: 8px;
  }

  .lead-action-hub {
    --lead-pwa-surface: var(--admin-surface, #fff);
    --lead-pwa-surface-soft: var(--admin-surface-header, #eef2f7);
    --lead-pwa-ink: var(--admin-ink, #0f172a);
    --lead-pwa-muted: var(--ab-muted, #64748b);
    --lead-pwa-line: var(--ab-line, #dfe5ed);
    --lead-pwa-line-soft: var(--ab-line-soft, #e5eaf1);
    --lead-pwa-primary: var(--admin-primary, #2478e8);
    display: grid;
    gap: 10px;
  }

  .lead-permanent-delete-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  .lead-permanent-delete-card__body p {
    margin: 0;
  }

  .lead-permanent-delete-card__confirm {
    justify-self: end;
  }

  .lead-permanent-delete-card__confirm.is-confirming {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    justify-self: stretch;
    gap: 10px;
  }

  .lead-permanent-delete-card__confirm.is-confirming .ax-confirm-submit__panel {
    grid-column: 2;
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .lead-permanent-delete-card__body,
    .lead-permanent-delete-card__confirm.is-confirming {
      grid-template-columns: 1fr;
    }

    .lead-permanent-delete-card__confirm,
    .lead-permanent-delete-card__confirm.is-confirming,
    .lead-permanent-delete-card__confirm .ax-btn {
      width: 100%;
    }

    .lead-permanent-delete-card__confirm.is-confirming .ax-confirm-submit__panel {
      grid-column: 1;
    }
  }

  .lead-action-hub .lead-pwa-next-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .lead-action-hub .lead-pwa-next-actions > .tw-inline-block {
    width: 100%;
    min-width: 0;
  }

  .lead-action-hub .lead-pwa-next-actions__btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 100%;
    min-height: 44px;
    padding: 6px 4px;
    border: 1px solid var(--lead-pwa-line);
    border-radius: 10px;
    background: var(--lead-pwa-surface);
    color: var(--lead-pwa-ink);
    font-size: 10.5px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .lead-action-hub .lead-pwa-next-actions__btn i {
    font-size: 15px;
  }

  .lead-action-hub .lead-pwa-next-actions__btn--primary {
    border-color: var(--lead-pwa-primary);
    background: color-mix(in srgb, var(--lead-pwa-primary) 12%, var(--lead-pwa-surface));
    color: var(--lead-pwa-primary);
  }

  .lead-action-hub .lead-pwa-next-actions__btn--success {
    border-color: #86efac;
    background: color-mix(in srgb, #22c55e 14%, var(--lead-pwa-surface));
    color: #047857;
  }

  .lead-action-hub .lead-pwa-next-actions__btn--warning {
    border-color: #fde68a;
    background: color-mix(in srgb, #f59e0b 12%, var(--lead-pwa-surface));
    color: #b45309;
  }

  .lead-action-hub .lead-pwa-next-actions__btn--info {
    border-color: #bae6fd;
    background: color-mix(in srgb, #0ea5e9 12%, var(--lead-pwa-surface));
    color: #0369a1;
  }

  .lead-action-hub .lead-pwa-next-actions__btn--neutral {
    border-color: var(--lead-pwa-line);
    background: var(--lead-pwa-surface-soft);
    color: var(--lead-pwa-ink);
  }

  .lead-action-hub .lead-pwa-next-actions__btn--danger {
    border-color: #fecdd3;
    background: color-mix(in srgb, #f43f5e 10%, var(--lead-pwa-surface));
    color: #9f1239;
  }

  .lead-operational-section {
    display: grid;
    gap: 10px;
  }

  .lead-operational-section--agenda {
    border-color: color-mix(in srgb, var(--admin-primary, #2478e8) 42%, var(--lead-pwa-line, #dfe5ed));
  }

  .lead-operational-section--agenda .lead-operational-section__title {
    color: var(--admin-primary, #2478e8);
  }

  .lead-operational-section--tasks {
    border-color: #fde68a;
  }

  .lead-operational-section--tasks .lead-operational-section__title {
    color: #b45309;
  }

  .lead-operational-section--labels {
    border-color: #bae6fd;
  }

  .lead-operational-section--labels .lead-operational-section__title {
    color: #0369a1;
  }

  .lead-operational-section--proposals {
    border-color: var(--lead-pwa-line, #dfe5ed);
  }

  .lead-operational-section--proposals .lead-operational-section__title {
    color: var(--lead-pwa-ink, #0f172a);
  }

  .lead-operational-section--pulse {
    animation: lead-operational-section-pulse 1200ms ease-out;
  }

  @keyframes lead-operational-section-pulse {
    0%, 100% { box-shadow: 0 1px 2px rgba(15, 23, 42, .06); }
    18%, 65% {
      box-shadow:
        0 0 0 3px color-mix(in srgb, var(--admin-primary, #2478e8) 18%, transparent),
        0 12px 28px rgba(37, 99, 235, .18);
    }
  }

  .lead-operational-section__header,
  .lead-operational-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
  }

  .lead-operational-section__header {
    min-height: 34px;
  }

  .lead-operational-section__title {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: var(--admin-ink, #1f2733);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .lead-operational-section__actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lead-operational-row {
    padding: 8px;
    border: 1px solid var(--ax-border-soft, #d8dee8);
    border-radius: 8px;
    background: #fff;
  }

  .lead-operational-row__body {
    display: grid;
    min-width: 0;
    gap: 3px;
  }

  .lead-operational-row__body strong,
  .lead-operational-row__body span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lead-operational-row__body strong {
    color: var(--admin-ink, #1f2733);
    font-size: 13px;
    font-weight: 850;
    line-height: 1.25;
  }

  .lead-operational-row__body span {
    color: #667085;
    font-size: 11px;
    font-weight: 700;
  }

  .lead-detail-task-row {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 8px;
    border: 1px solid var(--ax-border-soft, #d8dee8);
    border-radius: 8px;
    background: #fff;
  }

  .lead-detail-task-row--next {
    border-color: color-mix(in srgb, var(--admin-primary, #365f8f) 34%, var(--ax-border-soft, #d8dee8));
    background: color-mix(in srgb, var(--admin-primary, #365f8f) 6%, #fff);
  }

  .lead-detail-task-row--alert {
    border-color: #fecdd3;
    background: #fff1f2;
  }

  .lead-detail-task-row__body {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  .lead-detail-task-row__body strong,
  .lead-detail-task-row__body span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lead-detail-task-row__body strong {
    color: var(--admin-ink, #1f2733);
    font-size: 13px;
    font-weight: 850;
    line-height: 1.25;
  }

  .lead-detail-task-row__body span {
    color: #667085;
    font-size: 11px;
    font-weight: 700;
  }

  .lead-detail-task-row--alert .lead-detail-task-row__body strong,
  .lead-detail-task-row--alert .lead-detail-task-row__body span {
    color: #9f1239;
  }

  html[data-admin-theme="dark"] .lead-detail-task-row {
    border-color: var(--ax-dark-border-soft);
    background: var(--ax-dark-surface);
  }

  html[data-admin-theme="dark"] .lead-operational-row {
    border-color: var(--ax-dark-border-soft);
    background: var(--ax-dark-surface);
  }

  html[data-admin-theme="dark"] .lead-operational-section__title,
  html[data-admin-theme="dark"] .lead-operational-row__body strong {
    color: var(--ax-dark-text);
  }

  html[data-admin-theme="dark"] .lead-operational-row__body span {
    color: var(--ax-dark-text-muted);
  }

  html[data-admin-theme="dark"] .lead-detail-task-row--next {
    border-color: var(--ax-dark-border);
    background: var(--ax-dark-surface-raised);
  }

  html[data-admin-theme="dark"] .lead-detail-task-row--alert {
    border-color: var(--ax-dark-danger-border);
    background: var(--ax-dark-danger-surface);
  }

  html[data-admin-theme="dark"] .lead-detail-task-row__body strong {
    color: var(--ax-dark-text);
  }

  html[data-admin-theme="dark"] .lead-detail-task-row__body span {
    color: var(--ax-dark-text-muted);
  }

  html[data-admin-theme="dark"] .lead-detail-task-row--alert .lead-detail-task-row__body strong,
  html[data-admin-theme="dark"] .lead-detail-task-row--alert .lead-detail-task-row__body span {
    color: var(--ax-dark-danger-text);
  }

  @media (max-width: 767.98px) {
    body.ax-app .ax-navbar,
    body.ax-app .ax-sidebar-contextbar,
    body.ax-app .ax-contextbar {
      display: none !important;
    }

    body.ax-app > .ax-main {
      min-height: 100dvh !important;
      margin: 0 !important;
      padding: 0 !important;
      background: var(--admin-workspace-bg, #f6f8fb) !important;
    }

    html[data-admin-theme="dark"] body.ax-app > .ax-main {
      background: var(--ax-dark-workspace, #0f1726) !important;
    }

    .lead-show-workspace {
      min-height: 100dvh;
      margin: 0;
      background: var(--admin-workspace-bg, #f6f8fb);
    }

    html[data-admin-theme="dark"] .lead-show-workspace {
      background: var(--ax-dark-workspace, #0f1726);
    }

    .lead-show-workspace > .ax-workspace-heading,
    .lead-show-workspace > .lead-origin-block,
    .lead-show-workspace > .ax-card,
    .lead-show-workspace > .tw-grid {
      display: none !important;
    }

    .lead-pwa-detail {
      --lead-pwa-bg: var(--admin-workspace-bg, #f6f8fb);
      --lead-pwa-surface: var(--admin-surface, #fff);
      --lead-pwa-surface-soft: var(--admin-surface-header, #eef2f7);
      --lead-pwa-ink: var(--admin-ink, #0f172a);
      --lead-pwa-muted: var(--ab-muted, #64748b);
      --lead-pwa-line: var(--ab-line, #dfe5ed);
      --lead-pwa-line-soft: var(--ab-line-soft, #e5eaf1);
      --lead-pwa-primary: var(--admin-primary, #2478e8);
      display: grid;
      align-content: start;
      gap: 6px;
      min-height: 100dvh;
      padding: max(8px, env(safe-area-inset-top, 0px)) 8px calc(82px + env(safe-area-inset-bottom, 0px));
      background: var(--lead-pwa-bg);
      color: var(--lead-pwa-ink);
    }

    html[data-admin-theme="dark"] .lead-pwa-detail {
      --lead-pwa-bg: var(--ax-dark-workspace, #0f1726);
      --lead-pwa-surface: var(--ax-dark-surface, #172238);
      --lead-pwa-surface-soft: var(--ax-dark-surface-raised, #202d43);
      --lead-pwa-ink: var(--ax-dark-text, #e8eef7);
      --lead-pwa-muted: var(--ax-dark-text-muted, #9eabc0);
      --lead-pwa-line: var(--ax-dark-border, #3b4d68);
      --lead-pwa-line-soft: var(--ax-dark-border-soft, #33445d);
      --lead-pwa-primary: var(--ax-dark-link, #9bc5ef);
    }

    .lead-pwa-detail__top {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr) auto;
      gap: 8px;
      align-items: center;
    }

    .lead-pwa-detail__top-actions {
      display: flex;
      gap: 6px;
    }

    .lead-pwa-detail__icon-btn,
    .lead-pwa-detail__favorite {
      display: inline-grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 12px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-ink);
      font-size: 20px;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

    .lead-pwa-detail__favorite {
      border-color: #facc15;
      color: #ca8a04;
    }

    .lead-pwa-detail__favorite.is-active {
      background: color-mix(in srgb, #facc15 22%, var(--lead-pwa-surface));
      color: #ca8a04;
    }

    .lead-pwa-detail__favorite-form {
      margin: 0;
    }

    .lead-pwa-detail__title {
      min-width: 0;
      text-align: center;
    }

    .lead-pwa-detail__title strong {
      display: block;
      overflow: hidden;
      color: var(--lead-pwa-ink);
      font-size: 17px;
      font-weight: 950;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pwa-detail__title span {
      display: block;
      margin-top: 2px;
      color: var(--lead-pwa-muted);
      font-size: 12px;
      font-weight: 800;
    }

    .lead-pwa-detail__hero,
    .lead-pwa-detail__panel {
      display: grid;
      gap: 7px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 12px;
      background: var(--lead-pwa-surface);
      padding: 10px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
      margin-bottom: 6px;
    }

    .lead-pwa-detail__hero-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      align-items: start;
    }

    .lead-pwa-detail__name {
      margin: 0;
      color: var(--lead-pwa-muted) !important;
      font-size: 15px;
      font-weight: 650;
      line-height: 1.2;
    }

    .lead-pwa-detail__badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 26px;
      padding: 0 10px;
      border: 1px solid var(--lead-pwa-primary);
      border-radius: 999px;
      color: var(--lead-pwa-primary);
      font-size: 12px;
      font-weight: 850;
      white-space: nowrap;
    }

    .lead-pwa-detail__meta {
      display: grid;
      gap: 5px;
      color: var(--lead-pwa-muted);
      font-size: 13px;
      font-weight: 700;
    }

    .lead-pwa-detail__meta span {
      display: flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
    }

    .lead-pwa-detail__meta b {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lead-pwa-detail__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .lead-pwa-detail__action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 38px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 11px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-ink);
      font-size: 13px;
      font-weight: 900;
      text-decoration: none;
    }

    .lead-pwa-detail__action--whatsapp {
      border-color: #86efac;
      background: color-mix(in srgb, #22c55e 14%, var(--lead-pwa-surface));
      color: #047857;
    }

    .lead-pwa-detail__section-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--lead-pwa-ink);
      font-size: 14px;
      font-weight: 950;
    }

    .lead-pwa-detail__section-title small {
      color: var(--lead-pwa-muted);
      font-size: 12px;
      font-weight: 850;
    }

    .lead-pwa-detail__funnel {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .lead-pwa-detail__funnel::-webkit-scrollbar { display: none; }

    .lead-pwa-detail__step {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 27px;
      padding: 0 9px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 999px;
      background: var(--lead-pwa-surface-soft);
      color: var(--lead-pwa-muted);
      font-size: 12px;
      font-weight: 850;
      white-space: nowrap;
    }

    .lead-pwa-detail__step--current {
      border-color: var(--lead-pwa-primary);
      background: color-mix(in srgb, var(--lead-pwa-primary) 14%, var(--lead-pwa-surface));
      color: var(--lead-pwa-primary);
    }

    .lead-pwa-detail__record {
      display: grid;
      gap: 2px;
      min-width: 0;
      padding: 9px 0;
      border-top: 1px solid var(--lead-pwa-line-soft);
      color: var(--lead-pwa-muted);
      font-size: 14px;
      font-weight: 700;
    }

    .lead-pwa-detail__record:first-of-type {
      border-top: 0;
      padding-top: 0;
    }

    .lead-pwa-detail__record strong {
      color: var(--lead-pwa-ink);
      font-size: 15px;
      font-weight: 700;
    }

    .lead-pwa-detail__record span,
    .lead-pwa-detail__notes {
      color: var(--lead-pwa-muted);
      line-height: 1.35;
      font-weight: 500;
    }

    .lead-pwa-detail__notes-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 10px;
    }

    .lead-pwa-detail__notes-head {
      align-items: center;
      justify-content: flex-start;
    }

    .lead-pwa-detail__notes-title {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    .lead-pwa-detail__notes-title i {
      display: inline-grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--lead-pwa-primary) 12%, var(--lead-pwa-surface));
      color: var(--lead-pwa-primary);
      font-size: 14px;
    }

    .lead-pwa-detail__notes-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 26px;
      height: 26px;
      padding: 0 8px;
      border-radius: 999px;
      background: var(--lead-pwa-surface-soft);
      color: var(--lead-pwa-muted);
      font-size: 12px;
      font-weight: 900;
    }

    .lead-pwa-detail__note-composer {
      justify-self: end;
      margin: 0;
    }

    .lead-pwa-detail__note-composer[open] {
      grid-column: 1 / -1;
    }

    .lead-pwa-detail__note-form {
      display: grid;
      gap: 8px;
      margin-top: 10px;
      padding: 10px;
      border: 1px solid var(--lead-pwa-line-soft);
      border-radius: 10px;
      background: var(--lead-pwa-surface-soft);
    }

    .lead-pwa-detail__note-form textarea {
      min-height: 92px;
      resize: vertical;
    }

    .lead-pwa-detail__note-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 34px;
      padding: 0 11px;
      border: 1px solid var(--lead-pwa-line);
      border-radius: 999px;
      background: var(--lead-pwa-surface);
      color: var(--lead-pwa-primary);
      font-size: 12px;
      font-weight: 850;
      list-style: none;
    }

    .lead-pwa-detail__note-toggle::-webkit-details-marker {
      display: none;
    }

    .lead-pwa-detail__notes-timeline {
      display: grid;
      grid-column: 1 / -1;
      gap: 0;
      margin-top: 2px;
    }

    .lead-pwa-detail__notes-empty {
      grid-column: 1 / -1;
    }

    .lead-pwa-detail__note-item {
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 10px;
    }

    .lead-pwa-detail__note-line {
      display: grid;
      justify-items: center;
      position: relative;
      min-height: 100%;
    }

    .lead-pwa-detail__note-dot {
      display: inline-grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border: 1px solid color-mix(in srgb, var(--lead-pwa-primary) 18%, var(--lead-pwa-line));
      border-radius: 999px;
      background: color-mix(in srgb, var(--lead-pwa-primary) 10%, var(--lead-pwa-surface));
      color: var(--lead-pwa-primary);
      font-size: 14px;
      position: relative;
      z-index: 1;
    }

    .lead-pwa-detail__note-rail {
      position: absolute;
      top: 30px;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 2px;
      background: var(--lead-pwa-line-soft);
    }

    .lead-pwa-detail__note-card {
      min-width: 0;
