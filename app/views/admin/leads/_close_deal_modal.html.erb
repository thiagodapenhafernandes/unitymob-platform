<div data-controller="ax-modal" class="tw-inline-block">
  <button type="button" class="lead-pwa-next-actions__btn lead-pwa-next-actions__btn--success" data-action="ax-modal#open">
    <i class="bi bi-check-circle" aria-hidden="true"></i><span>Fechado</span>
  </button>
  <div id="<%= modal_id %>" class="ax-modal-overlay" hidden data-ax-modal-target="overlay" data-action="click->ax-modal#backdropClose">
    <div class="ax-modal-panel" role="dialog" aria-modal="true" aria-label="Fechar negócio">
      <div class="ax-modal-panel__section-header tw-flex tw-items-center tw-justify-between tw-px-4 tw-py-3">
        <strong>Fechar negócio</strong>
        <button type="button" class="ax-ico-btn" data-action="ax-modal#close" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
      </div>
      <%= form_with model: lead, url: close_deal_admin_lead_path(lead), method: :post, namespace: modal_id, data: { turbo: false } do |form| %>
        <div class="tw-px-4 tw-py-4 tw-grid tw-gap-3">
          <%= ax_currency_field form: form, method: :closing_commission, label: "Comissão real do fechamento (opcional)", inputmode: "decimal", tooltip: "Informe a comissão real em reais. Sem valor informado, a conversão Google será enviada sem valor monetário." %>
        </div>
        <div class="ax-modal-panel__section-footer tw-flex tw-justify-end tw-gap-2 tw-px-4 tw-py-3">
          <button type="button" class="ax-btn ax-btn--sm" data-action="ax-modal#close">Cancelar</button>
          <%= form.submit "Fechar negócio", class: "ax-btn ax-btn--sm ax-btn--success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
