<%# Entradas da linha do tempo do lead. locals: entries, detailed (boolean) %>
<div class="tw-grid tw-gap-0">
  <% detailed = local_assigns.fetch(:detailed, true) %>
  <% entries.each_with_index do |act, i| %>
    <% e = timeline_entry(act, detailed: detailed) %>
    <% receipts = local_assigns.fetch(:push_receipts, {}).fetch(act, []) %>
    <% initial_notice = act.is_a?(LeadActivity) && act.kind == "notification_sent" && e[:notification_mode].present? %>
    <div class="tw-flex tw-gap-3">
      <div class="tw-flex tw-flex-col tw-items-center">
        <span class="ax-timeline-marker <%= Admin::UiHelper::AX_BADGE_TONES.fetch(e[:color].to_s.to_sym, "ax-badge--gray") %>" data-brand="<%= e[:icon].to_s.delete_prefix("bi-") %>" aria-hidden="true"><i class="bi <%= e[:icon] %>"></i></span>
        <% unless i == entries.size - 1 %><span class="lead-timeline-rail"></span><% end %>
      </div>
      <div class="tw-pb-4 tw-flex-1">
        <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2">
          <span class="ax-strong"><%= e[:label] %><% if e[:notification_mode] %> pelo <%= ax_badge(e[:notification_mode][:label], tone: e[:notification_mode][:tone]) %><% end %></span>
          <span class="ax-page-subtitle"><%= l(act.created_at, format: initial_notice ? "%d/%m/%Y %H:%M" : "%d/%m/%Y %H:%M:%S") %></span>
        </div>
        <% if e[:whatsapp_status_events].present? %>
          <details class="ax-page-subtitle">
            <summary><%= e[:detail] %></summary>
            <div class="tw-mt-2 tw-grid tw-gap-1.5">
              <% e[:whatsapp_status_events].each do |label, occurred_at, extra, tone| %>
                <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2">
                  <%= ax_badge(label, tone: tone) %>
                  <span><%= l(occurred_at, format: "%d/%m/%Y %H:%M:%S") %></span>
                  <% if extra.present? %><span>· <%= extra %></span><% end %>
                </div>
              <% end %>
            </div>
          </details>
        <% elsif receipts.any? %>
          <details class="ax-page-subtitle">
            <summary><%= e[:detail] %></summary>
            <div class="tw-mt-2 tw-grid tw-gap-1.5">
              <% receipts.sort_by(&:created_at).each do |receipt| %>
                <div>
                  <%= ax_badge("Notificação recebida no aparelho", tone: :green) %>
                  <span><%= l(receipt.created_at, format: "%d/%m/%Y %H:%M:%S") %></span>
                  <div><%= push_delivery_timeline_detail(receipt, detailed: detailed) %></div>
                </div>
              <% end %>
            </div>
          </details>
        <% elsif e[:detail].present? %>
          <div class="ax-page-subtitle"><%= e[:detail] %></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
