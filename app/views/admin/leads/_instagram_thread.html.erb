<% window_open = Instagram::Reply.window_open?(lead) %>
<div class="ax-card tw-mb-3" id="lead-instagram-thread"
     data-controller="ax-live-thread"
     data-ax-live-thread-channel-value="LeadConversationChannel"
     data-ax-live-thread-params-value="<%= { lead_id: lead.id, tenant_id: lead.tenant_id }.to_json %>"
     data-action="turbo:submit-start->ax-live-thread#submitting turbo:submit-end->ax-live-thread#submitted turbo:frame-load->ax-live-thread#frameLoaded">
  <div class="ax-card__body">
    <%= render "admin/leads/instagram_messages_frame", lead: lead %>
    <div id="lead_instagram_status_<%= lead.id %>" role="alert" aria-live="polite"></div>
    <% if can?(:edit, :leads) %>
      <%= form_with url: reply_instagram_admin_lead_path(lead), method: :post, class: "lead-ig-thread__form", data: { admin_navigation_ignore: true } do |f| %>
        <%= f.text_area :body, rows: 2, maxlength: 1000, placeholder: "Responder no Instagram…", class: "ax-control", aria: { label: "Responder no Instagram" }, disabled: !window_open, data: { ax_live_thread_target: "input" } %>
        <%= f.submit "Enviar", class: "ax-btn ax-btn--sm ax-btn--primary", disabled: !window_open, data: { ax_live_thread_target: "submit" } %>
      <% end %>
    <% end %>
  </div>
</div>
