<%# locals: lead %>
<%
  open_tasks = lead.tasks.includes(:admin_user).ordered.limit(50).reject do |task|
    task.concluida? || task.title.to_s.squish.match?(/\A(notificar corretor sobre oportunidade|oportunidade de interesse para)\b/i)
  end
  next_task = open_tasks.select(&:pendente?).find { |task| task.due_at.present? } || open_tasks.find(&:pendente?)
  appointments = lead.appointments.upcoming.limit(20)
  proposals = lead.proposals.ordered.limit(20)
  lead_labels = lead.labels_for(current_admin_user)
  contact_history_activities = lead.activities.where(kind: "note").recent.limit(40)
  proposal_habitations = can?(:manage, :comercial) ? current_tenant.habitations.order(updated_at: :desc).limit(500) : []
  new_proposal = lead.proposals.new(habitation_id: lead.property_id, admin_user: current_admin_user, validade: 7.days.from_now.to_date)
  archive_reason_options = current_tenant.attribute_options.for_context("lead").for_category("archive_reason").ordered
%>

<%= turbo_frame_tag dom_id(lead, :pwa_operational_panel) do %>
  <% if next_task.present? || can?(:manage, :comercial) %>
    <section class="lead-pwa-detail__panel">
      <div class="lead-pwa-detail__section-title">
        <span>Ações do lead</span>
        <small><%= open_tasks.size %> tarefa<%= "s" if open_tasks.size != 1 %></small>
      </div>
      <div class="lead-operational-row lead-operational-row--compact">
        <span class="lead-operational-row__body">
          <strong>Tentativas sem resposta</strong>
          <span>Desde a última resposta nesta etapa</span>
        </span>
        <span class="ax-badge ax-badge--amber"><%= lead_unsuccessful_attempt_count(lead) %></span>
      </div>
      <%= render "admin/leads/action_hub",
            namespace: "Pwa#{lead.id}",
            lead: lead,
            open_tasks: open_tasks,
            appointments: appointments,
            proposals: proposals,
            labels_count: lead_labels.size,
            next_task: next_task,
            new_proposal: new_proposal,
            proposal_habitations: proposal_habitations,
            archive_reason_options: archive_reason_options,
            show_tasks: false,
            close_deal_form_id: "lead_close_deal_pwa_#{lead.id}" %>
    </section>
  <% end %>

  <%= render "admin/leads/operational_sections",
        lead: lead,
        anchor_prefix: "lead-pwa",
        namespace: "PwaSection#{lead.id}",
        section_class: "lead-pwa-detail__panel",
        empty_class: "lead-pwa-detail__empty",
        schedule_modal_id: "scheduleActivityPwaSection#{lead.id}",
        edit_appointment_modal_prefix: "editAppointmentPwa",
        new_task_modal_id: "newTaskLeadPwaSection#{lead.id}",
        edit_task_modal_prefix: "editTaskPwa",
        new_proposal_modal_id: "newProposalPwaSection#{lead.id}",
        edit_proposal_modal_prefix: "editProposalPwa",
        open_tasks: open_tasks,
        next_task: next_task,
        appointments: appointments,
        proposals: proposals,
        lead_labels: lead_labels,
        contact_history_activities: contact_history_activities,
        contact_history_modal_id: "leadLogContactHistoryPwaSection#{lead.id}",
        new_proposal: new_proposal,
        proposal_habitations: proposal_habitations %>
<% end %>
