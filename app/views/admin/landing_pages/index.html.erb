<%# Landing Pages — listagem compacta (.ax-*). %>
<div class="public-site-workspace">
<%= ax_workspace_heading(eyebrow: "Site público · Conteúdo", icon: "file-earmark-post", title: @page_title, subtitle: @page_subtitle, metrics: [{ value: @landing_pages.total_entries, label: "páginas" }], actions: ax_button("Nova página", new_admin_landing_page_path, variant: :primary, size: :sm, icon: "plus-lg")) %>

<div class="ax-table-wrap">
  <table class="ax-table">
    <thead>
      <tr>
        <th>Título</th>
        <th class="ax-table__col--w-220">Endereço</th>
        <th class="ax-table__col--sm">Status</th>
        <th>Blocos</th>
        <th class="ax-num ax-table__col--compact">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @landing_pages.each do |page| %>
        <tr>
          <td class="ax-strong"><%= link_to page.title, edit_admin_landing_page_path(page) %></td>
          <td><code class="tw-text-primary">/<%= page.slug %></code></td>
          <td>
            <% tone = { "published" => "green", "draft" => "amber", "inactive" => "gray" }.fetch(page.status, "gray") %>
            <span class="ax-badge ax-badge--<%= tone %> ax-badge--dot"><%= page.status_label %></span>
          </td>
          <td>
            <% if page.blocks.any? %>
              <div class="tw-flex tw-flex-wrap tw-gap-1">
                <% page.blocks.group_by(&:block_type).each do |type, blocks| %>
                  <span class="ax-badge ax-badge--gray"><%= blocks.size %> <%= LandingPages::BlockTypes.find(type)&.label || type %></span>
                <% end %>
              </div>
            <% else %>
              <span class="ax-badge ax-badge--gray" title="Página antiga: abre no layout de lista de imóveis. Edite e salve para convertê-la em blocos.">Vitrine (layout antigo)</span>
            <% end %>
          </td>
          <td class="ax-num">
            <span class="tw-inline-flex tw-gap-0.5">
              <% if page.slug.present? && page.published? %><%= link_to public_landing_page_path(page.slug), target: "_blank", class: "ax-ico-btn", title: "Ver no site" do %><i class="bi bi-eye"></i><% end %><% end %>
              <%= link_to edit_admin_landing_page_path(page), class: "ax-ico-btn", title: "Editar" do %><i class="bi bi-pencil"></i><% end %>
              <%= button_to admin_landing_page_path(page), method: :delete, form_class: "tw-inline", form: { data: { turbo_confirm: 'Tem certeza que deseja excluir esta página?' } }, class: "ax-ico-btn", title: "Excluir" do %><i class="bi bi-trash"></i><% end %>
            </span>
          </td>
        </tr>
      <% end %>
      <% if @landing_pages.empty? %>
        <tr><td colspan="5"><div class="ax-empty">
          <i class="bi bi-file-earmark-plus tw-text-2xl tw-block tw-mb-2 tw-text-ink-faint"></i>Nenhuma página criada ainda.
        </div></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
</div>

<% if @landing_pages.respond_to?(:total_pages) && @landing_pages.total_pages > 1 %>
  <%= ax_pagination @landing_pages, params: request.query_parameters %>
<% end %>
