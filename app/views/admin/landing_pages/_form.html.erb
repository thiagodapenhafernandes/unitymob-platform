<%# Editor de páginas por blocos: etapas à esquerda, prévia real (a página do site) à direita. %>
<% editing = @landing_page.persisted? %>
<%= form_with(model: [:admin, @landing_page], local: true, multipart: true, class: "ax-guided landing-page-guided",
              data: {
                controller: "landing-page-builder",
                landing_page_builder_preview_url_value: render_preview_admin_landing_pages_path(id: @landing_page.slug.presence),
                landing_page_builder_saved_status_value: (editing ? @landing_page.status : "new"),
                action: "input->landing-page-builder#schedule change->landing-page-builder#schedule input->landing-page-builder#refreshProgress " \
                        "change->landing-page-builder#refreshProgress focusin->landing-page-builder#focusStep focusin->landing-page-builder#selectBlock trix-change->landing-page-builder#schedule " \
                        "trix-file-accept->landing-page-builder#blockFiles"
              }) do |f| %>
  <%= ax_error_summary(@landing_page) %>
  <% block_errors = @landing_page.blocks.flat_map { |block| block.errors.full_messages }.uniq %>
  <% if block_errors.any? %>
    <%= ax_inline_notice(tone: :danger, icon: "exclamation-triangle") { block_errors.to_sentence } %>
  <% end %>

  <%= ax_guided_header(controller: "landing-page-builder", icon: "bi-layout-text-window-reverse",
                       title: (editing ? "Ajuste sua página" : "Vamos criar sua página"),
                       subtitle: "Monte a página com blocos: capa, textos, botões e a seleção de imóveis. O resultado aparece ao lado, do jeito que o visitante vai ver.",
                       progress_label: "Comece pelo título",
                       steps: [["Página", "bi-file-earmark-text"], ["Blocos", "bi-layout-three-columns"], ["Google", "bi-google"]]) %>

  <div class="ax-guided-layout">
    <div class="ax-guided-steps">
      <%= ax_guided_step(number: 1, color: :blue, title: "Página", subtitle: "Título, endereço e se ela está no ar.", collapsible: true, collapsed: !@landing_page.errors.any?) do %>
        <% unless editing %>
          <fieldset class="ax-guided-fieldset">
            <legend>Comece de um modelo</legend>
            <div class="ax-choice-cards lp-templates" role="group" aria-label="Modelo da página">
              <% LandingPages::Templates::ALL.each do |template| %>
                <%= link_to new_admin_landing_page_path(template: template.key), class: "ax-choice-card lp-template#{" is-current" if template.key == @template&.key}", aria: { current: (template.key == @template&.key) } do %>
                  <span class="ax-choice-card__icon"><i class="bi bi-<%= template.icon %>"></i></span>
                  <strong><%= template.label %></strong>
                  <small><%= template.description %></small>
                <% end %>
              <% end %>
            </div>
            <p class="ax-guided-hint">Trocar de modelo recarrega a tela com os blocos do modelo. Escolha antes de editar.</p>
          </fieldset>
        <% end %>
        <%= ax_field_grid do %>
          <div class="ax-span-12">
            <%= ax_text_field(form: f, method: :title, label: "Título da página", placeholder: "Ex.: Imóveis em destaque na cidade", required: true,
                              hint: "Nome interno e título do Google. Em páginas sem capa, também é o H1 da página.",
                              data: { landing_page_builder_target: "title", action: "input->landing-page-builder#titleChanged" }) %>
          </div>
          <div class="ax-span-12">
            <%= ax_field_label(f, :slug, text: "Endereço (URL)") %>
            <%= ax_input_group(prefix: "/") do %>
              <%= f.text_field :slug, class: "ax-control", placeholder: "apartamentos-na-planta", data: { landing_page_builder_target: "slug", action: "input->landing-page-builder#slugChanged" } %>
            <% end %>
            <p class="ax-field__hint">Acompanha o título enquanto você escreve. Depois de salva, a página mantém o endereço (links já publicados não quebram).</p>
          </div>
          <div class="ax-span-12">
            <fieldset class="ax-guided-fieldset">
              <legend>Colunas do conteúdo</legend>
              <%= ax_choice_group(form: f, method: :layout_columns, variant: :chips, selected: @landing_page.layout_columns, aria_label: "Colunas do conteúdo",
                                  choices: [{ value: 1, label: "1 coluna", icon: "bi-square" }, { value: 2, label: "2 colunas", icon: "bi-layout-split" }, { value: 3, label: "3 colunas", icon: "bi-layout-three-columns" }]) %>
              <p class="ax-guided-hint">Com 2 ou 3 colunas, os blocos com largura "1 coluna" ou "2 colunas" ficam lado a lado. Os de "Linha inteira" ocupam a largura toda. No celular tudo vira uma coluna.</p>
            </fieldset>
          </div>
          <div class="ax-span-12">
            <%= ax_text_field(form: f, method: :description, label: "Descrição curta", type: :textarea, rows: 2,
                              hint: "Aparece abaixo do título quando a página não tem capa.") %>
          </div>
        <% end %>
        <fieldset class="ax-guided-fieldset">
          <legend>Status</legend>
          <%= ax_choice_group(form: f, method: :status, variant: :cards, selected: @landing_page.status, aria_label: "Status da página",
                              choices: [
                                { value: "draft", label: "Rascunho", icon: "bi-pencil-square", description: "Em edição. Não abre no site." },
                                { value: "published", label: "Publicada", icon: "bi-broadcast", description: "No ar e indexável pelo Google." },
                                { value: "inactive", label: "Inativa", icon: "bi-slash-circle", description: "Fora do ar. Não abre nem é indexada." }
                              ]) %>
        </fieldset>
      <% end %>

      <%= ax_guided_step(number: 2, color: :violet, title: "Blocos", subtitle: "A página é a pilha de blocos abaixo, de cima para baixo.", collapsible: true, collapsed: !@landing_page.errors.any?) do %>
        <div class="lp-blocks" data-landing-page-builder-target="list" data-action="dragover->landing-page-builder#cardDragOver drop->landing-page-builder#cardDrop">
          <%= f.fields_for :blocks do |bf| %>
            <%= render "admin/landing_pages/block", bf: bf, open: bf.object.errors.any? %>
          <% end %>
        </div>
        <p class="lp-blocks__empty" data-landing-page-builder-target="empty" hidden>Nenhum bloco ainda. Adicione o primeiro abaixo.</p>

        <%# Menu próprio (não é <select>): cada tipo com ícone e descrição. O JS abre, fecha e insere o bloco. %>
        <div class="lp-dropdown" data-landing-page-builder-target="addMenu">
          <button type="button" class="ax-btn ax-btn--primary lp-dropdown__toggle" aria-haspopup="menu" aria-expanded="false" data-action="landing-page-builder#toggleAddMenu">
            <i class="bi bi-plus-lg ax-ico" aria-hidden="true"></i><span>Adicionar bloco</span><i class="bi bi-chevron-down lp-dropdown__caret" aria-hidden="true"></i>
          </button>
          <div class="lp-dropdown__menu" role="menu" hidden data-landing-page-builder-target="addMenuList">
            <% LandingPages::BlockTypes::ALL.each do |definition| %>
              <button type="button" role="menuitem" class="lp-dropdown__item" data-action="landing-page-builder#add" data-block-type="<%= definition.key %>">
                <span class="lp-dropdown__icon"><i class="bi bi-<%= definition.icon %>" aria-hidden="true"></i></span>
                <span><strong><%= definition.label %></strong><small><%= definition.description %></small></span>
              </button>
            <% end %>
          </div>
        </div>

        <%# Moldes dos blocos novos: o JS troca __INDEX__ pelo próximo índice. %>
        <% LandingPages::BlockTypes::ALL.each do |definition| %>
          <template data-landing-page-builder-target="template" data-block-type="<%= definition.key %>">
            <%= f.fields_for :blocks, LandingPageBlock.new(block_type: definition.key, data: definition.defaults, visible: true), child_index: "__INDEX__" do |bf| %>
              <%= render "admin/landing_pages/block", bf: bf, open: false %>
            <% end %>
          </template>
        <% end %>
      <% end %>

      <%= ax_guided_step(number: 3, color: :amber, title: "Como o Google vê", subtitle: "Título e descrição nos resultados de busca. Em branco, valem o título da página e um trecho.", optional: true, collapsible: true, collapsed: true) do %>
        <div data-controller="seo-snippet" data-seo-snippet-host-value="<%= request.host %>" data-action="input->seo-snippet#refresh">
          <%= ax_field_grid do %>
            <div class="ax-span-12">
              <%= ax_text_field(form: f, method: :meta_title, label: "Título SEO (Meta Title)", placeholder: "Título para o Google", label_meta: tag.span(safe_join([tag.span("0", data: { seo_snippet_target: "titleCount" }), "/60"]), class: "seo-editor-counter")) %>
            </div>
            <div class="ax-span-12">
              <%= ax_text_field(form: f, method: :meta_description, label: "Descrição SEO (Meta Description)", type: :textarea, rows: 2, placeholder: "Breve resumo para o Google...", label_meta: tag.span(safe_join([tag.span("0", data: { seo_snippet_target: "descriptionCount" }), "/160"]), class: "seo-editor-counter")) %>
            </div>
            <div class="ax-span-12">
              <div class="lp-serp" aria-label="Prévia nos resultados do Google">
                <span class="lp-serp__url" data-seo-snippet-target="url"></span>
                <strong class="lp-serp__title" data-seo-snippet-target="title"></strong>
                <p class="lp-serp__desc" data-seo-snippet-target="description"></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <aside class="ax-guided-aside" aria-label="Pré-visualização da página">
      <section class="public-form-preview lp-preview">
        <header class="public-form-preview__bar">
          <div class="public-form-preview__quick">
            <div class="public-form-preview__savegroup" role="group" aria-label="Salvar">
              <button type="submit" name="continue" value="1" class="ax-btn ax-btn--primary ax-btn--sm" title="Salva e continua editando">
                <i class="bi bi-check2 ax-ico" aria-hidden="true"></i><span>Salvar</span>
              </button>
              <button type="submit" class="ax-btn ax-btn--primary ax-btn--sm" title="Salva e volta à lista">
                <i class="bi bi-box-arrow-right ax-ico" aria-hidden="true"></i><span>Salvar e sair</span>
              </button>
            </div>
            <span class="public-form-preview__save" data-landing-page-builder-target="saveStatus" role="status" aria-live="polite"></span>
            <span class="public-form-preview__save" data-landing-page-builder-target="status" role="status" aria-live="polite"></span>
          </div>
          <div class="public-form-preview__devices" role="group" aria-label="Dispositivo">
            <button type="button" class="public-form-preview__device" aria-pressed="true" data-device="desktop"
                    data-landing-page-builder-target="device" data-action="landing-page-builder#switchDevice">
              <i class="bi bi-display" aria-hidden="true"></i> Desktop
            </button>
            <button type="button" class="public-form-preview__device" aria-pressed="false" data-device="mobile"
                    data-landing-page-builder-target="device" data-action="landing-page-builder#switchDevice">
              <i class="bi bi-phone" aria-hidden="true"></i> Mobile
            </button>
          </div>
        </header>
        <div class="public-form-preview__stage" data-landing-page-builder-target="stage">
          <iframe class="public-form-preview__frame" title="Pré-visualização da página" sandbox="allow-same-origin"
                  data-landing-page-builder-target="frame"></iframe>

          <%# Ferramentas sobre a prévia: aparecem no bloco em foco (o JS posiciona e mostra só o que vale para o tipo). %>
          <div class="lp-tools" data-landing-page-builder-target="tools" hidden
               data-action="mouseenter->landing-page-builder#keepTools mouseleave->landing-page-builder#toolsLeave click->landing-page-builder#toolClick mousedown->landing-page-builder#toolMouseDown change->landing-page-builder#toolChange">
            <button type="button" class="lp-tools__btn lp-tools__grip" data-tool="grip" title="Arraste para mover o bloco" aria-label="Mover bloco"><i class="bi bi-grip-vertical"></i></button>
            <button type="button" class="lp-tools__btn" data-tool="up" title="Subir" aria-label="Subir bloco"><i class="bi bi-arrow-up"></i></button>
            <button type="button" class="lp-tools__btn" data-tool="down" title="Descer" aria-label="Descer bloco"><i class="bi bi-arrow-down"></i></button>
            <span class="lp-tools__group" data-for="cover button">
              <button type="button" class="lp-tools__btn" data-tool="align" data-value="left" title="Alinhar à esquerda" aria-label="Alinhar à esquerda"><i class="bi bi-text-left"></i></button>
              <button type="button" class="lp-tools__btn" data-tool="align" data-value="center" title="Centralizar" aria-label="Centralizar"><i class="bi bi-text-center"></i></button>
              <button type="button" class="lp-tools__btn" data-tool="align" data-value="right" title="Alinhar à direita" aria-label="Alinhar à direita"><i class="bi bi-text-right"></i></button>
            </span>
            <span class="lp-tools__group" data-for="cover image">
              <button type="button" class="lp-tools__btn" data-tool="image" title="Escolher imagem de fundo" aria-label="Imagem de fundo"><i class="bi bi-image"></i></button>
              <select class="lp-tools__select" data-tool="overlay" data-only-for="cover" aria-label="Escurecer a imagem" title="Escurecer a imagem">
                <option value="0">Sem escurecer</option><option value="25">Leve</option><option value="45">Médio</option><option value="65">Forte</option>
              </select>
            </span>
            <span class="lp-tools__group" data-for="text">
              <button type="button" class="lp-tools__btn" data-tool="width" title="Alternar largura (estreita/larga)" aria-label="Largura"><i class="bi bi-arrows-expand-vertical"></i></button>
            </span>
            <select class="lp-tools__select" data-tool="span" aria-label="Largura na linha" title="Largura na linha (páginas de 2 ou 3 colunas)">
              <option value="full">Linha inteira</option><option value="1">1 coluna</option><option value="2">2 colunas</option>
            </select>
            <button type="button" class="lp-tools__btn" data-tool="edit" title="Todos os campos no editor" aria-label="Abrir no editor"><i class="bi bi-pencil-square"></i></button>
            <button type="button" class="lp-tools__btn" data-tool="hide" title="Ocultar (reative pelo olho no cartão)" aria-label="Ocultar bloco"><i class="bi bi-eye-slash"></i></button>
            <button type="button" class="lp-tools__btn" data-tool="duplicate" data-not-for="property_showcase" title="Duplicar" aria-label="Duplicar bloco"><i class="bi bi-copy"></i></button>
            <button type="button" class="lp-tools__btn lp-tools__btn--danger" data-tool="remove" title="Remover" aria-label="Remover bloco"><i class="bi bi-trash"></i></button>
          </div>

          <div class="lp-richbar" data-landing-page-builder-target="richbar" hidden data-action="mousedown->landing-page-builder#richMouseDown click->landing-page-builder#richClick">
            <button type="button" data-cmd="bold" title="Negrito" aria-label="Negrito"><i class="bi bi-type-bold"></i></button>
            <button type="button" data-cmd="italic" title="Itálico" aria-label="Itálico"><i class="bi bi-type-italic"></i></button>
            <button type="button" data-cmd="insertUnorderedList" title="Lista" aria-label="Lista"><i class="bi bi-list-ul"></i></button>
            <button type="button" data-cmd="link" title="Link" aria-label="Link"><i class="bi bi-link-45deg"></i></button>
            <button type="button" data-cmd="removeFormat" title="Limpar formatação" aria-label="Limpar formatação"><i class="bi bi-eraser"></i></button>
          </div>

          <div class="lp-menu" data-landing-page-builder-target="menu" hidden data-action="click->landing-page-builder#menuClick">
            <strong>Adicionar bloco aqui</strong>
            <% LandingPages::BlockTypes::ALL.each do |definition| %>
              <button type="button" data-block-type="<%= definition.key %>"><i class="bi bi-<%= definition.icon %>"></i><%= definition.label %></button>
            <% end %>
          </div>

          <div class="lp-dropline" data-landing-page-builder-target="dropline" hidden></div>
          <div class="lp-dragshield" data-landing-page-builder-target="shield" hidden></div>
        </div>
      </section>
      <p class="ax-guided-aside__hint">Clique no texto para editar ali mesmo, arraste pelo ⠿ para mover e use o + entre os blocos para adicionar. Links ficam desativados aqui.</p>
    </aside>
  </div>
<% end %>
