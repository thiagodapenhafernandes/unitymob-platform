<%# Filtros que definem quais imóveis a vitrine mostra (os mesmos de Habitation.advanced_search).
    locals: df (fields_for ...[data]), filters (Hash). Um conjunto de campos por bloco. %>
<%
  flag_groups = [
    { title: "Localização e sol", icon: "water", tone: "teal", flags: [%w[frente_mar Frente\ Mar], %w[quadra_mar Quadra\ Mar], %w[vista_mar Vista\ Mar], %w[sol_manha Sol\ da\ manhã], %w[sol_tarde Sol\ da\ tarde], %w[sol_dia_todo Sol\ o\ dia\ todo]] },
    { title: "Lazer e estrutura", icon: "building-check", tone: "violet", flags: [%w[piscina Piscina], %w[churrasqueira Churrasqueira], ["cozinha_gourmet_churrasqueira", "Cozinha gourmet com churrasqueira"], ["dependencia_empregada", "Dependência de empregada"], %w[sacada Sacada]] },
    { title: "Acabamento", icon: "brush", tone: "pink", flags: [%w[mobiliado Mobiliado], %w[decorado Decorado], ["garden_flag", "Garden"]] },
    { title: "Negócio e destaque", icon: "stars", tone: "amber", flags: [["lancamento_flag", "Lançamento"], ["aceita_permuta_flag", "Aceita Permuta"], ["aceita_financiamento_flag", "Aceita Financiamento"], ["festival_flag", "Oportunidade especial"], ["opportunity", "Oportunidade (Preço Reduzido)"], ["exibir_no_site_portal_flag", "Exibir no site"]] }
  ]
  filters = filters.to_h.stringify_keys
  selected_flags = Array(filters["characteristics"])
  unique = df.object_name.gsub(/[^a-zA-Z0-9_]/, "_")
%>
<%= df.fields_for :filters, OpenStruct.new(filters) do |fp| %>
<div class="lp-filters">
  <p class="lp-filters__title"><i class="bi bi-funnel" aria-hidden="true"></i> Quais imóveis aparecem</p>
  <%= ax_chip_section(title: "Onde", icon: "geo-alt", tone: "teal") do %>
    <%= ax_field_grid do %>
      <div class="ax-span-6"><%= ax_autocomplete_select_field(form: fp, method: :city, label: "Cidade(s)", choices: (@property_cities + Array(filters["city"])).uniq.sort, multiple: true, placeholder: "Selecione cidades", select_options: { selected: Array(filters["city"]) }) %></div>
      <div class="ax-span-6"><%= ax_autocomplete_select_field(form: fp, method: :neighborhood, label: "Bairro(s)", choices: (@property_neighborhoods + Array(filters["neighborhood"])).uniq.sort, multiple: true, placeholder: "Selecione bairros", select_options: { selected: Array(filters["neighborhood"]) }) %></div>
      <div class="ax-span-12">
        <%= ax_autocomplete_select_field(form: fp, method: :development, label: "Empreendimento(s)", choices: Array(filters["development"]).map { |name| [name, name] }, multiple: true,
                                         placeholder: "Digite o nome do empreendimento", url: filter_options_admin_landing_pages_path(type: "developments"), min_length: 2,
                                         select_options: { selected: Array(filters["development"]) }) %>
      </div>
    <% end %>
  <% end %>

  <%= ax_chip_section(title: "O quê", icon: "search", tone: "blue") do %>
    <%= ax_field_grid do %>
      <div class="ax-span-12"><%= ax_text_field(form: fp, method: :q, label: "Texto livre", placeholder: "Digite código, bairro, título ou característica") %></div>
      <div class="ax-span-12">
        <%= ax_autocomplete_select_field(form: fp, method: :property_codes, label: "Códigos dos imóveis", choices: property_code_options_for(Array(filters["property_codes"]), exact: true), multiple: true,
                                         placeholder: "Digite o código ou título do imóvel", url: filter_options_admin_landing_pages_path(type: "property_codes"), min_length: 2,
                                         select_options: { selected: Array(filters["property_codes"]) }) %>
      </div>
      <div class="ax-span-6"><%= ax_autocomplete_select_field(form: fp, method: :category, label: "Categoria(s)", choices: (@property_categories + Array(filters["category"])).uniq.sort, multiple: true, placeholder: "Selecione categorias", select_options: { selected: Array(filters["category"]) }) %></div>
      <div class="ax-span-6"><%= ax_select_field(form: fp, method: :transaction_type, label: "Transação", choices: [["Venda", "venda"], ["Aluguel", "aluguel"]], select_options: { include_blank: "Todas" }) %></div>
    <% end %>
  <% end %>

  <%= ax_chip_section(title: "Perfil", icon: "sliders", tone: "violet") do %>
    <%= ax_field_grid do %>
      <div class="ax-span-6"><%= ax_number_field(form: fp, method: :target_price, label: "Preço sugerido (±20%)", placeholder: "Ex: 1500000", min: 0) %></div>
      <div class="ax-span-6"><%= ax_text_field(form: fp, method: :caracteristica_unica, label: "Característica única (tag)", placeholder: "Ex: Oportunidade exclusiva") %></div>
      <div class="ax-span-3"><%= ax_measure_field(form: fp, method: :min_area, label: "Área mínima", unit: "m²", min: 0) %></div>
      <div class="ax-span-3"><%= ax_number_field(form: fp, method: :min_bedrooms, label: "Mín. dormitórios", min: 0) %></div>
      <div class="ax-span-3"><%= ax_number_field(form: fp, method: :min_suites, label: "Mín. suítes", min: 0) %></div>
      <div class="ax-span-3"><%= ax_number_field(form: fp, method: :min_parking, label: "Mín. vagas", min: 0) %></div>
    <% end %>
  <% end %>

  <p class="lp-filters__title"><i class="bi bi-stars" aria-hidden="true"></i> Características e flags <em>opcional</em></p>
  <div class="lp-flags">
    <% flag_groups.each do |group| %>
      <%= ax_chip_section(title: group[:title], icon: group[:icon], tone: group[:tone], count: "#{group[:flags].count { |value, _| selected_flags.include?(value) }}/#{group[:flags].size}") do %>
        <%= ax_chip_grid(class_name: "ax-chip-grid--calm ax-chip-grid--rows") do %>
          <% group[:flags].each do |value, label| %>
            <%= ax_toggle_chip(nil, nil, label: label, name: "#{fp.object_name}[characteristics][]", checked_value: value, unchecked_value: "", include_hidden: false,
                               checked: selected_flags.include?(value), id: "#{unique}_char_#{value}") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
<% end %>
