<%
  can_launch_signup = @diagnostics.all? { |item| item[:ok] || item[:fallback].present? }
  active_tab = params[:tab].presence || "whatsapp"
  connected = @whatsapp_integration.connected?
  effective_connected = connected || @whatsapp_effective_ready
%>

<% content_for :admin_contextbar_breadcrumb do %>
  <%= link_to "Admin", admin_root_path %>
  <i class="bi bi-chevron-right"></i>
  <span>Integrações</span>
  <i class="bi bi-chevron-right"></i>
  <strong>WhatsApp</strong>
<% end %>

<% content_for :admin_contextbar_actions do %>
  <%= link_to admin_whatsapp_conversations_path, class: "ax-contextbar__button" do %>
    <i class="bi bi-chat-dots"></i><span>Atendimento</span>
  <% end %>
  <% if @whatsapp_integration.persisted? && connected %>
    <%= button_to disconnect_admin_whatsapp_integration_path, method: :delete,
                  class: "ax-contextbar__button ax-contextbar__button--danger",
                  data: { turbo_confirm: "Remover a conexão atual do WhatsApp?" } do %>
      <i class="bi bi-box-arrow-right"></i><span>Desconectar</span>
    <% end %>
  <% end %>
<% end %>

<div class="wa-workspace"
     data-controller="whatsapp-integration"
     data-whatsapp-integration-app-id-value="<%= ENV.fetch('FACEBOOK_APP_ID', '') %>"
     data-whatsapp-integration-api-version-value="<%= ENV['WHATSAPP_EMBEDDED_SIGNUP_API_VERSIONS'].presence || ENV['WHATSAPP_GRAPH_API_VERSION'].presence || ENV['META_API_VERSION'].presence || 'v24.0' %>"
     data-whatsapp-integration-config-id-value="<%= @embedded_signup_config_id %>"
     data-whatsapp-integration-callback-url-value="<%= embedded_signup_callback_admin_whatsapp_integration_path %>"
     data-whatsapp-integration-test-url-value="<%= test_connection_admin_whatsapp_integration_path %>"
     data-whatsapp-integration-send-url-value="<%= send_test_admin_whatsapp_integration_path %>">
  <% connection_status = if @whatsapp_using_global
       ax_badge("Usando conexão global", tone: :blue, dot: true)
     elsif connected
       ax_badge("Conectado", tone: :green, dot: true)
     else
       ax_badge("Aguardando conexão", tone: :gray)
     end %>
  <%= ax_workspace_heading(
        eyebrow: "Integração",
        icon: "whatsapp",
        title: "Integração WhatsApp",
        subtitle: "Conecte o WhatsApp Business pela Meta e configure os telefones usados nos formulários do site.",
        actions: connection_status,
        class_name: "wa-command"
      ) %>

  <nav class="wa-tabs" aria-label="Seções da integração">
    <%= link_to admin_whatsapp_integration_path(tab: "whatsapp"),
                class: "wa-tabs__item #{'is-active' if active_tab == 'whatsapp'}",
                aria: ({ current: "page" } if active_tab == "whatsapp") do %>
      <i class="bi bi-whatsapp" aria-hidden="true"></i><span>WhatsApp Business API</span>
    <% end %>
    <%= link_to admin_whatsapp_integration_path(tab: "site_phones"),
                class: "wa-tabs__item #{'is-active' if active_tab == 'site_phones'}",
                aria: ({ current: "page" } if active_tab == "site_phones") do %>
      <i class="bi bi-telephone-outbound" aria-hidden="true"></i><span>Telefones do Site</span>
    <% end %>
  </nav>

  <% if active_tab == "site_phones" %>
    <div class="wa-grid">
      <div class="wa-main">
        <%= ax_operational_panel(
              eyebrow: "Formulários do site",
              title: "Telefones dos formulários do site"
            ) do %>
          <div class="wa-panel-body">
            <p class="wa-hint">Defina o número de destino e se o visitante passa pelo formulário intermediário antes do WhatsApp.</p>

            <% if @phone_settings_errors.present? %>
              <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                <strong>Revise os campos:</strong> <%= @phone_settings_errors.to_sentence %>
              <% end %>
            <% end %>

            <%= form_with model: @whatsapp_integration, url: phone_settings_admin_whatsapp_integration_path, method: :patch, html: { class: "habitation-form-ui wa-form" } do |f| %>
              <div class="wa-field">
                <%= ax_field_label(f, :default_whatsapp_number, text: "Número padrão",
                      tooltip: "Usado quando o tipo de negociação não tiver número específico.") %>
                <%= ax_input_group(prefix: tag.i(class: "bi bi-whatsapp ax-input-group__icon--whatsapp")) do %>
                  <%= f.telephone_field :default_whatsapp_number,
                        class: "ax-control",
                        placeholder: "(47) 99999-9999",
                        value: @whatsapp_integration.default_whatsapp_number.presence || @site_phone_settings[:default_phone],
                        data: { controller: "phone-input" } %>
                <% end %>
              </div>

              <div class="wa-negotiations">
                <% WhatsappBusinessIntegration::NEGOTIATION_TYPES.each do |key, config| %>
                  <section class="wa-negotiation">
                    <header class="wa-negotiation__head">
                      <span class="wa-negotiation__icon"><i class="bi bi-whatsapp"></i></span>
                      <div>
                        <strong><%= config[:label] %></strong>
                        <span><%= config[:default_message] %></span>
                      </div>
                    </header>
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: config[:phone_attribute], label: "WhatsApp de destino",
                            type: :tel, placeholder: "Usar número padrão", data: { controller: "phone-input" }) %>
                    </div>
                    <%= ax_toggle_chip(f, config[:form_attribute],
                          label: "Captar dados antes de redirecionar",
                          checked_value: "1", unchecked_value: "0",
                          class_name: "wa-negotiation__toggle") %>
                  </section>
                <% end %>
              </div>

              <div class="wa-field wa-field--divider">
                <%= ax_field_label(text: "Cartão de apresentação do corretor",
                      tooltip: "Vale para toda a equipe. Desligado, os cartões saem sempre como texto (sem a foto do corretor). O telefone pessoal do corretor nunca é enviado.") %>
                <%= ax_switch_field(form: f, method: :allow_photo_presentation,
                      label: "Permitir cartão com foto do corretor",
                      checked: @whatsapp_integration.allow_photo_presentation?) %>
              </div>

              <div class="ax-form-actions">
                <%= f.submit "Salvar telefones do site", class: "ax-btn ax-btn--primary" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <aside class="wa-aside">
        <%= ax_operational_panel(eyebrow: "Resumo", title: "Como o site usa") do %>
          <div class="wa-panel-body">
            <dl class="wa-state">
              <% @site_phone_settings[:negotiations].each do |key, item| %>
                <div class="wa-state__row">
                  <dt>
                    <strong><%= item[:label] %></strong>
                    <span><%= item[:requires_form] ? "Com formulário intermediário" : "Direto para o WhatsApp" %></span>
                  </dt>
                  <dd><code><%= item[:phone].presence || @site_phone_settings[:default_phone] %></code></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>

        <%= ax_operational_panel(eyebrow: "Regra", title: "Regra padrão") do %>
          <div class="wa-panel-body">
            <p class="wa-hint">Se um número específico ficar em branco, o site usa o número padrão. Locação diária entra na regra de locação.</p>
          </div>
        <% end %>
      </aside>
    </div>
  <% else %>
    <div class="wa-grid">
      <div class="wa-main">
        <% if @whatsapp_using_global %>
          <%= ax_inline_notice(tone: :info, icon: "globe2") do %>
            <strong>Esta conta está usando o WhatsApp global do sistema.</strong>
            As notificações de distribuição saem pela conexão global enquanto esta conta não tiver uma conexão própria pronta.
          <% end %>
        <% end %>

        <%= ax_operational_panel(
              eyebrow: "WhatsApp Business API",
              title: "Conexão WhatsApp",
              actions: ax_badge(@whatsapp_using_global ? "Global ativo" : (connected ? "Conectado" : "Aguardando conexão"), tone: @whatsapp_using_global ? :blue : (connected ? :green : :gray), dot: connected || @whatsapp_using_global)
            ) do %>
          <div class="wa-panel-body">
            <% if connected %>
              <article class="wa-summary-row">
                <div class="wa-summary-row__icon"><i class="bi bi-whatsapp"></i></div>
                <div class="wa-summary-row__main">
                  <strong>API conectada</strong>
                  <span><%= @phone_info.to_h[:name].presence || @whatsapp_integration.connected_by_admin_user&.name || "Conta WhatsApp" %></span>
                  <small><%= @phone_info.to_h[:number].presence || "Phone Number ID #{@whatsapp_integration.phone_number_id}" %></small>
                </div>
                <div class="wa-summary-row__meta">
                  <%= ax_badge(@phone_info.to_h[:quality].presence || "Qualidade pendente", tone: ({ "GREEN" => :green, "YELLOW" => :amber, "RED" => :red }[@phone_info.to_h[:quality].to_s] || :gray)) %>
                  <span><%= @whatsapp_integration.connected_at ? l(@whatsapp_integration.connected_at, format: :short) : "Conectado" %></span>
                </div>
              </article>
            <% else %>
              <%= ax_inline_notice(tone: :info, icon: "whatsapp", compact: true) do %>
                Conecte a conta pela Meta ou preencha manualmente o número das notificações abaixo.
              <% end %>
            <% end %>

            <details class="wa-advanced-details" <%= "open" if @webhook_settings_errors.present? %>>
              <summary class="wa-advanced-details__summary">
                <span>Detalhes técnicos e webhook</span>
                <i class="bi bi-chevron-down"></i>
              </summary>

              <% if connected %>
                <div class="wa-connected">
                  <% [
                       ["WABA ID", @whatsapp_integration.waba_id],
                       ["Phone Number ID", @whatsapp_integration.phone_number_id],
                       ["Business ID", @whatsapp_integration.business_id.presence || "Não informado"],
                       ["Token", @whatsapp_integration.token_preview || "Salvo"],
                       ["Conectado por", @whatsapp_integration.connected_by_admin_user&.name || "Sistema"],
                       ["Data", (@whatsapp_integration.connected_at ? l(@whatsapp_integration.connected_at, format: :short) : "—")]
                     ].each do |label, value| %>
                    <div class="wa-connected__cell">
                      <span><%= label %></span>
                      <strong><%= value %></strong>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <%# Webhook de mensagens (inbox) — agora editável %>
              <section class="wa-webhook">
                <header class="wa-webhook__head">
                  <div>
                    <span class="ax-operational-panel__eyebrow">Inbox</span>
                    <h3>Webhook de mensagens</h3>
                  </div>
                  <%= link_to "Abrir Atendimento", admin_whatsapp_conversations_path, class: "ax-btn ax-btn--sm" %>
                </header>
                <p class="wa-hint">Configure no painel da Meta (WhatsApp › Configuration › Webhook) para receber mensagens e retornos de aprovação. Campos a assinar: <code>messages</code> e <code>message_template_status_update</code>.</p>

                <% if @webhook_settings_errors.present? %>
                  <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                    <strong>Revise os campos:</strong> <%= @webhook_settings_errors.to_sentence %>
                  <% end %>
                <% end %>

                <%= form_with model: @whatsapp_integration, url: admin_whatsapp_integration_path, method: :patch, html: { class: "habitation-form-ui wa-form" } do |f| %>
                  <div class="wa-webhook__grid">
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: :webhook_callback_url, label: "Callback URL", type: :url,
                            tooltip: "Em produção, use o domínio público (HTTPS). Em branco, usa o padrão: #{@default_webhook_callback_url}",
                            value: @webhook_callback_url, placeholder: @default_webhook_callback_url) %>
                    </div>
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: :webhook_verify_token, label: "Verify Token",
                            tooltip: "Cole este valor no painel da Meta ao assinar o webhook.", value: @webhook_verify_token) %>
                    </div>
                  </div>
                  <div class="wa-webhook__actions">
                    <%= f.submit "Salvar webhook", class: "ax-btn ax-btn--primary ax-btn--sm" %>
                  </div>
                <% end %>

                <% if @global_webhook_callback_url.present? && @global_webhook_verify_token.present? %>
                  <%= ax_inline_notice(tone: :info, icon: "globe2", compact: true) do %>
                    <strong>Webhook global Unitymob:</strong>
                    para usar o app Meta central, configure a Callback URL
                    <code><%= @global_webhook_callback_url %></code>
                    e o Verify Token
                    <code><%= @global_webhook_verify_token %></code>.
                  <% end %>
                <% end %>
              </section>
            </details>

            <% if !connected && @whatsapp_integration.last_error_message.present? %>
              <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                <strong>Último retorno da Meta:</strong>
                <%= @whatsapp_integration.last_error_message %>
                <% if @whatsapp_integration.last_error_code.present? %>
                  <span class="wa-hint">(<%= @whatsapp_integration.last_error_code %>)</span>
                <% end %>
              <% end %>
            <% end %>

            <div id="whatsapp-signup-feedback" class="ax-inline-notice" hidden role="alert" data-whatsapp-integration-target="signupFeedback"></div>

            <div class="wa-connect">
              <button type="button"
                      id="whatsapp-embedded-signup-button"
                      class="ax-btn ax-btn--primary wa-connect__button"
                      data-whatsapp-integration-target="signupButton"
                      data-action="whatsapp-integration#launchSignup"
                      <%= "disabled" unless can_launch_signup %>>
                <i class="bi bi-whatsapp"></i> <%= connected ? "Reconectar WhatsApp pela Meta" : "Conectar WhatsApp pela Meta" %>
              </button>
              <% unless can_launch_signup %>
                <span class="wa-hint">Revise os itens de configuração antes de conectar.</span>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Conexão manual (System User / Cloud API) — número fixo das notificações do sistema %>
        <%= ax_operational_panel(
              eyebrow: "Notificações do sistema",
              title: "Número fixo para notificações automáticas",
              actions: ax_badge(@whatsapp_using_global ? "Usando global" : (@whatsapp_integration.messaging_ready? ? "Pronto p/ envio" : "Não configurado"), tone: @whatsapp_using_global ? :blue : (@whatsapp_integration.messaging_ready? ? :green : :gray))
            ) do %>
          <div class="wa-panel-body">
            <section class="wa-context-block wa-context-block--primary">
              <div class="wa-context-block__head">
                <div>
                  <span>Envio automático</span>
                  <strong>Número das notificações do sistema</strong>
                  <p>Usado para distribuição de leads e avisos internos. Este número é único para as notificações automáticas da conta.</p>
                </div>
              </div>

              <% if @phone_info %>
                <% quality_tone = { "GREEN" => :green, "YELLOW" => :amber, "RED" => :red }[@phone_info[:quality].to_s] || :gray %>
                <div class="wa-phone-info">
                  <div class="wa-phone-info__cell">
                    <span>Número</span>
                    <strong><%= @phone_info[:number].presence || "—" %></strong>
                  </div>
                  <div class="wa-phone-info__cell">
                    <span>Nome verificado</span>
                    <strong><%= @phone_info[:name].presence || "—" %></strong>
                  </div>
                  <div class="wa-phone-info__cell">
                    <span>Quality rating</span>
                    <%= ax_badge(@phone_info[:quality].presence || "—", tone: quality_tone, dot: quality_tone != :gray) %>
                  </div>
                </div>
              <% end %>

              <% if @manual_connection_errors.present? %>
                <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                  <strong>Revise os campos:</strong> <%= @manual_connection_errors.to_sentence %>
                <% end %>
              <% end %>

              <details class="wa-advanced-details" <%= "open" if @manual_connection_errors.present? %>>
                <summary class="wa-advanced-details__summary">
                  <span>Configuração avançada do número</span>
                  <i class="bi bi-chevron-down"></i>
                </summary>

                <%= form_with model: @whatsapp_integration, url: manual_connection_admin_whatsapp_integration_path, method: :patch, html: { class: "habitation-form-ui wa-form" } do |f| %>
                  <div class="wa-field">
                    <%= ax_text_field(form: f, method: :access_token, label: "Access Token (System User / permanente)", type: :password,
                          tooltip: "Token usado pelas notificações do sistema e como credencial base para testar/enviar pelos números cadastrados abaixo. Salvo no backend, nunca exibido completo.",
                          value: "",
                          autocomplete: "off",
                          placeholder: @whatsapp_integration.access_token.present? ? "Token salvo (#{@whatsapp_integration.token_preview}) — preencha para substituir" : "Cole o token da Cloud API") %>
                  </div>

                  <div class="wa-webhook__grid">
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: :phone_number_id, label: "Phone Number ID das notificações",
                            value: @whatsapp_integration.phone_number_id, placeholder: "Ex.: 649374078254590") %>
                    </div>
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: :waba_id, label: "WABA das notificações",
                            value: @whatsapp_integration.waba_id, placeholder: "Ex.: 616242481017427") %>
                    </div>
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: :business_id, label: "Business ID (opcional)", value: @whatsapp_integration.business_id) %>
                    </div>
                    <div class="wa-field">
                      <%= ax_text_field(form: f, method: :app_secret, label: "App Secret (opcional, p/ webhook)", type: :password,
                            tooltip: "Valida a assinatura do webhook. Deixe em branco para manter o atual.", value: "", autocomplete: "off",
                            placeholder: @whatsapp_integration.app_secret.present? ? "Salvo — preencha para substituir" : "Opcional") %>
                    </div>
                  </div>

                  <div class="wa-webhook__actions">
                    <%= f.submit "Salvar número das notificações", class: "ax-btn ax-btn--primary ax-btn--sm" %>
                  </div>
                <% end %>
              </details>

              <% if @whatsapp_integration.messaging_ready? && @whatsapp_integration.phone_number_id.present? %>
                <% phone_registered = @phone_info.to_h[:code_verification_status].to_s == "VERIFIED" %>
                <div class="wa-register-phone <%= 'wa-register-phone--ready' if phone_registered %>">
                  <div>
                    <strong><%= phone_registered ? "Número registrado na Meta" : "Registro do número na Meta" %></strong>
                    <% if phone_registered %>
                      <p>Registro confirmado pela Cloud API. PIN 2FA definido e guardado fora do sistema; não exibimos segredo operacional nesta tela.</p>
                    <% else %>
                      <p>Use quando a Meta mostrar o telefone como pendente. Informe o PIN de 6 dígitos da verificação em duas etapas do número.</p>
                    <% end %>
                  </div>

                  <% if phone_registered %>
                    <%= ax_badge("Registrado", tone: :green, dot: true) %>
                  <% else %>
                    <%= form_with url: register_phone_number_admin_whatsapp_integration_path,
                                  method: :post,
                                  local: true,
                                  class: "wa-register-phone__form" do %>
                      <%= password_field_tag :pin,
                            nil,
                            class: "ax-control",
                            inputmode: "numeric",
                            pattern: "\\d{6}",
                            maxlength: 6,
                            autocomplete: "one-time-code",
                            placeholder: "PIN 2FA",
                            aria: { label: "PIN de seis dígitos do WhatsApp" } %>
                      <%= button_tag type: :submit,
                            class: "ax-btn ax-btn--sm ax-btn--primary",
                            data: { turbo_confirm: "Registrar este Phone Number ID na Meta usando o PIN informado?" } do %>
                        <i class="bi bi-check2-circle"></i> Registrar número
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>

              <div class="wa-test">
                <div class="wa-test__bar">
                  <button type="button" class="ax-btn ax-btn--sm" data-action="whatsapp-integration#testConnection">
                    <i class="bi bi-plug"></i> Testar conexão
                  </button>
                  <div class="wa-test__send">
                    <input type="tel"
                           class="ax-control"
                           autocomplete="tel"
                           data-controller="phone-input"
                           data-whatsapp-integration-target="testTo"
                           placeholder="Número p/ teste"
                           aria-label="Número para teste">
                    <button type="button" class="ax-btn ax-btn--sm ax-btn--primary" data-action="whatsapp-integration#sendTest">
                      <i class="bi bi-send"></i> Enviar teste
                    </button>
                  </div>
                </div>
                <div data-whatsapp-integration-target="testResult" class="ax-inline-notice" hidden role="status"></div>
              </div>
            </section>

            <% activation_template = @lead_activation_template %>
            <% activation_editable = Whatsapp::LeadActivationTemplate.editable?(activation_template) %>
            <% activation_status = activation_template.status.to_s.presence || "DRAFT" %>
            <% activation_status_tone = { "APPROVED" => :green, "PENDING" => :amber, "REJECTED" => :red, "PAUSED" => :amber, "DRAFT" => :gray }.fetch(activation_status.upcase, :gray) %>
            <% activation_status_label = { "APPROVED" => "Aprovado", "PENDING" => "Pendente", "REJECTED" => "Reprovado", "PAUSED" => "Pausado", "DRAFT" => "Enviar" }.fetch(activation_status.upcase, activation_status) %>
            <% activation_preview_values = ["Nome do corretor", "Nome da imobiliária"] %>

            <section id="lead-activation-template" class="wa-context-block">
              <div class="wa-context-block__head">
                <div>
                  <span>Apresentação do corretor</span>
                  <strong>Template oficial para primeiro contato</strong>
                  <p>Template oficial usado no menu Apresentação do lead para iniciar conversa.</p>
                </div>
              </div>

              <% if @lead_activation_template_errors.present? %>
                <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                  <strong>Revise o template:</strong> <%= @lead_activation_template_errors.to_sentence %>
                <% end %>
              <% end %>

              <article class="wa-number-row wa-template-submit-row">
                <div class="wa-number-row__main">
                  <strong>Enviar template para aprovação da Meta</strong>
                  <span><%= Whatsapp::LeadActivationTemplate::TEMPLATE_NAME %> · Portuguese (BR)</span>
                  <small>Mensagem oficial com foto do corretor e variáveis {{1}} nome do corretor, {{2}} nome da imobiliária.</small>
                </div>
                <div class="wa-number-row__badges">
                  <%= ax_badge(activation_status_label, tone: activation_status_tone, dot: activation_status.upcase == "APPROVED") %>
                </div>
                <div class="wa-number-row__actions">
                  <% if activation_editable %>
                    <%= button_to submit_lead_activation_template_admin_whatsapp_integration_path,
                                  method: :post,
                                  class: "ax-btn ax-btn--sm ax-btn--primary",
                                  data: { turbo_submits_with: "Enviando..." },
                                  form: { class: "wa-lead-activation__approval", data: { turbo_confirm: "Enviar este template para aprovação da Meta? Depois disso, edite apenas se a Meta rejeitar." } } do %>
                      <i class="bi bi-send ax-ico"></i><span>Enviar</span>
                    <% end %>
                  <% end %>
                </div>
              </article>

              <details class="wa-template-details" <%= "open" if @lead_activation_template_errors.present? %>>
                <summary class="wa-template-details__summary">
                  <span>Editar rascunho, variáveis e prévia</span>
                  <i class="bi bi-chevron-down"></i>
                </summary>

                <% unless activation_editable %>
                  <%= ax_inline_notice(tone: :info, icon: "lock", compact: true) do %>
                    Template enviado para a Meta. Depois de aprovado, ele aparece como apresentação oficial no lead; para mudar o texto, crie um novo ciclo de aprovação.
                  <% end %>
                <% end %>

                <div class="wa-lead-activation">
                  <%= form_with model: activation_template,
                                url: lead_activation_template_admin_whatsapp_integration_path,
                                method: :patch,
                                local: true,
                                html: { class: "habitation-form-ui wa-form wa-lead-activation__form" } do |f| %>
                    <%= f.hidden_field :allow_category_change, value: "1" %>
                    <%= ax_select_field(form: f, method: :category, label: "Categoria Meta",
                          choices: [["Marketing", "MARKETING"], ["Utility", "UTILITY"]],
                          html_options: { disabled: !activation_editable }) %>
                    <div class="wa-field">
                      <%= ax_field_label(f, :body, text: "Texto do template",
                            tooltip: "Use {{1}} para nome do corretor e {{2}} para nome da imobiliária. Alterações estruturais precisam de aprovação da Meta.") %>
                      <%= f.text_area :body,
                            rows: 5,
                            class: "ax-control",
                            disabled: !activation_editable,
                            placeholder: Whatsapp::LeadActivationTemplate::DEFAULT_BODY %>
                    </div>
                    <%= ax_text_field(form: f, method: :footer_text, label: "Rodapé", value: activation_template.footer_text, disabled: !activation_editable) %>
                    <%= ax_file_field(form: f, method: :header_media_file, label: "Imagem de exemplo/padrão",
                          tooltip: "Obrigatória para aprovar template com imagem. No envio real, a foto do corretor logado pode substituir esta imagem.",
                          accept: "image/png,image/jpeg",
                          button_label: "Escolher imagem",
                          class_name: "wa-lead-activation__upload") if activation_editable %>

                    <div class="wa-webhook__actions">
                      <%= f.submit "Salvar rascunho", class: "ax-btn ax-btn--primary ax-btn--sm", disabled: !activation_editable %>
                    </div>
                  <% end %>

                  <aside class="wa-lead-activation__side">
                    <div class="wa-lead-activation__reference">
                      <span>Variáveis do template</span>
                      <div class="wa-variable-map">
                        <div class="wa-variable-map__row">
                          <span>{{1}}<small>Nome do corretor logado</small></span>
                          <strong>Nome do corretor</strong>
                        </div>
                        <div class="wa-variable-map__row">
                          <span>{{2}}<small>Nome da imobiliária</small></span>
                          <strong>Nome da imobiliária</strong>
                        </div>
                      </div>
                    </div>

                    <div class="wa-lead-activation__preview" aria-label="Prévia do WhatsApp">
                      <span>Prévia do primeiro contato</span>
                      <div class="wa-template-phone">
                        <div class="wa-template-bubble">
                          <% if activation_template.header_media_file.attached? %>
                            <%= image_tag activation_template.header_media_file, class: "wa-template-bubble__image", alt: "Imagem do template" %>
                          <% else %>
                            <div class="wa-template-bubble__image wa-template-bubble__image--placeholder">
                              <i class="bi bi-person-bounding-box"></i>
                            </div>
                          <% end %>
                          <p><%= simple_format(activation_template.render_body(activation_preview_values), {}, wrapper_tag: "span") %></p>
                          <% if activation_template.footer_text.present? %>
                            <small><%= activation_template.footer_text %></small>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </aside>
                </div>
              </details>
            </section>

            <% lead_alert_template = @lead_alert_template %>
            <% lead_alert_status = lead_alert_template.status.to_s.presence || "DRAFT" %>
            <% lead_alert_status_tone = { "APPROVED" => :green, "PENDING" => :amber, "REJECTED" => :red, "PAUSED" => :amber, "DRAFT" => :gray }.fetch(lead_alert_status.upcase, :gray) %>
            <% lead_alert_status_label = { "APPROVED" => "Aprovado", "PENDING" => "Pendente", "REJECTED" => "Reprovado", "PAUSED" => "Pausado", "DRAFT" => "Enviar" }.fetch(lead_alert_status.upcase, lead_alert_status) %>

            <% notification_template_actions = capture do %>
              <div class="wa-context-actions">
                <%= button_to sync_notification_templates_admin_whatsapp_integration_path,
                              method: :post,
                              class: "ax-btn ax-btn--sm",
                              form: { data: { turbo_confirm: "Sincronizar templates da WABA do número fixo das notificações?" } } do %>
                  <i class="bi bi-arrow-repeat ax-ico"></i><span>Sincronizar templates</span>
                <% end %>
                <%= ax_button("Adicionar finalidade", nil, variant: :success, size: :sm, icon: "plus-circle", data: { ax_modal_open: "#notificationTemplateSettingModal" }) %>
              </div>
            <% end %>

            <section class="wa-context-block">
              <div class="wa-context-block__head">
                <div>
                  <span>Templates do sistema</span>
                  <strong>Templates usados nas notificações automáticas</strong>
                  <p>Cada finalidade aponta para um template aprovado da WABA do número das notificações.</p>
                </div>
                <%= notification_template_actions %>
              </div>

              <% if @lead_alert_template_errors.present? %>
                <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                  <strong>Revise o template lead_alert:</strong> <%= @lead_alert_template_errors.to_sentence %>
                <% end %>
              <% end %>

              <article id="lead-alert-template" class="wa-number-row wa-template-submit-row">
                <div class="wa-number-row__main">
                  <strong>Enviar template para aprovação da Meta</strong>
                  <span><%= Whatsapp::LeadAlertTemplate::TEMPLATE_NAME %> · Utility · Portuguese (BR)</span>
                  <small>Confirmação automática enviada ao corretor quando entra um novo lead.</small>
                </div>
                <div class="wa-number-row__badges">
                  <%= ax_badge(lead_alert_status_label, tone: lead_alert_status_tone, dot: lead_alert_status.upcase == "APPROVED") %>
                </div>
                <div class="wa-number-row__actions">
                  <% if Whatsapp::LeadAlertTemplate.editable?(lead_alert_template) %>
                    <%= button_to submit_lead_alert_template_admin_whatsapp_integration_path,
                                  method: :post,
                                  class: "ax-btn ax-btn--sm ax-btn--primary",
                                  data: { turbo_submits_with: "Enviando..." },
                                  form: { data: { turbo_confirm: "Enviar o template lead_alert para análise da Meta?" } } do %>
                      <i class="bi bi-send ax-ico"></i><span>Enviar</span>
                    <% end %>
                  <% end %>
                </div>
              </article>

              <p class="wa-hint">Para distribuição de leads, o mapa padrão usa: cliente, origem, nome, telefone/link, email/link e outros dados.</p>

              <% if @notification_template_options.empty? %>
                <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
                  Nenhum template aprovado sincronizado para esta conta. Sincronize ou cadastre o template na área de Templates antes de ativar a notificação por WhatsApp.
                <% end %>
              <% end %>

              <div class="wa-number-list">
                <% @notification_template_settings.each do |setting| %>
                  <article class="wa-number-row">
                    <div class="wa-number-row__main">
                      <strong><%= setting.purpose_label %></strong>
                      <span><%= setting.whatsapp_template&.name || "Template não definido" %></span>
                      <small><%= setting.purpose_description %></small>
                    </div>
                    <div class="wa-number-row__badges">
                      <%= ax_badge(setting.active? ? "Ativo" : "Inativo", tone: setting.active? ? :green : :gray, dot: setting.active?) %>
                    </div>
                    <div class="wa-number-row__actions">
                      <%= ax_button("Editar", nil, size: :sm, icon: "pencil", data: { ax_modal_open: "#notificationTemplateSettingEditModal#{setting.id}" }) %>
                      <%= button_to admin_notification_template_setting_path(setting),
                                    method: :delete,
                                    class: "ax-btn ax-btn--sm ax-btn--danger",
                                    form: { data: { turbo_confirm: "Remover esta configuração de template?" } } do %>
                        <i class="bi bi-trash ax-ico"></i><span>Remover</span>
                      <% end %>
                    </div>
                  </article>

                  <%= ax_quick_modal(id: "notificationTemplateSettingEditModal#{setting.id}", title: "Editar template da finalidade", size: :sm, class_name: "whatsapp-sender-modal") do %>
                    <%= form_with model: [:admin, setting],
                                  url: admin_notification_template_setting_path(setting),
                                  method: :patch,
                                  local: true,
                                  class: "whatsapp-sender-modal__form" do |f| %>
                      <%= f.hidden_field :channel, value: "whatsapp" %>
                      <%= ax_select_field(form: f, method: :purpose, label: "Finalidade", choices: @notification_template_purpose_options) %>
                      <%= ax_select_field(form: f, method: :whatsapp_template_id, label: "Template aprovado",
                            choices: @notification_template_options, select_options: { include_blank: "Selecione" }) %>
                      <div class="ax-field">
                        <span class="ax-label">Mapa das variáveis</span>
                        <% edit_mapping = setting.variable_mapping.presence || setting.default_variable_mapping %>
                        <% edit_count = [setting.whatsapp_template&.variable_count.to_i, edit_mapping.keys.map(&:to_i).max || 0, 1].max %>
                        <% edit_refs = Array(setting.whatsapp_template&.variable_references).index_by { |item| item[:index].to_i } %>
                        <div class="wa-variable-map">
                          <% (1..edit_count).each do |index| %>
                            <label class="wa-variable-map__row">
                              <span>{{<%= index %>}}<small><%= edit_refs.dig(index, :context) %></small></span>
                              <%= select_tag "notification_template_setting[variable_mapping][#{index}]",
                                    options_for_select(setting.variable_source_options, edit_mapping[index.to_s]),
                                    class: "ax-control" %>
                            </label>
                          <% end %>
                        </div>
                      </div>
                      <label class="wa-number-checkbox">
                        <%= f.check_box :active %>
                        <span>Ativo</span>
                      </label>
                      <div class="whatsapp-sender-modal__actions">
                        <button type="button" class="ax-btn ax-btn--ghost" data-action="ax-modal#close">Cancelar</button>
                        <button type="submit" class="ax-btn ax-btn--primary">
                          <i class="bi bi-check2 ax-ico"></i><span>Salvar</span>
                        </button>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>

                <% if @notification_template_settings.empty? %>
                  <%= ax_empty_state(
                    title: "Nenhuma finalidade configurada",
                    description: "Adicione a finalidade de distribuição para o WhatsApp notificar o corretor com o template correto.",
                    icon: "bell",
                    compact: true
                  ) %>
                <% end %>
              </div>
            </section>

            <%= ax_quick_modal(id: "notificationTemplateSettingModal", title: "Adicionar template de notificação", size: :sm, class_name: "whatsapp-sender-modal") do %>
              <%= form_with model: [:admin, @new_notification_template_setting],
                            url: admin_notification_template_settings_path,
                            local: true,
                            class: "whatsapp-sender-modal__form" do |f| %>
                <%= f.hidden_field :channel, value: "whatsapp" %>
                <%= f.hidden_field :active, value: "1" %>
                <%= ax_select_field(form: f, method: :purpose, label: "Finalidade", choices: @notification_template_purpose_options) %>
                <div class="ax-field">
                  <%= f.label :whatsapp_template_id, "Template aprovado", class: "ax-label" %>
                  <%= f.select :whatsapp_template_id,
                        options_for_select(@notification_template_options),
                        { include_blank: "Selecione" },
                        class: "ax-control",
                        data: {
                          whatsapp_integration_target: "notificationTemplateSelect",
                          action: "change->whatsapp-integration#syncNotificationTemplateVariables"
                        } %>
                </div>
                <div class="ax-field">
                  <span class="ax-label">Mapa padrão das variáveis</span>
                  <div class="wa-variable-map"
                       data-whatsapp-integration-target="notificationVariableMap"
                       data-variable-sources="<%= @notification_template_variable_sources.to_json %>"
                       data-default-mapping="<%= @new_notification_template_setting.default_variable_mapping.to_json %>">
                    <% @new_notification_template_setting.default_variable_mapping.each do |index, source| %>
                      <label class="wa-variable-map__row">
                        <span>{{<%= index %>}}</span>
                        <%= select_tag "notification_template_setting[variable_mapping][#{index}]",
                              options_for_select(@notification_template_variable_sources, source),
                              class: "ax-control" %>
                      </label>
                    <% end %>
                  </div>
                </div>
                <p class="wa-hint">Ao selecionar um template, o sistema monta o mapa pela quantidade de placeholders e tenta inferir cada fonte pelo texto aprovado. Revise antes de salvar.</p>
                <div class="whatsapp-sender-modal__actions">
                  <button type="button" class="ax-btn ax-btn--ghost" data-action="ax-modal#close">Cancelar</button>
                  <button type="submit" class="ax-btn ax-btn--primary">
                    <i class="bi bi-check2 ax-ico"></i><span>Salvar finalidade</span>
                  </button>
                </div>
              <% end %>
            <% end %>

            <% sender_panel_actions = capture do %>
              <% if @whatsapp_integration.messaging_ready? && @whatsapp_integration.phone_number_id.present? && !@current_integration_sender_number&.active? %>
                <%= button_to use_current_number_for_campaigns_admin_whatsapp_integration_path,
                              method: :post,
                              class: "ax-btn ax-btn--sm",
                              form: { data: { turbo_confirm: "Disponibilizar o número já integrado também para campanhas?" } } do %>
                  <i class="bi bi-check2-circle ax-ico"></i><span>Usar número integrado</span>
                <% end %>
              <% end %>
              <%= ax_button("Adicionar número", nil, variant: :success, size: :sm, icon: "plus-circle", data: { ax_modal_open: "#whatsappAccountNumberModal" }) %>
            <% end %>

            <section class="wa-context-block">
              <div class="wa-context-block__head">
                <div>
                  <span>Campanhas</span>
                  <strong>Números disponíveis para campanhas</strong>
                  <p>Estes números aparecem na seleção das campanhas de disparo. Não alteram o número fixo das notificações acima.</p>
                </div>
                <%= sender_panel_actions %>
              </div>

              <div class="wa-number-list">
                <% @whatsapp_sender_numbers.each do |number| %>
                  <article class="wa-number-row">
                    <div class="wa-number-row__main">
                      <strong><%= number.formatted_phone %></strong>
                      <span><%= number.label %></span>
                      <small>Phone Number ID: <%= number.phone_number_id %><%= " · WABA: #{number.waba_id}" if number.waba_id.present? %></small>
                    </div>
                    <div class="wa-number-row__badges">
                      <%= ax_badge(number.messaging_ready? ? "Conectado" : number.status.humanize, tone: number.messaging_ready? ? :green : :amber, dot: true) %>
                    </div>
                    <div class="wa-number-row__actions">
                      <%= ax_button("Editar", nil, size: :sm, icon: "pencil", data: { ax_modal_open: "#whatsappAccountNumberEditModal#{number.id}" }) %>
                      <button type="button"
                              class="ax-btn ax-btn--sm"
                              data-action="whatsapp-integration#testSenderConnection"
                              data-test-url="<%= test_connection_admin_whatsapp_sender_number_path(number) %>">
                        <i class="bi bi-plug ax-ico"></i><span>Testar</span>
                      </button>

                      <%= button_to admin_whatsapp_sender_number_path(number),
                                    method: :delete,
                                    class: "ax-btn ax-btn--sm ax-btn--danger",
                                    form: { data: { turbo_confirm: "Remover este número da conta? O histórico de campanhas será preservado." } } do %>
                        <%= hidden_field_tag :return_to, admin_whatsapp_integration_path %>
                        <i class="bi bi-trash ax-ico"></i><span>Remover</span>
                      <% end %>
                    </div>
                    <div class="wa-number-row__test" data-wa-number-test-result hidden></div>
                  </article>

                  <%= ax_quick_modal(id: "whatsappAccountNumberEditModal#{number.id}", title: "Editar número WhatsApp", size: :sm, class_name: "whatsapp-sender-modal") do %>
                    <%= form_with model: [:admin, number],
                                  url: admin_whatsapp_sender_number_path(number),
                                  method: :patch,
                                  local: true,
                                  class: "whatsapp-sender-modal__form" do |f| %>
                      <%= hidden_field_tag :return_to, admin_whatsapp_integration_path %>
                      <%= ax_text_field(form: f, method: :label, label: "Nome interno") %>
                      <%= ax_text_field(form: f, method: :display_phone_number, label: "Número WhatsApp", type: :tel,
                            data: { controller: "phone-input" }) %>
                      <%= ax_text_field(form: f, method: :phone_number_id, label: "Phone Number ID") %>
                      <%= ax_text_field(form: f, method: :waba_id, label: "WhatsApp Business Account ID (WABA)") %>
                      <div class="whatsapp-sender-modal__actions">
                        <button type="button" class="ax-btn ax-btn--ghost" data-action="ax-modal#close">Cancelar</button>
                        <button type="submit" class="ax-btn ax-btn--primary">
                          <i class="bi bi-check2 ax-ico"></i><span>Salvar alterações</span>
                        </button>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>

                <% if @whatsapp_sender_numbers.empty? %>
                  <%= ax_empty_state(
                    title: "Nenhum número cadastrado",
                    description: "Use o número já integrado ou adicione outro número que poderá ser escolhido nas campanhas de disparo.",
                    icon: "telephone-plus",
                    compact: true
                  ) %>
                <% end %>
              </div>
            </section>

            <%= ax_quick_modal(id: "whatsappAccountNumberModal", title: "Adicionar número WhatsApp", size: :sm, class_name: "whatsapp-sender-modal") do %>
              <%= form_with model: [:admin, @new_whatsapp_sender_number],
                            url: admin_whatsapp_sender_numbers_path,
                            local: true,
                            class: "whatsapp-sender-modal__form" do |f| %>
                <%= hidden_field_tag :return_to, admin_whatsapp_integration_path %>
                <%= ax_text_field(form: f, method: :label, label: "Nome interno", placeholder: "Ex: Campanhas venda") %>
                <%= ax_text_field(form: f, method: :display_phone_number, label: "Número WhatsApp", type: :tel,
                      placeholder: "(47) 2122-8669", data: { controller: "phone-input" }) %>
                <%= ax_text_field(form: f, method: :phone_number_id, label: "Phone Number ID", placeholder: "434291556438028") %>
                <%= ax_text_field(form: f, method: :waba_id, label: "WhatsApp Business Account ID (WABA)", placeholder: "428655400336219") %>
                <p class="wa-hint">O número ficará disponível na seleção da campanha automaticamente.</p>
                <div class="whatsapp-sender-modal__actions">
                  <button type="button" class="ax-btn ax-btn--ghost" data-action="ax-modal#close">Cancelar</button>
                  <button type="submit" class="ax-btn ax-btn--primary">
                    <i class="bi bi-check2 ax-ico"></i><span>Salvar número</span>
                  </button>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <aside class="wa-aside">
        <%= ax_operational_panel(eyebrow: "Status", title: "Diagnóstico") do %>
          <div class="wa-panel-body">
            <dl class="wa-state">
              <% @diagnostics.each do |item| %>
                <div class="wa-state__row">
                  <dt>
                    <strong><%= item[:label] %></strong>
                    <% if item[:fallback].present? && !item[:ok] %>
                      <span>Usando padrão: <code><%= item[:fallback] %></code></span>
                    <% elsif item[:detail].present? %>
                      <span><%= item[:detail] %></span>
                    <% end %>
                  </dt>
                  <dd>
                    <% if item[:ok] || item[:fallback].present? %>
                      <i class="bi bi-check-circle-fill tw-text-green-600"></i>
                    <% else %>
                      <i class="bi bi-exclamation-triangle-fill tw-text-amber-600"></i>
                    <% end %>
                  </dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>

        <%= ax_operational_panel(eyebrow: "Segurança", title: "Token e segredo") do %>
          <div class="wa-panel-body">
            <p class="wa-hint">O token retornado pela Meta é salvo no backend e não é exibido completo na interface.</p>
          </div>
        <% end %>
      </aside>
    </div>

  <% end %>
</div>

<style id="wa-integration-styles">
  .wa-workspace { display: grid; gap: 8px; padding-top: 8px; }
  .wa-command { margin-bottom: 0; }

  .wa-tabs { display: inline-flex; gap: 3px; padding: 3px; border: 1px solid #d8dee8; border-radius: 8px; background: #eef2f7; }
  .wa-tabs__item {
    display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 12px;
    border: 1px solid transparent; border-radius: 6px; color: #64748b;
    font-size: 12px; font-weight: 800; text-decoration: none;
  }
  .wa-tabs__item:hover { background: #fff; color: #1f2937; }
  .wa-tabs__item.is-active { background: #fff; color: var(--admin-primary, #365f8f); border-color: color-mix(in srgb, var(--admin-primary) 28%, #d8dee8); box-shadow: 0 1px 2px rgba(15,23,42,.06); }

  .wa-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; align-items: start; }
  @media (min-width: 1080px) { .wa-grid { grid-template-columns: minmax(0, 1fr) 340px; } }
  .wa-main { display: grid; gap: 8px; min-width: 0; }
  .wa-aside { display: grid; gap: 8px; min-width: 0; }
  @media (min-width: 1080px) { .wa-aside { position: sticky; top: calc(var(--ax-navbar-h, 48px) + var(--ax-contextbar-h, 40px) + 8px); } }

  .wa-panel-body { padding: 12px; display: grid; gap: 14px; }
  .wa-hint { margin: 0; color: #8a93a3; font-size: 11.5px; line-height: 1.45; }
  .wa-form { gap: 14px; }
  .wa-field { display: grid; gap: 5px; min-width: 0; }
  .wa-field--divider { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--ax-border-soft, #eceef1); }

  .wa-connected { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 12px; border: 1px solid var(--ax-border-soft, #e7ebf2); border-radius: 8px; background: #f8fafc; }
  .wa-connected__cell { display: grid; gap: 2px; min-width: 0; }
  .wa-connected__cell span { color: #697586; font-size: 10.5px; text-transform: uppercase; letter-spacing: .04em; font-weight: 700; }
  .wa-connected__cell strong { color: #1f2733; font-size: 13px; overflow-wrap: anywhere; }
  .wa-summary-row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--ax-border-soft, #e7ebf2);
    border-radius: 8px;
    background: #f8fafc;
  }
  .wa-summary-row__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #e6f6ec;
    color: #0e9f6e;
    font-size: 17px;
  }
  .wa-summary-row__main { display: grid; gap: 2px; min-width: 0; }
  .wa-summary-row__main strong { color: #1f2733; font-size: 13.5px; line-height: 1.2; }
  .wa-summary-row__main span { color: #4b5565; font-size: 12px; font-weight: 800; overflow-wrap: anywhere; }
  .wa-summary-row__main small { color: #8a93a3; font-size: 11px; overflow-wrap: anywhere; }
  .wa-summary-row__meta { display: inline-flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px; color: #8a93a3; font-size: 11px; font-weight: 700; }
  .wa-advanced-details { display: grid; gap: 10px; }
  .wa-advanced-details__summary {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 7px;
    padding: 2px 0;
    color: #365f8f;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }
