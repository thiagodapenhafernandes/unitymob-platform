<%#
  Chips (pins removíveis) dos imóveis de interesse do lead. Re-renderizado via
  fetch pelo property-interests controller. locals: lead (obrigatório),
  show_empty (opcional; default: lead sem property_id principal)
%>
<%
  interests = lead.property_interests.includes(:habitation).order(:created_at)
  show_empty = local_assigns.key?(:show_empty) ? local_assigns[:show_empty] : lead.property_id.blank?
  share_enabled = local_assigns[:share_url].present?
  shared_property_ids = Array(local_assigns[:shared_property_ids]).map(&:to_i)
  shared_property_statuses = local_assigns[:shared_property_statuses].presence || {}
  status_labels = {
    "sent" => "Enviado",
    "viewed" => "Visto",
    "opened" => "Aberto",
    "interested" => "Interessado"
  }
%>
<% interests.each do |interest| %>
  <% habitation = interest.habitation %>
  <div class="ax-context-pin ax-context-pin--property">
    <% if share_enabled %>
      <label class="lead-property-share-check">
        <input type="checkbox"
               value="<%= habitation.id %>"
               data-property-interests-target="shareCheckbox"
               data-action="property-interests#toggleShareSelection"
               aria-label="Selecionar <%= habitation.codigo %> para compartilhar">
      </label>
    <% end %>
    <%= link_to admin_habitation_path(habitation.id), class: "ax-context-pin__link", target: "_blank", rel: "noopener" do %>
      <i class="bi bi-house-door"></i>
      <span><%= [habitation.codigo, habitation.display_title.presence].compact_blank.join(" · ") %></span>
    <% end %>
    <% share_status = shared_property_statuses[habitation.id] || shared_property_statuses[habitation.id.to_s] || ("sent" if shared_property_ids.include?(habitation.id)) %>
    <% if share_status.present? %>
      <span class="lead-property-share-badge lead-property-share-badge--<%= share_status %>"><%= status_labels.fetch(share_status, "Enviado") %></span>
    <% end %>
    <button type="button"
            class="ax-context-pin__remove"
            title="Remover imóvel de interesse"
            aria-label="Remover <%= habitation.codigo %> dos interesses"
            data-action="property-interests#remove"
            data-url="<%= admin_lead_property_interest_path(lead, interest, (share_enabled ? { share: "1" } : {})) %>">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>
<% end %>
<% if interests.empty? && show_empty %>
  <div class="ax-context-pin ax-context-pin--property">
    <span class="ax-context-pin__link"><i class="bi bi-house-door"></i><span>Sem imóvel específico</span></span>
  </div>
<% end %>
