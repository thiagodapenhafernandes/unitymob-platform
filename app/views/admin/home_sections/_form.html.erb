<%= form_with model: [:admin, @home_section], local: true do |f| %>
  <%= ax_error_summary(@home_section) %>

  <div class="ax-card">
    <div class="ax-card__body">
      <div class="tw-mb-3">
        <%= f.label :title, "Título", class: "ax-label" %>
        <%= f.text_field :title, class: "ax-control", required: true %>
      </div>

      <div class="tw-mb-3">
        <%= f.label :subtitle, "Subtítulo (opcional)", class: "ax-label" %>
        <%= f.text_area :subtitle, rows: 2, class: "ax-control" %>
      </div>

      <div class="tw-mb-3">
        <%= ax_switch_field(label: "Seção Ativa", form: f, method: :active, input_html: { role: "switch", checked: @home_section.persisted? ? @home_section.active : true }) %>
        <small class="tw-text-ink-muted">Seções inativas não aparecem na página inicial</small>
      </div>

      <div class="border tw-rounded-lg tw-p-2 tw-mb-3">
        <h6 class="tw-font-bold tw-text-ink-muted tw-mb-2">Curadoria de imóveis</h6>
        <p class="ax-page-subtitle tw-mb-3">
          Imóveis selecionados manualmente aparecem primeiro. Os filtros completam a seção com imóveis públicos deste tenant.
        </p>

        <%= f.fields_for :property_filters do |filters_form| %>
          <div class="tw-mb-4">
            <%= ax_autocomplete_select_field(
                  form: filters_form,
                  method: :selected_property_ids,
                  label: "Imóveis específicos",
                  choices: @property_options || [],
                  select_options: { selected: @home_section.selected_property_ids },
                  multiple: true,
                  placeholder: "Buscar por código, título ou localização",
                  html_options: {
                    name: "home_section[property_filters][selected_property_ids][]"
                  },
                  tom_select_options: {
                    plugins: ["remove_button"],
                    maxOptions: 500
                  }
                ) %>
            <small class="tw-text-ink-muted">
              A lista mostra imóveis publicáveis da conta atual. Deixe vazio para usar apenas a regra automática da seção.
            </small>
          </div>
        <% end %>

        <h6 class="tw-font-bold tw-text-ink-muted tw-mb-2">Filtros automáticos</h6>
        <%= ax_chip_grid do %>
          <% HomeSection::PROPERTY_FILTER_OPTIONS.each do |key, option| %>
            <%= ax_toggle_chip(
                  label: option[:label],
                  name: "home_section[property_filters][#{key}]",
                  checked: @home_section.property_filter_enabled?(key),
                  include_hidden: false,
                  class_name: "ax-toggle-chip--full"
                ) %>
          <% end %>
        <% end %>
      </div>

      <div class="tw-flex tw-gap-2">
        <%= link_to "Cancelar", admin_home_sections_path, class: "ax-btn ax-btn--ghost" %>
        <%= f.submit @home_section.persisted? ? "Atualizar Seção" : "Criar Seção", class: "ax-btn ax-btn--primary" %>
      </div>
    </div>
  </div>
<% end %>
