<%# Seções da Home — compacto (.ax-*) com reordenação SortableJS. %>
<div class="public-site-workspace">
<%= ax_workspace_heading(eyebrow: "Site público · Home", icon: "layout-text-sidebar", title: "Seções da Home", subtitle: "Ordene, publique e configure os blocos exibidos na página inicial.", metrics: [{ value: @home_sections.size, label: "seções" }], actions: ax_button("Nova seção", new_admin_home_section_path, variant: :primary, size: :sm, icon: "plus-lg")) %>

<%= ax_operational_panel(eyebrow: "Composição", title: "Blocos da página inicial") do %>
  <%= render "sections_table", sections: @home_sections %>
<% end %>
</div>
