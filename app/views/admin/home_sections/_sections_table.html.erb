<%# Tabela de seções da Home — compartilhada entre /admin/home_sections e a aba Seções de /admin/home_setting/edit.
    Locais: sections (coleção ordenada), return_to ("home_settings" volta para a aba; nil mantém a listagem).
    Sem <form> de propósito: dentro da aba, a tabela vive aninhada no formulário da Home. %>
<% return_to = local_assigns[:return_to] %>
<div class="ax-table-wrap" id="home-sections-table">
  <table class="ax-table">
    <thead>
      <tr>
        <th class="ax-table__col--w-80">Ordem</th>
        <th>Título</th>
        <th class="ax-table__col--w-320">Conteúdo e filtros</th>
        <th class="ax-table__col--w-120">Status</th>
        <th class="ax-num ax-table__col--md">Ações</th>
      </tr>
    </thead>
    <tbody id="sortable-sections" data-controller="home-sections-sort" data-home-sections-sort-url-value="<%= update_order_admin_home_sections_path %>">
      <% sections.each do |section| %>
        <tr data-id="<%= section.id %>" class="ax-table__row--sortable">
          <td>
            <i class="bi bi-grip-vertical tw-text-ink-faint"></i>
            <span class="ax-badge ax-badge--gray tw-ml-1"><%= section.order_position || '-' %></span>
          </td>
          <td>
            <span class="ax-strong"><%= section.title %></span>
            <% if section.subtitle.present? %><div class="tw-text-2xs tw-text-ink-faint"><%= truncate(section.subtitle, length: 60) %></div><% end %>
          </td>
          <td>
            <span class="ax-badge ax-badge--blue"><%= section.public_section_kind_label %></span>
            <% if section.property_filter_labels.any? %>
              <div class="tw-flex tw-flex-wrap tw-gap-1 tw-mt-1">
                <% section.property_filter_labels.each do |label| %><span class="ax-badge ax-badge--gray"><%= label %></span><% end %>
              </div>
            <% else %>
              <div class="tw-text-2xs tw-text-ink-faint tw-mt-1"><%= if section.blog? then "3 artigos publicados mais recentes" elsif section.city_links? then "Cidades com mais imóveis e seus bairros" else "Sem filtros adicionais" end %></div>
            <% end %>
          </td>
          <td>
            <%= link_to toggle_active_admin_home_section_path(section, return_to: return_to), data: { turbo_method: :patch }, role: "button",
                  class: "ax-badge #{section.active ? 'ax-badge--green' : 'ax-badge--gray'} tw-border-0 tw-cursor-pointer",
                  title: section.active? ? "Desativar seção" : "Ativar seção" do %>
              <i class="bi bi-toggle-<%= section.active ? 'on' : 'off' %>"></i> <%= section.active ? 'Ativo' : 'Inativo' %>
            <% end %>
          </td>
          <td class="ax-num">
            <span class="tw-inline-flex tw-gap-0.5">
              <%= link_to admin_home_section_path(section, return_to: return_to), class: "ax-ico-btn", title: "Ver" do %><i class="bi bi-eye"></i><% end %>
              <%= link_to edit_admin_home_section_path(section, return_to: return_to), class: "ax-ico-btn", title: "Editar" do %><i class="bi bi-pencil"></i><% end %>
              <%= link_to admin_home_section_path(section, return_to: return_to), data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja remover esta seção?" }, class: "ax-ico-btn", title: "Excluir" do %><i class="bi bi-trash"></i><% end %>
            </span>
          </td>
        </tr>
      <% end %>

      <% if sections.empty? %>
        <tr><td colspan="5"><%= ax_empty_state(title: "Nenhuma seção cadastrada", description: "Adicione o primeiro bloco para compor a página inicial.", icon: "layout-text-sidebar", action: ax_button("Nova seção", new_admin_home_section_path(return_to: return_to), variant: :primary, size: :sm), compact: true) %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
