<% content_for :title, "Configurações da Conta" %>

<div class="layout-settings-workspace">
  <%= ax_workspace_heading(
        eyebrow: "Conta · Governança",
        icon: "building-gear",
        title: "Configurações da Conta",
        subtitle: "Tudo que é da conta em um lugar: marca, equipe e permissões, notificações, segurança, auditorias e compliance."
      ) %>

  <%# ---- Identidade da conta (único bloco editável) ---- %>
  <%= ax_studio_group(title: "Identidade da conta", subtitle: "Como a conta se chama para clientes e para a equipe.", icon: "building") do %>
    <%= ax_field_grid do %>
      <div class="ax-span-6">
        <div class="ax-field">
          <span class="ax-field-label">Nome de exibição</span>
          <p class="ax-studio-value"><%= LayoutSetting.instance.site_name.presence || "Não definido" %></p>
          <p class="ax-field__hint">
            Aparece no site, nos cartões de apresentação e no <code>{empresa}</code>.
            <% if can?(:manage, :site_publico) %>
              Editável em <%= link_to "Site público → Identidade", edit_admin_public_identity_path, class: "ax-link" %>.
            <% end %>
          </p>
        </div>
      </div>

      <% if can?(:manage, :conta) %>
        <div class="ax-span-6">
          <%= form_with url: admin_account_settings_path, method: :patch do %>
            <%= ax_standalone_field(
                  name: "tenant[name]",
                  id: "tenant_name",
                  label: "Nome interno da conta",
                  value: current_tenant.name,
                  maxlength: 80,
                  required: true,
                  hint: "Uso administrativo (relatórios e painel do sistema). Não aparece para clientes.",
                  action: button_tag("Salvar", type: "submit", class: "ax-btn ax-btn--primary")
                ) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# ---- Atalhos por assunto ---- %>
  <div class="ax-hub-grid">
    <% if can?(:manage, :conta) %>
      <%= ax_studio_group(title: "Aparência da plataforma", subtitle: "Nome, cores e menu lateral do ambiente da equipe.", icon: "palette") do %>
        <div class="ax-hub-links">
          <%= ax_hub_link("Abrir Aparência da plataforma", edit_admin_layout_setting_path, icon: "palette") %>
        </div>
      <% end %>
    <% end %>

    <% if can?(:manage, :site_publico) %>
      <%= ax_studio_group(title: "Identidade do site", subtitle: "Marca, logo, favicon, paleta e modelo visual do site público.", icon: "stars") do %>
        <div class="ax-hub-links">
          <%= ax_hub_link("Abrir Identidade do site", edit_admin_public_identity_path, icon: "stars") %>
        </div>
      <% end %>
    <% end %>

    <% if can?(:view, :corretores) || can?(:manage, :conta) %>
      <%= ax_studio_group(title: "Equipe e permissões", subtitle: "Usuários da conta, perfis de acesso e convites externos.", icon: "people") do %>
        <div class="ax-hub-links">
          <% if can?(:view, :corretores) %>
            <%= ax_hub_link("Usuários", admin_admin_users_path, icon: "people") %>
          <% end %>
          <% if can?(:manage, :conta) %>
            <%= ax_hub_link("Perfis de acesso", admin_profiles_path, icon: "shield-lock") %>
          <% end %>
          <% if can?(:manage, :corretores) %>
            <%= ax_hub_link("Acessos externos", admin_account_memberships_path, icon: "person-plus") %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% if can?(:manage, :integracoes) %>
      <%= ax_studio_group(title: "Notificações", subtitle: "Servidor de e-mail (SMTP) desta conta para envios de leads e avisos.", icon: "bell") do %>
        <div class="ax-hub-links">
          <%= ax_hub_link("Meu SMTP", edit_admin_email_setting_path, icon: "envelope-at") %>
        </div>
        <p class="ax-field__hint">Push e transportes globais de notificação são configurados pelo Admin do Sistema.</p>
      <% end %>
    <% end %>

    <% if can?(:manage, :access_security) %>
      <%= ax_studio_group(title: "Segurança de acesso", subtitle: "Políticas de sessão, IPs, aparelhos confiáveis e 2FA da equipe.", icon: "fingerprint") do %>
        <div class="ax-hub-links">
          <%= ax_hub_link("Abrir Segurança de Acesso", admin_access_security_path, icon: "fingerprint") %>
          <%= ax_hub_link("Verificação em duas etapas", admin_two_factor_settings_path, icon: "shield-lock") %>
        </div>
      <% end %>
    <% end %>

    <% if can?(:manage, :conta) || can?(:view, :field_audit) || can?(:view, :access_audit) || can?(:view, :data_export_audit) %>
      <%= ax_studio_group(title: "Auditorias", subtitle: "Trilhas de uso operacional, acesso, campo, apresentações e exportações de dados.", icon: "clipboard-check") do %>
        <div class="ax-hub-links">
          <% if can?(:manage, :conta) %>
            <%= ax_hub_link("Operacional", admin_user_activity_sessions_path, icon: "activity") %>
          <% end %>
          <% if can?(:view, :field_audit) %>
            <%= ax_hub_link("Campo", admin_field_audit_logs_path, icon: "shield-lock-fill") %>
          <% end %>
          <% if can?(:view, :access_audit) %>
            <%= ax_hub_link("Acessos", admin_access_audit_logs_path, icon: "person-lock") %>
            <%= ax_hub_link("Apresentações WhatsApp", admin_presentation_audit_logs_path, icon: "person-badge") %>
          <% end %>
          <% if can?(:view, :data_export_audit) %>
            <%= ax_hub_link("Exportações", admin_data_export_audit_logs_path, icon: "file-earmark-arrow-down") %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% if can?(:view, :whatsapp_campaigns) %>
      <%= ax_studio_group(title: "Compliance WhatsApp", subtitle: "Contatos importados por CSV e descadastros (opt-out) dos disparos.", icon: "whatsapp") do %>
        <div class="ax-hub-links">
          <%= ax_hub_link("Importados CSV", admin_whatsapp_campaign_recipients_path, icon: "table") %>
          <%= ax_hub_link("Descadastros", admin_whatsapp_campaign_unsubscribes_path, icon: "person-dash") %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
