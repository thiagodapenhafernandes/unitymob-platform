<%# Linhas repetíveis com vários campos (ex.: nome + URL + ícone), sobre o
    controller dynamic-list. Cada linha envia input_name[índice][chave].
    Locals: label, rows, fields, input_name, add_label, empty_hint, class_name.
    fields: [{ key:, label:, placeholder:, type: (:text|:url|:number|:select), options:, width: }] %>
<%
  columns = fields.map { |field| field[:width] || "minmax(0, 1fr)" }.push("auto").join(" ")
  render_field = lambda do |field, index, value|
    name = "#{input_name}[#{index}][#{field[:key]}]"
    value = field[:default] if value.nil?
    common = { class: "ax-control", "aria-label": field[:label] }
    case field[:type]&.to_sym
    when :hidden
      hidden_field_tag(name, field[:key] == "row_key" ? index : value)
    when :file
      file_field_tag("#{field[:input_name]}[#{index}]", common.merge(accept: "image/png,image/jpeg,image/webp", data: { landing_page_builder_target: "file" }))
    when :select
      select_tag(name, options_for_select(field[:options], value), common.merge(include_blank: field[:placeholder]))
    when :color
      render "admin/shared/ui/color_control",
        color_input: color_field_tag(name, value.presence || "#ffffff", id: "#{name.gsub(/[^a-zA-Z0-9_]/, '_')}_picker", class: "ax-color-control__swatch", "aria-label": "Escolha a cor de #{field[:label]}", data: { ax_color_pair_target: "swatch", action: "input->ax-color-pair#sync" }),
        text_input: text_field_tag(name, value.presence || "#ffffff", class: "ax-color-control__text", spellcheck: false, "aria-label": "#{field[:label]} — hexadecimal", data: { ax_color_pair_target: "text", action: "input->ax-color-pair#sync" })
    when :range
      tag.div(data: { controller: "ax-range" }) do
        range_field_tag(nil, value, min: field[:range].first, max: field[:range].last, "aria-label": field[:label], data: { ax_range_target: "range", action: "input->ax-range#sync" }) +
        number_field_tag(name, value, common.merge(min: field[:range].first, max: field[:range].last, data: { ax_range_target: "number", action: "input->ax-range#sync" }))
      end
    when :rich
      rich_id = name.gsub(/[^a-zA-Z0-9_]/, "_")
      rich_text_area_tag(name, value, id: rich_id, input: "#{rich_id}_input")
    when :textarea
      text_area_tag(name, value, common.merge(placeholder: field[:placeholder], rows: 3))
    when :number
      text_field_tag(name, value, common.merge(placeholder: field[:placeholder], inputmode: "numeric"))
    when :url
      url_field_tag(name, value, common.merge(placeholder: field[:placeholder]))
    else
      text_field_tag(name, value, common.merge(placeholder: field[:placeholder]))
    end
  end
%>
<div class="<%= ["ax-dynamic-list ax-repeatable-rows", class_name].compact.join(" ") %>"
     data-controller="dynamic-list"
     style="--ax-repeatable-columns: <%= columns %>">
  <div class="ax-dynamic-list__header">
    <h6 class="ax-dynamic-list__title"><%= label %></h6>
    <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm" data-action="dynamic-list#add">
      <i class="bi bi-plus-lg ax-ico" aria-hidden="true"></i><%= add_label %>
    </button>
  </div>
  <div class="ax-repeatable-rows__head" aria-hidden="true">
    <% fields.each do |field| %><span><%= field[:label] %></span><% end %><span></span>
  </div>
  <div class="ax-dynamic-list__items" data-dynamic-list-target="container">
    <% Array(rows).each_with_index do |row, index| %>
      <div class="ax-input-group ax-dynamic-list__item">
        <% fields.each do |field| %><%= tag.label(class: "ax-repeatable-rows__field", hidden: field[:type] == :hidden) { tag.span(field[:label], class: "ax-repeatable-rows__label") + render_field.call(field, index, row[field[:key]]) } %><% end %>
        <div class="ax-repeatable-rows__actions">
        <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm" data-action="dynamic-list#move" data-direction="-1" aria-label="Subir item"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
        <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm" data-action="dynamic-list#move" data-direction="1" aria-label="Descer item"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
        <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm ax-text-danger" data-action="dynamic-list#remove" aria-label="Remover linha">
          <i class="bi bi-trash" aria-hidden="true"></i>
        </button>
        </div>
      </div>
    <% end %>
  </div>
  <% if empty_hint.present? %><p class="ax-repeatable-rows__hint"><%= empty_hint %></p><% end %>
  <template data-dynamic-list-target="template">
    <% fields.each do |field| %><%= tag.label(class: "ax-repeatable-rows__field", hidden: field[:type] == :hidden) { tag.span(field[:label], class: "ax-repeatable-rows__label") + render_field.call(field, "NEW_RECORD", nil) } %><% end %>
    <div class="ax-repeatable-rows__actions">
        <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm" data-action="dynamic-list#move" data-direction="-1" aria-label="Subir item"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
        <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm" data-action="dynamic-list#move" data-direction="1" aria-label="Descer item"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
        <button type="button" class="ax-btn ax-btn--ghost ax-btn--sm ax-text-danger" data-action="dynamic-list#remove" aria-label="Remover linha">
      <i class="bi bi-trash" aria-hidden="true"></i>
    </button>
    </div>
  </template>
</div>
