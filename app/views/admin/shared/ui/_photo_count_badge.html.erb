<%
  total_count = local_assigns.fetch(:total_count).to_i
  preview_count = [local_assigns.fetch(:preview_count, total_count).to_i, total_count].min
  site_count = local_assigns[:site_count]&.to_i
  compact = local_assigns.fetch(:compact, false)
  internal_with_site_delta = site_count.present? && site_count != total_count
  label = if compact
            total_count.to_s
          elsif internal_with_site_delta
            "#{total_count} mídias · #{site_count} no site"
          else
            "#{total_count} #{total_count == 1 ? 'foto' : 'fotos'}"
          end
  title = if internal_with_site_delta
            "#{total_count} mídias internas; #{site_count} publicadas no site. Fotos fora do site continuam visíveis no sistema."
          elsif preview_count < total_count
            "Prévia com #{preview_count} das #{total_count} fotos. Abra o imóvel para ver todas."
          else
            "#{total_count} #{total_count == 1 ? 'foto disponível' : 'fotos disponíveis'}."
          end
%>

<% if total_count.positive? %>
  <span class="ax-photo-count-badge <%= 'ax-photo-count-badge--compact' if compact %>"
        title="<%= title %>"
        aria-label="<%= label %>">
    <i class="bi bi-images" aria-hidden="true"></i>
    <%= label %>
  </span>
<% end %>
