<%= time_tag lead.entry_received_at, title: "Recebimento da consulta" do %><%= l(lead.entry_received_at, format: "%d/%m/%Y %H:%M") %><% end %>
<% if lead.entry_received_at.to_i / 60 != lead.created_at.to_i / 60 %>
  <span class="ax-record-sub">Cadastro: <%= l(lead.created_at, format: "%d/%m/%Y %H:%M") %></span>
<% end %>
