<%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle-fill") do %>
  <div class="ax-issue-summary">
  <strong><%= title %></strong>
  <details>
    <summary><%= pluralize(messages.size, "pendência", "pendências") %> · Ver motivos e orientações</summary>
    <ul class="tw-text-sm tw-space-y-2 tw-mt-2">
      <% messages.uniq.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
    <%= local_assigns[:resolution] %>
  </details>
  </div>
<% end %>
