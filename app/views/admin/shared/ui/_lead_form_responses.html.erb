<% groups.each do |group| %>
  <%= ax_operational_panel(eyebrow: "Captação", title: "Respostas do formulário #{group[:provider]}") do %>
    <div class="ax-panel-body">
      <p class="tw-mb-4 tw-text-sm tw-text-slate-500">
        <%= group[:form_name] %>
        <% if group[:received_at] %> · Recebido em <%= l(group[:received_at], format: :short) %><% end %>
      </p>
      <%= ax_field_grid do %>
        <% group[:answers].each do |entry| %>
          <div class="ax-span-6 ax-field">
            <span class="ax-field-label"><%= entry[:question] %></span>
            <p class="tw-m-0 tw-whitespace-pre-line tw-break-words"><%= entry[:answer].presence || "Não informado" %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
