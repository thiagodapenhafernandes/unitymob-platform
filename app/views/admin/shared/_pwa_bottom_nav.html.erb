<%
  can_access_pwa_nav = lambda do |action, resource|
    if respond_to?(:can?)
      can?(action, resource)
    else
      current_admin_user&.can?(action, resource)
    end
  rescue Devise::MissingWarden
    false
  end

  current_controller_path = controller_path.to_s
  current_controller_name = controller_name.to_s
  current_path = request.path
  pwa_tenant_context = respond_to?(:current_tenant) && current_tenant.present?
  pwa_leads_view_mode = current_admin_user&.leads_view_mode.to_s.presence_in(%w[kanban list]) || "list"
  pwa_leads_mobile_tab = pwa_leads_view_mode == "kanban" ? "all" : "todo"
  pwa_queue_position = pwa_current_queue_position
  pwa_queue_path = if can_access_pwa_nav.call(:view, :distribution_rules) || can_access_pwa_nav.call(:manage, :distribution_rules)
    admin_distribution_rules_path
  else
    admin_leads_path(view: "list", mobile_tab: "todo")
  end

  pwa_nav_items = [
    {
      label: "Home",
      icon: "grid-1x2",
      path: field_root_path,
      visible: current_admin_user.present? && pwa_tenant_context,
      active: current_controller_path == "field/home" || current_path == field_root_path
    },
    {
      label: "Leads",
      icon: "house-door",
      path: admin_leads_path(view: pwa_leads_view_mode, mobile_tab: pwa_leads_mobile_tab),
      visible: can_access_pwa_nav.call(:view, :leads),
      active: current_controller_name == "leads"
    },
    {
      label: "Imóveis",
      icon: "building",
      path: admin_habitations_path,
      visible: can_access_pwa_nav.call(:view, :imoveis),
      active: current_controller_name == "habitations" || current_controller_name == "habitation_media"
    },
    {
      label: "Captações",
      icon: "inboxes",
      path: admin_captacoes_path,
      visible: can_access_pwa_nav.call(:view, :captacoes),
      active: %w[habitation_intakes captacoes].include?(current_controller_name) && current_path.start_with?(admin_captacoes_path)
    },
    {
      label: "Fila",
      icon: "list-ol",
      path: pwa_queue_path,
      badge: (pwa_queue_position.present? ? "#{pwa_queue_position}º" : nil),
      visible: can_access_pwa_nav.call(:view, :leads),
      active: current_controller_name == "distribution_rules"
    }
  ].select { |item| pwa_tenant_context && item[:visible] }
%>

<% if pwa_nav_items.any? %>
  <nav class="ax-pwa-bottom-nav" aria-label="Navegação principal do PWA">
    <% pwa_nav_items.each do |item| %>
      <%= link_to item[:path],
                  class: "ax-pwa-bottom-nav__item #{'is-active' if item[:active]}",
                  aria: ({ current: "page" } if item[:active]) do %>
        <span class="ax-pwa-bottom-nav__icon-wrap">
          <i class="bi bi-<%= item[:icon] %>" aria-hidden="true"></i>
          <% if item[:badge].present? %>
            <strong class="ax-pwa-bottom-nav__badge"><%= item[:badge] %></strong>
          <% end %>
        </span>
        <span><%= item[:label] %></span>
      <% end %>
    <% end %>
  </nav>
<% end %>
