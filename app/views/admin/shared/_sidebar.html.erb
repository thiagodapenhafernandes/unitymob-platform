<%
    system_admin_without_tenant = current_admin_user&.system_admin? && !selected_tenant_context?
    vista_soft_context = controller_name == 'habitations' && params[:sort] == 'last_sync_at'
    can_access = lambda do |action, resource|
      if respond_to?(:can?)
        can?(action, resource)
      else
        user = respond_to?(:current_admin_user) ? current_admin_user : nil
        user&.can?(action, resource)
      end
    rescue Devise::MissingWarden
      false
    end
  %>
<ul class="ax-nav <%= 'ax-nav--sectioned' unless system_admin_without_tenant %>" data-controller="menu-sections">
  <% if respond_to?(:impersonating_admin_user?) && impersonating_admin_user? %>
    <%# Aviso de impersonação: discreto e sempre visível no topo do menu. Em modo
        compacto sobra só o ícone, e o title carrega o contexto completo. %>
    <li class="ax-nav__impersonation"
        title="Você está acessando como <%= current_admin_user.name %>. Admin original: <%= impersonation_admin_user.name %>.">
      <span class="ax-nav__impersonation-icon" aria-hidden="true"><i class="bi bi-person-check-fill"></i></span>
      <span class="ax-nav__impersonation-body">
        <small>Acessando como</small>
        <strong><%= current_admin_user.name %></strong>
        <em>via <%= impersonation_admin_user.name %></em>
      </span>
      <%= button_to admin_impersonation_path,
            method: :delete,
            class: "ax-nav__impersonation-exit",
            form_class: "ax-nav__impersonation-form",
            title: "Voltar ao admin",
            aria: { label: "Voltar ao admin" },
            form: { data: { turbo: false } } do %>
        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
      <% end %>
    </li>
  <% end %>
  <% if system_admin_without_tenant %>
    <li class="ax-nav__section">Sistema</li>
    <li class="ax-nav__item">
      <%= link_to admin_system_path, class: "ax-nav__link #{'active' if controller_name == 'system' && action_name == 'index'}" do %>
        <i class="bi bi-hdd-stack"></i><span>Painel do Sistema</span>
      <% end %>
    </li>
    <li class="ax-nav__item">
      <%= link_to admin_system_health_path, class: "ax-nav__link #{'active' if controller_name == 'health'}" do %>
        <i class="bi bi-activity"></i><span>Saúde do Sistema</span>
      <% end %>
    </li>
    <li class="ax-nav__item">
      <%= link_to admin_system_tenants_path, class: "ax-nav__link #{'active' if controller_path == 'admin/system/tenants'}" do %>
        <i class="bi bi-building"></i><span>Contas</span>
      <% end %>
    </li>
    <li class="ax-nav__item">
      <%= link_to admin_system_users_path, class: "ax-nav__link #{'active' if controller_name == 'system' && action_name == 'users'}" do %>
        <i class="bi bi-people"></i><span>Usuários</span>
      <% end %>
    </li>
    <li class="ax-nav__item">
      <%= link_to admin_system_error_events_path, class: "ax-nav__link #{'active' if controller_name == 'error_events'}" do %>
        <i class="bi bi-bug"></i><span>Erros da Aplicação</span>
      <% end %>
    </li>
    <li class="ax-nav__item">
      <%= link_to edit_admin_system_notification_settings_path, class: "ax-nav__link #{'active' if controller_name == 'notification_settings'}" do %>
        <i class="bi bi-broadcast-pin"></i><span>Notificações Globais</span>
      <% end %>
    </li>
    <li class="ax-nav__caption">Operação</li>
    <li class="ax-nav__hint">Acesse áreas operacionais apenas por impersonação.</li>
  <% else %>
    <%

    # Visibilidade de seção vem de um catálogo único no helper; o detalhe de cada
    # item continua validado por can? e pelo backend.
    produto_visible = admin_sidebar_section_visible?(:product)
    operacao_visible = admin_sidebar_section_visible?(:operation)
    gestao_visible = admin_sidebar_section_visible?(:management)
    crescimento_visible = admin_sidebar_section_visible?(:growth)
  %>
    <% if produto_visible %>
      <li class="ax-nav__section" data-nav-section="product">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-product">
          <i class="bi bi-grid-1x2"></i><span>Produto</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-product" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:product) %>
        </ul>
      </li>
    <% end %>

    <% if operacao_visible %>
      <li class="ax-nav__section" data-nav-section="operation">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-operation">
          <i class="bi bi-briefcase"></i><span>Operação</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-operation" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:operation) %>
        </ul>
      </li>
    <% end %>

    <% if gestao_visible %>
      <li class="ax-nav__section" data-nav-section="management">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-management">
          <i class="bi bi-people"></i><span>Gestão</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-management" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:management) %>
        </ul>
      </li>
    <% end %>

    <% if crescimento_visible %>
      <li class="ax-nav__section" data-nav-section="growth">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-growth">
          <i class="bi bi-graph-up-arrow"></i><span>Crescimento</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-growth" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:growth) %>
        </ul>
      </li>
    <% end %>

    <% if admin_sidebar_section_visible?(:public_site) %>
      <li class="ax-nav__section" data-nav-section="public-site">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-public-site">
          <i class="bi bi-globe2"></i><span>Site público</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-public-site" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:public_site) %>
        </ul>
      </li>
    <% end %>

    <%# Integrações técnicas %>
    <% integrations_menu_visible = admin_sidebar_section_visible?(:integrations) %>
    <% if integrations_menu_visible %>
      <li class="ax-nav__section" data-nav-section="integrations">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-integrations">
          <i class="bi bi-plug"></i><span>Integrações</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-integrations" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:integrations) %>
        </ul>
      </li>
    <% end %>

    <%# Webhook de entrada pessoal — item próprio para quem tem a permissão mas
        NÃO tem manage :integracoes (o grupo Integrações não aparece pra ele). %>
    <% if can_access.call(:manage, :inbound_webhooks) && !can_access.call(:manage, :integracoes) %>
      <li class="ax-nav__item">
        <%= link_to admin_webhook_settings_path(tab: "inbound"), class: "ax-nav__link #{'active' if controller_name == 'webhook_settings'}" do %>
          <i class="bi bi-box-arrow-in-down"></i><span>Webhook de entrada</span>
        <% end %>
      </li>
    <% end %>

    <%# Configurações internas %>
    <%
      settings_menu_visible = admin_sidebar_section_visible?(:settings)
      settings_visible = settings_menu_visible
    %>
    <% if settings_visible %>
      <li class="ax-nav__section" data-nav-section="settings">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-settings">
          <i class="bi bi-sliders"></i><span>Configurações</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-settings" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:settings) %>
        </ul>
      </li>
    <% end %>

    <%# Configurações da Conta (ex-Administração + marca + notificações) %>
    <%
      account_menu_visible = admin_sidebar_section_visible?(:account)
    %>
    <% if account_menu_visible %>
      <li class="ax-nav__section" data-nav-section="account">
        <button type="button" class="ax-nav__section-trigger" data-menu-sections-target="trigger" data-action="menu-sections#toggle" aria-expanded="false" aria-controls="nav-section-account">
          <i class="bi bi-building-gear"></i><span>Conta</span><i class="bi bi-chevron-down"></i>
        </button>
        <ul class="ax-nav__section-items" id="nav-section-account" data-menu-sections-target="items">
          <%= admin_sidebar_section_items(:account) %>
        </ul>
      </li>
    <% end %>

    <%# Admin do Sistema — acima da conta, visível só para super admins. %>
    <% if current_admin_user&.system_admin? %>
      <li class="ax-nav__section">Sistema</li>
      <li class="ax-nav__item">
        <%= link_to admin_system_path, class: "ax-nav__link #{'active' if controller_name == 'system' && action_name == 'index'}" do %>
          <i class="bi bi-hdd-stack"></i><span>Painel do Sistema</span>
        <% end %>
      </li>
      <li class="ax-nav__item">
        <%= link_to admin_system_health_path, class: "ax-nav__link #{'active' if controller_name == 'health'}" do %>
          <i class="bi bi-activity"></i><span>Saúde do Sistema</span>
        <% end %>
      </li>
      <li class="ax-nav__item">
        <%= link_to admin_system_tenants_path, class: "ax-nav__link #{'active' if controller_path == 'admin/system/tenants'}" do %>
          <i class="bi bi-building"></i><span>Contas</span>
        <% end %>
      </li>
      <li class="ax-nav__item">
        <%= link_to admin_system_error_events_path, class: "ax-nav__link #{'active' if controller_name == 'error_events'}" do %>
          <i class="bi bi-bug"></i><span>Erros da Aplicação</span>
        <% end %>
      </li>
      <li class="ax-nav__item">
        <%= link_to edit_admin_system_notification_settings_path, class: "ax-nav__link #{'active' if controller_name == 'notification_settings'}" do %>
          <i class="bi bi-broadcast-pin"></i><span>Notificações Globais</span>
        <% end %>
      </li>
    <% end %>

  <% end %>
</ul>
