<%= ax_operational_panel(title: "Disponibilidade e acesso", class_name: "ax-panel--settings tw-mb-4") do %>
<p class="ax-field__hint">Ative os recursos, defina quem pode usar e configure voz e histórico.</p>
<%= ax_studio_group(title: "Recursos da busca", actions: tag.span("Comportamento", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-switches ax-studio-switches ax-studio-switches--2">
                <%= ax_switch_field(form: f, method: :ai_property_search_enabled, label: "Ativar busca inteligente", class_name: "ax-switch--card") %>
                <%= ax_switch_field(form: f, method: :voice_property_search_enabled, label: "Exibir gravação por voz no PWA", class_name: "ax-switch--card") %>
              </div>
            <% end %>
<%= ax_studio_group(title: "Disponibilidade por perfil", subtitle: "Quem pode usar a busca inteligente.", actions: tag.span("Permissões", class: "ax-badge ax-badge--gray")) do %>
              <%= ax_check_group(form: f, method: :ai_property_search_allowed_profiles, choices: PropertySetting::AI_PROPERTY_SEARCH_PROFILE_OPTIONS.to_a) %>
            <% end %>
<%= ax_studio_group(title: "Voz", actions: tag.span("PWA", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-fields">
                <%= ax_text_field(form: f, method: :ai_property_search_language, label: "Idioma", class_name: "ax-span-4", placeholder: "pt-BR") %>
                <%= ax_number_field(form: f, method: :ai_property_search_max_audio_duration_seconds, label: "Áudio máximo (segundos)", class_name: "ax-span-4", min: 5, max: 180) %>
              </div>
            <% end %>
<%= ax_studio_group(title: "Transcrição de áudio", actions: tag.span("Voz", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-switches ax-studio-switches ax-studio-switches--2">
                <%= ax_switch_field(form: f, method: :ai_property_search_transcription_vocabulary_enabled, label: "Vocabulário do catálogo na transcrição de áudio", class_name: "ax-switch--card") %>
              </div>
              <small class="ax-field__hint">Envia cidades, bairros e empreendimentos da conta para a transcrição reconhecer nomes falados com mais exatidão.</small>
            <% end %>
<%= ax_studio_group(title: "Histórico e privacidade") do %>
                <%= ax_switch_field(form: f, method: :ai_property_search_history_enabled, label: "Registrar histórico operacional", class_name: "ax-switch--card") %><div class="property-settings-ai-fields">
                <%= ax_number_field(form: f, method: :ai_property_search_history_retention_days, label: "Retenção do histórico (dias)", class_name: "ax-span-12", min: 1, max: 365) %></div><%= ax_inline_notice(tone: :info, icon: "shield-lock", compact: true) do %>O áudio original não é persistido. O histórico guarda apenas transcrição, filtros, contagem e tempos quando ativado.<% end %><% end %>
<% end %>
<%= ax_operational_panel(title: "Como a busca interpreta", class_name: "ax-panel--settings tw-mb-4") do %>
<p class="ax-field__hint">Instruções e critérios usados para encontrar imóveis.</p>
<%= ax_studio_group(title: "Instruções da IA", actions: tag.span("IA", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-fields">
                <div class="ax-span-12"><%= render "admin/shared/ui/expandable_textarea", name: "property_setting[ai_property_search_instructions]", id: "property_setting_ai_property_search_instructions", label: "Instrução principal da IA", value: property_setting.ai_property_search_instructions, hint: "Defina como interpretar os pedidos. Os campos permitidos abaixo prevalecem sobre estas instruções.", rows: 7 %></div>
              </div>
            <% end %>
<div class="property-settings-ai-fields">
                <%= ax_autocomplete_select_field(form: f, method: :ai_property_search_data_source, label: "Fonte de dados", choices: PropertySetting::AI_PROPERTY_SEARCH_DATA_SOURCES.map { |value| [PropertySetting::AI_PROPERTY_SEARCH_DATA_SOURCE_LABELS.fetch(value, value.humanize), value] }, class_name: "ax-span-4") %></div>
<%= ax_studio_group(title: "Campos de busca", actions: tag.span("Permissões", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <fieldset class="property-settings-ai-options"><legend>Campos permitidos para busca</legend><%= ax_check_group(form: f, method: :ai_property_search_allowed_fields, choices: PropertySetting::AI_PROPERTY_SEARCH_FIELD_OPTIONS.to_a, class_name: "ax-check-group--fields") %></fieldset>
            <% end %>
<%= ax_studio_group(title: "Reconhecimento por catálogo", actions: tag.span("Catálogo", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-switches ax-studio-switches ax-studio-switches--2">
                <%= ax_switch_field(form: f, method: :ai_property_search_development_name_enabled, label: "Buscar pelo nome do empreendimento", class_name: "ax-switch--card") %>
                <%= ax_switch_field(form: f, method: :ai_property_search_developer_name_enabled, label: "Buscar por incorporadora", class_name: "ax-switch--card") %>
                <%= ax_switch_field(form: f, method: :ai_property_search_development_aliases_enabled, label: "Considerar nomes comerciais alternativos", class_name: "ax-switch--card") %>
                <%= ax_switch_field(form: f, method: :ai_property_search_search_by_characteristics_enabled, label: "Identificar por características", class_name: "ax-switch--card") %>
              </div>
            <% end %>
<%= ax_studio_group(title: "Flexibilidade e tolerâncias", actions: tag.span("Correspondência", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-switches ax-studio-switches ax-studio-switches--2">
                <%= ax_switch_field(form: f, method: :ai_property_search_allow_flexible_results, label: "Sugerir alternativas após busca sem resultados", class_name: "ax-switch--card") %>
                <%= ax_switch_field(form: f, method: :ai_property_search_resilient_search_enabled, label: "Busca resiliente (sempre tentar alternativas)", class_name: "ax-switch--card") %>
                <%= ax_switch_field(form: f, method: :ai_property_search_fuzzy_matching_enabled, label: "Aceitar nomes aproximados", class_name: "ax-switch--card") %>
              </div>
              <details class="ax-studio-advanced" <%= "open" if property_setting.errors.any? %>>
<summary><i class="bi bi-sliders"></i><span>Avançado: tolerâncias da busca</span><i class="bi bi-chevron-down"></i></summary>
<div class="property-settings-ai-metrics">
                <%= ax_number_field(form: f, method: :ai_property_search_price_tolerance_percentage, label: "Tolerância de preço (%)", hint: "Aplicada para mais no máximo e para menos no mínimo pedidos.", min: 0, max: 30) %>
                <%= ax_number_field(form: f, method: :ai_property_search_fuzzy_similarity_threshold, label: "Similaridade mínima", hint: "0,30 equilibra variações e falsos positivos.", min: 0.1, max: 1, step: 0.05) %>
                <%= ax_number_field(form: f, method: :ai_property_search_location_fuzzy_threshold, label: "Similaridade mínima de localização", hint: "0,40 é mais conservador para cidades e bairros.", min: 0.1, max: 1, step: 0.05) %>
              </div>
</details>
            <% end %>
<details class="ax-studio-advanced" <%= "open" if property_setting.errors.any? %>>
<summary><i class="bi bi-sliders"></i><span>Avançado: parâmetros da resposta</span><i class="bi bi-chevron-down"></i></summary>
<%= ax_studio_group(title: "Parâmetros da resposta", actions: tag.span("IA", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-fields">
                <%= ax_number_field(form: f, method: :ai_property_search_temperature, label: "Variação da resposta (Temperature)", hint: "Padrão conservador: 0,20.", class_name: "ax-span-3", min: 0, max: 2, step: 0.01) %>
                <%= ax_number_field(form: f, method: :ai_property_search_top_p, label: "Diversidade (Top P)", hint: "Padrão: 0,80.", class_name: "ax-span-3", min: 0, max: 1, step: 0.01) %>
                <%= ax_number_field(form: f, method: :ai_property_search_frequency_penalty, label: "Repetições (Frequency penalty)", hint: "Padrão: 0,50.", class_name: "ax-span-3", min: -2, max: 2, step: 0.01) %>
                <%= ax_number_field(form: f, method: :ai_property_search_presence_penalty, label: "Novos termos (Presence penalty)", hint: "Padrão: 0,20.", class_name: "ax-span-3", min: -2, max: 2, step: 0.01) %>
              </div>
            <% end %>
</details>
<details class="ax-studio-advanced" <%= "open" if property_setting.errors.any? %>>
<summary><i class="bi bi-sliders"></i><span>Avançado: contexto do catálogo</span><i class="bi bi-chevron-down"></i></summary>
<%= ax_studio_group(title: "Profundidade do contexto do catálogo", actions: tag.span("Catálogo", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-fields">
                <%= ax_number_field(form: f, method: :ai_property_search_catalog_property_types_limit, label: "Tipos de imóvel no contexto", hint: "Padrão atual: 12.", class_name: "ax-span-4", min: 1, max: 50) %>
                <%= ax_number_field(form: f, method: :ai_property_search_catalog_cities_limit, label: "Cidades no contexto", hint: "Padrão atual: 12.", class_name: "ax-span-4", min: 1, max: 50) %>
                <%= ax_number_field(form: f, method: :ai_property_search_catalog_neighborhoods_limit, label: "Bairros no contexto", hint: "Padrão atual: 18.", class_name: "ax-span-4", min: 1, max: 80) %>
                <%= ax_number_field(form: f, method: :ai_property_search_catalog_developments_limit, label: "Empreendimentos no contexto", hint: "Padrão atual: 12.", class_name: "ax-span-4", min: 1, max: 50) %>
                <%= ax_number_field(form: f, method: :ai_property_search_catalog_feature_terms_limit, label: "Características e lazer", hint: "Padrão atual: 20.", class_name: "ax-span-4", min: 1, max: 100) %>
                <%= ax_number_field(form: f, method: :ai_property_search_catalog_alias_names_limit, label: "Nomes alternativos por empreendimento", hint: "Padrão atual: 5.", class_name: "ax-span-4", min: 1, max: 20) %>
              </div>
            <% end %>
</details>
<% end %>
<%= ax_operational_panel(title: "Resultados e mensagens", class_name: "ax-panel--settings tw-mb-4") do %>
<p class="ax-field__hint">Escolha a apresentação dos imóveis e os textos exibidos na busca.</p>
<%= ax_studio_group(title: "Apresentação dos resultados", actions: tag.span("Execução", class: "ax-badge ax-badge--gray"), class_name: "property-settings-ai-search-group") do %>
              <div class="property-settings-ai-fields">
                <%= ax_autocomplete_select_field(form: f, method: :ai_property_search_default_sort, label: "Ordenação padrão", choices: PropertySetting::AI_PROPERTY_SEARCH_SORTS.map { |value| [PropertySetting::AI_PROPERTY_SEARCH_SORT_LABELS.fetch(value, value.humanize), value] }, class_name: "ax-span-4") %>
                <%= ax_number_field(form: f, method: :ai_property_search_max_results, label: "Máximo de resultados", class_name: "ax-span-4", min: 1, max: 100) %>
                <%= ax_text_field(form: f, method: :ai_property_search_welcome_message, label: "Mensagem inicial", class_name: "ax-span-12") %>
                <%= ax_text_field(form: f, method: :ai_property_search_processing_message, label: "Mensagem durante o processamento", class_name: "ax-span-6") %>
                <%= ax_text_field(form: f, method: :ai_property_search_no_results_message, label: "Mensagem sem resultados", class_name: "ax-span-6") %>
              </div>
            <% end %>
<%= ax_studio_group(title: "Campos visíveis nos cards", subtitle: "Informações mostradas em cada imóvel do resultado, no PWA.", actions: tag.span("Resultado", class: "ax-badge ax-badge--gray")) do %>
              <%= ax_check_group(form: f, method: :ai_property_search_result_fields, choices: PropertySetting::AI_PROPERTY_SEARCH_RESULT_FIELD_OPTIONS.to_a) %>
            <% end %>
<% end %>
