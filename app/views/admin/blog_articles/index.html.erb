<%= ax_workspace_heading(title: "Blog", eyebrow: "Site público", icon: "journal-richtext", actions: ax_button("Novo artigo", new_admin_blog_article_path, variant: :primary, icon: "plus-lg")) %>
<%= ax_filter_form(url: admin_blog_articles_path, reset_path: admin_blog_articles_path) do |form| %>
  <%= ax_field_grid do %>
    <div class="ax-span-6"><%= ax_text_field(form: form, method: :q, label: "Buscar artigo", value: params[:q], placeholder: "Título ou palavra-chave") %></div>
    <div class="ax-span-3"><%= ax_select_field(form: form, method: :category_id, label: "Categoria", choices: @categories.map { |c| [c.name, c.id] }, select_options: { include_blank: "Todas", selected: params[:category_id] }) %></div>
    <div class="ax-span-3"><%= ax_select_field(form: form, method: :status, label: "Status", choices: BlogArticle::STATUS_LABELS.map { |value, label| [label, value] }, select_options: { include_blank: "Todos", selected: params[:status] }) %></div>
  <% end %>
<% end %>
  <div class="ax-table-wrap"><table class="ax-table ax-table--media-list">
    <thead><tr><th>Artigo</th><th>Categorias</th><th>Status</th><th>Publicação</th><th class="ax-num">Ações</th></tr></thead>
    <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= render "admin/shared/ui/table_record", title: article.title, url: edit_admin_blog_article_path(article), image_url: article.cover.attached? ? blog_image_url(article.cover, size: [132, 88]) : nil %></td>
        <td><% article.blog_categories.each do |category| %><div><%= category.name %></div><% end %><%= "Sem categoria" if article.blog_categories.empty? %></td>
        <td><%= ax_badge(BlogArticle::STATUS_LABELS.fetch(article.publication_status), tone: { "published" => :green, "scheduled" => :blue, "inactive" => :gray, "draft" => :gray }.fetch(article.publication_status)) %></td>
        <td><%= l(article.published_at, format: "%d/%m/%Y %H:%M") if article.published_at %></td>
        <td class="ax-num">
          <% actions = capture do %>
            <% if article.publicly_visible? %><%= link_to article.public_url(fallback_base_url: request.base_url), target: "_blank", rel: "noopener", class: "ax-menu__item" do %><%= ax_icon("box-arrow-up-right") %><span>Ver artigo publicado</span><% end %><% end %>
            <%= link_to preview_admin_blog_article_path(article), target: "_blank", rel: "noopener", class: "ax-menu__item" do %><%= ax_icon("eye") %><span>Preview</span><% end %>
            <%= link_to edit_admin_blog_article_path(article), class: "ax-menu__item" do %><%= ax_icon("pencil") %><span>Editar</span><% end %>
            <div class="ax-menu__sep"></div>
            <%= button_to admin_blog_article_path(article), method: :delete, class: "ax-menu__item ax-menu__item--danger", form: { data: { turbo_confirm: "Excluir o artigo ‘#{article.title}’? Esta ação não pode ser desfeita." } } do %><%= ax_icon("trash") %><span>Excluir</span><% end %>
          <% end %>
          <%= render "admin/shared/ui/actions_dropdown", label: "Ações para #{article.title}", actions: actions %>
        </td>
      </tr>
    <% end %>
    <% if @articles.empty? %><tr><td colspan="5">Nenhum artigo encontrado.</td></tr><% end %>
    </tbody>
  </table></div>
  <%= ax_pagination(@articles) %>
