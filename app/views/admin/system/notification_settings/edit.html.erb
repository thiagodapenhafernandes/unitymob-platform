<% content_for :title, "Notificações Globais — Admin do Sistema" %>

<% content_for :admin_contextbar_breadcrumb do %>
  <%= link_to "Plataforma", admin_system_path %>
  <i class="bi bi-chevron-right"></i>
  <strong>Notificações Globais</strong>
<% end %>

<% content_for :admin_contextbar_actions do %>
  <%= link_to admin_system_path, class: "ax-contextbar__button" do %>
    <i class="bi bi-hdd-stack"></i><span>Painel</span>
  <% end %>
<% end %>

<%
  system_setting = @system_setting
  global_email = @global_email
  push_setting = @push_setting
  wa_configured = system_setting.respond_to?(:whatsapp_configured?) ? (system_setting.whatsapp_configured? rescue false) : false
  email_ready = global_email.respond_to?(:configured?) ? (global_email.configured? rescue false) : false
  push_ready = push_setting.respond_to?(:configured?) ? (push_setting.configured? rescue false) : false
  encryption_ready = global_email.respond_to?(:encryption_ready?) ? (global_email.encryption_ready? rescue false) : true
%>

<div class="ax-system">
  <%= ax_workspace_heading(
        eyebrow: "Admin do Sistema",
        icon: "bell",
        title: "Notificações globais",
        subtitle: "Transportes globais de notificação — WhatsApp, SMTP e Web Push — usados como fallback opt-in pelas contas. Cada conta só usa o global quando não tem integração própria pronta e o opt-in está ligado.",
        actions: ax_badge(wa_configured ? "WhatsApp pronto" : "WhatsApp incompleto", tone: wa_configured ? :green : :gray, dot: true)
      ) %>

  <% unless encryption_ready %>
    <%= ax_inline_notice(tone: :warning, icon: "shield-lock") do %>
      Criptografia indisponível: defina <code>AR_ENCRYPTION_PRIMARY_KEY</code>, <code>AR_ENCRYPTION_DETERMINISTIC_KEY</code>
      e <code>AR_ENCRYPTION_KEY_DERIVATION_SALT</code> no ambiente para guardar tokens e senhas com segurança.
    <% end %>
  <% end %>

  <%
    studio_items = [
      { id: "sys-tab-whatsapp", icon: "whatsapp", label: "WhatsApp e webhooks", hint: "Número global e segredos da Meta" },
      { id: "sys-tab-smtp", icon: "envelope-at", label: "SMTP global", hint: "E-mail de fallback" },
      { id: "sys-tab-push", icon: "phone-vibrate", label: "Web Push", hint: "Transporte VAPID global" },
      { id: "sys-tab-tenants", icon: "buildings", label: "Contas", hint: "Opt-in do fallback por conta" }
    ]
    dirty_form = { controller: "ax-dirty-form", action: "input->ax-dirty-form#mark change->ax-dirty-form#mark" }
  %>
  <div class="ax-studio">
    <div class="ax-studio__nav">
      <%= ax_studio_nav(items: studio_items, panels_selector: "#sys-studio-sections", label: "Transportes globais de notificação") %>
    </div>

    <div class="ax-studio__stage" id="sys-studio-sections">
      <%# ============ WhatsApp global + segredos de webhook ============ %>
      <%= ax_studio_section(id: "sys-tab-whatsapp", icon: "whatsapp", active: true,
                            title: "WhatsApp global e webhooks",
                            subtitle: "Número global de notificações e os segredos que validam as entregas da Meta.",
                            actions: ax_badge(wa_configured ? "Pronto" : "Incompleto", tone: wa_configured ? :green : :gray, dot: true)) do %>
        <% if system_setting.present? %>
          <%= form_with(model: system_setting, url: admin_system_notification_settings_path, method: :patch, local: true, data: dirty_form, class: "layout-settings-form ax-studio-form") do |f| %>
            <%= ax_error_summary(system_setting) %>

            <%= ax_studio_group(title: "Número global de notificações", subtitle: "Usado por contas com o opt-in ligado e sem integração WhatsApp própria pronta.", icon: "whatsapp") do %>
              <%= ax_switch_field(form: f, method: :whatsapp_enabled, label: "Ativar WhatsApp global", description: "Liga ou desliga o número global para todas as contas com opt-in.", class_name: "ax-switch--card") %>
              <%= ax_field_grid do %>
                <div class="ax-span-12">
                  <% token_set = system_setting.respond_to?(:whatsapp_access_token) && (system_setting.whatsapp_access_token.present? rescue false) %>
                  <%= ax_text_field(form: f, method: :whatsapp_access_token, label: "Access token (permanente)", type: :password, value: nil,
                        autocomplete: "new-password", placeholder: token_set ? "•••••••• (preenchido)" : "EAAG...",
                        hint: "Deixe em branco para manter o token atual.") %>
                </div>
                <div class="ax-span-4">
                  <%= ax_text_field(form: f, method: :whatsapp_phone_number_id, label: "Phone Number ID", placeholder: "1234567890") %>
                </div>
                <div class="ax-span-4">
                  <%= ax_text_field(form: f, method: :whatsapp_business_account_id, label: "WhatsApp Business Account ID", placeholder: "opcional") %>
                </div>
                <div class="ax-span-4">
                  <%= ax_text_field(form: f, method: :whatsapp_template_name, label: "Template padrão", placeholder: "novo_lead") %>
                </div>
              <% end %>
            <% end %>

            <%= ax_studio_group(title: "Segredos de assinatura (Meta)", icon: "key",
                  subtitle: safe_join(["Validam a assinatura das entregas de webhook da Meta. Em branco, o sistema cai para as variáveis de ambiente."])) do %>
              <%= ax_field_grid do %>
                <div class="ax-span-6">
                  <% fb_set = system_setting.respond_to?(:facebook_app_secret) && (system_setting.facebook_app_secret.present? rescue false) %>
                  <%= ax_text_field(form: f, method: :facebook_app_secret, label: "Facebook App Secret", type: :password, value: nil,
                        autocomplete: "new-password", placeholder: fb_set ? "•••••••• (preenchido)" : "",
                        hint: "Deixe em branco para manter o atual.") %>
                </div>
                <div class="ax-span-6">
                  <% wa_set = system_setting.respond_to?(:whatsapp_app_secret) && (system_setting.whatsapp_app_secret.present? rescue false) %>
                  <%= ax_text_field(form: f, method: :whatsapp_app_secret, label: "WhatsApp App Secret", type: :password, value: nil,
                        autocomplete: "new-password", placeholder: wa_set ? "•••••••• (preenchido)" : "",
                        hint: "Deixe em branco para manter o atual.") %>
                </div>
              <% end %>
            <% end %>

            <%= ax_studio_savebar(form: f, cancel_path: admin_system_path, submit_label: "Salvar WhatsApp e webhooks") %>
          <% end %>
        <% else %>
            <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
              O modelo de notificação global (<code>SystemNotificationSetting</code>) ainda não existe neste ambiente — rode as migrations pendentes para editar o WhatsApp global e os segredos de webhook.
            <% end %>
        <% end %>
      <% end %>

      <%# ============ SMTP global de fallback ============ %>
      <%= ax_studio_section(id: "sys-tab-smtp", icon: "envelope-at",
                            title: "SMTP global de fallback",
                            subtitle: "Contas com opt-in de e-mail ligado e sem SMTP próprio usam este servidor.",
                            actions: ax_badge(email_ready ? "Pronto" : "Incompleto", tone: email_ready ? :green : :gray, dot: true)) do %>
        <% if global_email.present? %>
          <%= form_with(model: global_email, url: admin_system_notification_settings_path, method: :patch, local: true, data: dirty_form, class: "layout-settings-form ax-studio-form") do |f| %>
            <%= ax_error_summary(global_email) %>

            <%= ax_studio_group(title: "E-mail de fallback", icon: "envelope-at") do %>
              <%= ax_switch_field(form: f, method: :enabled, label: "Ativar SMTP global", description: "Liga ou desliga o servidor de fallback.", class_name: "ax-switch--card") %>
              <%= ax_field_grid do %>
                <div class="ax-span-6">
                  <%= ax_text_field(form: f, method: :from_name, label: "Nome do remetente", placeholder: "Ex.: Plataforma") %>
                </div>
                <div class="ax-span-6">
                  <%= ax_text_field(form: f, method: :from_email, label: "E-mail do remetente", type: :email, placeholder: "no-reply@plataforma.com.br") %>
                </div>
                <div class="ax-span-8">
                  <%= ax_text_field(form: f, method: :smtp_address, label: "Host SMTP", placeholder: "smtp.seuprovedor.com") %>
                </div>
                <div class="ax-span-4">
                  <%= ax_measure_field(form: f, method: :smtp_port, label: "Porta", unit: "TCP", placeholder: "587", step: 1, min: 1, max: 65535) %>
                </div>
                <div class="ax-span-6">
                  <%= ax_text_field(form: f, method: :smtp_user_name, label: "Usuário", placeholder: "no-reply@plataforma.com.br") %>
                </div>
                <div class="ax-span-6">
                  <% pass_set = global_email.respond_to?(:encryption_ready?) && global_email.encryption_ready? && (global_email.smtp_password.present? rescue false) %>
                  <%= ax_text_field(form: f, method: :smtp_password, label: "Senha", type: :password, value: nil,
                        autocomplete: "new-password", placeholder: pass_set ? "•••••••• (preenchida)" : "",
                        hint: "Deixe em branco para manter a senha atual.") %>
                </div>
                <div class="ax-span-6">
                  <%= ax_autocomplete_select_field(form: f, method: :smtp_authentication, label: "Autenticação",
                        choices: EmailSetting::AUTHENTICATIONS.map { |a| [a, a] }) %>
                </div>
                <div class="ax-span-6">
                  <%= ax_text_field(form: f, method: :reply_to, label: "Responder para (reply-to)", type: :email, placeholder: "opcional") %>
                </div>
              <% end %>
              <%= ax_switch_field(form: f, method: :smtp_enable_starttls_auto, label: "STARTTLS automático", description: "Negocia a criptografia da conexão quando o servidor oferece.", class_name: "ax-switch--card") %>
            <% end %>

            <%= ax_studio_savebar(form: f, cancel_path: admin_system_path, submit_label: "Salvar SMTP global") %>
          <% end %>
        <% end %>
      <% end %>

      <%# ============ Web Push (VAPID) global ============ %>
      <%= ax_studio_section(id: "sys-tab-push", icon: "phone-vibrate",
                            title: "Web Push (VAPID)",
                            subtitle: "O transporte VAPID é global; o alvo (aparelho do corretor) é resolvido por conta no dispatcher.",
                            actions: ax_badge(push_ready ? "Pronto" : "Incompleto", tone: push_ready ? :green : :gray, dot: true)) do %>
        <% if push_setting.present? %>
          <%= form_with(model: [:admin, push_setting], url: admin_system_notification_settings_path, method: :patch, local: true, data: dirty_form, class: "layout-settings-form ax-studio-form") do |f| %>
            <%= ax_error_summary(push_setting) %>

            <%= ax_studio_group(title: "Transporte de push global", icon: "phone-vibrate") do %>
              <%= ax_switch_field(form: f, method: :enabled, label: "Ativar Web Push", description: "Liga ou desliga o transporte global.", class_name: "ax-switch--card") %>
              <%= ax_text_field(form: f, method: :subject_email, label: "E-mail de contato (VAPID subject)",
                    type: :email, placeholder: (ENV["VAPID_SUBJECT_EMAIL"].presence || "suporte@plataforma.com.br"),
                    hint: "Exigido pelo protocolo Web Push como canal de contato do remetente.") %>
            <% end %>

            <%= ax_studio_savebar(form: f, cancel_path: admin_system_path, submit_label: "Salvar Web Push") %>
          <% end %>

          <%= ax_studio_group(title: "Chaves VAPID", icon: "key", subtitle: "Credenciais que assinam o envio. A chave privada nunca é exibida.",
                actions: (push_setting.respond_to?(:keys_source) ? (
                push_setting.keys_source == :custom ? ax_badge("Personalizadas", tone: :amber) :
                (push_setting.keys_source == :env ? ax_badge("Do ambiente (ENV)", tone: :blue) : ax_badge("Ausentes", tone: :gray))
              ) : nil)) do %>
            <% if push_setting.respond_to?(:keys_present?) && push_setting.keys_present? %>
              <div class="ax-field">
                <%= ax_field_label(nil, nil, text: "Chave pública (em uso)") %>
                <textarea class="ax-control" rows="2" readonly><%= push_setting.effective_public_key %></textarea>
                <p class="ax-field__hint">
                  <% if push_setting.keys_source == :env %>
                    Vindas da configuração do servidor (<code>VAPID_*</code>). É o recomendado — dispositivos já inscritos continuam funcionando.
                  <% else %>
                    Geradas aqui e guardadas criptografadas. A chave privada nunca é exibida.
                  <% end %>
                </p>
              </div>
            <% else %>
              <%= ax_inline_notice(tone: :warning, icon: "key") do %>
                Nenhuma chave VAPID disponível. Defina <code>VAPID_PUBLIC_KEY</code> / <code>VAPID_PRIVATE_KEY</code> no ambiente
                <% if push_setting.respond_to?(:encryption_ready?) && push_setting.encryption_ready? %>ou gere um par na tela de Push<% end %>.
              <% end %>
            <% end %>
            <p class="ax-field__hint">
              A geração/rotação das chaves VAPID fica na tela <%= link_to "Push (PWA)", edit_admin_push_setting_path, class: "ax-link" %>.
            </p>
          <% end %>
        <% end %>
      <% end %>

      <%# ============ Opt-in do fallback global por conta ============ %>
      <%= ax_studio_section(id: "sys-tab-tenants", icon: "buildings",
                            title: "Fallback global por conta (opt-in)",
                            subtitle: "Cada conta só usa o transporte global quando liga o opt-in e a integração própria dela não está pronta.",
                            actions: ax_badge("#{@tenants.to_a.size} contas", tone: :gray)) do %>
        <%= ax_studio_group(title: "Contas") do %>
          <% unless @fallback_columns_ready %>
            <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle") do %>
              As colunas <code>use_global_whatsapp_fallback</code> / <code>use_global_email_fallback</code> ainda não existem no Tenant — rode as migrations pendentes para habilitar os opt-ins.
            <% end %>
          <% end %>

          <% if @tenants.blank? %>
            <%= ax_empty_state(title: "Nenhuma conta cadastrada", description: "Crie uma conta para configurar o fallback global.", icon: "building") %>
          <% else %>
            <%= form_with(url: update_tenant_fallbacks_admin_system_notification_settings_path, method: :patch, local: true) do %>
              <div class="ax-table-wrap">
                <table class="ax-table">
                  <thead>
                    <tr>
                      <th>Conta</th>
                      <th class="ax-table__col--w-160">WhatsApp global</th>
                      <th class="ax-table__col--w-160">E-mail global</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @tenants.each do |tenant| %>
                      <% wa_on = tenant.has_attribute?(:use_global_whatsapp_fallback) ? (tenant.use_global_whatsapp_fallback rescue false) : false %>
                      <% email_on = tenant.has_attribute?(:use_global_email_fallback) ? (tenant.use_global_email_fallback rescue false) : false %>
                      <tr>
                        <td class="ax-strong"><%= tenant.name %></td>
                        <td>
                          <%= ax_check_field(name: "use_global_whatsapp_fallback[]", value: tenant.id, checked: wa_on, id: "use_global_whatsapp_fallback_#{tenant.id}", label: "Usar", input_html: { disabled: !@fallback_columns_ready }) %>
                        </td>
                        <td>
                          <%= ax_check_field(name: "use_global_email_fallback[]", value: tenant.id, checked: email_on, id: "use_global_email_fallback_#{tenant.id}", label: "Usar", input_html: { disabled: !@fallback_columns_ready }) %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <%= ax_form_actions(sticky: false) do %>
                <%= submit_tag "Salvar opt-ins", class: "ax-btn ax-btn--primary", disabled: !@fallback_columns_ready %>
              <% end %>
            <% end %>
          <% end %>

        <% end %>
      <% end %>
    </div>

    <aside class="ax-studio__aside" aria-label="Status dos transportes">
      <%= ax_studio_group(title: "Transportes globais", subtitle: "Estado atual de cada canal.", icon: "activity") do %>
        <%= ax_status_list(
              label: "Estado dos transportes globais",
              rows: [
                { label: "WhatsApp global", value: ax_badge(wa_configured ? "Pronto" : "Incompleto", tone: wa_configured ? :green : :gray, dot: true) },
                { label: "SMTP global", value: ax_badge(email_ready ? "Pronto" : "Incompleto", tone: email_ready ? :green : :gray, dot: true) },
                { label: "Web Push (VAPID)", value: ax_badge(push_ready ? "Pronto" : "Incompleto", tone: push_ready ? :green : :gray, dot: true) }
              ]
            ) %>
        <p class="ax-field__hint">
          Um transporte só é usado por uma conta quando o <strong>opt-in</strong> da conta está ligado e a integração <strong>própria</strong> dela não está pronta.
        </p>
      <% end %>

      <%= ax_studio_group(title: "Ordem de resolução", icon: "diagram-2") do %>
        <ol class="ax-field__hint ax-field__hint--steps">
          <li>A conta usa <strong>sempre</strong> a integração própria quando ela está pronta.</li>
          <li>Se não estiver e o <strong>opt-in</strong> da conta estiver ligado, cai para o transporte global.</li>
          <li>Sem opt-in ou sem global configurado, o canal simplesmente não dispara.</li>
        </ol>

      <% end %>
    </aside>
  </div>
</div>
