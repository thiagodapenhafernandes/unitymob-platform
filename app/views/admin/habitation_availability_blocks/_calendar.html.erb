<%= turbo_frame_tag dom_id(@habitation, :availability_picker) do %>
  <div data-current-month="<%= @month.strftime("%Y-%m") %>">
  <%= render "admin/shared/ui/date_range_calendar", month: @month, weeks: rental_availability_days(@month, @blocks),
        previous_path: admin_habitation_availability_blocks_path(@habitation.id, modal: "1", calendar: "1", month: (@month << 1).strftime("%Y-%m")),
        next_path: admin_habitation_availability_blocks_path(@habitation.id, modal: "1", calendar: "1", month: (@month >> 1).strftime("%Y-%m")) %>
    <details class="ax-date-range__blocks">
      <summary>Bloqueios de <%= l(@month, format: "%B de %Y") %> · <%= @blocks.size %></summary>
      <% if @blocks.empty? %><p class="ax-guided-hint">Nenhum período bloqueado neste mês.</p><% end %>
      <% @blocks.each do |block| %>
        <div class="ax-date-range__block">
          <span><%= l(block.starts_on) %> a <%= l(block.ends_on) %></span>
          <%= button_to "Liberar período", admin_habitation_availability_block_path(@habitation.id, block, modal: "1", month: @month.strftime("%Y-%m")), method: :delete, form: { data: { turbo_frame: dom_id(@habitation, :availability_modal) } }, class: "ax-btn ax-btn--sm ax-btn--secondary", data: { turbo_confirm: "Liberar este período no calendário?" } %>
        </div>
      <% end %>
    </details>
  </div>
<% end %>
