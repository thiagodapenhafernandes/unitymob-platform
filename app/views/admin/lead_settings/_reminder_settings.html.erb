<%= ax_studio_section(id: "lead-tab-reminders", icon: "alarm",
                      title: "Lembretes de tarefas, agenda e visitas",
                      subtitle: "Lembretes por push para o responsável da atividade. As regras abaixo valem para esta conta, inclusive para atividades pessoais.") do %>
  <%= ax_studio_group(title: "Antes do horário agendado", subtitle: "Até três avisos antes do compromisso, mais um opcional no vencimento.") do %>
    <%= ax_field_grid(columns: 12) do %>
      <div class="ax-span-4"><%= ax_measure_field(form: f, method: :reminder_first_minutes, label: "1º lembrete", unit: "min antes", min: 1, max: 10080, step: 1, required: true) %></div>
      <div class="ax-span-4"><%= ax_measure_field(form: f, method: :reminder_second_minutes, label: "2º lembrete", unit: "min antes", min: 1, max: 10080, step: 1, required: true) %></div>
      <div class="ax-span-4"><%= ax_measure_field(form: f, method: :reminder_third_minutes, label: "3º lembrete", unit: "min antes", min: 1, max: 10080, step: 1, required: true) %></div>
    <% end %>
    <%= ax_switch_field(form: f, method: :reminder_due_enabled, label: "Avisar também no vencimento", class_name: "ax-switch--card") %>
  <% end %>

  <%= ax_studio_group(title: "Enquanto a atividade estiver atrasada", subtitle: "Horário de Brasília. O intervalo é contado a partir do último envio.") do %>
    <%= ax_field_grid(columns: 12) do %>
      <div class="ax-span-4"><%= ax_measure_field(form: f, method: :reminder_overdue_minutes, label: "Repetir a cada", unit: "min", min: 1, max: 10080, step: 1, required: true) %></div>
      <div class="ax-span-4"><%= ax_text_field(form: f, method: :reminder_start_time, label: "A partir de", type: :time, required: true, step: 60) %></div>
      <div class="ax-span-4"><%= ax_text_field(form: f, method: :reminder_end_time, label: "Até", type: :time, required: true, step: 60) %></div>
    <% end %>
  <% end %>

  <%= ax_studio_group(title: "Quando uma tentativa falhar", subtitle: "Aplica-se à repetição de uma tentativa. Os próximos lembretes programados mantêm seus horários.") do %>
    <%= ax_field_grid(columns: 12) do %>
      <div class="ax-span-4"><%= ax_measure_field(form: f, method: :reminder_retry_minutes, label: "Aguardar antes de tentar de novo", unit: "min", min: 1, max: 10080, step: 1, required: true) %></div>
    <% end %>
  <% end %>
<% end %>
