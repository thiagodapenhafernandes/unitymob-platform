<% content_for :admin_contextbar_title, @public_form.name %>
<% content_for :admin_contextbar_actions do %>
  <%= link_to admin_public_forms_path, class: "ax-contextbar__button" do %>
    <i class="bi bi-arrow-left ax-ico"></i><span>Voltar</span>
  <% end %>
  <%= link_to admin_public_form_path(@public_form), class: "ax-contextbar__button" do %>
    <i class="bi bi-inbox ax-ico"></i><span>Ver envios</span>
  <% end %>
<% end %>

<%= render "form", public_form: @public_form %>
