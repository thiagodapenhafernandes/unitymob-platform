<h1 class="wizard-section-title"><i class="bi bi-house-heart-fill tw-text-primary"></i>Vamos começar</h1>
<p class="wizard-section-subtitle">
  Olá, <strong><%= current_admin_user.name.split.first %></strong>! Selecione o tipo de cadastro, a categoria e o status comercial.
</p>

<%
  cadastro_profiles = Habitation::REGISTRATION_PROFILES
  cadastro_categories = cadastro_profiles.transform_values { |config| config.fetch(:categories) }
  cadastro_type_labels = cadastro_profiles.transform_values { |config| config.fetch(:label) }
  cadastro_type_icons = cadastro_profiles.transform_values { |config| config.fetch(:icon) }
  inferred_cadastro_type = @captacao.registration_group
  current_category = @captacao.categoria
  if current_category.present?
    cadastro_categories[inferred_cadastro_type] = (cadastro_categories.fetch(inferred_cadastro_type) + [current_category]).uniq
  end
%>

<div class="wizard-start-grid"
     data-controller="habitation-form"
     data-habitation-form-categories-by-type-value="<%= json_escape(cadastro_categories.to_json) %>"
     data-habitation-form-tipo-by-type-value="<%= json_escape(cadastro_profiles.transform_values { |config| config.fetch(:tipo) }.to_json) %>">
  <div class="wizard-field-group">
    <label class="ax-label">Tipo de cadastro <span class="required-star">*</span></label>
    <div class="wizard-option-grid" data-controller="option-picker">
      <% cadastro_type_labels.each do |val, label| %>
        <div>
          <label class="wizard-option-card <%= 'selected' if inferred_cadastro_type == val %>">
            <%= radio_button_tag "habitation[cadastro_type]",
                                 val,
                                 inferred_cadastro_type == val,
                                 data: {
                                   habitation_form_target: "cadastroType",
                                   action: "change->option-picker#pick change->habitation-form#cadastroTypeChanged"
                                 } %>
            <div class="icon"><i class="bi <%= cadastro_type_icons[val] %>"></i></div>
            <div class="wizard-option-card__text"><%= label %></div>
          </label>
        </div>
      <% end %>
    </div>
    <%= f.hidden_field :tipo, value: (@captacao.tipo.presence || (inferred_cadastro_type == "empreendimento" ? "Empreendimento" : "Unitário")), data: { habitation_form_target: "tipo" } %>
  </div>

  <%= ax_select_field(form: f, method: :categoria, label: "Categoria",
        choices: cadastro_categories.fetch(inferred_cadastro_type),
        select_options: { include_blank: "Selecione..." }, class_name: "wizard-field-group",
        html_options: { data: { habitation_form_target: "category" } }) %>

  <div class="wizard-field-group">
    <label class="ax-label">Status comercial <span class="required-star">*</span></label>
    <div class="wizard-option-grid" data-controller="option-picker">
      <% [
        ["venda",          "Venda",           "bi-cash-coin"],
        ["locacao_anual",  "Locação anual",   "bi-calendar-month"],
        ["ambos",          "Venda e locação", "bi-arrow-left-right"],
        ["locacao_diaria", "Locação diária",  "bi-calendar-day"]
      ].each do |val, label, icon| %>
        <div>
          <label class="wizard-option-card <%= 'selected' if @captacao.modalidade == val %>">
            <%= f.radio_button :modalidade, val, data: { action: "change->option-picker#pick" } %>
            <div class="icon"><i class="bi <%= icon %>"></i></div>
            <div class="wizard-option-card__text"><%= label %></div>
          </label>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= ax_inline_notice(tone: :neutral, icon: "info-circle-fill") do %>
  Você está logado como <strong><%= current_admin_user.name %></strong>. A captação vai ficar atribuída a você automaticamente.
<% end %>
