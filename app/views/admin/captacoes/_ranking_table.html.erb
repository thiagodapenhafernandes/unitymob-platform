<% max_ct = rows.map { |row| row.ct.to_i }.max.to_i %>
<% max_ct = 1 if max_ct.zero? %>
<% secondary_count_key = local_assigns[:secondary_count_key] %>
<% secondary_count_label = local_assigns[:secondary_count_label] %>
<% stacked_count_segments = local_assigns[:stacked_count_segments] || [] %>
<% secondary_stacked_count_segments = local_assigns[:secondary_stacked_count_segments] || [] %>
<% has_secondary_count = secondary_count_key.present? %>
<% max_secondary_ct = has_secondary_count ? rows.map { |row| row.public_send(secondary_count_key).to_i }.max.to_i : 1 %>
<% max_secondary_ct = 1 if max_secondary_ct.zero? %>
<% secondary_bar_max = secondary_stacked_count_segments.any? ? max_ct : max_secondary_ct %>
<div class="ax-table-wrap">
  <table class="ax-table">
    <thead class="capt-ranking-table__head">
      <tr>
        <th class="ax-table__col--w-40">Rank</th>
        <th>Corretor</th>
        <th class="capt-ranking-table__col-chart">Captação</th>
        <% if has_secondary_count %>
          <th class="capt-ranking-table__col-chart"><%= secondary_count_label %></th>
        <% end %>
        <th class="tw-text-right"><%= value_label %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each_with_index do |row, i| %>
        <% secondary_count = has_secondary_count ? row.public_send(secondary_count_key).to_i : nil %>
        <tr class="capt-ranking-row">
          <td class="tw-font-bold tw-text-ink-muted"><%= i + 1 %></td>
          <td><%= row.name %></td>
          <td>
            <% if stacked_count_segments.any? %>
              <% count_percent = (row.ct.to_f / max_ct * 100).round(2) %>
              <% segment_texts = stacked_count_segments.filter_map { |segment| segment_count = row.public_send(segment[:key]).to_i; "#{segment_count} #{segment[:label]}" if segment_count.positive? } %>
              <div class="bar-cell bar-cell--stacked">
                <div class="capt-ranking-stacked" role="img" aria-label="<%= "#{row.name}: #{segment_texts.presence&.join(', ') || '0 captações'}" %>">
                  <div class="capt-ranking-stacked__fill" style="width: <%= count_percent %>%;">
                    <% stacked_count_segments.each do |segment| %>
                      <% segment_count = row.public_send(segment[:key]).to_i %>
                      <% next if segment_count.zero? %>
                      <span class="capt-ranking-stacked__segment capt-ranking-stacked__segment--<%= segment[:tone] %>" style="flex: <%= segment_count %>;" title="<%= "#{segment_count} #{segment[:label]}" %>">
                        <span class="capt-ranking-stacked__segment-label">
                          <span class="capt-ranking-stacked__segment-count"><%= segment_count %></span>
                          <span class="capt-ranking-stacked__segment-text"><%= segment[:label] %></span>
                        </span>
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="bar-cell">
                <%= ax_progress(
                  value: (row.ct.to_f / max_ct * 100).to_i,
                  class_name: "capt-ranking-row__progress",
                  label: "#{row.name}: #{row.ct} captações"
                ) %>
                <span class="label"><%= row.ct %></span>
              </div>
            <% end %>
          </td>
          <% if has_secondary_count %>
            <td>
              <% if secondary_stacked_count_segments.any? %>
                <% secondary_percent = (secondary_count.to_f / secondary_bar_max * 100).round(2) %>
                <% secondary_segment_texts = secondary_stacked_count_segments.filter_map { |segment| segment_count = row.public_send(segment[:key]).to_i; "#{segment_count} #{segment[:label]}" if segment_count.positive? } %>
                <div class="bar-cell bar-cell--stacked">
                  <div class="capt-ranking-stacked" role="img" aria-label="<%= "#{row.name}: #{secondary_segment_texts.presence&.join(', ') || '0 captações'} com administração" %>">
                    <div class="capt-ranking-stacked__fill" style="width: <%= secondary_percent %>%;">
                      <% secondary_stacked_count_segments.each do |segment| %>
                        <% segment_count = row.public_send(segment[:key]).to_i %>
                        <% next if segment_count.zero? %>
                        <span class="capt-ranking-stacked__segment capt-ranking-stacked__segment--<%= segment[:tone] %>" style="flex: <%= segment_count %>;" title="<%= "#{segment_count} #{segment[:label]}" %>">
                          <span class="capt-ranking-stacked__segment-label">
                            <span class="capt-ranking-stacked__segment-count"><%= segment_count %></span>
                            <span class="capt-ranking-stacked__segment-text"><%= segment[:label] %></span>
                          </span>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% else %>
                <div class="bar-cell">
                  <%= ax_progress(
                    value: (secondary_count.to_f / max_secondary_ct * 100).to_i,
                    class_name: "capt-ranking-row__progress capt-ranking-row__progress--secondary",
                    label: "#{row.name}: #{secondary_count} captações com administração"
                  ) %>
                  <span class="label"><%= secondary_count %></span>
                </div>
              <% end %>
            </td>
          <% end %>
          <td class="tw-text-right tw-font-semibold">
            <%= number_to_currency(row.total_value.to_f, unit: "R$ ", precision: 0) %>
          </td>
        </tr>
      <% end %>
      <% if rows.empty? %>
        <tr><td colspan="<%= has_secondary_count ? 5 : 4 %>" class="tw-text-center tw-text-ink-muted tw-py-2"><i class="bi bi-inbox"></i> Sem dados no período.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
