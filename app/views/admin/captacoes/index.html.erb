<%# Captações — compacto (.ax-*). %>
<% modalidade_map = { "venda" => ["blue", "Venda"], "locacao_anual" => ["amber", "Locação"], "ambos" => ["green", "Ambos"], "locacao_diaria" => ["blue", "Temporada"] } %>
<% dashboard = @captacoes_dashboard || {} %>
<% filters_active = params[:property_kind].present? || params[:status].present? || params[:corretor_id].present? || @q.present? %>
<% default_status_label = can_filter_intakes_by_broker? ? "Todos" : "Minhas pendências" %>
<% status_filter_options = [
  (can_filter_intakes_by_broker? ? ["Todos", "all"] : ["Minhas pendências", ""]),
  ["Rascunho", "draft"],
  ["Em revisão administrativa", "submitted_for_admin_review"],
  ["Publicar no site", "admin_approved"],
  ["Interno", "internal"],
  ["Publicado no site", "published"],
  ["Devolvido ao corretor", "returned_to_broker"]
] %>
<% selected_status_filter = params[:status].presence || (can_filter_intakes_by_broker? ? "all" : "") %>
<% status_tiles = [
  ["Total", dashboard[:total].to_i, "neutral"],
  ["Rascunhos", dashboard[:draft].to_i, "amber"],
  ["Em revisão adm.", dashboard[:submitted_for_admin_review].to_i, "blue"],
  ["Publicar no site", dashboard[:admin_approved].to_i, "cyan"],
  ["Internas", dashboard[:internal].to_i, "neutral"],
  ["Publicadas no site", dashboard[:published].to_i, "green"],
  ["Devolvidas", dashboard[:returned_to_broker].to_i, "red"]
] %>
<% pending_count = dashboard[:draft].to_i + dashboard[:submitted_for_admin_review].to_i + dashboard[:admin_approved].to_i %>
<% pwa_base_params = request.query_parameters.except("page", "status") %>
<% pwa_search_params = request.query_parameters.except("q", "page") %>
<% pwa_active_status = params[:status].presence || (can_filter_intakes_by_broker? ? "all" : "") %>
<% pwa_status_tabs = [
  {
    key: can_filter_intakes_by_broker? ? "all" : "",
    label: can_filter_intakes_by_broker? ? "Todas" : "Pendências",
    icon: "collection",
    path: admin_captacoes_path(pwa_base_params.merge(status: can_filter_intakes_by_broker? ? "all" : "")),
    count: can_filter_intakes_by_broker? ? dashboard[:total].to_i : pending_count
  },
  { key: "draft", label: "Rascunhos", icon: "file-earmark-text", path: admin_captacoes_path(pwa_base_params.merge(status: "draft")), count: dashboard[:draft].to_i },
  { key: "submitted_for_admin_review", label: "Revisão", icon: "clipboard-check", path: admin_captacoes_path(pwa_base_params.merge(status: "submitted_for_admin_review")), count: dashboard[:submitted_for_admin_review].to_i },
  { key: "admin_approved", label: "Para site", icon: "send", path: admin_captacoes_path(pwa_base_params.merge(status: "admin_approved")), count: dashboard[:admin_approved].to_i },
  { key: "published", label: "Publicadas", icon: "globe2", path: admin_captacoes_path(pwa_base_params.merge(status: "published")), count: dashboard[:published].to_i }
] %>
<% intake_status_badge_tones = {
  "draft" => "amber",
  "submitted_for_admin_review" => "blue",
  "admin_approved" => "cyan",
  "internal" => "gray",
  "published" => "green",
  "returned_to_broker" => "red"
} %>
<% heading_actions = capture do %>
  <% if can_export_captacoes? %>
    <%= link_to export_admin_captacoes_path(request.query_parameters), class: "ax-workspace-heading__tool captacoes-heading-action" do %>
      <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
      <span>Exportar</span>
    <% end %>
  <% end %>
  <%= link_to new_admin_captacao_path, class: "ax-workspace-heading__tool captacoes-heading-action captacoes-heading-action--primary" do %>
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    <span>Nova captação</span>
  <% end %>
<% end %>

<div class="captacoes-workspace" data-controller="lead-pwa-filter">
  <section class="captacoes-pwa-header" aria-label="Navegação de captações no PWA">
    <div class="captacoes-pwa-topbar">
      <%= link_to admin_captacoes_path(pwa_base_params.merge(status: can_filter_intakes_by_broker? ? "all" : "")),
                  class: "captacoes-pwa-queue",
                  aria: { label: "Ver captações" } do %>
        <strong><%= number_with_delimiter(can_filter_intakes_by_broker? ? dashboard[:total].to_i : pending_count) %></strong>
        <span><%= can_filter_intakes_by_broker? ? "total" : "pend." %></span>
      <% end %>

      <%= form_with url: admin_captacoes_path, method: :get, local: true, class: "captacoes-pwa-search" do %>
        <% pwa_search_params.each do |param_key, param_value| %>
          <% Array(param_value).reject(&:blank?).each do |hidden_value| %>
            <%= hidden_field_tag(param_value.is_a?(Array) ? "#{param_key}[]" : param_key, hidden_value) %>
          <% end %>
        <% end %>
        <button type="submit" class="captacoes-pwa-search__submit" aria-label="Buscar captações">
          <i class="bi bi-search" aria-hidden="true"></i>
        </button>
        <%= search_field_tag :q,
                             @q,
                             placeholder: "Busque por código, imóvel, bairro...",
                             autocomplete: "off",
                             inputmode: "search",
                             aria: { label: "Buscar captações" } %>
      <% end %>

      <button type="button"
              class="captacoes-pwa-filter"
              data-lead-pwa-filter-target="trigger"
              data-action="lead-pwa-filter#open"
              aria-expanded="false"
              aria-label="Abrir filtros">
        <i class="bi bi-funnel" aria-hidden="true"></i>
        <% if filters_active %>
          <span class="captacoes-pwa-filter__badge">•</span>
        <% end %>
      </button>
    </div>

    <nav class="captacoes-pwa-tabs" aria-label="Filtros rápidos de captações">
      <% pwa_status_tabs.each do |tab| %>
        <%= link_to tab[:path],
                    class: "captacoes-pwa-tab #{'is-active' if pwa_active_status == tab[:key]}",
                    aria: ({ current: "page" } if pwa_active_status == tab[:key]) do %>
          <i class="bi bi-<%= tab[:icon] %>" aria-hidden="true"></i>
          <span class="captacoes-pwa-tab__label"><%= tab[:label] %></span>
          <span class="captacoes-pwa-tab__count"><%= number_with_delimiter(tab[:count]) %></span>
        <% end %>
      <% end %>
    </nav>
  </section>

  <%= ax_workspace_heading(
        title: "Captações",
        eyebrow: "Operação",
        icon: "journal-plus",
        subtitle: (tenant_owner? || owns_all_resource?(:captacoes) || can?(:review, :captacoes) || current_admin_user.can_view_team?(:captacoes)) ? "Captações da equipe, revisão e publicação." : "Suas captações em andamento.",
        pills: [filters_active ? "Filtrado" : default_status_label],
        metrics: [
          { value: dashboard[:total].to_i, label: "total" },
          { value: dashboard[:missing_photos].to_i, label: "sem fotos" }
        ],
        actions: heading_actions,
        class_name: "captacoes-heading"
      ) %>

  <section class="ax-metric-grid captacoes-kpi-strip" aria-label="Resumo de captações">
    <% status_tiles.each do |label, value, tone| %>
      <%= ax_metric_card(label:, value:, class_name: "captacoes-kpi captacoes-kpi--#{tone}") %>
    <% end %>
  </section>

  <section class="captacoes-signal-strip" aria-label="Indicadores rápidos">
    <div class="captacoes-signal-group">
      <span class="captacoes-signal-label">Tipos de cadastro</span>
      <span class="ax-badge ax-badge--gray">Residencial: <%= dashboard.dig(:property_kinds, :residencial).to_i %></span>
      <span class="ax-badge ax-badge--gray">Comercial: <%= dashboard.dig(:property_kinds, :sala_comercial).to_i %></span>
      <span class="ax-badge ax-badge--gray">Terreno: <%= dashboard.dig(:property_kinds, :terreno).to_i %></span>
    </div>
    <div class="captacoes-signal-group">
      <span class="captacoes-signal-label">Status comercial</span>
      <span class="ax-badge ax-badge--blue">Venda: <%= dashboard.dig(:modalities, :venda).to_i %></span>
      <span class="ax-badge ax-badge--amber">Locação: <%= dashboard.dig(:modalities, :locacao_anual).to_i %></span>
      <span class="ax-badge ax-badge--green">Ambos: <%= dashboard.dig(:modalities, :ambos).to_i %></span>
      <span class="ax-badge ax-badge--blue">Temporada: <%= dashboard.dig(:modalities, :locacao_diaria).to_i %></span>
    </div>
    <div class="captacoes-signal-group captacoes-signal-group--risk">
      <span class="captacoes-signal-label">Últimos 7 dias / Sem fotos</span>
      <strong><%= dashboard[:last_7_days].to_i %></strong>
      <span>·</span>
      <strong><%= dashboard[:missing_photos].to_i %> sem fotos</strong>
    </div>
  </section>

  <section class="captacoes-admin-strip" aria-label="Resumo administrativo das captações">
    <div class="captacoes-admin-strip__header">
      <i class="bi bi-clipboard-check" aria-hidden="true"></i>
      <span>Administrativo</span>
    </div>
    <div class="captacoes-admin-strip__metrics">
      <span><strong><%= dashboard[:admin_releases].to_i %></strong> liberações</span>
      <span><strong><%= dashboard[:site_releases].to_i %></strong> para site</span>
      <span><strong><%= dashboard[:internal_releases].to_i %></strong> internas</span>
    </div>
  </section>

  <%= form_with url: admin_captacoes_path, method: :get, local: true, class: "captacoes-filter-panel captacoes-filter-panel--desktop", id: "captacoes-filter-panel" do %>
    <%= hidden_field_tag :team, params[:team] if params[:team].present? %>
    <div class="captacoes-filter-panel__header">
      <div>
        <span class="captacoes-filter-panel__eyebrow"><i class="bi bi-funnel" aria-hidden="true"></i> Filtros</span>
        <strong>Refinar captações</strong>
      </div>
      <%= ax_team_toggle(:captacoes, class_name: "captacoes-team-toggle") %>
    </div>
    <div class="captacoes-filter-grid">
      <div class="captacoes-filter-field">
        <label class="ax-label" for="property_kind">Tipo de cadastro</label>
        <%= select_tag :property_kind, options_for_select([["Todos os tipos", ""], ["Residencial", "residencial"], ["Sala comercial", "sala_comercial"], ["Terreno", "terreno"]], params[:property_kind]), class: "ax-select" %>
      </div>
      <div class="captacoes-filter-field">
        <label class="ax-label" for="status">Status da captação</label>
        <%= select_tag :status, options_for_select(status_filter_options, selected_status_filter), class: "ax-select" %>
      </div>
      <% if can_filter_intakes_by_broker? %>
        <div class="captacoes-filter-field captacoes-filter-field--broker">
          <label class="ax-label" for="corretor_id">Captador responsável</label>
          <%= select_tag :corretor_id,
                         options_from_collection_for_select(@captacao_brokers, :id, :name, params[:corretor_id]),
                         include_blank: "Todos captadores",
                         class: "ax-select" %>
        </div>
      <% end %>
      <div class="captacoes-filter-actions">
        <button type="submit" class="ax-btn ax-btn--primary"><i class="bi bi-funnel ax-ico" aria-hidden="true"></i>Filtrar</button>
        <% if filters_active %><%= link_to "Limpar", admin_captacoes_path(team: params[:team]), class: "ax-btn ax-btn--ghost" %><% end %>
      </div>
    </div>
  <% end %>

  <div class="captacoes-pwa-filter-overlay"
       aria-label="Filtros de captações"
       data-lead-pwa-filter-target="panel"
       data-action="keydown@window->lead-pwa-filter#closeOnEscape"
       hidden>
    <section class="captacoes-pwa-filter-panel" aria-label="Refinar captações">
      <div class="captacoes-pwa-filter-panel__head">
        <button type="button"
                class="captacoes-pwa-filter-panel__close"
                data-action="lead-pwa-filter#close"
                aria-expanded="false"
                aria-label="Voltar">
          <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="captacoes-pwa-filter-panel__heading">
          <strong class="captacoes-pwa-filter-panel__title">Refinar captações</strong>
          <% if filters_active %>
            <span class="captacoes-pwa-filter-panel__subtitle">Filtros aplicados</span>
          <% end %>
        </div>
        <%= link_to admin_captacoes_path(team: params[:team]), class: "captacoes-pwa-filter-panel__reset", aria: { label: "Limpar filtros" } do %>
          <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
        <% end %>
      </div>

      <%= form_with url: admin_captacoes_path, method: :get, local: true, class: "captacoes-pwa-filter-panel__form" do %>
        <%= hidden_field_tag :team, params[:team] if params[:team].present? %>
        <div class="captacoes-pwa-filter-grid">
          <div class="captacoes-filter-field">
            <label class="ax-label" for="pwa_property_kind">Tipo de cadastro</label>
            <%= select_tag :property_kind, options_for_select([["Todos os tipos", ""], ["Residencial", "residencial"], ["Sala comercial", "sala_comercial"], ["Terreno", "terreno"]], params[:property_kind]), class: "ax-select", id: "pwa_property_kind" %>
          </div>
          <div class="captacoes-filter-field">
            <label class="ax-label" for="pwa_status">Status da captação</label>
            <%= select_tag :status, options_for_select(status_filter_options, selected_status_filter), class: "ax-select", id: "pwa_status" %>
          </div>
          <% if can_filter_intakes_by_broker? %>
            <div class="captacoes-filter-field">
              <label class="ax-label" for="pwa_corretor_id">Captador responsável</label>
              <%= select_tag :corretor_id,
                             options_from_collection_for_select(@captacao_brokers, :id, :name, params[:corretor_id]),
                             include_blank: "Todos captadores",
                             class: "ax-select",
                             id: "pwa_corretor_id" %>
            </div>
          <% end %>
        </div>
        <div class="captacoes-pwa-filter-actions">
          <button type="submit">
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <span>Aplicar filtros</span>
          </button>
        </div>
      <% end %>
    </section>
  </div>

  <div class="captacoes-table-wrap ax-table-wrap">
    <table class="ax-table">
      <thead>
        <tr>
          <th>Imóvel</th>
          <th class="ax-table__col--compact">Referência</th>
          <th class="ax-table__col--w-120">Tipo de cadastro</th>
          <th class="ax-table__col--md">Status comercial</th>
          <% if can_filter_intakes_by_broker? %><th class="ax-table__col--w-150">Captador responsável</th><% end %>
          <th class="ax-num ax-table__col--w-130">Valor</th>
          <th class="ax-table__col--md">Status da captação</th>
          <th class="ax-table__col--sm">Atualizada</th>
          <th class="ax-num ax-table__col--sm">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @captacoes.each do |c| %>
          <%
            mod_color, mod_label = modalidade_map[c.modalidade] || ["gray", "—"]
            captacao_title = captacao_identity_title(c)
            captacao_subtitle = captacao_identity_subtitle(c)
          %>
          <tr>
            <td>
              <div class="ax-strong"><%= captacao_title %></div>
              <% if captacao_subtitle.present? %><div class="tw-text-2xs tw-text-ink-faint"><i class="bi bi-geo-alt" aria-hidden="true"></i> <%= captacao_subtitle %></div><% end %>
            </td>
            <td><% if c.codigo.present? %><%= link_to c.codigo, admin_habitations_path(q: c.codigo) %><% else %>—<% end %></td>
            <td><span class="ax-badge ax-badge--gray"><%= c.property_kind.humanize %></span></td>
            <td><span class="ax-badge ax-badge--<%= mod_color %>"><%= mod_label %></span></td>
            <% if can_filter_intakes_by_broker? %><td><%= c.corretor&.name.presence || "Sem corretor" %></td><% end %>
            <td class="ax-num"><% if c.valor_venda.present? %><%= number_to_currency(c.valor_venda, unit: "R$ ", precision: 0) %><% elsif c.valor_locacao.present? %><%= number_to_currency(c.valor_locacao, unit: "R$ ", precision: 0) %>/mês<% else %>—<% end %></td>
            <td>
              <% badge_tone = intake_status_badge_tones.fetch(c.intake_status, "gray") %>
              <span class="ax-badge ax-badge--<%= badge_tone %> ax-badge--dot"><%= c.intake_status_label %></span>
            </td>
            <td class="tw-text-2xs tw-text-ink-muted"><%= time_ago_in_words(c.updated_at) %></td>
            <td class="ax-num">
              <% if c.completed? %>
                <%= ax_icon_button label: "Ver captação #{captacao_title}", icon: "eye", url: admin_captacao_path(c) %>
              <% else %>
                <%= ax_icon_button label: "Continuar captação #{captacao_title}", icon: "pencil", url: edit_admin_captacao_path(c) %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @captacoes.empty? %>
          <tr><td colspan="<%= can_filter_intakes_by_broker? ? 9 : 8 %>">
            <%= ax_empty_state(
                  title: "Nenhuma captação encontrada",
                  description: "Você ainda não tem captações.",
                  action: link_to("Criar primeira", new_admin_captacao_path, class: "ax-btn ax-btn--primary"),
                  compact: true
                ) %>
          </td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="captacoes-mobile-list" aria-label="Lista de captações">
    <% @captacoes.each do |c| %>
      <%
        mod_color, mod_label = modalidade_map[c.modalidade] || ["gray", "—"]
        captacao_title = captacao_identity_title(c)
        captacao_subtitle = captacao_identity_subtitle(c)
      %>
      <article class="captacao-mobile-card">
        <div class="captacao-mobile-card__main">
          <div class="captacao-mobile-card__title"><%= captacao_title %></div>
          <div class="captacao-mobile-card__meta">
            <% if c.codigo.present? %><span>Cod. <%= c.codigo %></span><% end %>
            <% if captacao_subtitle.present? %><span><i class="bi bi-geo-alt" aria-hidden="true"></i> <%= captacao_subtitle %></span><% end %>
            <% if can_filter_intakes_by_broker? %><span><i class="bi bi-person" aria-hidden="true"></i> <%= c.corretor&.name.presence || "Sem corretor" %></span><% end %>
          </div>
          <div class="captacao-mobile-card__badges">
            <span class="ax-badge ax-badge--gray"><%= c.property_kind.humanize %></span>
            <span class="ax-badge ax-badge--<%= mod_color %>"><%= mod_label %></span>
            <% badge_tone = intake_status_badge_tones.fetch(c.intake_status, "gray") %>
            <span class="ax-badge ax-badge--<%= badge_tone %> ax-badge--dot"><%= c.intake_status_label %></span>
          </div>
        </div>
        <div class="captacao-mobile-card__side">
          <strong>
            <% if c.valor_venda.present? %>
              <%= number_to_currency(c.valor_venda, unit: "R$ ", precision: 0) %>
            <% elsif c.valor_locacao.present? %>
              <%= number_to_currency(c.valor_locacao, unit: "R$ ", precision: 0) %>/mês
            <% else %>
              —
            <% end %>
          </strong>
          <span><%= time_ago_in_words(c.updated_at) %></span>
          <% if c.completed? %>
            <%= link_to admin_captacao_path(c), class: "ax-btn ax-btn--sm ax-btn--ghost" do %><i class="bi bi-eye ax-ico" aria-hidden="true"></i>Ver<% end %>
          <% else %>
            <%= link_to edit_admin_captacao_path(c), class: "ax-btn ax-btn--sm" do %><i class="bi bi-pencil ax-ico" aria-hidden="true"></i>Continuar<% end %>
          <% end %>
        </div>
      </article>
    <% end %>
    <% if @captacoes.empty? %>
      <div class="captacoes-pwa-empty">
        <strong>Nenhuma captação nesta aba</strong>
        <span>Ajuste os filtros ou volte em Todas para ver sua carteira completa.</span>
      </div>
    <% end %>
  </div>

  <% if @captacoes.respond_to?(:total_pages) && @captacoes.total_pages > 1 %>
    <div class="captacoes-pagination">
      <%= ax_pagination @captacoes, params: request.query_parameters %>
    </div>
  <% end %>

  <%= link_to new_admin_captacao_path, class: "ax-pwa-action-fab captacoes-pwa-fab", aria: { label: "Nova captação" } do %>
    <i class="bi bi-plus" aria-hidden="true"></i>
    <span>Nova captação</span>
  <% end %>
</div>
