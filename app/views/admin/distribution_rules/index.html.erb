<%# Regras de Distribuição — listagem. A ação "Nova regra" vem da contextbar global. %>
<%= ax_workspace_heading(
      title: "Regras de Distribuição",
      eyebrow: "Distribuição de leads",
      icon: "diagram-3",
      subtitle: "Gerencie o fluxo vertical de entrada, fila, responsável, aceite e entrega dos leads à equipe.",
      metrics: [{ value: @distribution_rules.size, label: @distribution_rules.size == 1 ? "regra" : "regras" }],
      actions: ax_button("Objetivo", nil, size: :sm, icon: "info-circle", data: { ax_modal_open: "#distributionObjectiveModal" })) %>

<%= ax_quick_modal(id: "distributionObjectiveModal",
      title: "Qual é o objetivo e para que serve",
      size: :md,
      class_name: "distribution-objective-modal") do %>
  <div class="automation-workflow-objective">
    <div class="automation-workflow-objective__intro">
      <span class="automation-workflow-objective__icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
      <div>
        <div class="automation-workflow-objective__eyebrow">Distribuição vertical</div>
        <p>
          Use este módulo para controlar de onde o lead entra e para onde ele vai:
          origem, regra, fila, corretor, disponibilidade, represamento, próximo horário,
          aceite, check-in e notificações de distribuição.
        </p>
      </div>
    </div>
  </div>
<% end %>

<% if @holding_leads_count.to_i.positive? %>
  <div class="distribution-rules-index__notice">
    <%= ax_inline_notice(tone: :warning, icon: "pause-circle-fill") do %>
      <strong>Leads represados:</strong> <%= @holding_leads_count %> aguardando distribuição fora do horário.
      <%= link_to "Ver leads", admin_leads_path(status: Lead.status_value(:represado)), class: "ax-dashboard-panel__link distribution-rules-index__notice-link" %>
    <% end %>
  </div>
<% end %>

<%= ax_inline_notice(tone: :info, icon: "info-circle") do %>
  A ordem abaixo organiza a listagem e não altera a prioridade de distribuição.
  <%= link_to(@show_archived ? "Ver filas atuais" : "Ver filas arquivadas", admin_distribution_rules_path(archived: @show_archived ? nil : "1")) %>
<% end %>

<div class="ax-table-wrap distribution-rules-index__table">
  <table class="ax-table">
    <thead>
      <tr>
        <th>Nome</th>
        <th class="distribution-rules-index__col-type">Receber</th>
        <th class="distribution-rules-index__col-sources">Fontes</th>
        <th class="distribution-rules-index__col-mode">Modo</th>
        <th class="distribution-rules-index__col-leads">Leads</th>
        <th class="distribution-rules-index__col-last-lead">Último lead</th>
        <th class="distribution-rules-index__col-status">Status</th>
        <th class="ax-num distribution-rules-index__col-actions">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @distribution_rules.each_with_index do |rule, index| %>
        <% enabled_sources = distribution_rule_enabled_sources(rule) %>
        <% rule_lead_stats = @distribution_rule_lead_stats.fetch(rule.id, { count: 0, last_lead_at: nil }) %>
        <tr>
          <td>
            <div class="ax-strong"><%= rule.name %></div>
            <div class="tw-flex tw-gap-1 tw-mt-1">
              <% if rule.pocket_active? %><span class="ax-badge ax-badge--amber"><i class="bi bi-hourglass-split" aria-hidden="true"></i> <%= rule.pocket_time %>m</span><% end %>
              <% if rule.pocket_to_pool? %><span class="ax-badge ax-badge--blue"><i class="bi bi-people" aria-hidden="true"></i> Bolsão</span><% end %>
              <% if rule.represamento_active? %><span class="ax-badge ax-badge--blue"><i class="bi bi-moon-stars" aria-hidden="true"></i> Represamento</span><% end %>
            </div>
          </td>
          <td><span class="ax-badge ax-badge--gray tw-uppercase tw-font-mono"><%= distribution_rule_business_label(rule) %></span></td>
          <td>
            <span class="tw-inline-flex tw-gap-2 tw-text-base" aria-label="Fontes: <%= enabled_sources.presence&.to_sentence || 'nenhuma' %>">
              <% if rule.source_tiktok? %><i class="bi bi-tiktok" title="TikTok Ads" aria-hidden="true"></i><% end %>
              <% if rule.source_linkedin? %><i class="bi bi-linkedin tw-text-blue-600" title="LinkedIn Ads" aria-hidden="true"></i><% end %>
              <% if rule.source_meta? %><i class="bi bi-facebook tw-text-blue-600" title="Meta" aria-hidden="true"></i><% end %>
              <% if rule.source_rd_station? %><i class="bi bi-envelope-paper tw-text-green-600" title="RD Station" aria-hidden="true"></i><% end %>
              <% if rule.source_lovers? %><i class="bi bi-heart tw-text-rose-600" title="Lovers" aria-hidden="true"></i><% end %>
              <% if rule.source_webhook? %><i class="bi bi-diagram-2 tw-text-ink-muted" title="Webhook" aria-hidden="true"></i><% end %>
              <% if rule.source_site? %><i class="bi bi-globe tw-text-cyan-600" title="Site" aria-hidden="true"></i><% end %>
              <% if rule.source_portal? %><i class="bi bi-building tw-text-green-600" title="Portais" aria-hidden="true"></i><% end %>
            </span>
          </td>
          <td>
            <span class="tw-inline-flex tw-items-center tw-gap-1.5 tw-text-2xs tw-uppercase tw-font-semibold tw-text-ink-muted">
              <i class="bi bi-<%= rule.rotary? ? 'arrow-repeat' : (rule.performance? ? 'graph-up-arrow' : (rule.attendance? ? 'person-check' : 'lightning-fill')) %>" aria-hidden="true"></i>
              <%= distribution_rule_mode_label(rule) %>
            </span>
          </td>
          <td class="ax-num">
            <strong><%= number_with_delimiter(rule_lead_stats[:count]) %></strong>
          </td>
          <td>
            <% if rule_lead_stats[:last_lead_at].present? %>
              <span class="tw-inline-flex tw-items-center tw-gap-1.5 tw-text-2xs tw-font-semibold tw-text-ink-muted">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <%= l(rule_lead_stats[:last_lead_at], format: :short) %>
              </span>
            <% else %>
              <span class="tw-text-2xs tw-text-ink-muted">Nenhum lead</span>
            <% end %>
          </td>
          <td>
            <% if rule.archived_at.present? %><span class="ax-badge ax-badge--gray">Arquivada</span>
            <% elsif rule.active? %><span class="ax-badge ax-badge--green ax-badge--dot">Ativa</span>
            <% else %><span class="ax-badge ax-badge--gray ax-badge--dot">Inativa</span><% end %>
          </td>
          <td class="ax-num">
            <span class="tw-inline-flex tw-gap-0.5">
              <%= link_to admin_distribution_rule_path(rule), class: "ax-ico-btn", title: "Ver #{rule.name}", aria: { label: "Ver regra #{rule.name}" } do %><i class="bi bi-eye" aria-hidden="true"></i><% end %>
              <%= link_to edit_admin_distribution_rule_path(rule), class: "ax-ico-btn", title: "Editar #{rule.name}", aria: { label: "Editar regra #{rule.name}" } do %><i class="bi bi-pencil" aria-hidden="true"></i><% end %>
              <% if @show_archived %>
                <%= button_to "Restaurar", restore_admin_distribution_rule_path(rule), method: :patch, form_class: "tw-inline", class: "ax-btn ax-btn--sm" %>
              <% else %>
                <% [["up", "Subir", "arrow-up", index.zero?], ["down", "Descer", "arrow-down", index == @distribution_rules.size - 1]].each do |direction, label, icon, disabled| %>
                  <%= button_to move_admin_distribution_rule_path(rule, direction: direction), method: :patch, disabled: disabled, form_class: "tw-inline", class: "ax-ico-btn", title: "#{label} #{rule.name}", aria: { label: "#{label} regra #{rule.name}" } do %><i class="bi bi-<%= icon %>" aria-hidden="true"></i><% end %>
                <% end %>
                <%= button_to toggle_active_admin_distribution_rule_path(rule), method: :patch, form_class: "tw-inline", class: "ax-ico-btn", title: rule.active? ? "Pausar #{rule.name}" : "Ativar #{rule.name}", aria: { label: rule.active? ? "Pausar regra #{rule.name}" : "Ativar regra #{rule.name}" } do %><i class="bi bi-<%= rule.active? ? 'pause-circle' : 'play-circle' %>" aria-hidden="true"></i><% end %>
                <%= button_to archive_admin_distribution_rule_path(rule), method: :patch, form_class: "tw-inline", form: { data: { turbo_confirm: "Arquivar a regra #{rule.name}? O histórico será preservado." } }, class: "ax-ico-btn", title: "Arquivar #{rule.name}", aria: { label: "Arquivar regra #{rule.name}" } do %><i class="bi bi-archive" aria-hidden="true"></i><% end %>
              <% end %>
            </span>
          </td>
        </tr>
      <% end %>

      <% if @distribution_rules.empty? %>
        <tr>
          <td colspan="8">
            <%= ax_empty_state(
                  title: "Nenhuma regra definida",
                  description: "Crie a primeira regra para distribuir leads entre fontes, filas e corretores.",
                  icon: "diagram-3",
                  action: ax_button("Criar primeira regra", new_admin_distribution_rule_path, variant: :primary, size: :sm, icon: "plus-lg")
                ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
