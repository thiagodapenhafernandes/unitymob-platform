<%
  admin_surface = @layout_setting.respond_to?(:admin_surface_color) ? @layout_setting.admin_surface_color.presence : nil
  admin_header = @layout_setting.respond_to?(:admin_header_color) ? @layout_setting.admin_header_color.presence : nil
  admin_workspace = @layout_setting.respond_to?(:admin_workspace_color) ? @layout_setting.admin_workspace_color.presence : nil
  admin_sidebar = @layout_setting.respond_to?(:admin_sidebar_color) ? @layout_setting.admin_sidebar_color.presence : nil
  admin_ink = @layout_setting.respond_to?(:admin_ink_color) ? @layout_setting.admin_ink_color.presence : nil
  admin_surface ||= LayoutSetting::ADMIN_SURFACE_DEFAULT
  admin_header ||= LayoutSetting::ADMIN_HEADER_DEFAULT
  admin_workspace ||= LayoutSetting::ADMIN_WORKSPACE_DEFAULT
  admin_sidebar ||= LayoutSetting::ADMIN_SIDEBAR_DEFAULT
  admin_primary = @layout_setting.admin_primary_color.presence || LayoutSetting::ADMIN_PRIMARY_DEFAULT
  admin_ink ||= LayoutSetting::ADMIN_INK_DEFAULT
  admin_menu_section_styles = @layout_setting.admin_menu_section_styles
  effective_admin_theme = @layout_setting.effective_admin_theme(mode: current_admin_user.effective_admin_theme_mode)
  admin_menu_sections = [
    { key: "product", label: "Produto", icon: "grid-1x2" },
    { key: "operation", label: "Operação", icon: "briefcase" },
    { key: "management", label: "Gestão", icon: "people" },
    { key: "growth", label: "Crescimento", icon: "graph-up-arrow" },
    { key: "public_site", label: "Site público", icon: "globe2" },
    { key: "integrations", label: "Integrações", icon: "plug" },
    { key: "settings", label: "Configurações", icon: "sliders" },
    { key: "account", label: "Conta", icon: "building-gear" }
  ]
  account_brand_name = @layout_setting.site_name.presence || current_tenant&.name.presence || "Unitymob"
  account_admin_area_name = @layout_setting.respond_to?(:admin_area_label) ? @layout_setting.admin_area_label : "Plataforma"
  admin_theme_tokens = [
    { attr: :admin_surface_color, token: "surface", label: "surface.DEFAULT", value: admin_surface, default: LayoutSetting::ADMIN_SURFACE_DEFAULT },
    { attr: :admin_header_color, token: "header", label: "surface.header", value: admin_header, default: LayoutSetting::ADMIN_HEADER_DEFAULT },
    { attr: :admin_workspace_color, token: "workspace", label: "workspace.background", value: admin_workspace, default: LayoutSetting::ADMIN_WORKSPACE_DEFAULT },
    { attr: :admin_sidebar_color, token: "sidebar", label: "sidebar.background", value: admin_sidebar, default: LayoutSetting::ADMIN_SIDEBAR_DEFAULT },
    { attr: :admin_primary_color, token: "primary", label: "primary", value: admin_primary, default: LayoutSetting::ADMIN_PRIMARY_DEFAULT },
    { attr: :admin_ink_color, token: "ink", label: "ink", value: admin_ink, default: LayoutSetting::ADMIN_INK_DEFAULT }
  ]
  admin_token_contract = {
    "surface.DEFAULT" => {
      value: admin_surface,
      theme_var: "--theme-surface",
      description: "Superfície base de painéis, cards, inputs, menus e áreas de conteúdo.",
      aliases: %w[--admin-surface --ab-panel --ab-control-bg --ax-panel-bg --ax-control-bg]
    },
    "surface.header" => {
      value: admin_header,
      theme_var: "--theme-header",
      description: "Cabeçalhos de painel, barras internas e superfícies de topo.",
      aliases: %w[--admin-surface-header --ab-panel-header --ax-panel-header]
    },
    "workspace.background" => {
      value: admin_workspace,
      theme_var: "--theme-workspace",
      description: "Fundo do workspace principal, incluindo a área do ax-main.",
      aliases: %w[--admin-workspace-bg --ab-page --ax-page-bg .ax-main]
    },
    "sidebar.background" => {
      value: admin_sidebar,
      theme_var: "--theme-sidebar",
      description: "Fundo exclusivo da navegação lateral. Não altera cabeçalhos nem painéis.",
      aliases: %w[--admin-sidebar-bg .ax-sidebar]
    },
    "primary" => {
      value: admin_primary,
      theme_var: "--theme-primary",
      description: "Ações principais, menu ativo, foco, badges e estados de destaque.",
      aliases: %w[--admin-primary --admin-primary-soft --admin-primary-ring --ax-field-focus]
    },
    "ink" => {
      value: admin_ink,
      theme_var: "--theme-ink",
      description: "Texto forte, títulos, linhas derivadas e contraste dos componentes internos.",
      aliases: %w[--admin-ink --ab-ink --ab-muted --ab-line --ax-border]
    }
  }
%>

<%
  token_titles = {
    "surface" => ["Painéis e campos", "card-heading", "Cartões, tabelas, campos e menus."],
    "header" => ["Cabeçalhos e barras", "window-stack", "Topo dos painéis e barras internas."],
    "workspace" => ["Fundo da área de trabalho", "grid-1x2", "O fundo atrás de todos os painéis."],
    "sidebar" => ["Menu lateral", "layout-sidebar", "Somente a navegação lateral."],
    "primary" => ["Cor de destaque", "droplet-half", "Ações principais, menu ativo e foco."],
    "ink" => ["Texto e linhas", "type", "Títulos, textos e bordas derivadas."]
  }
  studio_items = [
    { id: "layout-tab-brand", icon: "type", label: "Nome da plataforma", hint: "Como o topo interno se chama" },
    { id: "layout-tab-colors", icon: "palette2", label: "Cores da plataforma", hint: "Superfícies, destaque e texto" },
    { id: "layout-tab-menu", icon: "layout-sidebar-inset", label: "Menu lateral", hint: "Cor de cada divisão" },
    { id: "interest-intelligence-settings", icon: "bullseye", label: "Inteligência de interesse", hint: "Leitura lead e imóvel" },
    { id: "layout-tab-impact", icon: "diagram-3", label: "Onde cada ajuste aparece", hint: "Mapa de impacto e tokens" }
  ]
  preview_nav_items = {
    "product" => [["house", "Painel"], ["buildings", "Imóveis"], ["person-lines-fill", "Leads"]],
    "operation" => [["briefcase", "Comercial"], ["lightning-charge", "Automação"], ["plus-square", "Captações"]],
    "management" => [["people", "Equipe"], ["shield-check", "Perfis"]],
    "growth" => [["megaphone", "Marketing"], ["graph-up", "Relatórios"]],
    "public_site" => [["globe2", "Site"], ["search", "SEO"]],
    "integrations" => [["plug", "Portais"], ["whatsapp", "WhatsApp"]],
    "settings" => [["sliders", "Geral"], ["bell", "Notificações"]],
    "account" => [["grid-1x2", "Visão geral"], ["palette2", "Identidade e Marca"]]
  }
  menu_style_struct = Struct.new(:background_color, :text_color, :border_color, :background_opacity, :box_shadow, keyword_init: true)
  menu_style_fields = [
    ["background_color", "Fundo", "background"],
    ["text_color", "Texto", "text"],
    ["border_color", "Borda", "border"]
  ]
  interest_number_fields = [
    ["minimum_match_score", "Score mínimo", "Compatibilidade mínima para sugerir um imóvel ao lead.", 0, 100, "pts"],
    ["max_suggestions", "Máximo de sugestões", "Limite exibido na ficha do lead e usado nas ações.", 1, 20, nil],
    ["strong_interest_views", "Visualizações fortes", "Visitas ao mesmo tipo de imóvel para reforçar o sinal.", 1, 20, nil],
    ["price_tolerance_percent", "Tolerância de preço", "Margem aceita acima ou abaixo da faixa inferida.", 0, 100, "%"],
    ["idle_without_match_hours", "Lead parado sem match", "Janela usada em jornadas de recuperação quando não há imóvel aderente.", 1, 720, "horas"]
  ]
  interest_weight_fields = {
    city_weight: "Cidade", neighborhood_weight: "Bairro", category_weight: "Tipo",
    bedrooms_weight: "Dormitórios", parking_weight: "Vagas", price_weight: "Preço"
  }
  interest_safeguards = [
    ["broker_review_required", "Exigir revisão humana antes de comunicação ativa", "Mantém a inteligência como apoio de curadoria; mensagens para o lead devem passar pelo corretor ou gestor."],
    ["requires_public_tracking_consent", "Exigir consentimento no site público", "Mostra um aviso discreto antes de rastrear navegação anônima para personalização de atendimento."],
    ["allow_direct_lead_message", "Permitir envio direto ao lead quando não exigir revisão", "Use com cuidado. Com revisão humana ativa, a plataforma sempre cria rascunho/nota para o corretor."]
  ]
  interest_settings = InterestIntelligence::Settings::DEFAULTS.merge(@layout_setting.interest_intelligence_settings.to_h)
  token_hex = admin_theme_tokens.to_h { |item| [item[:token], item[:value].upcase] }
%>

<div class="layout-settings-workspace"
     data-controller="layout-theme-preview"
     data-layout-theme-preview-initial-surface="<%= effective_admin_theme[:surface] %>"
     data-layout-theme-preview-initial-header="<%= effective_admin_theme[:header] %>"
     data-layout-theme-preview-initial-workspace="<%= effective_admin_theme[:workspace] %>"
     data-layout-theme-preview-initial-sidebar="<%= effective_admin_theme[:sidebar] %>"
     data-layout-theme-preview-initial-primary="<%= effective_admin_theme[:primary] %>"
     data-layout-theme-preview-initial-ink="<%= effective_admin_theme[:ink] %>">
  <%= ax_workspace_heading(
        eyebrow: "Conta · Plataforma",
        icon: "palette2",
        title: "Aparência da plataforma",
        pills: ["Escopo: conta", "Tema pessoal: #{current_admin_user.effective_admin_theme_mode == 'dark' ? 'Escuro' : 'Claro'}"],
        subtitle: "Nome, cores e menu do ambiente interno da equipe. A marca e as cores do site público ficam em Site público → Identidade. Cada usuário continua escolhendo individualmente entre modo claro e escuro."
      ) %>

  <%= form_with(model: [:admin, @layout_setting], local: true,
                html: { multipart: true, data: { controller: "ax-dirty-form", action: "input->ax-dirty-form#mark change->ax-dirty-form#mark" } },
                class: "layout-settings-form") do |f| %>
    <%= ax_error_summary(@layout_setting) %>

    <div class="ax-studio">
      <div class="ax-studio__nav">
        <%= ax_studio_nav(items: studio_items, panels_selector: "#layout-studio-sections", label: "Seções da identidade visual") %>
      </div>

      <div class="ax-studio__stage" id="layout-studio-sections">
        <%# ===== Nome da plataforma ===== %>
        <%= ax_studio_section(id: "layout-tab-brand", icon: "type", active: true,
                              title: "Nome da plataforma",
                              subtitle: "Completa o topo interno ao lado da marca. Só a equipe enxerga.",
                              actions: tag.span("conta", class: "ax-badge ax-badge--blue")) do %>
          <%= ax_studio_group(title: "Como o topo se chama", subtitle: "A marca vem de Site público → Identidade; aqui você ajusta só o nome do ambiente interno.") do %>
            <%= ax_field_grid do %>
              <div class="ax-span-6">
                <%= ax_text_field(
                      form: f,
                      method: :admin_area_name,
                      label: "Nome da plataforma",
                      placeholder: "Ex.: Plataforma, Operação, Painel",
                      hint: safe_join(["Sufixo do topo interno. Evite ", tag.code("Admin"), " como nome de produto."]),
                      clearable: true,
                      data: { action: "input->layout-theme-preview#updateName", preview_name: "area", preview_fallback: account_admin_area_name }
                    ) %>
              </div>
            <% end %>
            <div class="lss-topbar-demo" aria-label="Como o topo aparece">
              <span class="lss-topbar-demo__mark"><i class="bi bi-buildings"></i></span>
              <strong data-layout-theme-preview-target="brandName"><%= account_brand_name %></strong>
              <em data-layout-theme-preview-target="areaName"><%= account_admin_area_name %></em>
              <small>Contexto operacional para corretores, gestores e operadores.</small>
            </div>
            <p class="ax-field__hint"><%= link_to "Editar marca, logo e favicon em Site público → Identidade", edit_admin_public_identity_path, class: "ax-link" %></p>
          <% end %>
        <% end %>

        <%# ===== Cores da plataforma ===== %>
        <%= ax_studio_section(id: "layout-tab-colors", icon: "palette2",
                              title: "Cores da plataforma",
                              subtitle: safe_join(["Afeta somente o ambiente interno em ", tag.code("/admin"), ": botões, menu ativo, badges, superfícies e estados de foco. Cada mudança aparece na prévia ao lado."]),
                              actions: capture do %>
            <button type="button" class="ax-btn ax-btn--sm" data-action="layout-theme-preview#resetDefaults">
              <i class="bi bi-arrow-counterclockwise ax-ico"></i>
              Restaurar padrões
            </button>
          <% end) do %>
          <%= ax_inline_notice(tone: :info, icon: "sun",
                               body: "Estas são as cores da identidade da conta. O modo claro ou escuro é escolhido por cada usuário no menu pessoal, e o escuro deriva destas mesmas cores.") %>

          <div class="lss-colors">
            <% admin_theme_tokens.each do |theme_token| %>
              <% title, icon, about = token_titles.fetch(theme_token[:token]) %>
              <div class="lss-color">
                <span class="lss-color__icon"><i class="bi bi-<%= icon %>"></i></span>
                <div class="lss-color__body">
                  <%= ax_color_field(
                        form: f,
                        method: theme_token[:attr],
                        label: title,
                        value: theme_token[:value],
                        token: theme_token[:token],
                        default_value: theme_token[:default],
                        swatch_title: "Escolha a cor de #{title.downcase}",
                        hint: safe_join([about, " Padrão ", tag.strong(theme_token[:default]), "."])
                      ) %>
                </div>
              </div>
            <% end %>
          </div>

          <div class="ax-studio-group lss-legibility">
            <div class="ax-studio-group__head"><h3>Legibilidade</h3><p>Confere, enquanto você escolhe, se as combinações continuam confortáveis de ler (WCAG).</p></div>
            <div class="lss-legibility__list">
              <div class="lss-legibility__item" data-layout-theme-preview-target="contrast" data-contrast-pair="ink:surface" data-state="pass">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>Texto sobre painéis<small>mínimo 4.5:1</small></span>
                <b data-contrast-value>–</b>
              </div>
              <div class="lss-legibility__item" data-layout-theme-preview-target="contrast" data-contrast-pair="white:primary" data-state="pass">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>Texto do botão primário<small>mínimo 4.5:1</small></span>
                <b data-contrast-value>–</b>
              </div>
              <div class="lss-legibility__item" data-layout-theme-preview-target="contrast" data-contrast-pair="primary:surface" data-state="pass">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>Destaque sobre painéis<small>mínimo 3:1</small></span>
                <b data-contrast-value>–</b>
              </div>
            </div>
          </div>
        <% end %>

        <%# ===== Menu lateral ===== %>
        <%= ax_studio_section(id: "layout-tab-menu", icon: "layout-sidebar-inset",
                              title: "Menu lateral",
                              subtitle: "Escolha uma divisão para ajustar fundo, texto, borda, opacidade e sombra. A sidebar e a prévia abrem essa divisão e mudam na hora, antes de salvar.",
                              actions: tag.span("navegação", class: "ax-badge ax-badge--gray")) do %>
          <div class="lss-menu">
            <ul class="lss-menu-picker" role="tablist" aria-label="Divisões do menu"
                data-controller="ax-tabs"
                data-ax-tabs-panel-selector-value="#layout-menu-panels"
                data-ax-tabs-sync-hash-value="false">
              <% admin_menu_sections.each_with_index do |section, index| %>
                <% css_key = section[:key].dasherize %>
                <li>
                  <button type="button"
                          class="lss-menu-chip<%= " active" if index.zero? %>"
                          data-ax-tabs-target="tab"
                          data-ax-tabs-target-param="#layout-menu-<%= css_key %>"
                          data-menu-section-key="<%= section[:key] %>"
                          data-action="click->ax-tabs#select click->layout-theme-preview#focusSection"
                          aria-selected="<%= index.zero? %>">
                    <span class="layout-settings-menu-style-preview"
                          data-menu-section-preview="<%= css_key %>">
                      <i class="bi bi-<%= section[:icon] %>"></i>
                      <strong><%= section[:label] %></strong>
                      <i class="bi bi-chevron-down"></i>
                    </span>
                  </button>
                </li>
              <% end %>
            </ul>

            <div class="lss-menu-panels" id="layout-menu-panels">
              <% admin_menu_sections.each_with_index do |section, index| %>
                <% key = section[:key] %>
                <% css_key = key.dasherize %>
                <% palette = admin_menu_section_styles.fetch(key) %>
                <% defaults = LayoutSetting::ADMIN_MENU_SECTION_STYLE_DEFAULTS.fetch(key) %>
                <% style_object = menu_style_struct.new(**palette.symbolize_keys.slice(*menu_style_struct.members)) %>
                <div class="lss-menu-panel" id="layout-menu-<%= css_key %>" data-menu-panel <%= "hidden" unless index.zero? %>>
                  <header class="lss-menu-panel__head">
                    <span class="lss-menu-panel__icon"><i class="bi bi-<%= section[:icon] %>"></i></span>
                    <div><strong><%= section[:label] %></strong><small>Como esta divisão aparece na sidebar.</small></div>
                    <button type="button" class="ax-btn ax-btn--sm" data-action="layout-theme-preview#resetMenuSection">
                      <i class="bi bi-arrow-counterclockwise ax-ico"></i> Padrão da divisão
                    </button>
                  </header>

                  <%= fields_for "layout_setting[admin_menu_section_colors][#{key}]", style_object do |sf| %>
                    <%= ax_field_grid do %>
                      <% menu_style_fields.each do |property, label, css_property| %>
                        <div class="ax-span-4">
                          <% pair_data = { menu_section_key: key, menu_style_property: css_property, default_value: defaults[property] } %>
                          <%= ax_color_field(
                                form: sf,
                                method: property.to_sym,
                                label: label,
                                value: palette[property],
                                swatch_title: "Escolha a cor de #{label.downcase} de #{section[:label]}",
                                color_options: { data: pair_data.merge(action: "input->layout-theme-preview#updateMenuSection") },
                                text_options: { data: pair_data.merge(action: "input->layout-theme-preview#updateMenuSection") }
                              ) %>
                        </div>
                      <% end %>
                      <div class="ax-span-4">
                        <%= ax_standalone_field(
                              name: "layout_setting[admin_menu_section_colors][#{key}][background_opacity]",
                              id: "layout_setting_admin_menu_section_colors_#{key}_background_opacity",
                              label: "Opacidade do fundo",
                              value: palette["background_opacity"],
                              type: :number,
                              suffix: "%",
                              min: 0, max: 100, step: 1,
                              data: { action: "input->layout-theme-preview#updateMenuSection", menu_section_key: key, menu_style_property: "background-opacity", default_value: defaults["background_opacity"] }
                            ) %>
                      </div>
                      <div class="ax-span-8">
                        <%= ax_standalone_field(
                              name: "layout_setting[admin_menu_section_colors][#{key}][box_shadow]",
                              id: "layout_setting_admin_menu_section_colors_#{key}_box_shadow",
                              label: "Sombra da divisão",
                              value: palette["box_shadow"],
                              placeholder: LayoutSetting::ADMIN_MENU_SECTION_SHADOW_DEFAULT,
                              spellcheck: false,
                              hint: safe_join(["Ex.: ", tag.code(LayoutSetting::ADMIN_MENU_SECTION_SHADOW_DEFAULT)]),
                              data: { action: "input->layout-theme-preview#updateMenuSection", menu_section_key: key, menu_style_property: "shadow", default_value: defaults["box_shadow"] }
                            ) %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ===== Inteligência de interesse ===== %>
        <%= ax_studio_section(id: "interest-intelligence-settings", icon: "bullseye",
                              class_name: "layout-settings-panel--interest-intelligence",
                              title: "Inteligência de interesse",
                              subtitle: "Diretrizes para interpretar navegação, sinais do lead e compatibilidade com imóveis sem criar atrito na operação.",
                              actions: tag.span("automação", class: "ax-badge ax-badge--blue")) do %>
          <div class="ax-studio-group">
            <%= ax_switch_field(form: f, method: :interest_intelligence_enabled,
                                label: "Ativar leitura de interesse lead-imóvel",
                                description: "Usa navegação pública, imóveis vistos, filtros e dados reais do lead para gerar eventos no builder de automação.",
                                class_name: "ax-switch--card") %>
          </div>

          <div class="ax-studio-group">
            <div class="ax-studio-group__head"><h3>Instruções para a plataforma/AI</h3><p>Se o campo ficar vazio, a plataforma usa a diretriz padrão do sistema. Personalize apenas quando a conta tiver uma estratégia própria de recomendação e curadoria.</p></div>
            <%= ax_text_field(form: f, method: :interest_intelligence_instructions, label: "Diretriz",
                              type: :textarea, rows: 7, class: "layout-settings-interest__textarea",
                              value: @layout_setting.interest_intelligence_instructions.presence || InterestIntelligence::SystemInstructions::DEFAULT_TEXT) %>
          </div>

          <div class="ax-studio-group">
            <div class="ax-studio-group__head"><h3>Sinais e limites</h3><p>Quanto o sistema exige para sugerir um imóvel e por quanto tempo espera.</p></div>
            <%= ax_field_grid do %>
              <% interest_number_fields.each do |key, label, hint, min, max, unit| %>
                <div class="ax-span-4">
                  <%= ax_standalone_field(
                        name: "layout_setting[interest_intelligence_settings][#{key}]",
                        id: "layout_setting_interest_intelligence_settings_#{key}",
                        label: label,
                        value: interest_settings[key],
                        type: :number,
                        suffix: unit,
                        min: min, max: max, step: 1,
                        hint: hint
                      ) %>
                </div>
              <% end %>
            <% end %>
          </div>

          <div class="ax-studio-group">
            <div class="ax-studio-group__head"><h3>Pesos da compatibilidade</h3><p>Quanto cada critério pesa no score entre o lead e o imóvel (0 a 100).</p></div>
            <%= ax_field_grid do %>
              <% interest_weight_fields.each do |key, label| %>
                <div class="ax-span-2">
                  <%= ax_standalone_field(
                        name: "layout_setting[interest_intelligence_settings][#{key}]",
                        id: "layout_setting_interest_intelligence_settings_#{key}",
                        label: label,
                        value: interest_settings[key.to_s],
                        type: :number,
                        min: 0, max: 100, step: 1
                      ) %>
                </div>
              <% end %>
            <% end %>
          </div>

          <div class="ax-studio-group">
            <div class="ax-studio-group__head"><h3>Salvaguardas</h3><p>Limites de comunicação e de privacidade para o uso dessa inteligência.</p></div>
            <div class="lss-switches">
              <% interest_safeguards.each do |key, label, description| %>
                <%= hidden_field_tag "layout_setting[interest_intelligence_settings][#{key}]", "0", id: nil %>
                <%= ax_switch_field(name: "layout_setting[interest_intelligence_settings][#{key}]",
                                    id: "layout_setting_interest_intelligence_settings_#{key}",
                                    checked: ActiveModel::Type::Boolean.new.cast(interest_settings[key]),
                                    label: label, description: description, class_name: "ax-switch--card") %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ===== Onde cada ajuste aparece ===== %>
        <%= ax_studio_section(id: "layout-tab-impact", icon: "diagram-3",
                              title: "Onde cada ajuste aparece",
                              subtitle: "O que esta tela muda (a plataforma interna da equipe), o que fica em Site público e os tokens que sustentam a plataforma.") do %>
          <div class="ax-studio-group">
            <div class="ax-studio-group__head"><h3>Quem enxerga cada coisa</h3><p>Cada camada tem a sua tela. Mexer numa não altera as outras.</p></div>
            <div class="layout-settings-impact-list">
              <div class="layout-settings-impact is-platform">
                <span class="layout-settings-impact__swatch layout-settings-impact__swatch--platform"></span>
                <div>
                  <strong>Plataforma</strong>
                  <small><code>Unitymob Plataforma</code> aparece apenas para operadores globais do sistema.</small>
                </div>
              </div>
              <div class="layout-settings-impact is-brand">
                <span class="layout-settings-impact__swatch layout-settings-impact__swatch--public"></span>
                <div>
                  <strong>Marca da conta</strong>
                  <small>“<%= account_brand_name %>” é editada em <%= link_to "Site público → Identidade", edit_admin_public_identity_path, class: "ax-link" %>.</small>
                </div>
              </div>
              <div class="layout-settings-impact is-internal">
                <span class="layout-settings-impact__swatch layout-settings-impact__swatch--admin"></span>
                <div>
                  <strong>Plataforma da conta</strong>
                  <small><code>admin_area_name</code> nomeia o ambiente operacional: <%= account_admin_area_name %>.</small>
                </div>
              </div>
              <div class="layout-settings-impact is-admin">
                <span class="layout-settings-impact__swatch layout-settings-impact__swatch--admin"></span>
                <div>
                  <strong>Tema da plataforma</strong>
                  <small><code>admin_primary_color</code> em <code>layouts/admin</code></small>
                </div>
              </div>
              <div class="layout-settings-impact">
                <span class="layout-settings-impact__swatch layout-settings-impact__swatch--public"></span>
                <div>
                  <strong>Paleta e modelo do site público</strong>
                  <small>Editados em <%= link_to "Site público → Identidade", edit_admin_public_identity_path, class: "ax-link" %>; não mudam a plataforma.</small>
                </div>
              </div>
            </div>

          </div>

          <div class="ax-studio-group">
            <div class="ax-studio-group__head"><h3>Tokens da plataforma agora</h3><p>Os valores em edição. Eles alimentam botões, superfícies, menu ativo, badges e foco.</p></div>
            <div class="layout-settings-token-board lss-tokens">
              <div>
                <span class="layout-settings-token-board__swatch" data-theme-swatch="surface"></span>
                <code>surface.DEFAULT</code>
                <em data-theme-token-label="surface"><%= token_hex["surface"] %></em>
              </div>
              <div>
                <span class="layout-settings-token-board__swatch" data-theme-swatch="header"></span>
                <code>surface.header</code>
                <em data-theme-token-label="header"><%= token_hex["header"] %></em>
              </div>
              <div>
                <span class="layout-settings-token-board__swatch" data-theme-swatch="workspace"></span>
                <code>workspace.background</code>
                <em data-theme-token-label="workspace"><%= token_hex["workspace"] %></em>
              </div>
              <div>
                <span class="layout-settings-token-board__swatch" data-theme-swatch="sidebar"></span>
                <code>sidebar.background</code>
                <em data-theme-token-label="sidebar"><%= token_hex["sidebar"] %></em>
              </div>
              <div>
                <span class="layout-settings-token-board__swatch" data-theme-swatch="primary"></span>
                <code>primary</code>
                <em data-theme-token-label="primary"><%= token_hex["primary"] %></em>
              </div>
              <div>
                <span class="layout-settings-token-board__swatch" data-theme-swatch="ink"></span>
                <code>ink</code>
                <em data-theme-token-label="ink"><%= token_hex["ink"] %></em>
              </div>
            </div>
          </div>

          <div class="ax-studio-group lss-guidelines">
            <div class="ax-studio-group__head"><h3>Diretrizes</h3></div>
            <ul>
              <li>Use <code>#365F8F</code> como padrão da plataforma interna.</li>
              <li>Use a marca da conta para nomes vistos por cliente e equipe.</li>
              <li>As cores do site público ficam em Site público → Identidade.</li>
              <li>Não use <code>Admin</code> como nome de produto; use <code>Plataforma</code> ou um nome operacional claro.</li>
            </ul>
          </div>

          <details class="ax-studio-advanced">
            <summary><i class="bi bi-braces"></i> Referência técnica dos tokens <i class="bi bi-chevron-down"></i></summary>
            <div class="layout-settings-token-contract">
              <% admin_token_contract.each do |token_label, token_contract| %>
                <div class="layout-settings-token-contract__item">
                  <span class="layout-settings-token-contract__swatch"
                        data-theme-swatch="<%= token_contract[:theme_var].delete_prefix("--theme-") %>"></span>
                  <div class="layout-settings-token-contract__content">
                    <strong><%= token_label %></strong>
                    <small><%= token_contract[:description] %></small>
                    <div class="layout-settings-token-contract__aliases">
                      <% token_contract[:aliases].each do |token_alias| %>
                        <code><%= token_alias %></code>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>

      <aside class="ax-studio__aside" aria-label="Prévia ao vivo">
        <div class="lss-preview" data-layout-theme-preview-target="preview">
          <div class="lss-preview__label"><span class="lss-preview__live"></span> Prévia ao vivo <em data-theme-token-label="primary"><%= admin_primary.upcase %></em></div>
          <div class="lss-app" aria-hidden="true">
            <header class="lss-app__top">
              <span class="lss-app__mark"><i class="bi bi-buildings"></i></span>
              <strong data-layout-theme-preview-target="brandName"><%= account_brand_name %></strong>
              <em data-layout-theme-preview-target="areaName"><%= account_admin_area_name %></em>
              <span class="lss-app__bell"><i class="bi bi-bell"></i></span>
              <span class="lss-app__avatar">A</span>
            </header>
            <div class="lss-app__body">
              <nav class="lss-sidebar">
                <ul class="ax-nav">
                  <% admin_menu_sections.each_with_index do |section, index| %>
                    <% open = index.zero? %>
                    <li class="ax-nav__section<%= " is-open" if open %>" data-nav-section="<%= section[:key].dasherize %>">
                      <span class="ax-nav__section-trigger" aria-expanded="<%= open %>">
                        <i class="bi bi-<%= section[:icon] %>"></i><span><%= section[:label] %></span><i class="bi bi-chevron-down"></i>
                      </span>
                      <ul class="ax-nav__section-items<%= " is-visible" if open %>">
                        <% preview_nav_items.fetch(section[:key]).each_with_index do |(icon, label), item_index| %>
                          <li><span class="ax-nav__link<%= " active" if open && item_index.zero? %>"><i class="bi bi-<%= icon %>"></i><span><%= label %></span></span></li>
                        <% end %>
                      </ul>
                    </li>
                  <% end %>
                </ul>
              </nav>
              <main class="lss-main">
                <div class="lss-main__head">
                  <div><small>Produto</small><strong>Imóveis</strong></div>
                  <span class="ax-badge ax-badge--blue">Ativo</span>
                </div>
                <div class="lss-main__actions">
                  <span class="ax-btn ax-btn--primary ax-btn--sm">Salvar</span>
                  <span class="ax-btn ax-btn--sm">Cancelar</span>
                </div>
                <div class="ax-field">
                  <span class="ax-field-label">Nome do imóvel</span>
                  <span class="ax-control lss-main__focus">Cobertura Vista Mar</span>
                </div>
                <div class="lss-main__card">
                  <div><span>Apto 402</span><span class="ax-badge ax-badge--green">Publicado</span></div>
                  <div><span>Casa Jardins</span><span class="ax-badge ax-badge--amber">Revisão</span></div>
                </div>
              </main>
            </div>
          </div>
          <p class="lss-preview__note">A prévia usa as cores em edição e o mesmo menu da plataforma. Elas só valem para a equipe depois de salvar.</p>
        </div>
      </aside>
    </div>

    <%= ax_studio_savebar(form: f, cancel_path: admin_root_path) %>
  <% end %>
</div>
