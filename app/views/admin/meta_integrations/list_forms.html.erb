<turbo-frame id="<%= @frame_id %>">
  <% if @forms.any? %>
    <% if @page_number == 1 %>
      <p class="tw-text-2xs tw-text-ink-muted tw-mb-2"><strong><%= @forms_total_count %></strong> formulários · Mais recentes primeiro</p>
      <div class="ax-table-wrap">
        <table class="ax-table ax-table--comfortable">
          <caption class="ax-table__caption--sr-only">Formulários de anúncio de <%= @page.name %></caption>
          <thead><tr><th scope="col">Nome do formulário</th><th scope="col">Criado em</th></tr></thead>
          <tbody id="page_forms_rows_<%= @page.id %>"><%= render "form_rows", forms: @forms %></tbody>
        </table>
      </div>
    <% else %>
      <%= turbo_stream.append "page_forms_rows_#{@page.id}" do %>
        <%= render "form_rows", forms: @forms %>
      <% end %>
    <% end %>

    <% if @next_page %>
      <% next_frame_id = "page_forms_#{@page.id}_page_#{@next_page}" %>
      <turbo-frame id="<%= next_frame_id %>"
                   src="<%= list_forms_admin_meta_integrations_path(page_id: @page.id, page: @next_page) %>"
                   loading="lazy">
        <div class="tw-flex tw-items-center tw-justify-center tw-gap-2 tw-py-3 tw-text-primary" role="status" aria-live="polite">
          <span class="ax-spinner" aria-hidden="true"></span>
          <span class="tw-text-2xs">Carregando mais formulários...</span>
        </div>
      </turbo-frame>
    <% end %>
  <% else %>
    <%= ax_record_item(
          title: "Nenhum formulário encontrado",
          meta: "Esta página ainda não tem formulários de anúncio.",
          icon: "file-earmark-x"
        ) %>
  <% end %>
</turbo-frame>
