<% ready = page.active? && page.instagram_enabled? && page.instagram_checked_at.present? && page.instagram_sync_error.blank? %>
<% state, tone = if page.instagram_sync_error.present?
  ["Pendente", :amber]
elsif ready
  [page.instagram_received_at.present? ? "Recebendo mensagens" : "Pronto para receber", :green]
elsif page.instagram_checked_at.present? && page.instagram_id.blank?
  ["Sem perfil vinculado", :gray]
else
  ["Aguardando verificação", :gray]
end %>
<%= ax_record_item(title: "Instagram Direct", icon: "instagram", meta: page.instagram_username.presence || "Perfil profissional vinculado à página", actions: ax_badge(state, tone: tone, dot: ready)) %>
<% if page.instagram_sync_error.present? %>
  <p class="tw-text-sm tw-text-ink-muted" role="status"><%= page.instagram_sync_error %></p>
<% elsif ready && page.instagram_received_at.present? %>
  <p class="tw-text-sm tw-text-ink-muted">Última mensagem recebida em <%= l(page.instagram_received_at, format: "%d/%m/%Y %H:%M") %>.</p>
<% elsif ready %>
  <p class="tw-text-sm tw-text-ink-muted">Configuração confirmada. Aguardando a primeira mensagem.</p>
<% elsif page.instagram_checked_at.present? && page.instagram_id.blank? %>
  <p class="tw-text-sm tw-text-ink-muted">A Meta não retornou um Instagram profissional vinculado a esta página.</p>
<% else %>
  <p class="tw-text-sm tw-text-ink-muted">O sistema verifica e prepara o recebimento automaticamente em segundo plano.</p>
<% end %>
