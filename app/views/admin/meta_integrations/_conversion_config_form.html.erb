<%= turbo_frame_tag "meta_conversion_config" do %>
  <%= form_with url: conversion_config_admin_meta_integrations_path, scope: :meta_conversion_config, method: :patch, class: "ax-integration-form" do |form| %>
    <div class="ax-field">
      <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-flex-wrap">
        <%= form.label :dataset_ids, "Onde o Facebook guarda os resultados", class: "ax-label" %>
        <button type="button" class="ax-btn ax-btn--sm ax-btn--ghost" data-ax-modal-open="#metaDatasetInfoModal">
          <i class="bi bi-question-circle" aria-hidden="true"></i> O que é isso?
        </button>
      </div>
      <p class="tw-text-sm tw-text-ink-muted">Escolha o da sua imobiliária. Se tiver mais de um, pode marcar todos: o aviso vai para cada um.</p>
      <% choices = datasets.map { |dataset| ["#{dataset[:name]} (#{dataset[:id]})", dataset[:id]] } %>
      <% missing = config.dataset_list.reject { |saved| choices.any? { |_, choice_id| choice_id.to_s == saved["id"] } } %>
      <% missing.each do |saved| %>
        <% choices.unshift(["#{saved["name"]} — escolhido antes, não apareceu agora", saved["id"]]) %>
      <% end %>
      <% if choices.any? %>
        <%= ax_autocomplete_select_field(form: form, method: :dataset_ids, label: "Resultados do Facebook", multiple: true, choices: choices, select_options: { selected: config.dataset_list.map { |saved| saved["id"] } }) %>
      <% else %>
        <%= form.text_field :dataset_ids_manual, value: "", class: "ax-control", placeholder: "Código de cada um, separados por vírgula", autocomplete: "off" %>
        <p class="tw-text-sm tw-text-ink-muted">Não encontramos nenhum nas suas contas de anúncios. Confira se escolheu a conta certa mais acima ou digite o código se você já o tem.</p>
      <% end %>
    </div>

    <%= ax_switch_field(form: form, method: :enabled, label: "Avisar o Facebook automaticamente", checked: config.enabled?, checked_value: "1", unchecked_value: "0", input_html: { checked: config.enabled? }) %>

    <details class="ax-integration-help">
      <summary>Avançado: modo de teste</summary>
      <div class="ax-field tw-mt-3">
        <%= form.label :test_event_code, "Código de teste", class: "ax-label" %>
        <%= form.text_field :test_event_code, value: config.test_event_code, class: "ax-control", placeholder: "Ex.: TEST12345", autocomplete: "off" %>
        <p class="tw-text-sm tw-text-ink-muted">Só use se quem cuida dos anúncios pedir. Os avisos aparecem na tela de testes do Facebook e não contam como resultado de verdade. Deixe em branco no dia a dia.</p>
      </div>
    </details>

    <div class="ax-integration-actions">
      <%= form.submit "Salvar", class: "ax-btn ax-btn--sm ax-btn--primary" %>
      <%= ax_badge(config.active? ? "Avisando o Facebook" : "Desativado", tone: config.active? ? :green : :gray, dot: config.active?) %>
    </div>
  <% end %>
<% end %>
