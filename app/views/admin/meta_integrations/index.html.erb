<% content_for :mobile_detail_header do %>
  <%= render "admin/shared/ui/mobile_detail_header", title: "Meta Leads", back_path: admin_root_path, icon: "meta" %>
<% end %>
<div class="ax-integration-layout">
<div class="integration-workspace meta-integration-workspace">
<%= ax_workspace_heading(icon: "meta", title: "Meta Leads", pills: [@integration ? "conectada" : "desconectada"], subtitle: "Gerencie formulários, Instagram Direct e a identificação de campanhas.", actions: capture do %>
  <% if @integration %>
    <%= turbo_stream_from "meta_sync_#{@integration.id}" %>
    <%= button_to disconnect_admin_meta_integrations_path, method: :delete, form_class: "tw-inline", class: "ax-btn ax-btn--sm ax-btn--danger", data: { turbo_confirm: "Desconectar esta conta da Meta?\n\nO CRM removerá a conexão, o token, as páginas e formulários sincronizados, os vínculos de Instagram e conta de anúncios e os avisos de falha desta integração. O recebimento por esta conexão será interrompido.\n\nOs leads e as mensagens já recebidos serão preservados. A autorização e as inscrições na Meta não serão removidas.\n\nAo reconectar, será necessário sincronizar e configurar os vínculos novamente." } do %>
      <i class="bi bi-box-arrow-right ax-ico" aria-hidden="true"></i><span>Desconectar conta</span>
    <% end %>
  <% end %>
<% end) %>

<div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-12 tw-gap-4">
  <div class="lg:tw-col-span-12">
    <%= render "sync_status", integration: @integration %>
    <div class="ax-integration-sections">
        <% if @integration %>
          <%= ax_record_item(
                title: "Conectado como #{@integration.name}",
                meta: @integration.email,
                icon: "person-fill",
                class_name: "meta-integration-account",
                actions: safe_join([
                  ax_badge(@integration.expired? ? "Autorização expirada" : "Conta conectada", tone: @integration.expired? ? :amber : :green)
                ], " ")
              ) %>

          <% if impersonating_admin_user? %>
            <%= turbo_stream_from "meta_selection_#{@integration.id}" %>
            <%= render "admin/meta_integrations/page_selection", integration: @integration %>
          <% end %>
          <%= render "pages", pages: @pages %>

          <%= ax_form_section(title: "Conta de anúncios", tooltip: "Usada para buscar informações de anúncios e campanhas dos leads.") do %>
            <%= turbo_frame_tag "meta_ad_accounts", src: ad_accounts_admin_meta_integrations_path do %>
              <p class="tw-text-sm tw-text-ink-muted" role="status">Consultando contas de anúncios na Meta...</p>
            <% end %>
          <% end %>

          <%= render "admin/meta_integrations/permissions", check: nil %>

          <% if @meta_webhook_callback_url.present? && @meta_webhook_verify_token.present? %>
            <%= ax_form_section(title: "Configuração técnica", collapse_id: "meta-webhook-settings", collapsed: true, tooltip: @meta_webhook_mode_description) do %>
              <% if @meta_webhook_mode == "gateway" %>
                <p class="tw-text-sm tw-text-ink-muted">O sistema gerencia a entrega pelo gateway Unitymob. Nenhuma configuração manual é necessária nesta tela.</p>
              <% else %>
              <p class="tw-text-sm tw-text-ink-muted">Dados para o responsável pelo aplicativo Meta próprio desta conta.</p>
              <div class="ax-integration-fields">
              <div class="ax-field"><%= label_tag :meta_webhook_callback, "Endereço de recebimento", class: "ax-label" %><%= text_field_tag :meta_webhook_callback, @meta_webhook_callback_url, class: "ax-control", readonly: true %></div>
              <div class="ax-field"><%= label_tag :meta_webhook_verify, "Token de verificação", class: "ax-label" %><%= text_field_tag :meta_webhook_verify, @meta_webhook_verify_token, class: "ax-control", readonly: true %></div>
              </div>
              <% end %>
            <% end %>
          <% end %>

        <% else %>
          <%= render("admin/shared/ui/integration_onboarding",
                title: "Conecte Facebook e Instagram ao CRM",
                description: "Use seu login do Facebook para autorizar os recursos da Meta que sua empresa utiliza.",
                features: [
                  ["Formulários de anúncios", "Receba no CRM os leads enviados pelos formulários das páginas autorizadas."],
                  ["Instagram Direct", "O sistema prepara automaticamente o recebimento de mensagens do perfil profissional vinculado à página selecionada."],
                  ["Campanhas e anúncios", "Selecione uma conta de anúncios para identificar campanhas dos leads, inclusive de anúncios que abrem o WhatsApp (CTWA)."]
                ],
                note: "O WhatsApp exige conexão própria em Integrações → WhatsApp.",
                action: capture do %>
            <%= button_to admin_user_facebook_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "ax-btn ax-btn--primary" do %>
              <i class="bi bi-facebook ax-ico" aria-hidden="true"></i> Continuar com Facebook
            <% end %>
            <p class="ax-integration-onboarding__hint">Após autorizar, confira as páginas e os recursos disponíveis. O sistema mostra as permissões pendentes e como liberá-las.</p>
          <% end) %>
        <% end %>
    </div>
  </div>

</div>
</div>

</div>
