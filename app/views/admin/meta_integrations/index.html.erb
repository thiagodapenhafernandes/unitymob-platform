<div class="ax-integration-layout">
<div class="integration-workspace meta-integration-workspace">
<%= ax_workspace_heading(icon: "meta", title: "Meta Leads", pills: [@integration ? "conectada" : "desconectada"], subtitle: "Monitore páginas e formulários que recebem leads automaticamente.", actions: capture do %>
  <% if @integration %>
    <%= turbo_stream_from "meta_sync_#{@integration.id}" %>
    <%= button_to disconnect_admin_meta_integrations_path, method: :delete, form_class: "tw-inline", class: "ax-btn ax-btn--sm ax-btn--danger", data: { turbo_confirm: "Tem certeza? Isso irá parar a importação de leads." } do %>
      <i class="bi bi-box-arrow-right ax-ico" aria-hidden="true"></i><span>Desconectar conta</span>
    <% end %>
  <% end %>
<% end) %>

<div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-12 tw-gap-4">
  <div class="lg:tw-col-span-12">
    <%= render "sync_status", integration: @integration %>
    <%= ax_operational_panel(title: @integration ? "Conta conectada" : "Conexão Facebook") do %>
        <% if @integration %>
          <%= ax_record_item(
                title: "Conectado como #{@integration.name}",
                meta: @integration.email,
                icon: "person-fill",
                class_name: "meta-integration-account",
                actions: safe_join([
                  ax_badge("Ativo", tone: :green, dot: true),
                  ax_badge("Token de longo prazo", tone: :green)
                ], " ")
              ) %>

          <%= render "admin/meta_integrations/permissions", check: nil %>

          <%= ax_form_section(title: "Conta de anúncios", tooltip: "Usada para buscar informações de anúncios e campanhas dos leads.") do %>
            <%= turbo_frame_tag "meta_ad_accounts", src: ad_accounts_admin_meta_integrations_path do %>
              <p class="tw-text-sm tw-text-ink-muted" role="status">Consultando contas de anúncios na Meta...</p>
            <% end %>
          <% end %>

          <% if @meta_webhook_callback_url.present? && @meta_webhook_verify_token.present? %>
            <%= ax_form_section(title: "Configuração do webhook", collapse_id: "meta-webhook-settings", collapsed: true, tooltip: @meta_webhook_mode_description) do %>
              <div class="ax-field"><%= label_tag :meta_webhook_callback, "Callback URL", class: "ax-label" %><%= text_field_tag :meta_webhook_callback, @meta_webhook_callback_url, class: "ax-control", readonly: true %></div>
              <div class="ax-field"><%= label_tag :meta_webhook_verify, "Verify Token", class: "ax-label" %><%= text_field_tag :meta_webhook_verify, @meta_webhook_verify_token, class: "ax-control", readonly: true %></div>
              <span class="ax-stat-label"><%= @meta_webhook_mode_label %></span>
            <% end %>
          <% end %>

          <%= render "pages", pages: @pages %>
        <% else %>
          <div class="tw-text-center tw-py-8">
            <i class="bi bi-facebook tw-text-blue-600 meta-integration-connect-icon" aria-hidden="true"></i>
            <h2 class="ax-page-title tw-mt-3 tw-mb-2">Conecte sua conta do Facebook</h2>
            <p class="ax-page-subtitle tw-max-w-md tw-mx-auto tw-mb-4">Integre suas Páginas e Formulários de Lead Ads para receber leads automaticamente no CRM.</p>
            <%= button_to admin_user_facebook_omniauth_authorize_path, method: :post, data: { turbo: false }, form_class: "tw-inline", class: "ax-btn ax-btn--primary" do %>
              <i class="bi bi-facebook ax-ico" aria-hidden="true"></i> Continuar com Facebook
            <% end %>
          </div>
        <% end %>
    <% end %>
  </div>

</div>
</div>

</div>
