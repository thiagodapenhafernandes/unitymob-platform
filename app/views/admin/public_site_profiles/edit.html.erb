<%
  legal_gaps = @profile.activation_gaps - ["Cidade principal"]
  custom_ranges = @profile.custom_price_ranges?
  sale_auto = @automatic_price_ranges["venda"]
  rental_auto = @automatic_price_ranges["aluguel"]
  city_choices = [["Automática#{" — #{@automatic_city}" if @automatic_city}", ""]] +
                 (@city_suggestions | [@profile.primary_city.presence].compact).map { |city| [city, city] }
  metrics = [
    { value: legal_gaps.empty? ? "OK" : legal_gaps.size, label: legal_gaps.empty? ? "dados jurídicos" : "pendências jurídicas",
      class_name: ("is-warning" if legal_gaps.any?) },
    { value: custom_ranges ? "Personalizadas" : "Automáticas", label: "faixas de preço" },
    { value: @profile.primary_city.presence || @automatic_city || "—", label: "cidade principal" }
  ]
  price_fields = [
    { key: :label, label: "Nome (opcional)", placeholder: "Gerado automaticamente", width: "minmax(0, 1.4fr)" },
    { key: :min, label: "De (R$)", placeholder: "0", type: :number },
    { key: :max, label: "Até (R$)", placeholder: "sem limite", type: :number }
  ]
%>

<% content_for :admin_contextbar_actions do %>
  <%= link_to edit_admin_institutional_page_path, class: "ax-btn ax-btn--sm" do %>
    <i class="bi bi-file-earmark-text ax-ico" aria-hidden="true"></i><span>Páginas institucionais</span>
  <% end %>
  <%= button_tag type: "submit", form: "public-site-profile-form", class: "ax-btn ax-btn--primary ax-btn--sm" do %>
    <i class="bi bi-check2 ax-ico" aria-hidden="true"></i><span>Salvar</span>
  <% end %>
<% end %>

<div class="public-site-workspace public-site-profile">
  <%= ax_workspace_heading(eyebrow: "Site público · Governança", icon: "building-gear", title: "Perfil público",
        subtitle: "Região de atuação, dados legais e as faixas de preço que a busca do site oferece.",
        metrics: metrics) %>

  <%= form_with model: @profile, url: admin_public_site_profile_path, method: :patch, id: "public-site-profile-form" do |f| %>
    <%= ax_error_summary(@profile) %>

    <div class="public-site-profile__row">
      <%= ax_form_section(title: "Identidade e região", eyebrow: "Mercado", icon: "geo-alt") do %>
        <%= ax_select_field(form: f, method: :primary_city, label: "Cidade principal", choices: city_choices) %>
        <p class="public-site-profile__hint">As opções vêm das cidades dos imóveis publicados. "Automática" acompanha a cidade com mais imóveis.</p>
        <%= ax_inline_notice(tone: :neutral, icon: "broadcast", compact: true, announce: false,
              body: "Aparece em: SEO e dados estruturados, subtítulo da home, página Sobre, e-mails de lead e textos gerados por IA.") %>
      <% end %>

      <%= ax_form_section(title: "Página do imóvel", eyebrow: "Empreendimento", icon: "buildings") do %>
        <%= ax_switch_field(form: f, method: :show_development_identity, class_name: "ax-switch--card",
              label: "Mostrar o nome do empreendimento",
              description: "Exibe nome, rua, descrição e link da página do empreendimento no bloco \"Sobre o empreendimento\" das unidades. Desligado, o bloco mostra só fotos, faixas, lazer e bairro. Sem nome cadastrado, fica sempre discreto.") %>
      <% end %>
    </div>

    <%
      financing_source = @profile.financing_rate_source.presence || Financing::CentralBankRate::DEFAULT_SOURCE
      financing_choices = Financing::CentralBankRate::SERIES.map do |source, series|
        rate = @financing_rates[source]
        label = "Banco Central — #{series[:label]}"
        label += " (#{number_with_precision(rate.annual_rate, precision: 2, separator: ",")}% a.a.#{", #{I18n.l(rate.reference_date, format: "%b/%Y").downcase}" if rate.reference_date})" unless rate.fallback
        [label, source]
      end + [["Taxa própria da imobiliária", "custom"]]
    %>
    <%= ax_form_section(title: "Simulador de financiamento", eyebrow: "Site", icon: "calculator") do %>
      <div data-controller="conditional-reveal" data-conditional-reveal-kind-value="select">
        <%= ax_switch_field(form: f, method: :financing_simulator_enabled, class_name: "ax-switch--card",
              input_html: { checked: @profile.financing_simulator_enabled? },
              label: "Mostrar o simulador no site",
              description: "Página /simulador, item \"Simule um financiamento\" do menu e bloco \"Simule o financiamento deste imóvel\" nos imóveis à venda. Desligado, tudo some do site.") %>
        <div class="public-site-profile__fields">
          <%= ax_select_field(form: f, method: :financing_rate_source, label: "Taxa de juros sugerida", choices: financing_choices,
                select_options: { selected: financing_source },
                html_options: { data: { conditional_reveal_target: "trigger", action: "change->conditional-reveal#sync" } }) %>
          <div data-conditional-reveal-target="panel" data-conditional-reveal-values="custom" <%= "hidden" unless financing_source == "custom" %>>
            <%= ax_text_field(form: f, method: :financing_custom_rate, label: "Taxa própria (% ao ano)", type: :number,
                  step: "0.01", min: "0.01", max: "30", placeholder: "Ex.: 10,5",
                  hint: "Por exemplo, a taxa do banco parceiro da imobiliária.") %>
          </div>
        </div>
        <p class="public-site-profile__hint tw-mb-0">O Banco Central publica a média do mercado com 2 a 3 meses de atraso; o site atualiza sozinho. O visitante pode alterar a taxa na simulação.</p>
      </div>
    <% end %>

    <%= ax_form_section(title: "Dados jurídicos", eyebrow: "Privacidade", icon: "file-earmark-lock") do %>
      <% if legal_gaps.any? %>
        <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle", compact: true, body: "Falta preencher: #{legal_gaps.join(', ')}.") %>
      <% else %>
        <%= ax_inline_notice(tone: :success, icon: "check-circle", compact: true, body: "Dados jurídicos essenciais preenchidos.") %>
      <% end %>
      <div class="public-site-profile__fields">
        <%= ax_text_field(form: f, method: :legal_name, label: "Razão social") %>
        <%= ax_text_field(form: f, method: :legal_document, label: "CNPJ/Documento") %>
        <div>
          <%= ax_text_field(form: f, method: :creci, label: "CRECI da empresa") %>
          <p class="public-site-profile__hint">É o CRECI jurídico da imobiliária. O CRECI de cada loja, mostrado no rodapé, fica em <%= link_to "Lojas", admin_stores_path %>.</p>
        </div>
        <%= ax_text_field(form: f, method: :privacy_email, label: "E-mail de privacidade", type: :email) %>
        <%= ax_text_field(form: f, method: :legal_address, label: "Endereço jurídico", class_name: "public-site-profile__field--wide") %>
      </div>
      <%= ax_inline_notice(tone: :neutral, icon: "broadcast", compact: true, announce: false,
            body: "Aparece em: Política de Privacidade, Termos de Uso e cabeçalho da ficha de captação.") %>
    <% end %>

    <%= ax_form_section(title: "Faixas de preço da busca", eyebrow: "Filtros", icon: "cash-stack") do %>
      <div class="public-site-profile__ranges">
        <div class="public-site-profile__row public-site-profile__row--flush">
          <% [["Venda", sale_auto], ["Locação", rental_auto]].each do |title, auto| %>
            <div class="public-site-profile__preview" aria-label="Faixas automáticas de <%= title.downcase %>">
              <span class="public-site-profile__preview-label"><%= title %> — calculado pelo estoque</span>
              <% if auto && auto[:ranges].any? %>
                <div class="public-site-profile__chips">
                  <% auto[:ranges].each do |label, _range| %><%= ax_badge(label, tone: :blue) %><% end %>
                </div>
                <p class="public-site-profile__hint tw-mb-0">Slider do filtro: de <%= PublicSite::PriceRanges.short_money(auto[:min]) %> a <%= PublicSite::PriceRanges.short_money(auto[:max]) %> · base de <%= auto[:count] %> imóveis.</p>
              <% else %>
                <p class="public-site-profile__hint tw-mb-0">Poucos imóveis para calcular: o site usa as faixas padrão do sistema.</p>
              <% end %>
            </div>
          <% end %>
        </div>

        <%= ax_switch_field(form: f, method: :custom_price_ranges, input_html: { checked: custom_ranges }, class_name: "ax-switch--card public-site-profile__custom-toggle",
              label: "Personalizar as faixas",
              description: "Desligado, as faixas acompanham o estoque automaticamente. Ligado, a busca mostra exatamente as faixas abaixo (o slider do filtro continua pelo estoque).") %>

        <div class="public-site-profile__custom">
          <%= ax_repeatable_rows(label: "Faixas de venda", rows: @profile.sale_price_rows, fields: price_fields,
                input_name: "public_site_profile[sale_price_rows]", add_label: "Adicionar faixa",
                empty_hint: "Sem faixas de venda personalizadas.") %>
          <%= ax_repeatable_rows(label: "Faixas de locação", rows: @profile.rental_price_rows, fields: price_fields,
                input_name: "public_site_profile[rental_price_rows]", add_label: "Adicionar faixa",
                empty_hint: "Sem faixas de locação personalizadas.") %>
          <p class="public-site-profile__hint tw-mb-0">Valores em reais. "Até" vazio significa "acima de". Sem nome, o site gera um (ex.: "R$ 1,5 mi a R$ 3 mi").</p>
        </div>
      </div>
      <%= ax_inline_notice(tone: :neutral, icon: "broadcast", compact: true, announce: false,
            body: "Aparece em: busca do topo da home, filtros da listagem e limites do filtro detalhado.") %>
    <% end %>

    <div class="public-site-profile__footer"><%= f.submit "Salvar perfil público", class: "ax-btn ax-btn--primary" %></div>
  <% end %>
</div>
