<%
  editing = template.meta_id.present?
  header_icons = { "none" => "bi-dash-circle", "text" => "bi-fonts", "image" => "bi-image", "video" => "bi-camera-video", "document" => "bi-file-earmark-pdf" }
  selected_header = template.header_format.presence || "none"
%>
<%= form_with model: [:admin, template],
              class: "ax-guided",
              data: {
                controller: "whatsapp-template-form",
                whatsapp_template_form_type_value: "text",
                action: "submit->whatsapp-template-form#submitStarted input->whatsapp-template-form#refresh change->whatsapp-template-form#refresh focusin->whatsapp-template-form#focusStep",
                whatsapp_template_form_upload_media_url_value: upload_media_admin_whatsapp_templates_path
              } do |f| %>
  <%= hidden_field_tag :whatsapp_sender_number_id, sender_number&.id if sender_number %>
  <%= f.hidden_field :template_type, value: "text" %>

  <%= render "form_feedback", template: template %>

  <%= ax_guided_header(controller: "whatsapp-template-form", icon: "bi-stars", title: (editing ? "Ajuste seu template" : "Vamos criar seu template"),
                             subtitle: "Cinco passos rápidos. Você vê a mensagem como o cliente vai receber, enquanto escreve.",
                             steps: [["Identifique", "bi-tag"], ["Objetivo", "bi-bullseye"], ["Mensagem", "bi-chat-text"], ["Botões", "bi-hand-index"], ["Revisar", "bi-send-check"]]) %>

  <div class="ax-guided-layout">
    <div class="ax-guided-steps">

      <%= render "builder_identity", f: f, template: template, name_placeholder: "ex: boas_vindas_lead" %>

      <%= ax_guided_step(number: 3, color: :green, title: "Escreva a mensagem", subtitle: "Escreva como falaria com o cliente. Use variáveis para personalizar.") do %>
        <fieldset class="ax-guided-fieldset">
          <legend>Cabeçalho <em>opcional</em></legend>
          <%= ax_choice_group(form: f, method: :header_format, variant: :segment, selected: selected_header, aria_label: "Tipo de cabeçalho",
                              input_data: { whatsapp_template_form_target: "mediaSelect", action: "change->whatsapp-template-form#toggleMedia" },
                              choices: WhatsappTemplate::HEADER_FORMATS.map { |key, label| { value: key, label: label, icon: header_icons.fetch(key, "bi-dash-circle") } }) %>
          <div class="ax-guided-grid">
            <div class="ax-guided-span-2" data-whatsapp-template-form-target="headerTextField">
              <%= ax_text_field(form: f, method: :header_text, label: "Texto do cabeçalho", tooltip: "Texto curto que aparece antes da mensagem.", maxlength: 60, placeholder: "Ex: Informação importante") %>
            </div>
            <div class="ax-field ax-guided-span-2" data-whatsapp-template-form-target="mediaField">
              <%= ax_field_label(f, :header_media_file, text: "Mídia de exemplo", tooltip: "Anexe o arquivo que será usado como exemplo na aprovação. O sistema prepara o envio automaticamente.") %>
              <div class="ax-upload-control whatsapp-template-upload-control">
                <%= ax_file_upload_button(
                      form: f,
                      method: :header_media_file,
                      label: "Selecionar mídia",
                      input_id: "whatsapp_template_header_media_file",
                      multiple: false,
                      accept: "image/png,image/jpeg,video/mp4,video/3gpp,application/pdf",
                      input_class: "whatsapp-template-file",
                      input_data: { action: "change->whatsapp-template-form#updateFileName" }
                    ) %>
                <span class="ax-upload-status" data-whatsapp-template-file-status>Nenhum arquivo selecionado</span>
              </div>
              <%= f.hidden_field :header_media_handle %>
              <div class="wtb-rules" data-whatsapp-template-form-target="mediaRules">
                <span>Imagem: JPG, PNG</span><span>Vídeo: MP4 ou 3GPP</span><span>Documento: PDF</span>
              </div>
            </div>
          </div>
        </fieldset>

        <%= render "builder_message", f: f, template: template, label: "Texto da mensagem", rows: 6,
                                      tooltip: "Escreva a mensagem como o cliente receberá. Para trechos personalizados, use os exemplos abaixo na ordem em que aparecem no texto.",
                                      placeholder: "Olá {{1}}, temos uma novidade para você." %>
      <% end %>

      <%= ax_guided_step(number: 4, color: :amber, title: "Rodapé e botões", optional: true, subtitle: "Dê ao cliente um jeito fácil de responder, abrir um link ou ligar.") do %>
      <%= ax_text_field(form: f, method: :footer_text, label: "Rodapé", tooltip: "Texto curto opcional, sem variáveis.", maxlength: 60,
                        label_meta: tag.span("0 / 60", class: "ax-guided-counter", data: { guided: "footerCount" }), placeholder: "Ex: Responda SAIR para não receber mais") %>

      <div class="wtb-vars__head">
        <div><strong>Botões</strong><p>Até 3 aparecem direto na mensagem. Resposta rápida devolve o clique para o seu fluxo.</p></div>
        <button type="button" class="ax-btn ax-btn--sm" data-action="whatsapp-template-form#addButton">
          <i class="bi bi-plus-lg ax-ico"></i><span>Adicionar botão</span>
        </button>
      </div>
      <div class="whatsapp-template-button-list wtb-buttons" data-whatsapp-template-form-target="buttonList">
        <% existing_buttons = template.clean_buttons.presence || [{}] %>
        <% existing_buttons.first(WhatsappTemplate::MAX_BUTTONS).each_with_index do |button, index| %>
          <%= render "builder_button_row", index: index, button: button %>
        <% end %>
      </div>
      <template data-whatsapp-template-form-target="buttonTemplate"><%= render "builder_button_row", index: "__INDEX__" %></template>
      <% end %>

      <%= ax_guided_review(number: 5, title: "Tudo certo para enviar?", subtitle: "A Meta revisa o modelo antes de liberar o uso. Você acompanha o status na listagem.",
                     submit_label: (template.meta_id.present? ? "Salvar e reenviar para aprovação" : "Enviar para aprovação"),
                     cancel_path: admin_whatsapp_templates_path(whatsapp_sender_number_id: sender_number&.id),
                     checks: [["name", "Nome do template"], ["body", "Texto da mensagem"], ["examples", "Exemplos das variáveis"], ["header", "Cabeçalho"], ["buttons", "Botões"]]) %>
    </div>

    <%= render "builder_preview", mode: "text" %>
  </div>
<% end %>
