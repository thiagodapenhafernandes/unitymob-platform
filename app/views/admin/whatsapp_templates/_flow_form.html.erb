<%
  editing = template.meta_id.present?
  config = template.clean_flow_config
%>
<%= form_with model: [:admin, template],
              class: "ax-guided",
              data: {
                controller: "whatsapp-template-form",
                whatsapp_template_form_type_value: "flow",
                action: "submit->whatsapp-template-form#submitStarted input->whatsapp-template-form#refresh change->whatsapp-template-form#refresh focusin->whatsapp-template-form#focusStep"
              } do |f| %>
  <%= hidden_field_tag :whatsapp_sender_number_id, sender_number&.id if sender_number %>
  <%= f.hidden_field :template_type, value: "flow" %>
  <%= f.hidden_field :header_format, value: "none" %>

  <%= render "form_feedback", template: template %>

  <%= ax_guided_header(controller: "whatsapp-template-form", icon: "bi-diagram-3", title: (editing ? "Ajuste seu template com Flow" : "Vamos criar seu template com Flow"),
                             subtitle: "Uma mensagem com um botão que abre um formulário, agendamento ou pesquisa já criado na Meta.",
                             steps: [["Identifique", "bi-tag"], ["Objetivo", "bi-bullseye"], ["Mensagem", "bi-chat-text"], ["Flow", "bi-diagram-3"], ["Revisar", "bi-send-check"]]) %>

  <div class="ax-guided-layout">
    <div class="ax-guided-steps">
      <%= render "builder_identity", f: f, template: template, name_placeholder: "ex: flow_agendamento" %>

      <%= ax_guided_step(number: 3, color: :green, title: "Escreva a mensagem", subtitle: "O texto que convida o cliente a tocar no botão do Flow.") do %>
        <%= render "builder_message", f: f, template: template, label: "Texto da mensagem", rows: 5,
                                      tooltip: "Texto que introduz o botão do Flow. Use variáveis como {{1}} quando precisar personalizar.",
                                      placeholder: "Olá {{1}}, toque no botão para continuar." %>
        <%= ax_text_field(form: f, method: :footer_text, label: "Rodapé", tooltip: "Texto curto opcional exibido abaixo da mensagem.", maxlength: 60,
                          label_meta: tag.span("0 / 60", class: "ax-guided-counter", data: { guided: "footerCount" }), placeholder: "Ex: Leva menos de 1 minuto") %>
      <% end %>

      <%= ax_guided_step(number: 4, color: :amber, title: "Conexão com Flow", subtitle: "Informe qual Flow publicado na Meta o botão vai abrir.") do %>
        <div class="ax-guided-grid">
          <div class="ax-guided-span-2">
            <%= ax_standalone_field(name: "whatsapp_template[flow_config][flow_id]", id: "whatsapp_template_flow_config_flow_id", label: "ID do Flow na Meta", value: config["flow_id"],
                                    placeholder: "Ex: 000000000000000", inputmode: "numeric", autocomplete: "off",
                                    hint: "Copie no Gerenciador do WhatsApp, em Flows. O Flow precisa estar publicado.") %>
          </div>
          <%= ax_standalone_field(name: "whatsapp_template[flow_config][button_text]", id: "whatsapp_template_flow_config_button_text", label: "Texto do botão",
                                  value: config["button_text"].presence || "Abrir", maxlength: 25, placeholder: "Abrir cadastro", autocomplete: "off") %>
          <%= ax_standalone_select_field(name: "whatsapp_template[flow_config][action]", id: "whatsapp_template_flow_config_action", label: "Ação do Flow",
                                         choices: WhatsappTemplate::FLOW_ACTIONS.map { |key, label| [label, key] }, selected: config["action"].presence || "navigate", autocomplete: true,
                                         data: { whatsapp_template_form_target: "flowActionSelect", action: "change->whatsapp-template-form#toggleFlowFields" }) %>
          <div class="ax-guided-span-2" data-whatsapp-template-form-target="flowScreenField">
            <%= ax_standalone_field(name: "whatsapp_template[flow_config][screen]", id: "whatsapp_template_flow_config_screen", label: "Tela inicial", value: config["screen"],
                                    placeholder: "Ex: APPOINTMENT", autocomplete: "off", hint: "Opcional. Use quando o Flow precisa abrir em uma tela específica.") %>
          </div>
        </div>
      <% end %>

      <%= ax_guided_review(number: 5, title: "Tudo certo para enviar?", subtitle: "A Meta revisa o modelo antes de liberar o uso. Você acompanha o status na listagem.",
                     submit_label: (template.meta_id.present? ? "Salvar e reenviar para aprovação" : "Enviar para aprovação"),
                     cancel_path: admin_whatsapp_templates_path(whatsapp_sender_number_id: sender_number&.id),
                     checks: [["name", "Nome do template"], ["body", "Texto da mensagem"], ["examples", "Exemplos das variáveis"], ["flow", "Conexão com o Flow"]]) %>
    </div>

    <%= render "builder_preview", mode: "flow" %>
  </div>
<% end %>
