<%
  editing = template.meta_id.present?
%>
<%= form_with model: [:admin, template],
              class: "ax-guided",
              data: {
                controller: "whatsapp-template-form",
                whatsapp_template_form_type_value: "carousel",
                action: "submit->whatsapp-template-form#submitStarted input->whatsapp-template-form#refresh change->whatsapp-template-form#refresh focusin->whatsapp-template-form#focusStep",
                whatsapp_template_form_upload_media_url_value: upload_media_admin_whatsapp_templates_path
              } do |f| %>
  <%= hidden_field_tag :whatsapp_sender_number_id, sender_number&.id if sender_number %>
  <%= f.hidden_field :template_type, value: "carousel" %>
  <%= f.hidden_field :header_format, value: "none" %>

  <%= render "form_feedback", template: template %>

  <%= ax_guided_header(controller: "whatsapp-template-form", icon: "bi-collection", title: (editing ? "Ajuste seu carrossel" : "Vamos montar seu carrossel"),
                             subtitle: "Uma mensagem com 2 a 10 cards deslizantes, cada um com mídia, texto e botão.",
                             steps: [["Identifique", "bi-tag"], ["Objetivo", "bi-bullseye"], ["Introdução", "bi-chat-text"], ["Cards", "bi-collection"], ["Revisar", "bi-send-check"]]) %>

  <div class="ax-guided-layout">
    <div class="ax-guided-steps">
      <%= render "builder_identity", f: f, template: template, name_placeholder: "ex: carrossel_imoveis" %>

      <%= ax_guided_step(number: 3, color: :green, title: "Escreva a introdução", subtitle: "A mensagem que chega antes dos cards. Curta e convidativa.") do %>
        <%= render "builder_message", f: f, template: template, label: "Texto introdutório", rows: 4,
                                      tooltip: "Mensagem enviada antes dos cards. Use variáveis como {{1}} quando precisar personalizar.",
                                      placeholder: "Escolha uma das opções abaixo." %>
      <% end %>

      <%= ax_guided_step(number: 4, color: :amber, title: "Monte os cards", subtitle: "Cada card precisa de mídia, texto e um botão. O sistema envia as mídias para a Meta.") do %>
        <div class="wtb-vars__head">
          <div><strong>Cards do carrossel</strong><p>Entre 2 e 10 cards. Imagens ou vídeos, todos do mesmo tipo funcionam melhor.</p></div>
          <div class="wtb-vars__actions">
            <button type="button" class="ax-btn ax-btn--sm" data-action="whatsapp-template-form#toggleAllCards" data-guided="toggleAllCards">
              <i class="bi bi-arrows-expand ax-ico"></i><span>Expandir todos</span>
            </button>
            <button type="button" class="ax-btn ax-btn--primary ax-btn--sm" data-action="whatsapp-template-form#addCarouselCard">
              <i class="bi bi-plus-lg ax-ico"></i><span>Adicionar card</span>
            </button>
          </div>
        </div>
        <div class="whatsapp-template-carousel-list wtb-cardlist" data-whatsapp-template-form-target="carouselCardList">
          <% cards = template.clean_carousel_cards.presence || template.carousel_cards.presence || [{}, {}] %>
          <% cards.first(10).each_with_index do |card, index| %>
            <%= render "builder_card_row", index: index, card: card %>
          <% end %>
        </div>
        <template data-whatsapp-template-form-target="carouselCardTemplate"><%= render "builder_card_row", index: "__INDEX__", number: "__NUMBER__", collapsed: false %></template>
      <% end %>

      <%= ax_guided_review(number: 5, title: "Tudo certo para enviar?", subtitle: "A Meta revisa o modelo antes de liberar o uso. Você acompanha o status na listagem.",
                     submit_label: (template.meta_id.present? ? "Salvar e reenviar para aprovação" : "Enviar para aprovação"),
                     cancel_path: admin_whatsapp_templates_path(whatsapp_sender_number_id: sender_number&.id),
                     checks: [["name", "Nome do template"], ["body", "Texto introdutório"], ["examples", "Exemplos das variáveis"], ["cards", "Cards do carrossel"]]) %>
    </div>

    <%= render "builder_preview", mode: "carousel" %>
  </div>
<% end %>
