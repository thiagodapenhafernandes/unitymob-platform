<% status_label = t("whatsapp_template_statuses.#{@template.status.to_s.upcase}", default: @template.status.presence || "Rascunho") %>
<%= render "admin/shared/ui/mobile_detail_header", title: "Prévia do template", back_path: admin_whatsapp_templates_path(whatsapp_sender_number_id: params[:whatsapp_sender_number_id]), status: status_label %>
<% content_for :admin_contextbar_title, "Prévia do template" %>

<% content_for :admin_contextbar_actions do %>
  <%= link_to admin_whatsapp_templates_path(whatsapp_sender_number_id: params[:whatsapp_sender_number_id]), class: "ax-contextbar__button" do %>
    <i class="bi bi-arrow-left ax-ico"></i><span>Templates</span>
  <% end %>
  <% if @template.approved? %>
    <%= link_to new_campaign_admin_whatsapp_template_path(@template, whatsapp_sender_number_id: params[:whatsapp_sender_number_id]), class: "ax-contextbar__button ax-contextbar__button--primary" do %>
      <i class="bi bi-megaphone ax-ico"></i><span>Criar campanha</span>
    <% end %>
  <% end %>
<% end %>

<div class="whatsapp-templates">
  <section class="whatsapp-template-preview">
    <div>
      <span><%= @template.template_type_label %> · <%= @template.category_label %></span>
      <h1><%= @template.name %></h1>
      <p><%= @template.language == "pt_BR" ? "Português (Brasil)" : @template.language %> · <%= t("whatsapp_template_statuses.#{@template.status.to_s.upcase}", default: @template.status.presence || "Rascunho") %></p>
    </div>
    <%= render "admin/shared/ui/whatsapp_message_preview", template: @template %>
  </section>
</div>
