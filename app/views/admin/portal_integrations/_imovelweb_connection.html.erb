<section id="portal-imovelweb-leads" aria-label="Recebimento de leads Imovelweb">
  <%= ax_operational_panel(eyebrow: "Imovelweb → Unitymob", title: "Receber leads", class_name: "tw-mb-4") do %>
    <p>Receba as consultas com a mensagem e o contexto do anúncio.</p>
    <% production = @imovelweb_connections.select { |item| item.environment == "production" } %>
    <% production.each do |connection| %>
      <%= ax_field_group(title: "Conta #{connection.advertiser_code.presence || 'aguardando autorização'}", class_name: "tw-mt-4") do %>
        <%= turbo_stream_from connection, :connection_status %>
        <%= render "imovelweb_status", connection: connection %>
        <% last_received = @imovelweb_last_received[connection.id] %>
        <p class="ax-field__hint tw-mt-3">Último contato: <%= last_received ? l(last_received, format: :short) : "nenhum recebido" %> · <%= @imovelweb_receipt_counts.fetch([connection.id, "processed"], 0) %> processados.</p>
        <% quarantined = @imovelweb_receipt_counts.fetch([connection.id, "quarantined"], 0) %>
        <% if quarantined.positive? %>
          <p class="tw-mt-3"><%= link_to "#{quarantined} contatos aguardando revisão", admin_imovelweb_connection_lead_receipts_path(connection, status: "quarantined"), class: "ax-link" %></p>
        <% end %>
      <% end %>
    <% end %>

    <% if production.empty? || production.any?(&:binding_editable?) %>
      <%= ax_field_group(title: "Conectar conta anunciante", class_name: "tw-mt-4") do %>
        <p class="ax-field__hint tw-mb-3">Informe o código da sucursal. Depois, autorize a Unitymob com um usuário administrador ou supervisor do Imovelweb. A confirmação e a ativação acontecem automaticamente.</p>
        <%= form_with model: @imovelweb_binding, url: (@imovelweb_binding.persisted? ? admin_imovelweb_connection_path(@imovelweb_binding) : admin_imovelweb_connections_path), local: true, html: { aria: { label: "Conectar Imovelweb para receber leads" } } do |f| %>
          <%= ax_text_field(form: f, method: :advertiser_code, label: "Código da conta no Imovelweb", placeholder: "Ex.: 47294717", required: true, maxlength: 128, hint: "Use o código da sucursal que você vai autorizar.") %>
          <%= ax_form_actions(sticky: false) do %>
            <%= f.submit "Salvar e iniciar conexão", class: "ax-btn ax-btn--primary" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= ax_inline_notice(tone: :neutral, class_name: "tw-mt-4") do %>
      O contato é salvo mesmo quando o imóvel não é identificado. Novas consultas preservam o contexto e seguem as regras de atendimento da sua conta.
    <% end %>
    <div class="tw-mt-4"><%= ax_button("Regras de atendimento", admin_distribution_rules_path, variant: :ghost, icon: "diagram-3") %></div>
  <% end %>
  <% if @imovelweb_connections.any? { |connection| connection.environment == "sandbox" } %>
    <%= ax_collapsible_card(title: "Histórico de testes", collapse_id: "imovelweb-sandbox", collapsed: true) do %>
      <% @imovelweb_connections.select { |connection| connection.environment == "sandbox" }.each do |connection| %>
        <p><%= link_to "Consultar eventos de homologação", admin_imovelweb_connection_lead_receipts_path(connection), class: "ax-link" %></p>
      <% end %>
    <% end %>
  <% end %>
</section>
