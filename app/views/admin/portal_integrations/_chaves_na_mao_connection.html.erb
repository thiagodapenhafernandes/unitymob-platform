<section id="portal-direct-leads" aria-label="Configuração do recebimento direto do Chaves na Mão">
  <%= ax_operational_panel(eyebrow: "Leads", title: "Recebimento direto · Chaves na Mão", class_name: "tw-mt-4") do %>
    <%= chaves_na_mao_connection_badge(@chaves_na_mao_connection) %>
    <% if @chaves_na_mao_connection.last_lead_received_at.present? %>
      <p class="ax-field__hint tw-mt-3">Último lead processado: <%= l(@chaves_na_mao_connection.last_lead_received_at, format: :short) %>.</p>
    <% end %>
    <p class="ax-field__hint tw-mt-3">Confirme o recebimento com um lead de teste enviado pelo portal.</p>
    <%= ax_inline_notice(tone: :info, icon: "info-circle", class_name: "tw-mt-3") do %>
      Durante a validação, os eventos ficam registrados para conferência e não criam leads nem acionam corretores.
      Ao ativar a criação de leads, serão usadas as regras de distribuição e destinos configurados nesta conta.
      O Chaves na Mão envia os contatos diretamente para esta plataforma. O envio de imóveis continua independente.
    <% end %>

    <%= form_with(model: @chaves_na_mao_connection, url: admin_chaves_na_mao_connection_path, method: :patch, class: "tw-mt-4") do |f| %>
      <%= ax_field_group(title: "Configuração desta conta") do %>
        <%= ax_field_grid do %>
          <div class="ax-span-6">
            <%= ax_text_field(form: f, method: :account_code, label: "ID da conta no Chaves na Mão", readonly: !@chaves_na_mao_connection.account_code_editable?, inputmode: "numeric") %>
          </div>
          <div class="ax-span-6">
            <%= ax_text_field(form: f, method: :integration_token, label: "Token de integração de leads", type: :password, value: "", autocomplete: "new-password", hint: @chaves_na_mao_connection.integration_token.present? ? "Token configurado. Deixe em branco para manter." : "Disponível em Meus Dados no Chaves na Mão. Use o token da imobiliária, não a senha de acesso.") %>
          </div>
        <% end %>
        <%= ax_field_grid do %>
          <div class="ax-span-6">
            <%= ax_text_field(form: f, method: :login_email, label: "E-mail de acesso ao Chaves na Mão", type: :email, autocomplete: "off", hint: "E-mail da imobiliária no portal, usado junto com o token para autenticar o recebimento.") %>
          </div>
        <% end %>
        <%= ax_switch_field(form: f, method: :enabled, label: "Habilitar recebimento") %>
        <%= ax_switch_field(form: f, method: :operational, label: "Criar leads e aplicar as regras desta conta", description: "Desmarcado: apenas captura para validação. Eventos antigos não são processados ao ativar.") %>
      <% end %>
      <%= ax_form_actions(sticky: false) do %>
        <%= f.submit "Salvar configuração", class: "ax-btn ax-btn--primary" %>
      <% end %>
    <% end %>

    <% if @chaves_na_mao_connection.persisted? %>
      <%= ax_field_group(title: "Endereço de recebimento", class_name: "tw-mt-4") do %>
        <div data-controller="clipboard" data-clipboard-success-content-value="URL copiada!">
          <%= ax_standalone_field(name: :chaves_endpoint, id: :chaves_endpoint, label: "URL de recebimento desta conta", value: "#{request.base_url}/webhooks/chaves_na_mao/#{@chaves_na_mao_connection.route_key}", readonly: true,
                data: { clipboard_target: "source" }, action: ax_button("Copiar URL", variant: :secondary, icon: "clipboard", data: { action: "clipboard#copy" })) %>
        </div>
        <p class="ax-field__hint tw-mt-3">Envie esta URL ao Chaves na Mão e combine o envio direto de um lead de teste.</p>
      <% end %>
    <% end %>
    <% if @chaves_na_mao_receipts.present? %>
      <%= ax_field_group(title: "Últimos eventos recebidos", class_name: "tw-mt-4") do %>
        <ul>
          <% @chaves_na_mao_receipts.each do |receipt| %>
            <li>Evento #<%= receipt.id %> · <%= l(receipt.received_at, format: :short) %> · <%= { "captured" => "Somente conferência", "pending" => "Aguardando processamento", "processed" => "Processado", "quarantined" => "Requer conferência" }.fetch(receipt.status) %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>
</section>
<%= render "admin/portal_integrations/direct_lead_setup", integration: integration,
      setup: portal_direct_lead_setup(integration), section_id: "portal-chaves-support" %>
