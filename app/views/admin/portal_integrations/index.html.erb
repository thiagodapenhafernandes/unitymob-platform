<div class="ax-integration-layout">
<% current_integration = @integrations[@active_portal] %>
<% group_olx = current_integration.grupozap_family? %>
<% screen_title = group_olx ? "Grupo OLX" : current_integration.title %>
<% current_preview = @previews[@active_portal] || {} %>
<% current_readiness = @readiness[@active_portal] || {} %>
<% current_status = current_readiness[:status] %>
<% current_checklist = current_readiness[:checklist] || [] %>
<% readiness_tone = ->(color) { { "success" => :green, "danger" => :red, "warning" => :amber, "primary" => :blue }.fetch(color.to_s, :gray) } %>

<%= ax_workspace_heading(eyebrow: "Integrações · Distribuição", icon: "building", title: "Portais", pills: [screen_title], subtitle: "Envie imóveis aos portais e receba leads na sua conta.", metrics: [{ value: current_preview[:eligible_count].to_i, label: "elegíveis" }]) %>

<%= ax_field_grid(columns: 12, gap: :compact) do %>
  <!-- Sidebar de portais com status visual -->
  <div class="ax-span-3">
    <%= ax_panel(title: "Portais", subtitle: "Canais disponíveis", class_name: "portal-integrations-nav-panel") do %>
      <ul class="portal-integrations-nav">
        <% (PortalIntegration::PORTALS - ["vivareal_vrsync"]).each do |portal_key| %>
          <% integration = @integrations[portal_key] %>
          <% portal_status = @readiness.dig(portal_key, :status) || :disabled %>
          <% portal_color = integration.readiness_color(portal_status) %>
          <% portal_label = integration.readiness_label(portal_status) %>
          <% portal_eligible = @previews.dig(portal_key, :eligible_count).to_i %>
          <li class="portal-integrations-nav__item">
          <%= link_to admin_portal_integrations_path(portal: portal_key, anchor: ("portal-leads" if integration.grupozap_family?)),
                class: ["portal-integrations-nav__link", ("is-active" if @active_portal == portal_key || (group_olx && portal_key == "zapimoveis"))].compact.join(" "),
                aria: { current: ("page" if @active_portal == portal_key || (group_olx && portal_key == "zapimoveis")) } do %>
            <div class="tw-flex tw-justify-between tw-items-start tw-gap-2">
              <div>
                <div class="tw-font-semibold"><%= portal_key == "zapimoveis" ? "Grupo OLX" : integration.title %></div>
                <small class="portal-integrations-nav__meta <%= 'is-active' if @active_portal == portal_key %>">
                  <%= portal_eligible %> imóveis elegíveis
                </small>
              </div>
              <%= ax_badge(portal_label, tone: readiness_tone.call(portal_color)) %>
            </div>
          <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <!-- Painel principal -->
  <div class="ax-span-9">
    <% banner_color = current_integration.readiness_color(current_status) %>
    <% pending_items = current_checklist.reject { |item| item[:ok] } %>
    <div class="portal-integrations-commandbar">
      <div class="portal-integrations-commandbar__identity">
        <strong><%= screen_title %></strong>
        <%= ax_badge(current_integration.readiness_label(current_status), tone: readiness_tone.call(banner_color)) %>
      </div>
      <div class="portal-integrations-commandbar__metrics">
        <span><strong><%= current_preview[:eligible_count].to_i %></strong> elegíveis</span>
        <span><strong><%= current_preview[:rejected_count].to_i %></strong> rejeitados</span>
        <span><strong><%= current_integration.last_feed_at.present? ? l(current_integration.last_feed_at, format: :short) : "Nunca" %></strong> último acesso</span>
      </div>
      <% if current_integration.docs_url.present? %><%= ax_button("Documentação", current_integration.docs_url, variant: :ghost, size: :sm, icon: "box-arrow-up-right", target: "_blank", rel: "noopener") %><% end %>
    </div>

    <% if pending_items.any? %>
      <%= ax_inline_notice(tone: :warning, icon: "exclamation-triangle", class_name: "tw-mb-3") do %>
        <strong><%= pending_items.size %> <%= pending_items.size == 1 ? "pendência" : "pendências" %>:</strong>
        <%= pending_items.map { |item| item[:label] }.to_sentence %>.
      <% end %>
    <% end %>

    <% if current_integration.grupozap_family? %>
      <%= ax_studio_nav(items: [
        { id: "portal-publication", icon: "house", label: "Enviar imóveis" },
        { id: "portal-leads", icon: "people", label: "Receber leads" }
      ], orientation: :horizontal, variant: :underline, panels_selector: "#portal-integration-sections", label: "Objetivo da integração") %>
    <% end %>
    <div id="portal-integration-sections" class="tw-mt-3">
    <section id="portal-publication" aria-label="Envio de imóveis aos portais">
    <% if group_olx %>
      <%= ax_field_group(title: "Publicação por portal") do %>
        <div class="tw-flex tw-flex-wrap tw-gap-2 tw-mb-3">
          <% PortalIntegration::GRUPOZAP_PORTALS.each do |portal| %>
            <%= ax_button(@integrations[portal].title, admin_portal_integrations_path(portal: portal, anchor: "portal-publication"), variant: (@active_portal == portal ? :primary : :ghost), size: :sm) %>
          <% end %>
        </div>
        <p class="ax-field__hint">As configurações e URLs de feed existentes são mantidas por portal. Confirme no Canal Pro quais canais recebem seus anúncios; a OLX não exige uma conexão de leads separada.</p>
      <% end %>
    <% end %>
    <!-- Configuração -->
    <%= ax_operational_panel(eyebrow: "Publicação", title: "Enviar imóveis", class_name: "tw-mb-3") do %>
      <div class="ax-panel-body">
        <%= form_with model: current_integration,
                      url: admin_portal_integration_path(@active_portal),
                      method: :patch,
                      local: true do |f| %>
          <div class="tw-mb-4">
            <%= ax_switch_field(form: f, method: :enabled, label: "Integração ativa") %>
            <small class="portal-integrations-help">Habilita a integração com este portal. Para receber contatos, ative também o recebimento no bloco de leads.</small>
          </div>

          <%= ax_field_grid(columns: 12, gap: :compact) do %>
            <% if current_integration.requires_account_id? %>
              <div class="ax-span-6">
                <%= ax_text_field(form: f, method: :account_id, label: "Account ID", required: true, placeholder: "Ex: 12345", hint: "Obrigatório. ID da sua conta no portal; solicite ao gerente comercial.") %>
              </div>
              <div class="ax-span-6">
                <%= ax_text_field(form: f, method: :publisher_id, label: "Publisher ID", required: true, placeholder: "Ex: 67890", hint: "Obrigatório. ID do publicador, geralmente igual ao Account ID.") %>
              </div>
            <% elsif current_admin_user.system_admin? %>
              <div class="ax-span-6">
                <%= ax_text_field(form: f, method: :account_id, label: "Account ID", hint: "Opcional") %>
              </div>
              <div class="ax-span-6">
                <%= ax_text_field(form: f, method: :publisher_id, label: "Publisher ID", hint: "Opcional") %>
              </div>
            <% end %>

            <% if current_admin_user.system_admin? %>
            <div class="ax-span-6">
              <%= f.label :webhook_secret, "Webhook Secret", class: "ax-label" %>
              <small class="portal-integrations-help portal-integrations-help--inline">(opcional)</small>
              <%= f.password_field :webhook_secret, class: "ax-control",
                                   autocomplete: "off",
                                   placeholder: (current_integration.webhook_secret.present? ? "Já configurado. Preencha para substituir." : "Defina se for usar webhook do portal") %>
              <small class="portal-integrations-help">Usado para validar eventos enviados pelo portal de volta para nós.</small>
            </div>

            <% end %>

            <div class="ax-span-6">
              <%= ax_multiselect_field(form: f, method: :allowed_business_types, label: "Tipos de negócio", choices: @business_type_options, selected: current_integration.allowed_business_types, placeholder: "Selecione os tipos enviados") %>
              <p class="ax-field__hint">Quais tipos de transação serão enviados.</p>
            </div>

            <div class="ax-span-6">
              <%= ax_multiselect_field(form: f, method: :allowed_statuses, label: "Status permitidos", choices: @status_options, selected: current_integration.allowed_statuses, placeholder: "Selecione os status enviados") %>
              <p class="ax-field__hint">Apenas imóveis nestes status entram no feed.</p>
            </div>

            <div class="ax-span-12">
              <%= ax_switch_field(form: f, method: :require_exibir_no_site, label: "Enviar apenas imóveis exibidos no site") %>
              <small class="portal-integrations-help">Recomendado. Evita publicar imóveis ocultos do site público.</small>
            </div>

          <% end %>

          <%= ax_form_actions(sticky: false) do %>
            <%= f.submit "Salvar envio de imóveis", class: "ax-btn ax-btn--primary" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- URL do Feed em destaque (ação principal) -->
    <% feed_url = integrations_portals_feed_token_url(portal: @active_portal, token: current_integration.feed_token, format: current_integration.feed_format) %>
    <%= ax_operational_panel(eyebrow: "Publicação", title: "URL do Feed para o portal", class_name: "portal-integrations-feed-card tw-mb-3") do %>
      <div class="ax-panel-body" data-controller="clipboard" data-clipboard-success-content-value="✓ Copiado!">
        <p class="tw-text-sm tw-text-ink-muted tw-mb-3">
          <strong>Esta é a URL que você deve enviar ao <%= current_integration.title %>.</strong>
          O portal vai ler seus imóveis automaticamente a partir dela.
        </p>
        <%= ax_input_group(action: capture { %>
          <button type="button" class="ax-btn ax-btn--primary tw-gap-1"
                  data-action="clipboard#copy"
                  data-clipboard-target="button">
            <i class="bi bi-clipboard"></i>
            <span data-clipboard-target="content">Copiar</span>
          </button>
        <% }) do %>
          <input type="text" class="ax-control font-monospace tw-text-sm" readonly
                 value="<%= feed_url %>"
                 data-clipboard-target="source"
                 data-action="focus->clipboard#select click->clipboard#select">
        <% end %>
        <% if current_admin_user.system_admin? %>
        <div class="tw-flex tw-flex-wrap tw-gap-2 tw-mt-3">
          <%= link_to preview_feed_admin_portal_integration_path(@active_portal),
                      target: "_blank", rel: "noopener",
                      class: "ax-btn ax-btn--ghost ax-btn--sm tw-gap-1" do %>
            <i class="bi bi-eye"></i> Visualizar amostra (3 imóveis)
          <% end %>

        </div>
        <% end %>
      </div>
    <% end %>

    <% if current_admin_user.system_admin? %>
    <!-- Webhook (secundário) -->
    <%= ax_collapsible_card(title: "Webhook (opcional — eventos do portal)", collapse_id: "webhookSection", icon: "arrow-down-circle", collapsed: true, class_name: "tw-mb-3") do %>
          <p class="tw-text-sm tw-text-ink-muted tw-mb-2">
            Alguns portais conseguem nos enviar de volta avisos de aprovação, rejeição ou alterações.
            Configure essa URL no painel do portal se ele suportar webhooks.
          </p>
          <div class="portal-integrations-webhook-url">
            <%= webhooks_portal_events_url(portal: @active_portal) %>
          </div>
          <small class="portal-integrations-help">Use o Webhook Secret configurado acima para assinatura HMAC-SHA256.</small>
    <% end %>

    <% end %>

    <% if current_preview[:top_reasons].present? %>
      <details class="portal-integrations-rejections tw-mb-3">
        <summary>Ver principais motivos de rejeição</summary>
        <ul><% current_preview[:top_reasons].each do |reason, count| %><li><span><%= reason.humanize %></span><strong><%= count %></strong></li><% end %></ul>
      </details>
    <% end %>

    <!-- Tabela de retornos -->
    <%= ax_operational_panel(eyebrow: "Publicação", title: "Últimos retornos do portal") do %>
      <div class="ax-table-wrap">
        <table class="ax-table">
          <thead>
            <tr>
              <th scope="col">Código</th>
              <th scope="col">ID Externo</th>
              <th scope="col">Evento</th>
              <th scope="col">Status</th>
              <th scope="col">Atualizado em</th>
            </tr>
          </thead>
          <tbody>
            <% if @listing_states.any? %>
              <% @listing_states.each do |state| %>
                <tr>
                  <td><%= state.habitation_code.presence || "—" %></td>
                  <td><%= state.external_listing_id.presence || "—" %></td>
                  <td><%= state.last_event_type %></td>
                  <td><%= state.last_status.presence || "—" %></td>
                  <td><%= state.last_received_at.present? ? l(state.last_received_at, format: :short) : "—" %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="portal-integrations-empty-cell">
                  <%= ax_empty_state(title: "Sem eventos recebidos", description: "Eles aparecem aqui após o portal começar a sincronizar.", icon: "clock-history", compact: true) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    </section>

    <% if current_integration.grupozap_family? %>
      <section id="portal-leads" aria-label="Recebimento de leads do portal" hidden>
        <%= ax_inline_notice(tone: :neutral, class_name: "tw-mb-3") do %>
          Uma conexão para os leads de ZAP Imóveis, Viva Real e OLX disponibilizados pelo Grupo OLX. A origem aparece como Grupo OLX e segue as regras de distribuição desta conta.
        <% end %>
        <%= ax_field_grid(columns: 12, gap: :compact) do %>
        <div class="ax-span-8">
        <%= ax_operational_panel(eyebrow: "Leads", title: "Conta anunciante", class_name: "tw-mb-3") do %>
          <div class="ax-panel-body">
            <%= form_with model: @lead_integration, url: admin_portal_integration_path("zapimoveis"), method: :patch, local: true do |f| %>
              <%= hidden_field_tag :section, "leads" %>
              <%= ax_text_field(form: f, method: :account_id, id: "lead_advertiser_account_id", label_options: { for: "lead_advertiser_account_id" }, label: "ID da conta no Grupo OLX", placeholder: "Informe o código da conta anunciante", hint: "Solicite este código ao atendimento do portal. Ele identifica a conta, mas não autentica a conexão.") %>
              <div class="tw-mt-4">
              <%= ax_switch_field(form: f, method: :leads_enabled, label: "Receber leads do Grupo OLX") %>
              <p class="portal-integrations-help">Os contatos entram nesta conta e seguem suas regras de distribuição. A Unitymob prepara e mantém a conexão automaticamente.</p>
              </div>
              <%= ax_form_actions(sticky: false) do %>
                <%= f.submit "Salvar recebimento de leads", class: "ax-btn ax-btn--primary" %>
              <% end %>
            <% end %>
            <%= ax_field_group(title: "URL para receber leads") do %>
              <div data-controller="clipboard" data-clipboard-success-content-value="✓ Copiado!">
                <p class="ax-field__hint tw-mb-3">No Canal Pro, selecione Unitymob e vincule esta URL à sua conta anunciante.</p>
                <% if @lead_integration.lead_webhook_url.present? %>
                  <%= ax_input_group(action: capture { %>
                    <button type="button" class="ax-btn ax-btn--primary" data-action="clipboard#copy" data-clipboard-target="button">
                      <i class="bi bi-clipboard" aria-hidden="true"></i>
                      <span data-clipboard-target="content">Copiar URL</span>
                    </button>
                  <% }) do %>
                    <input type="text" class="ax-control" readonly aria-label="URL de recebimento de leads" value="<%= @lead_integration.lead_webhook_url %>" data-clipboard-target="source" data-action="focus->clipboard#select click->clipboard#select">
                  <% end %>
                  <p class="ax-field__hint tw-mt-3">O endereço é exclusivo desta conta. Consulte o status ao lado antes de disparar um lead de teste.</p>
                <% else %>
                  <%= ax_inline_notice(tone: :warning) do %>
                    A URL estará disponível quando o suporte configurar o endereço do Gateway da Unitymob neste servidor.
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        </div>
        <div class="ax-span-4">
          <%= ax_operational_panel(title: "Status da integração", class_name: "tw-mb-3") do %>
            <div class="ax-panel-body">
              <%= turbo_stream_from @lead_integration, :lead_connection %>
              <%= render "admin/portal_integrations/lead_connection", integration: @lead_integration %>
            </div>
          <% end %>
          <%= ax_operational_panel(title: "Como receber os leads") do %>
            <div class="ax-panel-body tw-text-sm">
              <div class="tw-space-y-3">
              <p><strong>1. Identifique a conta</strong><br>Informe o código da sua conta anunciante e salve o recebimento.</p>
              <p><strong>2. Copie a URL gerada</strong><br>A Unitymob prepara automaticamente o endereço de recebimento.</p>
              <p><strong>3. Vincule no Grupo OLX</strong><br>No Canal Pro, selecione Unitymob na integração de leads e informe esta URL.</p>
              <p class="tw-text-ink-muted">O ID sozinho não conecta a conta. Depois da vinculação, os leads seguem suas regras de distribuição.</p>
              </div>
            </div>
          <% end %>
        </div>
        <% end %>
    <% if @lead_integration.grupozap_family? && current_admin_user.system_admin? %>
      <%= ax_operational_panel(eyebrow: "Leads", title: "Chave do CRM — Grupo OLX", class_name: "tw-mb-3") do %>
        <div class="ax-panel-body">
          <p class="tw-text-sm tw-text-ink-muted tw-mb-3">
            Chave do recebimento direto neste servidor. No modo Gateway, o suporte configura a chave no Gateway central. Vale para ZAP Imóveis, Viva Real e OLX:
            sem ela, os leads são recusados. Por segurança, o valor nunca é exibido — só o status.
            <%= ax_badge(@grupozap_key_configured ? "Configurada" : "Não configurada", tone: (@grupozap_key_configured ? :green : :amber)) %>
          </p>
          <%= form_with url: grupozap_key_admin_portal_integrations_path, method: :post, local: true, class: "tw-flex tw-flex-wrap tw-items-end tw-gap-2" do %>
            <%= hidden_field_tag :portal, "zapimoveis" %>
            <div class="tw-flex-1 tw-min-w-[240px]">
              <%= label_tag :grupozap_secret_key, "SECRET_KEY", class: "ax-label" %>
              <%= password_field_tag :grupozap_secret_key, nil, class: "ax-control", autocomplete: "off",
                                     placeholder: (@grupozap_key_configured ? "Já configurada. Preencha para substituir." : "Cole aqui a chave enviada pelo Grupo OLX") %>
            </div>
            <%= submit_tag "Salvar chave", class: "ax-btn ax-btn--primary" %>
          <% end %>
        </div>
      <% end %>
    <% end %>

      </section>
    <% end %>
    </div>
  </div>
<% end %>

</div>
