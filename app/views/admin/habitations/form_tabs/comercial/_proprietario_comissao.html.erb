<%
  owner_visible = can_view_proprietor_data?(habitation)
  owner_can_manage = owner_visible && admin_or_administrative_user? && habitation_field_editable?("proprietor_id")
  owner_phones = if habitation.proprietor
                   [
                     habitation.proprietor.phone_primary,
                     habitation.proprietor.mobile_phone,
                     habitation.proprietor.business_phone,
                     habitation.proprietor.residential_phone
                   ]
                 else
                   [
                     habitation.proprietario_celular,
                     habitation.proprietario_telefone_comercial,
                     habitation.proprietario_telefone_residencial
                   ]
                 end.compact_blank.uniq
  owner_name = habitation.proprietario_nome.presence || "Proprietário não vinculado"
  owner_email = habitation.proprietario_email_display.presence
  owner_city = habitation.proprietor&.city.presence || habitation.proprietario_cidade.presence
  owner_payload = {
    id: habitation.proprietor_id,
    name: owner_name,
    phone_primary: owner_phones.first,
    phone_primary_display: Phones::Normalizer.display(owner_phones.first),
    phone_secondary: owner_phones.second,
    phone_secondary_display: Phones::Normalizer.display(owner_phones.second),
    email: owner_email,
    city: owner_city
  }.compact
  owner_selector_data = owner_visible ? { controller: "habitation-owner-selector" } : {}
  if owner_can_manage
    owner_selector_data.merge!(
      habitation_owner_selector_search_url_value: quick_search_admin_proprietors_path,
      habitation_owner_selector_create_url_value: quick_create_admin_proprietors_path,
      habitation_owner_selector_update_url_template_value: quick_update_admin_proprietor_path(":id"),
      habitation_owner_selector_can_edit_value: true
    )
  end
%>

<%= tag.div class: "habitation-owner-selector", data: owner_selector_data do %>
  <% if owner_visible %>
    <% owner_actions = capture do %>
      <% if owner_can_manage %>
        <%= ax_icon_button(
              label: "Gerenciar proprietário",
              icon: "gear",
              variant: :secondary,
              size: :sm,
              data: { ax_modal_open: "#quickProprietorModal" }
            ) %>
      <% end %>
    <% end %>

    <%= ax_form_section(title: "Proprietário e contatos", icon: "person-lines-fill", actions: owner_actions.presence) do %>
      <%= f.hidden_field :proprietor_id,
            data: {
              habitation_owner_selector_target: "hiddenInput",
              broker_field_policy_lock: true,
              field_lock_action: "campo:proprietor_id"
            },
            disabled: !habitation_field_editable?("proprietor_id") %>

      <div class="habitation-owner-card" data-owner-payload="<%= json_escape(owner_payload.to_json) %>">
        <% if habitation.proprietor_id.blank? && owner_name == "Proprietário não vinculado" %>
          <div class="habitation-owner-card__empty" data-habitation-owner-selector-target="empty">
            Nenhum proprietário vinculado.
          </div>
        <% end %>
        <div class="habitation-owner-card__head">
          <strong data-habitation-owner-selector-target="name"><%= owner_name %></strong>
          <% if owner_can_manage && habitation.proprietor_id.present? %>
            <button type="button"
                    class="ax-icon-btn"
                    title="Editar proprietário"
                    aria-label="Editar proprietário"
                    data-action="habitation-owner-selector#showEdit"
                    data-ax-modal-open="#quickProprietorModal">
              <i class="bi bi-pencil"></i>
            </button>
          <% end %>
        </div>
        <dl class="habitation-owner-card__facts">
          <div>
            <dt>Telefone</dt>
            <dd data-habitation-owner-selector-target="phonePrimary"><%= Phones::Normalizer.display(owner_phones.first).presence || "-" %></dd>
          </div>
          <div <%= "hidden" if owner_phones.second.blank? %>>
            <dt>Telefone 2</dt>
            <dd data-habitation-owner-selector-target="phoneSecondary"><%= Phones::Normalizer.display(owner_phones.second) %></dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd data-habitation-owner-selector-target="email"><%= owner_email.presence || "-" %></dd>
          </div>
          <div>
            <dt>Cidade</dt>
            <dd data-habitation-owner-selector-target="city"><%= owner_city.presence || "-" %></dd>
          </div>
        </dl>
      </div>
    <% end %>
  <% else %>
    <%= f.hidden_field :proprietor_id, data: { habitation_owner_selector_target: "hiddenInput" } %>
  <% end %>

  <%= ax_form_section(title: "Comissão e operação", icon: "cash-coin") do %>
    <%= ax_field_grid do %>
      <div class="ax-span-6">
        <%= ax_currency_field(form: f, method: :valor_livre_proprietario_formatted, label: "Proprietário (livre)", data: { controller: "mask", mask_type_value: "currency" }) %>
      </div>
      <div class="ax-span-6">
        <%= ax_currency_field(form: f, method: :valor_comissao_formatted, label: "Valor da comissão", data: { controller: "mask", mask_type_value: "currency" }) %>
      </div>
      <div class="ax-span-6">
        <%= ax_number_field(form: f, method: :captador_commission_percentage, label: "Comissão captador (%)", min: 0, max: 100, step: 0.01, placeholder: "0,00") %>
      </div>
      <div class="ax-span-6">
        <%= ax_number_field(form: f, method: :broker_commission_percentage, label: "Comissão corretor (%)", min: 0, max: 100, step: 0.01, placeholder: "0,00") %>
      </div>
      <div class="ax-span-12 ax-field-align-end">
        <%= ax_toggle_chip(f, :salute_rental_management_flag, label: "Administração de locação", class_name: "ax-toggle-chip--full") %>
      </div>
      <div class="ax-span-12"
           data-controller="conditional-reveal"
           data-conditional-reveal-kind-value="checkbox">
        <%= ax_field_grid do %>
          <div class="ax-span-5 ax-field-align-end">
            <%= ax_toggle_chip(
                  f,
                  :home_corporate_flag,
                  label: "Vitrine Corporate",
                  class_name: "ax-toggle-chip--full",
                  input_data: {
                    conditional_reveal_target: "trigger",
                    action: "change->conditional-reveal#sync"
                  }
                ) %>
          </div>
          <div class="ax-span-7 ax-reactive-inactive-hint"
               data-conditional-reveal-target="inactiveHint"
               <%= "hidden" if f.object.home_corporate_flag? %>>
            Ative para definir a posição do imóvel na vitrine Corporate.
          </div>
          <div class="ax-span-4 ax-reactive-context ax-reactive-context--inline"
               data-conditional-reveal-target="panel"
               <%= "hidden" unless f.object.home_corporate_flag? %>>
            <%= ax_number_field(
                  form: f,
                  method: :home_corporate_position,
                  label: "Posição na Home",
                  min: 1,
                  max: 20,
                  placeholder: "1, 2, 3...",
                  disabled: !f.object.home_corporate_flag?,
                  required: f.object.home_corporate_flag?,
                  data: { conditional_required: true }
                ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if owner_can_manage %>
    <% proprietor_modal_body = capture do %>
      <div class="habitation-owner-modal">
        <div class="ax-quick-modal__error" data-habitation-owner-selector-target="error" hidden></div>

        <div class="habitation-owner-search">
          <%= ax_field_label(nil, nil, text: "Buscar proprietário", for: "owner_proprietor_query") %>
          <input type="search"
                 id="owner_proprietor_query"
                 class="ax-control"
                 placeholder="Nome, telefone, e-mail ou cidade"
                 autocomplete="off"
                 data-habitation-owner-selector-target="query"
                 data-action="input->habitation-owner-selector#search">
        </div>

        <div class="habitation-owner-results" data-habitation-owner-selector-target="results" aria-live="polite"></div>

        <div class="habitation-owner-no-results" data-habitation-owner-selector-target="noResults" hidden>
          <span>Nenhum proprietário encontrado.</span>
          <button type="button" class="ax-btn ax-btn--sm ax-btn--primary" data-action="habitation-owner-selector#showCreate">
            <i class="bi bi-plus-circle"></i>
            Cadastrar novo proprietário
          </button>
        </div>

        <section class="habitation-owner-modal-panel" data-habitation-owner-selector-target="createPanel" hidden>
          <h4>Novo proprietário</h4>
          <div id="quickProprietorForm"
               data-habitation-owner-selector-target="createForm">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= ax_field_grid(columns: 12, gap: :compact) do %>
              <div class="ax-span-12">
                <%= ax_field_label(nil, nil, text: "Nome", for: "quick_proprietor_name") %>
                <input type="text" class="ax-control" id="quick_proprietor_name" name="proprietor[name]" required data-habitation-owner-selector-target="createName">
              </div>
              <div class="ax-span-6">
                <%= ax_field_label(nil, nil, text: "Telefone", for: "quick_proprietor_phone") %>
                <input type="text" class="ax-control" id="quick_proprietor_phone" name="proprietor[phone_primary]" data-controller="phone-input" data-habitation-owner-selector-target="createPhone">
              </div>
              <div class="ax-span-6">
                <%= ax_field_label(nil, nil, text: "E-mail", for: "quick_proprietor_email") %>
                <input type="email" class="ax-control" id="quick_proprietor_email" name="proprietor[email]" data-habitation-owner-selector-target="createEmail">
              </div>
              <div class="ax-span-12">
                <%= ax_field_label(nil, nil, text: "Cidade", for: "quick_proprietor_city") %>
                <input type="text" class="ax-control" id="quick_proprietor_city" name="proprietor[city]" data-habitation-owner-selector-target="createCity">
              </div>
              <div class="ax-span-12 habitation-owner-modal-panel__actions">
                <button type="button" class="ax-btn ax-btn--primary" data-action="habitation-owner-selector#create">Salvar e selecionar</button>
              </div>
            <% end %>
          </div>
        </section>

        <section class="habitation-owner-modal-panel" data-habitation-owner-selector-target="editPanel" hidden>
          <h4>Editar proprietário</h4>
          <div id="editQuickProprietorForm"
               data-habitation-owner-selector-target="editForm">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= ax_field_grid(columns: 12, gap: :compact) do %>
              <div class="ax-span-12">
                <%= ax_field_label(nil, nil, text: "Nome", for: "edit_quick_proprietor_name") %>
                <input type="text" class="ax-control" id="edit_quick_proprietor_name" name="proprietor[name]" required data-habitation-owner-selector-target="editName">
              </div>
              <div class="ax-span-6">
                <%= ax_field_label(nil, nil, text: "Telefone", for: "edit_quick_proprietor_phone") %>
                <input type="text" class="ax-control" id="edit_quick_proprietor_phone" name="proprietor[phone_primary]" data-controller="phone-input" data-habitation-owner-selector-target="editPhone">
              </div>
              <div class="ax-span-6">
                <%= ax_field_label(nil, nil, text: "E-mail", for: "edit_quick_proprietor_email") %>
                <input type="email" class="ax-control" id="edit_quick_proprietor_email" name="proprietor[email]" data-habitation-owner-selector-target="editEmail">
              </div>
              <div class="ax-span-12">
                <%= ax_field_label(nil, nil, text: "Cidade", for: "edit_quick_proprietor_city") %>
                <input type="text" class="ax-control" id="edit_quick_proprietor_city" name="proprietor[city]" data-habitation-owner-selector-target="editCity">
              </div>
              <div class="ax-span-12 habitation-owner-modal-panel__actions">
                <button type="button" class="ax-btn ax-btn--primary" data-action="habitation-owner-selector#update">Salvar proprietário</button>
              </div>
            <% end %>
          </div>
        </section>
      </div>
    <% end %>

    <% proprietor_modal_footer = capture do %>
      <button type="button" class="ax-btn" data-action="ax-modal#close">Cancelar</button>
    <% end %>

    <%= ax_quick_modal(
          id: "quickProprietorModal",
          title: "Alterar proprietário",
          footer: proprietor_modal_footer,
          body: proprietor_modal_body,
          size: :lg
        ) %>
  <% end %>
<% end %>
