<% fields = Habitation::CategoryDetails::DETAIL_FIELDS %>
<% if f.object.registration_group.in?(%w[terrenos comerciais_industriais]) %>
  <div data-category-details-section>
    <%= ax_form_section(title: "Dados específicos", eyebrow: "Estrutura", icon: "rulers") do %>
      <%= ax_field_grid do %>
        <% if f.object.registration_group == "comerciais_industriais" %>
          <% warehouse_type = f.object.selected_warehouse_type %>
          <% warehouse_type_options = (Habitation::CategoryDetails::WAREHOUSE_TYPE_OPTIONS + [warehouse_type]).compact_blank.uniq %>
          <div class="ax-span-4" data-category-options="<%= json_escape(Habitation::CategoryDetails::WAREHOUSE_CATEGORIES.to_json) %>" <%= "hidden" unless Habitation::CategoryDetails::WAREHOUSE_CATEGORIES.include?(f.object.categoria) %>>
            <%= ax_field_label(nil, nil, text: "Tipo de galpão") %>
            <%= select_tag "habitation[caracteristicas][]",
                           options_for_select(warehouse_type_options, warehouse_type),
                           include_blank: "Selecione...",
                           id: "habitation_warehouse_type",
                           class: "ax-control",
                           data: { controller: "tom-select", placeholder: "Selecione..." } %>
          </div>
        <% end %>
        <% fields.each do |name, config| %>
          <% next unless (config[:group] == :land) == (f.object.registration_group == "terrenos") %>
          <div class="ax-span-4" data-category-field="<%= name %>" <%= "hidden" unless f.object.category_detail_applicable?(name) %>>
            <% if config[:measure] || config[:count] %>
              <%= ax_number_field(form: f, method: name, label: config[:label], min: config[:count] ? 0 : 0.01, step: config[:count] ? 1 : 0.01) %>
            <% else %>
              <%= ax_text_field(form: f, method: name, label: config[:label]) %>
            <% end %>
          </div>
        <% end %>
        <% if f.object.registration_group == "terrenos" %>
          <% { frente_terreno_m: "Frente / testada (m)", fundo_terreno_m: "Fundo (m)" }.each do |name, label| %>
            <div class="ax-span-4"><%= ax_number_field(form: f, method: name, label: label, min: 0.01, step: 0.01) %></div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
