<!-- Tab: Características -->
<div class="tab-pane fade" id="features" role="tabpanel" aria-labelledby="features-tab">
  <div class="ax-form-workspace">
    <% profile = local_assigns[:registration_profile].presence || habitation&.registration_profile.presence || "imoveis_residenciais" %>
    <% standard_feature_options = habitation&.standard_feature_options.to_a %>
    <% show_internal_features = profile != "terrenos" || standard_feature_options.any? %>

    <%= render "admin/habitations/form_tabs/shared/texto_publico",
               f: f,
               can_edit_protected_habitation_fields: can_edit_protected_habitation_fields %>
    <% if show_internal_features %>
      <%= render "admin/habitations/form_tabs/estrutura/caracteristicas_internas",
                 f: f,
                 standard_feature_options: standard_feature_options %>
    <% end %>
  </div>
</div>
