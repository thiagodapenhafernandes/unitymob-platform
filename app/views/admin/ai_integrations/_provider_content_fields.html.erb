<%# locals: f, provider %>
<%
  tenant = current_tenant
  connected = provider.connected?(tenant: tenant)
  model = provider.model(tenant: tenant)
  model_custom = (Ai::Provider.automatic?(model) || provider.known_response_model?(model)) ? "" : model.to_s.strip
  field = ->(name) { "providers[#{provider.key}][#{name}]" }
%>
<%= ax_panel(title: "Configuração do provedor · #{provider.label}", subtitle: "Credencial e modelo.", actions: ax_badge(connected ? "conectada" : "aguardando token", tone: connected ? :green : :amber)) do %>
  <%= ax_inline_notice(tone: connected ? :success : :warning, icon: connected ? "check-circle" : "exclamation-triangle") do %>
    <span>
      Status:
      <strong><%= connected ? "Conectado" : "Aguardando token" %></strong>
    </span>
  <% end %>

  <div class="tw-mb-3">
    <%= f.label field.call(:api_key), "Token #{provider.label}", class: "ax-label tw-font-semibold" %>
    <%= f.password_field field.call(:api_key),
        class: "ax-control",
        autocomplete: "off",
        placeholder: (connected ? "Token já configurado. Preencha apenas para substituir." : provider.token_placeholder) %>
    <div class="ax-field-hint">Preencha somente para configurar ou substituir a credencial atual.</div>
  </div>

  <div class="tw-mb-3">
    <%= f.label field.call(:model_choice), "Modelo", class: "ax-label tw-font-semibold" %>
    <%= f.select field.call(:model_choice),
        options_for_select(provider.response_model_options(api_key: provider.api_key(tenant: tenant), selected: model), model),
        {},
        class: "ax-control" %>
    <div class="ax-field-hint">
      Use automático para manter o padrão operacional. Se o modelo configurado ficar indisponível, o sistema tenta o fallback <code><%= provider.fallback_response_model %></code>.
    </div>
  </div>

  <div class="tw-mb-3">
    <%= f.label field.call(:model_custom), "Modelo personalizado", class: "ax-label tw-font-semibold" %>
    <%= f.text_field field.call(:model_custom),
        class: "ax-control",
        value: model_custom,
        placeholder: "Ex.: #{provider.default_model}" %>
    <div class="ax-field-hint">Use apenas quando o modelo desejado não aparecer no select.</div>
  </div>
<% end %>
