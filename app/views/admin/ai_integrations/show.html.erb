<% content_for :mobile_detail_header do %>
  <%= render "admin/shared/ui/mobile_detail_header", title: "IA", subtitle: "Configurações de IA", back_path: admin_root_path, status: @active_provider.label %>
<% end %>
<div class="ax-integration-layout">
<div class="integration-workspace ai-integration-workspace">
<%= ax_workspace_heading(
      eyebrow: "Integrações · IA",
      class_name: "ax-workspace-heading--desktop",
      icon: "stars",
      title: "IA",
      pills: [@content_connected ? "conteúdo conectado" : "conteúdo pendente", @voice_connected ? "voz conectada" : "voz pendente", "padrão: #{@active_provider.label}"],
      subtitle: "Conexões em um só lugar. Instruções, regras e limites organizados por módulo.",
      metrics: [
        { value: number_with_delimiter(@pending_suggestions_count), label: "pendentes" },
        { value: number_with_delimiter(@failed_suggestions_count), label: "falhas" }
      ]
    ) %>

<ul class="ax-form-tabs tw-mb-4" role="tablist" data-controller="ax-tabs" data-ax-tabs-reveal-active-value="true" data-ax-tabs-panel-selector-value="#ai-integration-tab-content">
  <li>
    <button class="ax-form-tabs__item active" id="ai-integration-connections-tab" type="button" role="tab" aria-controls="ai-integration-connections" aria-selected="true" tabindex="0" data-ax-tabs-target="tab" data-ax-tabs-target-param="#ai-integration-connections" data-action="click->ax-tabs#select">
      <i class="bi bi-diagram-3" aria-hidden="true"></i> Conexões e módulos
    </button>
  </li>
  <li>
    <button class="ax-form-tabs__item" id="ai-integration-content-tab" type="button" role="tab" aria-controls="ai-integration-content" aria-selected="false" tabindex="-1" data-ax-tabs-target="tab" data-ax-tabs-target-param="#ai-integration-content" data-action="click->ax-tabs#select">
      <i class="bi bi-pencil-square" aria-hidden="true"></i> Conteúdo
    </button>
  </li>
  <li>
    <button class="ax-form-tabs__item" id="ai-integration-voice-tab" type="button" role="tab" aria-controls="ai-integration-voice" aria-selected="false" tabindex="-1" data-ax-tabs-target="tab" data-ax-tabs-target-param="#ai-integration-voice" data-action="click->ax-tabs#select">
      <i class="bi bi-mic" aria-hidden="true"></i> Busca e voz
    </button>
  </li>
  <li>
    <button class="ax-form-tabs__item" id="ai-integration-leads-tab" type="button" role="tab" aria-controls="ai-integration-leads" aria-selected="false" tabindex="-1" data-ax-tabs-target="tab" data-ax-tabs-target-param="#ai-integration-leads" data-action="click->ax-tabs#select">
      <i class="bi bi-bullseye" aria-hidden="true"></i> Leads
    </button>
  </li>
  <li>
    <button class="ax-form-tabs__item" id="ai-integration-data-tab" type="button" role="tab" aria-controls="ai-integration-data" aria-selected="false" tabindex="-1" data-ax-tabs-target="tab" data-ax-tabs-target-param="#ai-integration-data" data-action="click->ax-tabs#select">
      <i class="bi bi-graph-up" aria-hidden="true"></i> Dados
    </button>
  </li>
</ul>

<div class="ax-form-tabs__panels" id="ai-integration-tab-content">
  <section class="ax-form-tabs__panel" id="ai-integration-connections" role="tabpanel" aria-labelledby="ai-integration-connections-tab" aria-hidden="false" tabindex="0">
    <%= render "connections" %>
  </section>
  <section class="ax-form-tabs__panel" id="ai-integration-content" role="tabpanel" aria-labelledby="ai-integration-content-tab" aria-hidden="true" tabindex="0" hidden>
    <%= render "content" %>
  </section>

  <section class="ax-form-tabs__panel" id="ai-integration-voice" role="tabpanel" aria-labelledby="ai-integration-voice-tab" aria-hidden="true" tabindex="0" hidden>
    <div class="ax-integration-actions tw-mb-3">
      <% { "Texto" => "property_search_text", "Voz" => "property_search_voice", "Transcrição" => "property_search_transcription" }.each do |label, module_key| %>
        <span><%= label %>: <%= render "admin/shared/ai/module_binding_badge", module_key: module_key %></span>
      <% end %>
    </div>
    <%= form_with model: @property_setting, url: admin_ai_integration_path(anchor: "ai-integration-voice"), method: :patch, local: true do |f| %>
      <%= hidden_field_tag "ai[section]", "search", id: nil %>
      <%= render "admin/shared/ai/property_search_settings", f: f, property_setting: @property_setting %>
      <%= render "admin/shared/ai/property_search_sharing", f: f, property_setting: @property_setting %>
      <div class="ax-integration-actions tw-mt-3">
        <%= link_to "Nomes alternativos", edit_admin_property_setting_path(anchor: "property-settings-ai-aliases"), class: "ax-btn ax-btn--ghost" %>
        <%= link_to "Aprendizado supervisionado", edit_admin_property_setting_path(anchor: "property-settings-ai-learning"), class: "ax-btn ax-btn--ghost" %>
      </div>
      <div class="ax-integration-actions tw-mt-3">
        <%= f.submit "Salvar ajustes da busca", class: "ax-btn ax-btn--primary" %>
      </div>
    <% end %>
  </section>

  <section class="ax-form-tabs__panel" id="ai-integration-leads" role="tabpanel" aria-labelledby="ai-integration-leads-tab" aria-hidden="true" tabindex="0" hidden>
    <div class="ax-integration-actions tw-mb-3">
      <span>Resumo de interesse do lead: <%= render "admin/shared/ai/module_binding_badge", module_key: "interest_summary" %></span>
    </div>
    <p class="tw-text-sm tw-text-ink-muted tw-mb-3">
      Como a IA lê o interesse do lead e sugere imóveis na ficha. O resumo usa o vínculo definido em Conexões e módulos.
    </p>
    <%= form_with model: @layout_setting, url: admin_ai_integration_path(anchor: "ai-integration-leads"), method: :patch, local: true do |f| %>
      <%= hidden_field_tag "ai[section]", "interest", id: nil %>
      <%= render "admin/shared/ai/interest_intelligence_settings", f: f, layout_setting: @layout_setting %>
      <div class="tw-mt-3">
        <%= f.submit "Salvar inteligência de interesse", class: "ax-btn ax-btn--primary" %>
      </div>
    <% end %>
  </section>

  <section class="ax-form-tabs__panel" id="ai-integration-data" role="tabpanel" aria-labelledby="ai-integration-data-tab" aria-hidden="true" tabindex="0" hidden>
    <div class="ax-integration-actions tw-mb-3">
      <span>Diagnóstico do BI: <%= render "admin/shared/ai/module_binding_badge", module_key: "dashboard_diagnosis" %></span>
    </div>
    <%= form_with url: admin_ai_integration_path(anchor: "ai-integration-data"), method: :patch, scope: :ai, local: true do |f| %>
      <%= f.hidden_field :section, value: "diagnosis", id: nil %>
      <%= ax_operational_panel(title: "Diagnóstico do BI", class_name: "ax-panel--settings tw-mb-4", actions: ax_badge(@dashboard_diagnosis_enabled ? "habilitado" : "desligado", tone: @dashboard_diagnosis_enabled ? :green : :gray)) do %>
        <%= ax_studio_group(title: "Uso de IA") do %>
          <%= hidden_field_tag "ai[dashboard_diagnosis_enabled]", "0", id: nil %>
          <%= ax_switch_field(name: "ai[dashboard_diagnosis_enabled]", id: "ai_dashboard_diagnosis_enabled", checked: @dashboard_diagnosis_enabled,
                label: "Usar IA para o diagnóstico do BI", description: "Quando desligado, o dashboard mantém a análise automática sem chamada externa.", class_name: "ax-switch--card") %>
        <% end %>
        <%= ax_studio_group(title: "Limites e consumo") do %>
          <%= ax_field_grid do %>
            <div class="ax-span-6">
              <%= ax_number_field(form: f, method: :dashboard_diagnosis_weekly_limit, label: "Limite semanal de diagnósticos", min: 0, max: 10, value: @dashboard_diagnosis_weekly_limit,
                    hint: "#{@dashboard_diagnosis_weekly_used} usado(s) nesta semana. Limita novas consultas; não agenda a geração.") %>
            </div>
            <div class="ax-span-6">
              <%= ax_currency_field(form: f, method: :dashboard_diagnosis_monthly_budget_reais, label: "Teto mensal estimado", value: number_with_precision(@dashboard_diagnosis_monthly_budget_cents.to_i / 100.0, precision: 2, separator: ",", delimiter: "."), inputmode: "decimal", placeholder: "10,00") %>
              <p class="ax-field__hint">Gasto estimado no mês: <%= number_to_currency(@dashboard_diagnosis_monthly_cost_cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>. Teto de R$ 0,00 a R$ 1.000,00.</p>
            </div>
          <% end %>
          <%= ax_inline_notice(tone: :info, compact: true, icon: "info-circle") do %>
            Valor zero em qualquer limite impede novas chamadas externas. Diagnósticos já armazenados podem continuar disponíveis. O gasto é uma estimativa, não uma fatura.
          <% end %>
        <% end %>
      <% end %>
      <div class="ax-integration-actions">
        <%= f.submit "Salvar diagnóstico do BI", class: "ax-btn ax-btn--primary" %>
      </div>
    <% end %>
  </section>
</div>
</div>

</div>
