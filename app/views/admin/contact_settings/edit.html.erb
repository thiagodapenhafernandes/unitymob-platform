<%
  routing = @whatsapp_integration.site_phone_settings
  studio_items = [
    { id: "contact-tab-channels", icon: "telephone", label: "Canais", hint: "Telefone, e-mail, endereço e horário" },
    { id: "contact-tab-forms", icon: "whatsapp", label: "Interessados no imóvel", hint: "Para onde vai o lead e o que ele lê" },
    { id: "contact-tab-social", icon: "share", label: "Redes e blog", hint: "Links exibidos no site" }
  ]
  negotiations = WhatsappBusinessIntegration::NEGOTIATION_TYPES
  phone_field = ->(form, method, label, **opts) { ax_text_field(form: form, method: method, label: label, type: :tel, placeholder: "+55 00 00000-0000", data: { controller: "phone-input" }, **opts) }
%>
<div class="public-site-workspace ctt-workspace">
  <%= ax_workspace_heading(
        eyebrow: "Site público · Estrutura",
        icon: "telephone",
        title: "Contato",
        subtitle: "Canais da imobiliária e o atendimento de quem se interessa por um imóvel: destino do WhatsApp, captura de dados e mensagens.",
        actions: ax_button("Voltar", admin_root_path, variant: :secondary, icon: "arrow-left")
      ) %>

  <%= form_with(model: @contact_setting, url: admin_contact_setting_path, method: :patch, local: true,
                html: { data: { controller: "ax-dirty-form", action: "input->ax-dirty-form#mark change->ax-dirty-form#mark" } }) do |f| %>
    <%= ax_error_summary(@contact_setting) %>

    <div class="ax-studio">
      <div class="ax-studio__nav">
        <%= ax_studio_nav(items: studio_items, panels_selector: "#contact-studio-sections", label: "Seções de contato") %>
      </div>

      <div class="ax-studio__stage" id="contact-studio-sections">
        <%= ax_studio_section(id: "contact-tab-channels", icon: "telephone", active: true,
                              title: "Canais",
                              subtitle: "Aparecem na página Contato, no rodapé e nos botões do site. O telefone no topo é ligado em Topo e menu.") do %>
          <%= ax_studio_group(title: "Telefones e e-mails") do %>
            <%= ax_field_grid do %>
              <div class="ax-span-6"><%= phone_field.call(f, :whatsapp_primary, "WhatsApp principal", autocomplete: "tel", hint: "Código do país + DDD + número.") %></div>
              <div class="ax-span-6"><%= phone_field.call(f, :whatsapp_secondary, "WhatsApp secundário", autocomplete: "tel", hint: "Opcional. Canal alternativo.") %></div>
              <div class="ax-span-6"><%= phone_field.call(f, :phone, "Telefone fixo", autocomplete: "tel", hint: "Aparece no topo se ligado em Topo e menu.") %></div>
              <div class="ax-span-6"><%= ax_text_field(form: f, method: :email_primary, label: "E-mail principal", type: :email, placeholder: "contato@suaimobiliaria.com.br") %></div>
              <div class="ax-span-6"><%= ax_text_field(form: f, method: :email_commercial, label: "E-mail comercial", type: :email, hint: "Opcional.") %></div>
            <% end %>
          <% end %>

          <%= ax_studio_group(title: "Endereço e horário", subtitle: "Mostrados na página Contato; o endereço também alimenta o mapa.") do %>
            <%= ax_field_grid do %>
              <div class="ax-span-6"><%= ax_text_field(form: f, method: :address, label: "Endereço", type: :textarea, rows: 3) %></div>
              <div class="ax-span-6"><%= ax_text_field(form: f, method: :business_hours, label: "Horário de atendimento", type: :textarea, rows: 3, placeholder: "Segunda a sexta, das 9h às 18h") %></div>
            <% end %>
          <% end %>
        <% end %>

        <%= ax_studio_section(id: "contact-tab-forms", icon: "whatsapp",
                              title: "Interessados no imóvel",
                              subtitle: "Cada tipo de negociação tem o seu destino de WhatsApp, o seu passo de captura e as suas mensagens. Campo vazio usa o padrão do sistema.") do %>
          <%= fields_for :whatsapp_business_integration, @whatsapp_integration do |wf| %>
            <%= ax_studio_group(title: "Número padrão", subtitle: "Usado quando o tipo de negociação não tem número próprio. Vazio usa o WhatsApp principal.") do %>
              <%= phone_field.call(wf, :default_whatsapp_number, "WhatsApp padrão dos formulários", value: @whatsapp_integration.default_whatsapp_number.presence || routing[:default_phone]) %>
            <% end %>

            <div class="ctt-negotiations">
              <% negotiations.each do |key, config| %>
                <% message = ContactSetting::PROPERTY_LEAD_MESSAGE_TYPES.fetch(key) %>
                <%= ax_studio_group(title: config[:label], subtitle: config[:default_message], icon: "whatsapp", class_name: "ctt-negotiation") do %>
                  <%= phone_field.call(wf, config[:phone_attribute], "WhatsApp de destino", placeholder: "Usar número padrão") %>
                  <div class="ax-studio-switches">
                    <%= ax_switch_field(form: wf, method: config[:form_attribute], label: "Captar dados antes de redirecionar", checked_value: "1", unchecked_value: "0") %>
                    <%= ax_switch_field(form: wf, method: config[:redirect_attribute], label: "Redirecionar para o WhatsApp após captar", checked_value: "1", unchecked_value: "0") %>
                  </div>
                  <%= ax_text_field(form: f, method: message.fetch(:success_attribute), label: "Mensagem de sucesso do modal", type: :textarea, rows: 3,
                                    placeholder: ContactSetting::DEFAULT_PROPERTY_LEAD_SUCCESS_MESSAGE,
                                    hint: "Aparece quando o lead é salvo e não há redirecionamento automático.") %>
                  <%= ax_text_field(form: f, method: message.fetch(:whatsapp_attribute), label: "Mensagem pré-preenchida do WhatsApp", type: :textarea, rows: 3,
                                    placeholder: ContactSetting::DEFAULT_PROPERTY_WHATSAPP_MESSAGE,
                                    hint: "Usada no botão de WhatsApp do imóvel e no redirecionamento após o modal.") %>
                <% end %>
              <% end %>
            </div>

            <div class="ctt-variables" aria-label="Variáveis disponíveis para mensagens">
              <span>Variáveis:</span>
              <% ContactSetting::PROPERTY_LEAD_VARIABLES.each do |token, description| %>
                <code title="<%= description %>"><%= token %></code>
              <% end %>
              <small><code>{nome}</code> vira o nome preenchido no modal e <code>{imovel}</code> o título do imóvel.</small>
            </div>

            <%= ax_studio_group(title: "Cartão do corretor", subtitle: "Vale para toda a equipe. Desligado, os cartões de apresentação saem sempre como texto, sem a foto do corretor.") do %>
              <%= ax_switch_field(form: wf, method: :allow_photo_presentation, label: "Permitir cartão com foto do corretor",
                                  description: "O telefone pessoal do corretor nunca é enviado.", checked: @whatsapp_integration.allow_photo_presentation?, class_name: "ax-switch--card") %>
            <% end %>
          <% end %>
        <% end %>

        <%= ax_studio_section(id: "contact-tab-social", icon: "share",
                              title: "Redes e blog",
                              subtitle: "Endereços completos. Aparecem no rodapé e na página Contato; Blog e YouTube também viram links do topo.") do %>
          <%= ax_studio_group(title: "Endereços") do %>
            <%= ax_field_grid do %>
              <% [
                [:facebook_url, "Facebook", "https://facebook.com/suaimobiliaria"],
                [:instagram_url, "Instagram", "https://instagram.com/suaimobiliaria"],
                [:youtube_url, "YouTube", "https://youtube.com/@suaimobiliaria"],
                [:linkedin_url, "LinkedIn", "https://linkedin.com/company/suaimobiliaria"],
                [:blog_url, "Blog", "https://suaimobiliaria.com.br/blog"]
              ].each do |method, label, placeholder| %>
                <div class="ax-span-6"><%= ax_text_field(form: f, method: method, label: label, type: :url, placeholder: placeholder) %></div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <aside class="ax-studio__aside" aria-label="Resumo dos destinos">
        <div class="ctt-summary">
          <h3>Para onde vai cada lead</h3>
          <dl>
            <% routing[:negotiations].each do |_key, item| %>
              <div>
                <dt><strong><%= item[:label] %></strong>
                  <span><%= item[:requires_form] ? (item[:redirect_after_capture] ? "Formulário e redirecionamento" : "Formulário sem redirecionamento") : "Direto para o WhatsApp" %></span></dt>
                <dd><code><%= item[:phone].presence || routing[:default_phone] %></code></dd>
              </div>
            <% end %>
          </dl>
          <p>O resumo reflete o que está salvo. Depois de salvar, o site usa os novos destinos em até 5 minutos.</p>
        </div>
      </aside>
    </div>

    <%= ax_studio_savebar(form: f, cancel_path: admin_root_path) %>
  <% end %>
</div>
