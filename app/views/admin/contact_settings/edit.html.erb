<div class="public-site-workspace">
  <%= ax_workspace_heading(
        eyebrow: "Site público · Estrutura",
        icon: "telephone",
        title: "Contato",
        subtitle: "Gerencie canais, redes sociais e mensagens usadas na captura de interessados em imóveis.",
        actions: ax_button("Voltar", admin_root_path, variant: :ghost, size: :sm, icon: "arrow-left")
      ) %>

  <%= form_with(model: @contact_setting, url: admin_contact_setting_path, method: :patch) do |f| %>
    <%= ax_error_summary(@contact_setting) %>

    <%= ax_field_grid do %>
      <div class="ax-span-6">
        <%= ax_operational_panel(eyebrow: "Atendimento", title: "Contato principal") do %>
          <div class="tw-grid tw-gap-4">
            <div class="ax-field">
              <%= ax_field_label(f, :whatsapp_primary, text: "WhatsApp principal") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-whatsapp tw-text-green-600", aria: { hidden: true })) do %>
                <%= f.text_field :whatsapp_primary, class: "ax-control", placeholder: "(11) 99999-0000", autocomplete: "tel", data: { controller: "phone-input" } %>
              <% end %>
              <p class="ax-field__hint">Formato: código do país + DDD + número.</p>
            </div>

            <div class="ax-field">
              <%= ax_field_label(f, :phone, text: "Telefone fixo") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-telephone tw-text-primary", aria: { hidden: true })) do %>
                <%= f.text_field :phone, class: "ax-control", placeholder: "(11) 3000-0000", autocomplete: "tel", data: { controller: "phone-input" } %>
              <% end %>
              <p class="ax-field__hint">Telefone fixo da empresa.</p>
            </div>

            <div class="ax-field">
              <label class="tw-flex tw-items-start tw-gap-3 tw-rounded-lg tw-border tw-border-slate-200 tw-bg-white tw-p-3">
                <%= f.check_box :show_phone_in_header, class: "tw-mt-1 tw-h-4 tw-w-4 tw-rounded tw-border-slate-300 tw-text-primary focus:tw-ring-primary" %>
                <span>
                  <strong class="tw-block tw-text-sm tw-font-semibold tw-text-slate-800">Exibir telefone no header</strong>
                  <span class="tw-block tw-text-xs tw-text-slate-500">Controla somente o telefone ao lado da logo no site público.</span>
                </span>
              </label>
            </div>

            <div class="ax-field">
              <%= ax_field_label(f, :email_primary, text: "E-mail principal") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-envelope tw-text-red-600", aria: { hidden: true })) do %>
                <%= f.email_field :email_primary, class: "ax-control", placeholder: "contato@suaimobiliaria.com.br" %>
              <% end %>
              <p class="ax-field__hint">E-mail principal para contato.</p>
            </div>

            <div class="ax-field">
              <div class="tw-flex tw-items-center tw-gap-2">
                <%= ax_field_label(f, :whatsapp_secondary, text: "WhatsApp secundário") %>
                <%= ax_badge("Opcional", tone: :gray) %>
              </div>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-whatsapp tw-text-green-600", aria: { hidden: true })) do %>
                <%= f.text_field :whatsapp_secondary, class: "ax-control", placeholder: "(11) 98888-0000", autocomplete: "tel", data: { controller: "phone-input" } %>
              <% end %>
              <p class="ax-field__hint">Canal alternativo de WhatsApp.</p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="ax-span-6">
        <%= ax_operational_panel(eyebrow: "Presença digital", title: "Redes sociais") do %>
          <div class="tw-grid tw-gap-4">
            <div class="ax-field">
              <%= ax_field_label(f, :facebook_url, text: "Facebook") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-facebook tw-text-primary", aria: { hidden: true })) do %>
                <%= f.url_field :facebook_url, class: "ax-control", placeholder: "https://facebook.com/suaimobiliaria" %>
              <% end %>
              <p class="ax-field__hint">URL completa da página do Facebook.</p>
            </div>

            <div class="ax-field">
              <%= ax_field_label(f, :instagram_url, text: "Instagram") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-instagram tw-text-red-600", aria: { hidden: true })) do %>
                <%= f.url_field :instagram_url, class: "ax-control", placeholder: "https://instagram.com/suaimobiliaria" %>
              <% end %>
              <p class="ax-field__hint">URL completa do perfil do Instagram.</p>
            </div>

            <div class="ax-field">
              <%= ax_field_label(f, :youtube_url, text: "YouTube") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-youtube tw-text-red-600", aria: { hidden: true })) do %>
                <%= f.url_field :youtube_url, class: "ax-control", placeholder: "https://youtube.com/@suaimobiliaria" %>
              <% end %>
              <p class="ax-field__hint">URL completa do canal do YouTube.</p>
            </div>

            <div class="ax-field">
              <%= ax_field_label(f, :blog_url, text: "Blog") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-journal-text tw-text-primary", aria: { hidden: true })) do %>
                <%= f.url_field :blog_url, class: "ax-control", placeholder: "https://suaimobiliaria.com.br/blog" %>
              <% end %>
              <p class="ax-field__hint">URL completa do blog exibido no menu público.</p>
            </div>

            <div class="ax-field">
              <%= ax_field_label(f, :linkedin_url, text: "LinkedIn") %>
              <%= ax_input_group(prefix: tag.i(class: "bi bi-linkedin tw-text-primary", aria: { hidden: true })) do %>
                <%= f.url_field :linkedin_url, class: "ax-control", placeholder: "https://linkedin.com/company/suaimobiliaria" %>
              <% end %>
              <p class="ax-field__hint">URL completa da página do LinkedIn.</p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="ax-span-12">
        <%= ax_operational_panel(eyebrow: "Atendimento do imóvel", title: "Mensagens do modal e do WhatsApp") do %>
          <div class="tw-grid tw-gap-5">
            <div class="tw-flex tw-flex-col tw-gap-3 lg:tw-flex-row lg:tw-items-start lg:tw-justify-between">
              <p class="tw-m-0 tw-max-w-3xl tw-text-sm tw-leading-6 tw-text-slate-600">
                Personalize o retorno exibido após o envio do modal e a mensagem que abre no WhatsApp. Quando um campo ficar vazio, o sistema usa o texto padrão.
              </p>
              <div class="tw-flex tw-flex-wrap tw-gap-2" aria-label="Variáveis disponíveis para mensagens">
                <% ContactSetting::PROPERTY_LEAD_VARIABLES.each do |token, description| %>
                  <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded-full tw-border tw-border-slate-200 tw-bg-white tw-px-3 tw-py-1 tw-text-xs tw-font-semibold tw-text-slate-600"
                        title="<%= description %>">
                    <code class="tw-font-mono tw-text-[11px] tw-text-primary"><%= token %></code>
                  </span>
                <% end %>
              </div>
            </div>

            <div class="tw-grid tw-gap-5 xl:tw-grid-cols-3">
              <% ContactSetting::PROPERTY_LEAD_MESSAGE_TYPES.each do |negotiation_type, config| %>
                <% success_method = config.fetch(:success_attribute) %>
                <% whatsapp_method = config.fetch(:whatsapp_attribute) %>
                <% success_hint_id = "contact_setting_#{success_method}_hint" %>
                <% whatsapp_hint_id = "contact_setting_#{whatsapp_method}_hint" %>

                <fieldset class="tw-min-w-0 tw-rounded-xl tw-border tw-border-slate-200 tw-p-4">
                  <legend class="tw-px-1 tw-text-sm tw-font-bold tw-text-slate-800"><%= config.fetch(:label) %></legend>

                  <div class="tw-grid tw-gap-4">
                    <div class="ax-field">
                      <%= ax_field_label(f, success_method, text: "Mensagem de sucesso do modal") %>
                      <p id="<%= success_hint_id %>" class="ax-field__hint tw-mb-2">
                        Aparece quando o lead é salvo e a conta não redireciona automaticamente para o WhatsApp.
                      </p>
                      <%= f.text_area success_method,
                                      class: "ax-control",
                                      rows: 4,
                                      placeholder: ContactSetting::DEFAULT_PROPERTY_LEAD_SUCCESS_MESSAGE,
                                      aria: { describedby: success_hint_id } %>
                    </div>

                    <div class="ax-field">
                      <%= ax_field_label(f, whatsapp_method, text: "Mensagem pré-preenchida do WhatsApp") %>
                      <p id="<%= whatsapp_hint_id %>" class="ax-field__hint tw-mb-2">
                        Usada no botão de WhatsApp do imóvel e no redirecionamento após o modal.
                      </p>
                      <%= f.text_area whatsapp_method,
                                      class: "ax-control",
                                      rows: 4,
                                      placeholder: ContactSetting::DEFAULT_PROPERTY_WHATSAPP_MESSAGE,
                                      aria: { describedby: whatsapp_hint_id } %>
                    </div>
                  </div>
                </fieldset>
              <% end %>
            </div>

            <p class="tw-m-0 tw-text-xs tw-leading-5 tw-text-slate-500">
              Exemplo: <code class="tw-rounded tw-bg-slate-100 tw-px-1 tw-py-0.5">{nome}</code> vira o nome preenchido no modal e <code class="tw-rounded tw-bg-slate-100 tw-px-1 tw-py-0.5">{imovel}</code> vira o título do imóvel.
            </p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= ax_sticky_action_footer(meta: safe_join([tag.i(class: "bi bi-shield-check tw-text-green-600", aria: { hidden: true }), tag.span("As informações serão atualizadas em todo o site")], " ")) do %>
      <%= f.submit "Salvar configurações", class: "ax-btn ax-btn--primary", data: { disable_with: "Salvando..." } %>
    <% end %>
  <% end %>
</div>
