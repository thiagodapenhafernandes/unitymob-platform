<%= turbo_frame_tag "admin_dashboard_funnel" do %>
  <article class="ax-dashboard-panel ax-dashboard-panel--funnel">
    <div class="ax-dashboard-panel__header">
      <div>
        <span class="ax-dashboard-panel__eyebrow">Funil</span>
        <h2>Conversão comercial</h2>
      </div>
      <%= ax_badge("#{@dashboard_period} dias", tone: :blue) %>
    </div>

    <div class="ax-dashboard-acquisition__grid ax-dashboard-funnel-layout">
      <div class="ax-dashboard-funnel-layout__main">
        <div class="ax-dashboard-funnel">
          <div class="ax-dashboard-funnel__visual" aria-label="Funil comercial dos últimos 30 dias">
            <% @commercial_funnel_rows.each do |row| %>
              <div class="ax-dashboard-funnel__stage ax-dashboard-funnel__stage--<%= row[:tone] %>">
                <span class="ax-dashboard-funnel__stage-label"><%= row[:label] %></span>
                <strong><%= number_with_delimiter(row[:value]) %></strong>
              </div>
            <% end %>
          </div>

          <div class="ax-dashboard-funnel__rates" aria-label="Taxas observadas e faixas de referência">
            <% @commercial_funnel_rows.each_cons(2) do |from, to| %>
              <div class="ax-dashboard-funnel__rate">
                <span><%= from[:label].split.first %> -> <%= to[:label].split.first %></span>
                <strong><%= number_to_percentage(to[:conversion_rate], precision: 1, strip_insignificant_zeros: true) %></strong>
              </div>
            <% end %>
            <div class="ax-dashboard-funnel__rate ax-dashboard-funnel__rate--overall">
              <span>Impacto -> venda</span>
              <strong><%= number_to_percentage(@commercial_funnel_rows.last[:overall_conversion_rate], precision: 1, strip_insignificant_zeros: true) %></strong>
            </div>
          </div>
        </div>
      </div>

      <div class="ax-dashboard-channel-quality__rows ax-dashboard-funnel-layout__side">
        <section class="ax-dashboard-channel-quality ax-dashboard-channel-quality--compact">
          <div class="ax-dashboard-acquisition__title">
            <h3>Gargalos do funil</h3>
            <small>Perdas e voltas que merecem atenção</small>
          </div>
          <% flow_rows = (@stage_loss_rows.map { |row| row.merge(unit: "perdas") } + @stage_reopen_rows.map { |row| row.merge(unit: "voltas") }).select { |row| row[:value].to_i.positive? } %>
          <% if flow_rows.any? %>
            <div class="ax-dashboard-channel-quality__rows">
              <% flow_rows.first(5).each do |row| %>
                <%= link_to row[:path], class: "ax-dashboard-channel-quality__row", data: { turbo_frame: "_top" } do %>
                  <span class="ax-dashboard-channel-quality__identity"><strong><%= row[:label] %></strong><small><%= row[:detail] %></small></span>
                  <span class="ax-dashboard-channel-quality__rate"><b><%= number_with_delimiter(row[:value]) %></b><small><%= row[:unit] %></small></span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="ax-dashboard-empty-row">Sem perda ou reabertura registrada no período.</div>
          <% end %>
        </section>

        <section class="ax-dashboard-channel-quality ax-dashboard-channel-quality--compact">
          <div class="ax-dashboard-acquisition__title">
            <h3>Leads quentes/mornos sem ação</h3>
            <small>Interpretação do sistema sem atualização recente</small>
          </div>
          <% active_temperature_rows = @lead_temperature_rows.select { |row| row[:value].to_i.positive? } %>
          <% if active_temperature_rows.any? %>
          <div class="ax-dashboard-channel-quality__rows">
            <% active_temperature_rows.each do |row| %>
              <%= link_to row[:path], class: "ax-dashboard-channel-quality__row", data: { turbo_frame: "_top" } do %>
                <span class="ax-dashboard-channel-quality__identity"><strong><%= row[:label] %></strong><small><%= row[:detail] %></small></span>
                <span class="ax-dashboard-channel-quality__rate"><b><%= number_with_delimiter(row[:value]) %></b><small>leads</small></span>
              <% end %>
            <% end %>
          </div>
          <% else %>
            <div class="ax-dashboard-empty-row">Sem lead quente ou morno parado.</div>
          <% end %>
        </section>
      </div>
    </div>
  </article>
<% end %>
