<%= turbo_frame_tag "admin_dashboard_service" do %>
  <div class="ax-dashboard-grid ax-dashboard-grid--service">
    <article class="ax-dashboard-panel ax-dashboard-service-panel">
      <div class="ax-dashboard-panel__header">
        <div>
          <span class="ax-dashboard-panel__eyebrow">Atendimento</span>
          <h2>SLA e ações urgentes</h2>
        </div>
        <%= ax_badge("#{@dashboard_period} dias", tone: :blue) %>
      </div>

      <div class="ax-dashboard-service-list">
        <% @service_sla_rows.select { |row| row[:value].to_i.positive? }.each do |row| %>
          <%= link_to row[:path], class: "ax-dashboard-service-row ax-dashboard-service-row--#{row[:tone]}", data: { turbo_frame: "_top" } do %>
            <span>
              <strong><%= row[:label] %></strong>
              <small><%= row[:detail] %></small>
            </span>
            <b><%= number_with_delimiter(row[:value]) %></b>
          <% end %>
        <% end %>
        <% if @service_sla_rows.none? { |row| row[:value].to_i.positive? } %>
          <div class="ax-dashboard-empty-row">Sem pendência de atendimento no período.</div>
        <% end %>
      </div>
    </article>

  </div>
<% end %>
