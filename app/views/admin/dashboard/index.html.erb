<%# Dashboard operacional — shell leve com slices assíncronos via Turbo Frames. %>
<%
  hour = Time.current.hour
  greeting = hour < 12 ? "Bom dia" : (hour < 18 ? "Boa tarde" : "Boa noite")
  first_name = current_admin_user.name.to_s.split.first.presence || current_admin_user.email
  dashboard_filter_params = { period: @dashboard_period, tab: @dashboard_tab }
  dashboard_filter_params[:broker_id] = @dashboard_broker_id if @dashboard_broker_id.present?

  dashboard_subtitle =
    if @is_admin_view && @field_feature_enabled
      "Campo ativo: #{@active_checkins_count} check-ins agora, #{@leads_today} leads hoje."
    elsif @is_admin_view
      "Campo desativado para esta operação. Ative quando houver equipe externa em rota."
    else
      "Painel pessoal: #{@leads_today} leads hoje, #{@properties_count} imóveis atribuídos."
    end

%>

<section class="ax-dashboard" aria-label="Dashboard operacional">
  <header class="ax-dashboard-command">
    <div class="ax-dashboard-command__main">
      <span class="ax-dashboard-command__eyebrow">Cockpit operacional</span>
      <div class="ax-dashboard-command__title-row">
        <h1><%= greeting %>, <%= first_name %></h1>
        <%= ax_badge(@is_admin_view ? "Admin" : "Meu painel", tone: :blue) %>
      </div>
      <p><%= l(Date.current, format: :long) %> · <%= dashboard_subtitle %></p>
      <small class="ax-dashboard-command__updated"><i class="bi bi-arrow-clockwise"></i> Atualizado <%= time_ago_in_words(@dashboard_updated_at) %> atrás</small>
    </div>

    <div class="ax-dashboard-command__status">
      <span><i class="bi bi-hdd-network"></i> Operação</span>
      <% if @field_feature_enabled %>
        <%= ax_badge("Campo ativo", tone: :green, dot: true) %>
      <% else %>
        <%= link_to edit_admin_field_settings_path, title: "Configurar módulo Campo" do %>
          <%= ax_badge("Campo pausado", tone: :amber) %>
        <% end %>
      <% end %>
    </div>
  </header>

  <nav class="ax-dashboard-tabs" aria-label="Áreas do dashboard">
    <% dashboard_tabs = [["overview", "Visão geral", "grid-1x2"], ["leads", "Leads", "megaphone"], ["properties", "Imóveis", "buildings"], ["site", "Site público", "globe2"]] %>
    <% dashboard_tabs << ["field", "Campo", "geo-alt"] if @field_feature_enabled %>
    <% dashboard_tabs.each do |key, label, icon| %>
      <%= link_to admin_root_path(tab: key, period: @dashboard_period, broker_id: @dashboard_broker_id),
                  class: "ax-dashboard-tabs__item #{'is-active' if @dashboard_tab == key}",
                  aria: { current: (@dashboard_tab == key ? "page" : nil) } do %>
        <span class="ax-dashboard-tabs__main">
          <i class="bi bi-<%= icon %>"></i>
          <span class="ax-dashboard-tabs__label"><%= label %></span>
        </span>
        <% if (badges = @dashboard_tab_badges[key]).present? %>
          <span class="ax-dashboard-tabs__badges" aria-label="Indicadores de <%= label %>">
            <% badges.each do |badge| %>
              <span class="ax-dashboard-tabs__badge ax-dashboard-tabs__badge--<%= badge[:tone] %>"
                    title="<%= badge[:title] %>"
                    aria-label="<%= "#{badge[:label]}: #{number_with_delimiter(badge[:value])}. #{badge[:title]}" %>">
                <span class="ax-dashboard-tabs__badge-value"><%= number_with_delimiter(badge[:value]) %></span>
                <span class="ax-dashboard-tabs__badge-label"><%= badge[:label] %></span>
              </span>
            <% end %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <%= form_with url: admin_root_path, method: :get, class: "ax-dashboard-filters", data: { turbo: false } do |form| %>
    <%= form.hidden_field :tab, value: @dashboard_tab %>
    <span><i class="bi bi-funnel"></i> Escopo do painel</span>
    <%= form.select :period, [["7 dias", 7], ["30 dias", 30], ["90 dias", 90]], { selected: @dashboard_period }, class: "ax-control", aria: { label: "Período do dashboard" }, onchange: "this.form.requestSubmit()" %>
    <% if @is_admin_view %>
      <%= form.select :broker_id, [["Todos os corretores", ""]] + @dashboard_brokers.map { |broker| [broker.name, broker.id] }, { selected: @dashboard_broker_id }, class: "ax-control", aria: { label: "Corretor do dashboard" }, onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <% if @dashboard_tab == "overview" %>
  <section class="ax-dashboard-panel ax-dashboard-actions" aria-labelledby="dashboard-actions-title">
    <div class="ax-dashboard-panel__header">
      <div>
        <span class="ax-dashboard-panel__eyebrow">Ações recomendadas</span>
        <h2 id="dashboard-actions-title">Por onde começar agora?</h2>
      </div>
      <div class="ax-dashboard-panel__actions">
        <%= ax_badge("#{@recommended_actions.size} ações", tone: @recommended_actions.any? ? :amber : :green) %>
      </div>
    </div>

    <div class="ax-dashboard-actions__grid">
      <% if @recommended_actions.any? %>
        <% @recommended_actions.each do |action| %>
          <%= link_to action[:path], class: "ax-dashboard-action ax-dashboard-action--#{action[:tone]}", data: { turbo_frame: "_top" } do %>
            <span class="ax-dashboard-action__icon"><i class="bi bi-<%= action[:icon] %>"></i></span>
            <span class="ax-dashboard-action__body">
              <strong><%= action[:title] %></strong>
              <small><%= action[:detail] %></small>
            </span>
            <b><%= number_with_delimiter(action[:value]) %></b>
          <% end %>
        <% end %>
      <% else %>
        <div class="ax-dashboard-action ax-dashboard-action--green">
          <span class="ax-dashboard-action__icon"><i class="bi bi-check2-circle"></i></span>
          <span class="ax-dashboard-action__body">
            <strong>Nenhuma ação crítica agora</strong>
            <small>Os principais sinais operacionais estão sem alerta no período.</small>
          </span>
          <b>0</b>
        </div>
      <% end %>
    </div>
  </section>

  <% diagnosis_limit = @dashboard_ai_diagnosis[:limit_status].to_h.with_indifferent_access %>
  <section class="ax-dashboard-panel ax-dashboard-actions" aria-labelledby="dashboard-ai-diagnosis-title">
    <div class="ax-dashboard-panel__header">
      <div>
        <span class="ax-dashboard-panel__eyebrow">IA textual</span>
        <h2 id="dashboard-ai-diagnosis-title"><%= @dashboard_ai_diagnosis[:title] %></h2>
      </div>
      <div class="ax-dashboard-panel__actions">
        <%= ax_badge(@dashboard_ai_diagnosis[:source].to_s.start_with?("openai") ? "OpenAI" : "determinístico", tone: @dashboard_ai_diagnosis[:source].to_s.start_with?("openai") ? :blue : :gray) %>
        <%= link_to "Limites", admin_ai_integration_path(anchor: "ai-dashboard-diagnosis"), class: "ax-dashboard-panel__link", data: { turbo_frame: "_top" } %>
      </div>
    </div>

    <div class="ax-dashboard-panel__body ax-dashboard-ai-diagnosis">
      <p class="ax-dashboard-ai-diagnosis__summary"><%= @dashboard_ai_diagnosis[:summary] %></p>

      <div class="ax-dashboard-actions__grid ax-dashboard-actions__grid--flush">
        <% diagnosis_recommendations = Array(@dashboard_ai_diagnosis[:recommendations]).first(4) %>
        <% if diagnosis_recommendations.any? %>
        <% diagnosis_recommendations.each do |item| %>
          <% item = item.with_indifferent_access %>
          <div class="ax-dashboard-action ax-dashboard-action--<%= item[:tone].presence || "blue" %>">
            <span class="ax-dashboard-action__icon"><i class="bi bi-stars"></i></span>
            <span class="ax-dashboard-action__body">
              <strong><%= item[:title] %></strong>
              <small><%= item[:detail] %></small>
            </span>
            <b><%= number_with_delimiter(item[:value].to_i) %></b>
          </div>
        <% end %>
        <% else %>
          <div class="ax-dashboard-action ax-dashboard-action--green">
            <span class="ax-dashboard-action__icon"><i class="bi bi-check2-circle"></i></span>
            <span class="ax-dashboard-action__body">
              <strong>Sem recomendação crítica</strong>
              <small>Os principais sinais operacionais estão dentro do esperado para o período.</small>
            </span>
            <b>0</b>
          </div>
        <% end %>
      </div>

      <div class="ax-dashboard-ai-diagnosis__limits">
        <%= ax_badge("#{diagnosis_limit[:weekly_used].to_i}/#{diagnosis_limit[:weekly_limit].to_i} diagnóstico(s) IA na semana", tone: diagnosis_limit[:weekly_remaining].to_i.positive? ? :blue : :amber) %>
        <%= ax_badge("#{number_to_currency(diagnosis_limit[:monthly_cost_cents].to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".")} / #{number_to_currency(diagnosis_limit[:monthly_budget_cents].to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".")} no mês", tone: diagnosis_limit[:monthly_budget_remaining_cents].to_i.positive? ? :blue : :amber) %>
      </div>
    </div>
  </section>

  <section class="ax-dashboard-panel ax-dashboard-questions ax-dashboard-questions--decision" aria-labelledby="dashboard-questions-title">
    <div class="ax-dashboard-panel__header">
      <div>
        <span class="ax-dashboard-panel__eyebrow">Decisão operacional</span>
        <h2 id="dashboard-questions-title"><%= @decision_questions.any? ? "O que exige ação agora?" : "Operação sem alerta crítico agora" %></h2>
      </div>
      <div class="ax-dashboard-panel__actions">
        <%= ax_badge("#{@dashboard_period} dias", tone: @decision_questions.any? ? :amber : :green) %>
      </div>
    </div>

    <div class="ax-dashboard-questions__grid">
      <% visible_questions = @decision_questions.any? ? @decision_questions : @health_questions.first(2) %>
      <% visible_questions.each do |item| %>
        <%= link_to item[:path], class: "ax-dashboard-question ax-dashboard-question--#{item[:tone]} #{'ax-dashboard-question--featured' if item[:featured]}", data: { turbo_frame: "_top" } do %>
          <span class="ax-dashboard-question__icon"><i class="bi bi-<%= item[:icon] %>"></i></span>
          <span class="ax-dashboard-question__body">
            <strong><%= item[:question] %></strong>
            <small><%= item[:answer] %></small>
          </span>
          <span class="ax-dashboard-question__action">
            <b><%= number_with_delimiter(item[:metric]) %></b>
            <em><%= item[:action] %></em>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="ax-dashboard-investigations" aria-label="Mapa de investigação operacional">
    <% @overview_investigations.each do |item| %>
      <article class="ax-dashboard-investigation ax-dashboard-investigation--<%= item[:tone] %>">
        <div class="ax-dashboard-investigation__head">
          <span class="ax-dashboard-investigation__icon"><i class="bi bi-<%= item[:icon] %>"></i></span>
          <span>
            <strong><%= item[:question] %></strong>
            <small><%= item[:answer] %></small>
          </span>
        </div>

        <div class="ax-dashboard-investigation__rows">
          <% if item[:rows].any? %>
            <% item[:rows].each do |row| %>
              <%= link_to row[:path], class: "ax-dashboard-investigation__row ax-dashboard-investigation__row--#{row[:tone]}", data: { turbo_frame: "_top" } do %>
                <span>
                  <strong><%= row[:label] %></strong>
                  <small><%= row[:detail] %></small>
                </span>
                <b><%= number_with_delimiter(row[:value]) %></b>
              <% end %>
            <% end %>
          <% else %>
            <div class="ax-dashboard-investigation__empty"><i class="bi bi-check2-circle"></i> <%= item[:empty] %></div>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <% end %>

  <% if @dashboard_tab == "leads" %>
  <div class="ax-dashboard-grid ax-dashboard-grid--primary ax-dashboard-grid--lead-top">
    <%= turbo_frame_tag "admin_dashboard_charts", src: admin_dashboard_section_path("charts", dashboard_filter_params) do %>
      <%= render "admin/dashboard/sections/loading_panel",
                 title: "Leads - últimos 30 dias",
                 eyebrow: "Aquisição",
                 chart: true %>
    <% end %>

    <%= turbo_frame_tag "admin_dashboard_status", src: admin_dashboard_section_path("status", dashboard_filter_params) do %>
      <%= render "admin/dashboard/sections/loading_panel", title: "Leads por status", eyebrow: "Status", chart: true, compact: true %>
    <% end %>
  </div>

  <%= turbo_frame_tag "admin_dashboard_funnel", src: admin_dashboard_section_path("funnel", dashboard_filter_params) do %>
    <%= render "admin/dashboard/sections/loading_panel", title: "Conversão comercial", eyebrow: "Funil", rows: 4 %>
  <% end %>

  <%= turbo_frame_tag "admin_dashboard_acquisition", src: admin_dashboard_section_path("acquisition", dashboard_filter_params), loading: "lazy" do %>
    <%= render "admin/dashboard/sections/loading_panel", title: "Origem dos leads", eyebrow: "Aquisição", chart: true %>
  <% end %>

  <%= turbo_frame_tag "admin_dashboard_service", src: admin_dashboard_section_path("service", dashboard_filter_params), loading: "lazy" do %>
    <div class="ax-dashboard-grid ax-dashboard-grid--service">
      <%= render "admin/dashboard/sections/loading_panel", title: "SLA e fila de leads", eyebrow: "Atendimento", rows: 4 %>
      <%= render "admin/dashboard/sections/loading_panel", title: "Atendimento pelo inbox", eyebrow: "WhatsApp", rows: 3 %>
    </div>
  <% end %>

  <%= render "admin/dashboard/sections/rankings" %>
  <% end %>

  <% if @dashboard_tab == "properties" %>
  <div class="ax-dashboard-properties-top ax-dashboard-properties-top--stacked">
    <%= turbo_frame_tag "admin_dashboard_operations", src: admin_dashboard_section_path("operations", dashboard_filter_params), loading: "lazy" do %>
      <div class="ax-dashboard-grid ax-dashboard-grid--operations ax-dashboard-grid--single">
        <%= render "admin/dashboard/sections/loading_panel", title: "Qualidade e últimas atualizações", eyebrow: "Catálogo", table: true, rows: 6 %>
      </div>
    <% end %>

    <%= turbo_frame_tag "admin_dashboard_rankings", src: admin_dashboard_section_path("rankings", dashboard_filter_params), loading: "lazy" do %>
      <div class="ax-dashboard-grid ax-dashboard-grid--rankings ax-dashboard-grid--rankings-single">
        <%= render "admin/dashboard/sections/loading_panel", title: "Carteira por corretor", eyebrow: "Distribuição", rows: 5, compact: true %>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "admin_dashboard_support", src: admin_dashboard_section_path("support", dashboard_filter_params), loading: "lazy" do %>
    <div class="ax-dashboard-grid ax-dashboard-grid--support">
      <%= render "admin/dashboard/sections/loading_panel", title: "Últimas captações", eyebrow: "Captação", rows: 5 %>
      <%= render "admin/dashboard/sections/loading_panel", title: "Distribuição por categoria", eyebrow: "Mix", rows: 6 %>
    </div>
  <% end %>
  <% end %>

  <% if @dashboard_tab == "site" %>
    <%= turbo_frame_tag "admin_dashboard_site", src: admin_dashboard_section_path("site", dashboard_filter_params), loading: "lazy" do %>
      <div class="ax-dashboard-grid ax-dashboard-grid--site">
        <%= render "admin/dashboard/sections/loading_panel", title: "Navegação e conversões do site", eyebrow: "Site público", rows: 6 %>
        <%= render "admin/dashboard/sections/loading_panel", title: "Imóveis e buscas com atenção", eyebrow: "Intenção", rows: 6 %>
      </div>
    <% end %>
  <% end %>

  <% if @dashboard_tab == "field" && @field_feature_enabled %>
    <div class="ax-dashboard-grid ax-dashboard-grid--monitoring">
      <%= turbo_frame_tag "admin_dashboard_rankings", src: admin_dashboard_section_path("rankings", dashboard_filter_params), loading: "lazy" do %>
        <%= render "admin/dashboard/sections/loading_panel", title: "Top lojas por check-ins", eyebrow: "Campo", rows: 5 %>
      <% end %>
    </div>
    <%= turbo_frame_tag "admin_dashboard_operations", src: admin_dashboard_section_path("operations", dashboard_filter_params), loading: "lazy" do %>
      <%= render "admin/dashboard/sections/loading_panel", title: "Atividade recente", eyebrow: "Auditoria", rows: 6 %>
    <% end %>
  <% end %>
</section>
