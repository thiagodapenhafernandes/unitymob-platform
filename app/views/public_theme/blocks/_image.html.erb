<%# Bloco "Imagem": imagem com legenda e link opcionais. Sem imagem não mostra nada (na prévia do admin, um convite).
    Locals: block, variant. %>
<% image = block.image_desktop %>
<% if image.attached? || @preview_mode %>
  <figure class="public-theme-block-image public-theme-block-image--<%= variant %> is-fit-<%= block.value(:fit) %><%= " is-rounded" if block.value(:rounded) %><%= " is-empty" unless image.attached? %>">
    <div class="container-custom">
      <% if image.attached? %>
        <% picture = image_tag(public_image_url(image, **Storage::PublicImageVariants::BUILDER_CONTENT), alt: block.value(:alt).to_s, class: "public-theme-block-image__img", loading: "lazy") %>
        <%= block.value(:link).present? ? link_to(picture, block.value(:link), class: "public-theme-block-image__link") : picture %>
      <% else %>
        <div class="public-theme-block-image__placeholder"><i class="bi bi-card-image" aria-hidden="true"></i> Escolha a imagem deste bloco</div>
      <% end %>
      <% if block.value(:caption).present? %><figcaption data-element-field="caption" style="<%= landing_page_action_color_style(block.data, "element_caption") %>" class="public-theme-block-image__caption"><%= block.value(:caption) %></figcaption><% end %>
    </div>
  </figure>
<% end %>
