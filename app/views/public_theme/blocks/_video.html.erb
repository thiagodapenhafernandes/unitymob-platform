<% src = block.video_embed_url %>
<% if src || @preview_mode %>
  <figure class="public-theme-block-video public-theme-block-video--<%= variant %><%= " is-empty" unless src %>">
    <div class="container-custom">
      <div class="public-theme-block-video__frame">
        <% if src && @preview_mode %>
          <% if block.image_desktop.attached? %>
            <%= image_tag(public_image_url(block.image_desktop, **Storage::PublicImageVariants::BUILDER), alt: "", class: "public-theme-block-video__thumb") %>
          <% elsif block.youtube_id %>
            <img class="public-theme-block-video__thumb" src="https://img.youtube.com/vi/<%= block.youtube_id %>/hqdefault.jpg" alt="<%= block.value(:title) %>">
          <% else %>
            <div class="public-theme-block-video__placeholder">Vimeo · <%= block.value(:title).presence || block.vimeo_id %></div>
          <% end %>
          <span class="public-theme-block-video__play" aria-hidden="true"><i class="bi bi-play-fill"></i></span>
        <% elsif src && block.value(:click_to_play) %>
          <a class="public-theme-block-video__start" href="<%= src %>" data-controller="public-video" data-action="public-video#play" data-public-video-title-value="<%= block.value(:title).presence || "Vídeo" %>">
            <% if block.image_desktop.attached? %>
              <%= image_tag(public_image_url(block.image_desktop, **Storage::PublicImageVariants::BUILDER), alt: "", loading: "lazy", class: "public-theme-block-video__thumb") %>
            <% elsif block.youtube_id %>
              <img class="public-theme-block-video__thumb" src="https://img.youtube.com/vi/<%= block.youtube_id %>/hqdefault.jpg" alt="" loading="lazy">
            <% end %>
            <span class="public-theme-block-video__start-label"><i class="bi bi-play-circle" aria-hidden="true"></i> Reproduzir <%= block.value(:title).presence || "vídeo" %></span>
          </a>
        <% elsif src %>
          <iframe src="<%= src %>" title="<%= block.value(:title).presence || "Vídeo" %>" loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
                  allow="encrypted-media; picture-in-picture; fullscreen"></iframe>
        <% else %>
          <div class="public-theme-block-video__placeholder"><i class="bi bi-play-btn" aria-hidden="true"></i> Cole a URL do YouTube ou Vimeo</div>
        <% end %>
      </div>
      <% if block.value(:caption).present? %><figcaption data-element-field="caption" style="<%= landing_page_action_color_style(block.data, "element_caption") %>" class="public-theme-block-video__caption"><%= block.value(:caption) %></figcaption><% end %>
    </div>
  </figure>
<% end %>
