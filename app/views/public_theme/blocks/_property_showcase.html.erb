<%# Bloco "Vitrine de imóveis": lista de imóveis dos filtros do bloco. Com filtros do visitante ligados é a vitrine
    interativa da página (barra de filtros, drawer, ordem, paginação) — o modo que a landing sempre teve.
    Locals: block, page, variant, showcase (LandingPages::Showcase::Result), h1 (este bloco abre a página com o H1). %>
<%
  interactive = block.interactive_showcase?
  page_path = public_landing_page_path(page.slug)
  habitations = showcase.habitations
  heading = block.value(:heading).presence
  subtitle = block.value(:subtitle).presence
  selected_sort = params[:sort].presence || block.value(:sort).presence || "newest"
  sort_options = [["Mais recentes", "newest"], ["Maior valor", "price_desc"], ["Menor valor", "price_asc"]]
%>
<section class="public-theme-block-showcase public-theme-block-showcase--<%= variant %><%= " is-interactive" if interactive %>">
  <% if interactive %>
  <!-- Advanced Filters Sidebar (Off-canvas) -->
    <div data-advanced-filters-target="overlay" class="public-advanced-drawer-overlay fixed inset-0 bg-black/50 z-50 hidden transition-opacity duration-300" data-action="click->advanced-filters#close"></div>
    
    <div data-advanced-filters-target="sidebar" class="public-advanced-drawer fixed top-0 right-0 h-full w-full max-w-md bg-white z-50 transform translate-x-full transition-transform duration-300 shadow-2xl overflow-y-auto">
      <div class="p-6">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xl font-bold text-blue-three">Filtros Avançados</h3>
          <button type="button" data-action="click->advanced-filters#close" class="text-gray-400 hover:text-red-500 transition-colors">
            <i class="bi bi-x-lg text-xl"></i>
          </button>
        </div>
        
        <%= form_with url: page_path, method: :get, id: "advanced-filters-form" do |f| %>

          <%= render 'habitations/advanced_filters_fields', f: f %>

          <div class="sticky bottom-0 bg-white pt-4 pb-2 border-t border-gray-100">
            <button type="submit" class="w-full py-3 bg-blue-three text-white font-bold rounded-lg hover:bg-blue-one transition-colors shadow-lg">
              Aplicar Filtros
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Horizontal Filter Bar (TOP) -->
    <div class="bg-white border-b border-gray-200 sticky top-[72px] z-30 shadow-sm py-3">
      <div class="container-custom">
        <%= form_with url: page_path, method: :get, class: "flex flex-col gap-3" do |f| %>
          
          <div class="flex flex-wrap lg:flex-nowrap items-center gap-3 w-full">
            <%= render 'habitations/horizontal_filters_fields', f: f %>

            <!-- Submit Button -->
            <button type="submit" class="bg-blue-three hover:bg-blue-one text-white px-8 py-2.5 rounded-lg text-sm font-bold transition-colors flex items-center gap-2 shadow-sm whitespace-nowrap">
              <i class="bi bi-search"></i>
              Aplicar Filtros
            </button>
            
            <!-- Plus Button (Advanced Filters) -->
            <button type="button" 
                    data-action="click->advanced-filters#open"
                    class="w-10 h-10 flex items-center justify-center bg-white border border-gray-200 rounded-lg hover:border-blue-three hover:text-blue-three text-gray-500 transition-colors shadow-sm flex-shrink-0">
              <i class="bi bi-plus-lg text-lg"></i>
            </button>
          </div>

          <!-- Row 2: Quick Filter Chips -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
             <%= render 'habitations/quick_filter_chips' %>

            <!-- Clear Filters (Within context) -->
            <% if params.except(:controller, :action, :page, :slug).present? %>
              <%= link_to page_path, class: "flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-gray-400 hover:text-red-500 transition-colors ml-auto" do %>
                <i class="bi bi-x-circle"></i>
                Limpar refinamentos
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="public-theme-block-showcase__head bg-white border-b border-gray-100 py-6">
    <div class="container-custom">
      <% if h1 %>
        <div class="flex items-center gap-2 text-xs text-gray-400 mb-2 uppercase tracking-wide">
          <%= link_to "Início", root_path, class: "hover:text-blue-three" %>
          <i class="bi bi-chevron-right text-[10px]"></i>
          <span class="text-blue-three font-bold"><%= page.title %></span>
        </div>
      <% end %>

      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
          <% if h1 %>
            <h1 class="public-theme-block-showcase__title text-3xl font-extrabold text-blue-three mb-2"><%= page.title %></h1>
            <% if page.description.present? %><p class="public-theme-block-showcase__lead text-gray-500 max-w-2xl"><%= page.description %></p><% end %>
          <% elsif heading %>
            <h2 class="public-theme-block-showcase__title text-2xl font-extrabold text-blue-three mb-2"><%= heading %></h2>
            <% if subtitle %><p class="public-theme-block-showcase__lead text-gray-500 max-w-2xl"><%= subtitle %></p><% end %>
          <% end %>
          <% if block.value(:show_count) %>
            <div class="<%= "mt-4 " if h1 || heading %>flex items-center gap-2">
              <span class="public-theme-block-showcase__count px-3 py-1 bg-blue-50 text-blue-three text-sm font-bold rounded-full">
                <%= showcase.total %> <%= showcase.total == 1 ? "imóvel encontrado" : "imóveis encontrados" %>
              </span>
            </div>
          <% end %>
        </div>

        <% if interactive %>
          <div class="flex items-center gap-2 self-end">
            <label for="showcase-sort-<%= block.id %>" class="text-sm text-gray-500 font-medium">Ordenar por:</label>
            <select id="showcase-sort-<%= block.id %>" class="public-theme-block-showcase__sort form-select border border-gray-200 rounded-lg text-sm font-bold text-blue-three cursor-pointer py-2 pl-3 pr-10" onchange="window.location = this.value">
              <% sort_options.each do |label, value| %>
                <option value="<%= public_landing_page_path(page.slug, request.query_parameters.merge(sort: value, page: nil).compact_blank) %>" <%= "selected" if selected_sort == value %>><%= label %></option>
              <% end %>
            </select>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="public-theme-block-showcase__results bg-gray-50 py-8">
    <div class="container-custom">
      <% if habitations.any? %>
        <%= theme_component(:property_grid, properties: habitations) %>
        <% if interactive %>
          <div class="flex justify-center mt-8">
            <%= theme_component(:pagination, collection: habitations, path_helper: ->(number) { public_landing_page_path(page.slug, request.query_parameters.merge(page: number).compact_blank) }) %>
          </div>
        <% end %>
      <% else %>
        <div class="public-theme-block-showcase__empty bg-white rounded-xl border border-gray-200 p-16 text-center max-w-2xl mx-auto">
          <div class="w-20 h-20 mx-auto mb-6 bg-gray-50 rounded-full flex items-center justify-center">
            <i class="bi bi-search text-3xl text-gray-400"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Nenhum imóvel encontrado</h3>
          <p class="text-gray-500 mb-8"><%= interactive ? "Tente ajustar seus filtros de busca ou remover refinamentos." : "Em breve novos imóveis nesta seleção." %></p>
          <% if interactive && params.except(:controller, :action, :page, :slug).present? %>
            <%= link_to "Ver todos desta página", page_path, class: "btn-primary inline-flex items-center gap-2" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
