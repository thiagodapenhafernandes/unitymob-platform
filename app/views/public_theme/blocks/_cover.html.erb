<%# Bloco "Capa": faixa de abertura com título (H1 quando é o primeiro bloco), subtítulo, imagem e botão.
    Locals: block, page, variant, h1. %>
<%
  title = block.value(:title).presence || page.title
  desktop = block.image_desktop
  mobile = block.image_mobile
%>
<section data-block-position="<%= block.position %>" class="public-theme-block-cover public-theme-block-cover--<%= variant %> is-align-<%= block.value(:align) %><%= " has-image" if desktop.attached? %>"
         style="--cover-overlay: <%= (block.value(:overlay).to_i / 100.0).round(2) %>">
  <% if desktop.attached? %>
    <picture class="public-theme-block-cover__media">
      <% if mobile.attached? %><source media="(max-width: 768px)" srcset="<%= url_for(mobile.variant(resize_to_limit: [900, 1300])) %>"><% end %>
      <%= image_tag desktop.variant(resize_to_limit: [1920, 1000]), alt: "", class: "public-theme-block-cover__image", loading: (h1 ? "eager" : "lazy") %>
    </picture>
  <% end %>
  <div class="public-theme-block-cover__inner">
    <%= content_tag(h1 ? :h1 : :h2, title, class: "public-theme-block-cover__title") %>
    <% if block.value(:subtitle).present? %><p class="public-theme-block-cover__subtitle"><%= block.value(:subtitle) %></p><% end %>
    <% if block.value(:button_label).present? && block.value(:button_url).present? %>
      <a href="<%= block.value(:button_url) %>" class="public-theme-block-cover__button"><%= block.value(:button_label) %></a>
    <% end %>
  </div>
</section>
