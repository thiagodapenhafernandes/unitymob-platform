<%# Hero luxury da home com dados da plataforma (sem CMS de blocos). %>
<%
  luxury_hero_images = Array(@hero_images)
  luxury_first_hero = luxury_hero_images.first || {}
  luxury_hero_src = luxury_first_hero[:source] || luxury_first_hero["source"]
  luxury_hero_mobile_src = luxury_first_hero[:mobile_source] || luxury_first_hero["mobile_source"] || luxury_hero_src
  luxury_hero_bg = public_image_url(luxury_hero_src, resize_to_limit: [1920, 1080], format: :webp, force_variant: true, representation_proxy: true).presence || public_image_url(luxury_hero_src).presence || luxury_hero_src
  luxury_hero_mobile = public_image_url(luxury_hero_mobile_src, resize_to_limit: [900, 1600], format: :webp, force_variant: true, representation_proxy: true).presence || public_image_url(luxury_hero_mobile_src).presence || luxury_hero_mobile_src
%>
<%= render layout: "public_theme/components/hero",
      locals: {
        id: "top",
        variant: "salute-luxury",
        class_name: "sl-hero",
        container_class: "sl-container",
        inner_class: "public-theme-hero__copy sl-hero__inner",
        background_url: luxury_hero_bg,
        background_mobile_srcset: luxury_hero_mobile,
        background_sizes: "100vw",
        background_alt: "",
        background_class: "public-theme-hero__bg sl-hero__bg",
        overlay_classes: ["public-theme-hero__overlay sl-hero__grade", "sl-hero__pattern"],
        tagline_class: "sl-tagline",
        title: @home_setting.hero_title,
        lead: @home_setting.hero_subtitle,
        lead_class: "sl-lead"
      } do %>
  <%= render "public_theme/components/transaction_switch",
        variant: "salute-luxury",
        class_name: "sl-transaction hero-cta",
        button_class: "public-theme-button sl-transaction__button btn fin",
        action: "click->salute-luxury-theme#setTransaction",
        default_value: "venda",
        options: [
          { label: "Comprar", value: "venda" },
          { label: "Alugar", value: "aluguel" }
        ] %>
  <%= render "public_theme/components/search_form",
        url: habitations_path,
        variant: "salute-luxury",
        class_name: "public-theme-search public-theme-hero__search sl-search search",
        property_types: Array(@property_types),
        location_options: Array(@location_options),
        price_options: public_price_range_options,
        transaction_default: "venda" %>
<% end %>
