<%# Hero "Barra": título e uma barra de busca em linha (Comprar/Alugar, localização, tipo, dormitórios e busca livre).
    Contrato: .public-theme-hero-bar(--<variante>) com __container, __inner, __search, __tabs, __tab, __field, __control,
    __submit e __detail (localização, tipo e dormitórios usam o combobox, com autocomplete); posição horizontal via is-align-left|center|right. O tema só estiliza a variante.
    Locals: variant. %>
<%
  align = @home_setting.hero_search_align
%>
<%= render layout: "public_theme/components/hero",
      locals: hero_background_locals.merge(
        id: "hero", variant: variant,
        class_name: "public-theme-hero-bar public-theme-hero-bar--#{variant} is-align-#{align}",
        container_class: "public-theme-hero-bar__container",
        inner_class: "public-theme-hero-bar__inner",
        overlay_classes: ["public-theme-hero-bar__overlay"],
        background_class: "public-theme-hero-bar__media",
        style: hero_layout_style,
        title: @home_setting.hero_title,
        lead: @home_setting.hero_subtitle
      ) do %>
  <%= render "public_theme/components/hero_bar_search", variant: variant %>
<% end %>
