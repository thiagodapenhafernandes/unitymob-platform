<%# Cartão de localização — mesmo HTML em todos os temas (contrato
    public-theme-property-map__*); cada tema estiliza a variante. Alvos do
    controller public-property-map ficam no wrapper da página. %>
<%
  public_map = local_assigns.fetch(:public_map)
  map_class = ["public-theme-property-map", "public-theme-property-map--#{local_assigns.fetch(:variant, "default")}", local_assigns[:class_name]].compact.join(" ")
  place_label = local_assigns[:place_label]
  radius = public_map.radius_meters.to_i
  map_note = if public_map.approximate?
    radius.positive? ? "Região aproximada, num raio de #{radius} m" : "Região aproximada do imóvel"
  else
    "Localização do imóvel"
  end
  external_label = public_map.provider == "google" ? "Abrir no Google Maps" : "Abrir no mapa"
%>

<% if public_map.visible? %>
  <section id="<%= local_assigns.fetch(:id, "localizacao-imovel") %>" class="<%= map_class %>">
    <header class="public-theme-property-map__heading">
      <span class="public-theme-property-map__eyebrow">Localização</span>
      <h3 class="public-theme-property-map__title"><%= place_label.presence || "Onde fica" %></h3>
      <p class="public-theme-property-map__note"><%= public_icon(public_map.approximate? ? "bullseye" : "geo-alt") %><%= map_note %></p>
    </header>

    <div class="public-theme-property-map__tabs" role="tablist" aria-label="Visualização da localização">
      <button type="button" class="public-theme-property-map__tab is-active" role="tab" aria-selected="true" data-public-property-map-target="mapButton" data-action="click->public-property-map#showMap"><%= public_icon("map") %>Mapa</button>
      <% if public_map.satellite_enabled? %>
        <button type="button" class="public-theme-property-map__tab" role="tab" aria-selected="false" data-public-property-map-target="satelliteButton" data-action="click->public-property-map#toggleSatellite"><%= public_icon("globe-americas") %>Satélite</button>
      <% end %>
      <% if public_map.street_view_enabled? %>
        <button type="button" class="public-theme-property-map__tab" role="tab" aria-selected="false" data-public-property-map-target="streetViewButton" data-action="click->public-property-map#showStreetView"><%= public_icon("person-standing") %>Rua</button>
      <% end %>
    </div>

    <div class="public-theme-property-map__shell" data-public-property-map-target="shell">
      <span class="public-theme-property-map__loader" data-public-property-map-target="loader" aria-hidden="true" hidden></span>
      <div class="public-theme-property-map__canvas"
           data-public-property-map-target="map"
           aria-label="<%= public_map.approximate? ? "Mapa com região aproximada do imóvel" : "Mapa com localização do imóvel" %>"></div>
      <% if public_map.street_view_enabled? %>
        <div class="public-theme-property-map__canvas public-theme-property-map__canvas--street"
             data-public-property-map-target="streetView"
             hidden
             aria-label="Vista da rua do imóvel"></div>
      <% end %>
    </div>

    <% if public_map.external_url.present? %>
      <%= link_to public_map.external_url, class: "public-theme-property-map__external", target: "_blank", rel: "noopener noreferrer" do %>
        <%= external_label %>
        <%= public_icon("arrow-up-right") %>
      <% end %>
    <% end %>
  </section>
<% elsif public_map.display_mode != "hidden" && place_label.present? %>
  <%# Sem coordenadas: mostra a região em texto, sem mapa. %>
  <section id="endereco-imovel" class="<%= map_class %> public-theme-property-map--without-map">
    <header class="public-theme-property-map__heading">
      <span class="public-theme-property-map__eyebrow">Localização</span>
      <h3 class="public-theme-property-map__title"><%= place_label %></h3>
      <p class="public-theme-property-map__note"><%= public_icon("geo-alt") %><%= public_map.display_mode == "exact" ? "Endereço do imóvel" : "Região do imóvel" %></p>
    </header>
  </section>
<% end %>
