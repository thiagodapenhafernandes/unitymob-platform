<%# Detalhe do empreendimento (default) — contrato: .public-theme-development-
    about/features/location/units (+ --<variante>). Variants mantêm os ganchos. %>
<div class="public-development-show bg-gray-50 min-h-screen">
  
  <!-- Hero Section with Background Image -->
  <% hero_image_source = @habitation.all_images.first %>
  <%# resize_to_limit (sem crop forçado): fotos de empreendimento costumam ser
      verticais, e um crop paisagem fixo cortava o prédio e ainda esticava o
      resultado, perdendo qualidade. Mesma caixa (1920x1080) já usada pelo
      hero do tema luxury, e já aquecida pelo Storage::WarmPublicVariantsJob. %>
  <% hero_image = public_image_url(hero_image_source, resize_to_limit: [1920, 1080], format: :webp) if hero_image_source %>
  <% hero_image_srcset = public_image_srcset(hero_image_source, widths: [640, 960, 1400, 1920], aspect_ratio: 1920.0 / 1080, format: :webp) if hero_image_source %>
  <div class="public-development-show__hero relative h-[60vh] min-h-[500px] bg-cover bg-center mt-[72px] <%= 'bg-gradient-to-br from-blue-three to-blue-one' unless hero_image %>"
       <%= "data-controller=\"public-hero-tint\"".html_safe if hero_image.present? %>>
    <% if hero_image.present? %>
      <%# Fundo desfocado (a partir do desktop): em vez de cortar a foto
          vertical com cover, ela aparece inteira (object-contain) e o vão das
          laterais recebe a mesma imagem ampliada e borrada — como
          WhatsApp/Instagram fazem com mídia vertical numa moldura larga.
          crossorigin: necessário pro public-hero-tint ler os pixels e extrair
          a cor média da foto (o Spaces já libera CORS pro nosso domínio). %>
      <%= image_tag hero_image,
          alt: "",
          aria: { hidden: true },
          crossorigin: "anonymous",
          class: "public-development-show__hero-blur hidden lg:block absolute inset-0 h-full w-full object-cover blur-2xl scale-[1.15]",
          loading: "lazy",
          decoding: "async" %>
      <%= image_tag hero_image,
          alt: development_name,
          crossorigin: "anonymous",
          data: { public_hero_tint_target: "source" },
          class: "absolute inset-0 h-full w-full object-cover lg:object-contain",
          fetchpriority: "high",
          loading: "eager",
          decoding: "async",
          srcset: hero_image_srcset,
          sizes: "100vw" %>
      <%# Camada de contraste entre a foto e o texto: gradiente mais escuro
          onde o texto fica (esquerda/embaixo), mais claro no resto, tingido
          pela cor média da própria foto (public-hero-tint) em vez de um véu
          sempre com a mesma cor fixa. %>
      <div class="public-development-show__hero-scrim absolute inset-0"></div>
    <% end %>
    <div class="absolute inset-0 flex items-center">
      <div class="container-custom">
        <div class="public-development-show__hero-content max-w-4xl text-white">
          <!-- Breadcrumb -->
          <div class="public-development-show__breadcrumb flex items-center gap-2 text-sm mb-6 text-white/80">
            <%= link_to "Início", root_path, class: "hover:text-golden-one transition" %>
            <i class="bi bi-chevron-right text-xs"></i>
            <%= link_to "Empreendimentos", habitations_path(category: 'Empreendimento'), class: "hover:text-golden-one transition" %>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-golden-one font-semibold"><%= @habitation.nome_empreendimento %></span>
          </div>

          <h1 class="public-development-show__title text-4xl lg:text-5xl font-bold mb-4">
            <%= @habitation.nome_empreendimento %>
          </h1>

          <% if @habitation.public_rating_configured? %>
            <div class="public-development-show__rating mb-5 flex flex-wrap items-center gap-2 text-sm font-semibold text-white">
              <span class="inline-flex items-center gap-1 text-golden-one" aria-label="Avaliação <%= public_rating_value_label(@habitation) %> de 5">
                <% public_rating_star_icon_names(@habitation).each do |icon_name| %>
                  <i class="bi <%= icon_name %>" aria-hidden="true"></i>
                <% end %>
              </span>
              <span><%= public_rating_value_label(@habitation) %></span>
              <span class="text-white/70">(<%= public_rating_count_label(@habitation) %>)</span>
            </div>
          <% end %>
          
          <div class="public-development-show__hero-meta flex flex-wrap items-center gap-6 mb-8">
            <div class="public-development-show__hero-meta-item flex items-center gap-2">
              <i class="bi bi-geo-alt text-golden-one text-xl"></i>
              <span class="text-lg"><%= [@habitation.public_neighborhood, @habitation.cidade].compact.join(' - ') %>, <%= @habitation.uf %></span>
            </div>
            
            <div class="public-development-show__availability flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
              <i class="bi bi-building text-golden-one text-xl"></i>
              <span class="font-bold"><%= @development_units.count %> <%= @development_units.count == 1 ? 'unidade disponível' : 'unidades disponíveis' %></span>
            </div>
          </div>

          <div class="public-development-show__hero-actions flex flex-wrap gap-4">
            <button type="button"
                class="public-development-show__cta public-development-show__cta--primary inline-flex items-center gap-2 px-8 py-4 bg-golden-one text-blue-three font-bold rounded-lg hover:bg-golden-two transition-all shadow-lg"
                data-action="click->lead-capture#open"
                data-property-id="<%= @habitation.id %>"
                data-property-code="<%= @habitation.codigo %>"
                data-property-title="<%= @habitation.nome_empreendimento %>"
                data-negotiation-type="<%= @habitation.whatsapp_negotiation_type %>"
                data-whatsapp-message="Olá, gostaria de saber mais sobre o empreendimento <%= @habitation.nome_empreendimento %>">
              <i class="bi bi-whatsapp text-xl"></i>
              <span>Fale Conosco</span>
            </button>
            
            <% if @habitation.tour_virtual.present? %>
              <%= link_to @habitation.tour_virtual,
                  target: "_blank",
                  class: "public-development-show__cta public-development-show__cta--ghost inline-flex items-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm text-white font-bold rounded-lg hover:bg-white/20 transition-all border-2 border-white/30" do %>
                <i class="bi bi-camera-video text-xl"></i>
                <span>Tour Virtual</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Unit Statistics Bar -->
  <% if @development_units.any? %>
    <div class="public-development-show__stats bg-white border-y border-gray-100 py-6">
      <div class="container-custom">
        <div class="public-development-show__stats-grid grid grid-cols-2 md:grid-cols-4 gap-6">
          
          <!-- Dormitórios -->
          <% 
            dorms = @development_units.map(&:dormitorios_qtd).compact.reject(&:zero?)
            if dorms.any?
              min_dorms = dorms.min
              max_dorms = dorms.max
          %>
            <div class="public-development-show__stat flex items-center gap-3">
              <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
                <i class="bi bi-door-closed text-blue-three text-2xl"></i>
              </div>
              <div>
                <p class="text-2xl font-bold text-gray-900">
                  <%= min_dorms == max_dorms ? min_dorms : "#{min_dorms} ou #{max_dorms}" %>
                </p>
                <p class="text-xs text-gray-500 uppercase tracking-wide">
                  <%= min_dorms == max_dorms && min_dorms == 1 ? 'Dormitório' : 'Dormitórios' %>
                </p>
              </div>
            </div>
          <% end %>
          
          <!-- Suítes -->
          <% 
            suites = @development_units.map(&:suites_qtd).compact.reject(&:zero?)
            if suites.any?
              min_suites = suites.min
              max_suites = suites.max
          %>
            <div class="public-development-show__stat flex items-center gap-3">
              <div class="w-12 h-12 bg-golden-50 rounded-lg flex items-center justify-center">
                <i class="bi bi-house-door text-golden-one text-2xl"></i>
              </div>
              <div>
                <p class="text-2xl font-bold text-gray-900">
                  <%= min_suites == max_suites ? min_suites : "#{min_suites} ou #{max_suites}" %>
                </p>
                <p class="text-xs text-gray-500 uppercase tracking-wide">
                  <%= min_suites == max_suites && min_suites == 1 ? 'Suíte' : 'Suítes' %>
                </p>
              </div>
            </div>
          <% end %>
          
          <!-- Área -->
          <% 
            areas = @development_units.filter_map(&:public_area_m2)
            if areas.any?
              min_area = areas.min.to_i
              max_area = areas.max.to_i
          %>
            <div class="public-development-show__stat flex items-center gap-3">
              <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
                <i class="bi bi-rulers text-blue-three text-2xl"></i>
              </div>
              <div>
                <p class="text-2xl font-bold text-gray-900">
                  <%= min_area == max_area ? "#{min_area}m²" : "#{min_area}m² a #{max_area}m²" %>
                </p>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Área privativa</p>
              </div>
            </div>
          <% end %>
          
          <!-- Vagas -->
          <% 
            vagas = @development_units.map(&:vagas_qtd).compact.reject(&:zero?)
            if vagas.any?
              min_vagas = vagas.min
              max_vagas = vagas.max
          %>
            <div class="public-development-show__stat flex items-center gap-3">
              <div class="w-12 h-12 bg-golden-50 rounded-lg flex items-center justify-center">
                <i class="bi bi-car-front text-golden-one text-2xl"></i>
              </div>
              <div>
                <p class="text-2xl font-bold text-gray-900">
                  <%= min_vagas == max_vagas ? min_vagas : "#{min_vagas} ou #{max_vagas}" %>
                </p>
                <p class="text-xs text-gray-500 uppercase tracking-wide">
                  <%= min_vagas == max_vagas && min_vagas == 1 ? 'Vaga' : 'Vagas' %>
                </p>
              </div>
            </div>
          <% end %>
          
        </div>
      </div>
    </div>
  <% end %>

  <!-- Available Units: título em largura total (garante que cards e o bloco de
       contato comecem na mesma altura) + cards em até 2 colunas + "Interessado?"
       (com Informações/Compartilhar/corretor) numa 3ª coluna, sticky. -->
  <div class="public-development-show__units-wrap container-custom">
    <h2 class="public-development-show__section-title public-development-show__units-title text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
      <div class="w-1 h-8 bg-golden-one rounded"></div>
      Unidades Disponíveis
      <span class="ml-auto text-base text-gray-500 font-normal">
        <%= @development_units.count %> <%= @development_units.count == 1 ? 'unidade' : 'unidades' %>
      </span>
    </h2>

    <% units_initial_batch = 6 %>
    <% units_paginated = @development_units.size > units_initial_batch %>
    <div class="public-development-show__units-layout grid grid-cols-1 lg:grid-cols-3 gap-8">
      <section class="public-theme-development-units public-theme-development-units--default public-development-show__units lg:col-span-2"
                <% if units_paginated %>
                  data-controller="public-progressive-reveal"
                  data-public-progressive-reveal-batch-size-value="<%= units_initial_batch %>"
                <% end %>>
        <% if @development_units.any? %>
          <!-- Scroll infinito: unidades além das 6 iniciais já estão no HTML
               (mesmos dados usados nas estatísticas do topo), só ficam ocultas
               até o visitante chegar perto do fim da lista. -->
          <div class="public-development-show__units-grid grid grid-cols-1 md:grid-cols-2 gap-6">
            <% @development_units.each_with_index do |unit, index| %>
              <div data-public-progressive-reveal-target="item"<%= " hidden".html_safe if index >= units_initial_batch %>>
                <%= render 'shared/tailwind/property_card', property: unit, priority_image: index < 2 %>
              </div>
            <% end %>
          </div>

          <% if units_paginated %>
            <div class="public-development-show__units-sentinel flex items-center justify-center gap-2 py-8 text-sm font-semibold text-gray-500"
                 data-public-progressive-reveal-target="sentinel">
              <i class="bi bi-arrow-repeat animate-spin text-golden-one" aria-hidden="true"></i>
              Carregando mais unidades…
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-12">
            <i class="bi bi-inbox text-6xl text-gray-300 mb-4"></i>
            <p class="text-gray-500">Nenhuma unidade disponível no momento.</p>
          </div>
        <% end %>
      </section>

      <!-- Interessado? + Informações + Compartilhar (e corretor, quando houver):
           tudo junto, sticky, começando na mesma altura dos cards. -->
      <aside class="public-development-show__units-aside lg:col-span-1">
        <div class="public-development-show__units-aside-stack lg:sticky lg:top-24 space-y-6">
          <% if @shared_broker.present? %>
            <%= render "habitations/shared_broker_card",
                shared_broker: @shared_broker,
                habitation: @habitation,
                share_token: @lead_share_token %>
          <% end %>

          <!-- Contact Card -->
          <div class="public-development-show__contact-card bg-gradient-to-br from-blue-three to-blue-one rounded-xl shadow-lg p-6 text-white">
            <h3 class="text-xl font-bold mb-4">Interessado?</h3>
            <p class="text-white/90 text-sm mb-6">Fale com um especialista e receba atendimento personalizado</p>

            <button type="button"
                class="public-development-show__cta public-development-show__cta--contact w-full bg-white text-blue-three font-bold py-3 px-4 rounded-lg hover:bg-gray-100 transition-colors flex items-center justify-center gap-2 mb-3"
                data-action="click->lead-capture#open"
                data-property-id="<%= @habitation.id %>"
                data-property-code="<%= @habitation.codigo %>"
                data-property-title="<%= @habitation.nome_empreendimento %>"
                data-negotiation-type="<%= @habitation.whatsapp_negotiation_type %>"
                data-whatsapp-message="Olá, gostaria de saber mais sobre o empreendimento <%= @habitation.nome_empreendimento %>">
              <i class="bi bi-whatsapp text-green-500 text-xl"></i>
              Falar no WhatsApp
            </button>

            <%= link_to "tel:+554733111067",
                class: "public-development-show__cta public-development-show__cta--contact-ghost w-full bg-white/10 backdrop-blur-sm text-white font-bold py-3 px-4 rounded-lg hover:bg-white/20 transition-colors flex items-center justify-center gap-2 mb-3" do %>
              <i class="bi bi-telephone text-golden-one"></i>
              (47) 3311-1067
            <% end %>

            <button type="button"
                class="public-development-show__cta public-development-show__cta--contact-ghost w-full bg-white/10 backdrop-blur-sm text-white font-bold py-3 px-4 rounded-lg hover:bg-white/20 transition-colors flex items-center justify-center gap-2"
                data-action="click->lead-capture#open"
                data-property-id="<%= @habitation.id %>"
                data-property-code="<%= @habitation.codigo %>"
                data-property-title="<%= @habitation.nome_empreendimento %>"
                data-negotiation-type="<%= @habitation.whatsapp_negotiation_type %>"
                data-whatsapp-message="Gostaria de agendar uma visita para <%= @habitation.nome_empreendimento %>">
              <i class="bi bi-calendar-check text-golden-one"></i>
              Agendar Visita
            </button>
          </div>

          <!-- Info Card -->
          <div class="public-development-show__info-card bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-4">Informações</h3>

            <div class="space-y-3 text-sm">
              <div class="flex justify-between py-2 border-b border-gray-100">
                <span class="text-gray-500">Código:</span>
                <span class="font-semibold text-gray-900"><%= @habitation.codigo %></span>
              </div>

              <% if @habitation.constructor_name.present? %>
                <div class="flex justify-between py-2 border-b border-gray-100">
                  <span class="text-gray-500">Construtora:</span>
                  <span class="font-semibold text-gray-900"><%= @habitation.constructor_name %></span>
                </div>
              <% end %>

              <% if @habitation.delivery_date_visible? %>
                <div class="flex justify-between py-2 border-b border-gray-100">
                  <span class="text-gray-500">Previsão de entrega:</span>
                  <span class="font-semibold text-gray-900"><%= l(@habitation.data_entrega, format: :long) %></span>
                </div>
              <% elsif @habitation.data_entrega.present? && @habitation.ready_to_move? %>
                <div class="flex justify-between py-2 border-b border-gray-100">
                  <span class="text-gray-500">Situação:</span>
                  <span class="font-semibold text-gray-900">Pronto para morar</span>
                </div>
              <% end %>

              <% if @habitation.aptos_andar.to_i > 0 %>
                <div class="flex justify-between py-2 border-b border-gray-100">
                  <span class="text-gray-500">Aptos por Andar:</span>
                  <span class="font-semibold text-gray-900"><%= @habitation.aptos_andar %></span>
                </div>
              <% end %>

              <% if @habitation.aptos_edificio.to_i > 0 %>
                <div class="flex justify-between py-2 border-b border-gray-100">
                  <span class="text-gray-500">Total de Aptos:</span>
                  <span class="font-semibold text-gray-900"><%= @habitation.aptos_edificio %></span>
                </div>
              <% end %>

              <div class="flex justify-between py-2">
                <span class="text-gray-500">Unidades:</span>
                <span class="font-semibold text-gray-900"><%= @development_units.count %> disponíveis</span>
              </div>
            </div>
          </div>

          <!-- Share Card -->
          <div class="public-development-show__share-card bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-4">Compartilhar</h3>
            <%= render "shared/broker_share_menu", property: @habitation %>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Main Content: Sobre / Características / Localização / FAQ, sem sidebar
       (tudo já subiu para junto de Unidades Disponíveis), largura total. -->
  <div class="public-development-show__content container-custom py-12">
    <div class="public-development-show__main space-y-12">
        <section class="public-development-show__section public-development-show__seo-summary bg-gradient-to-br from-blue-50/70 via-white to-white rounded-xl shadow-sm p-8 border border-blue-100">
          <span class="public-development-show__seo-summary-badge inline-flex items-center gap-1.5 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_12%,#fff)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-golden-one mb-4">
            <i class="bi bi-stars" aria-hidden="true"></i>
            Empreendimento em destaque
          </span>

          <h2 class="public-development-show__section-title public-development-show__seo-summary-title text-xl md:text-2xl font-bold text-gray-900 mb-3 leading-snug">
            <%= development_name %><%= " em #{development_full_location}" if development_full_location.present? %>
          </h2>

          <% if development_summary.present? %>
            <p class="public-development-show__seo-summary-text text-gray-600 leading-relaxed max-w-3xl"><%= development_summary %></p>
          <% end %>

          <% if development_summary_metrics.any? %>
            <div class="public-development-show__seo-summary-metrics grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
              <% metric_icons = %w[rulers door-closed car-front] %>
              <% development_summary_metrics.each_with_index do |metric, index| %>
                <div class="public-development-show__seo-summary-metric flex items-center gap-2.5 rounded-lg border border-blue-100 bg-white/80 px-4 py-3">
                  <i class="bi bi-<%= metric_icons[index] || 'check2-circle' %> text-golden-one text-lg" aria-hidden="true"></i>
                  <span class="text-sm font-semibold text-blue-three"><%= metric %></span>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="flex flex-wrap gap-3 mt-6">
            <% if @habitation.cidade.present? && development_city_path.present? %>
              <%= link_to development_city_path,
                  class: "public-development-show__seo-summary-link inline-flex items-center gap-2 rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-blue-three hover:bg-blue-50 hover:border-blue-200 transition" do %>
                Empreendimentos em <%= @habitation.cidade %>
                <i class="bi bi-arrow-right text-xs" aria-hidden="true"></i>
              <% end %>
            <% end %>
            <% if @habitation.public_neighborhood.present? && development_neighborhood_path.present? %>
              <%= link_to development_neighborhood_path,
                  class: "public-development-show__seo-summary-link inline-flex items-center gap-2 rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-blue-three hover:bg-blue-50 hover:border-blue-200 transition" do %>
                Empreendimentos em <%= @habitation.public_neighborhood %>
                <i class="bi bi-arrow-right text-xs" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </div>
        </section>

        <!-- Photo Gallery: menos fotos visíveis, clique abre a galeria completa
             (mesmo padrão de galeria + swipe mobile da página do imóvel). -->
        <% gallery_images = @habitation.all_images %>
        <% if gallery_images.size > 1 %>
          <div class="public-development-show__gallery-wrap" data-controller="fancybox-gallery">
            <section class="public-development-show__gallery relative overflow-hidden rounded-2xl bg-white shadow-[0_18px_45px_rgba(15,23,42,0.1)]"
                     data-controller="public-gallery-mobile"
                     data-public-gallery-mobile-property-id-value="<%= @habitation.id %>">
              <div class="public-development-show__gallery-grid grid h-[300px] grid-cols-1 gap-2 sm:h-[360px] lg:h-[420px] lg:grid-cols-[1.08fr_1fr]">
                <a href="<%= public_image_url(gallery_images.first) %>"
                   data-fancybox="property-gallery"
                   data-caption="<%= development_name %> - Foto 1"
                   data-public-gallery-mobile-src="<%= public_image_url(gallery_images.first, resize_to_limit: [1200, 900], format: :webp) %>"
                   data-public-gallery-mobile-srcset="<%= public_image_srcset(gallery_images.first, widths: [480, 800, 1200], aspect_ratio: 4.0 / 3, format: :webp) %>"
                   data-public-gallery-mobile-sizes="100vw"
                   data-public-gallery-mobile-class="<%= public_gallery_image_class(gallery_images.first) %>"
                   data-public-gallery-mobile-style="<%= public_gallery_image_style(gallery_images.first, primary: true) %>"
                   class="public-development-show__gallery-primary relative block h-full overflow-hidden bg-gray-100">
                  <%= image_tag public_image_url(gallery_images.first, resize_to_limit: [1200, 900], format: :webp),
                      alt: "#{development_name} - Foto 1",
                      class: "h-full w-full object-cover transition-transform duration-700 hover:scale-105 #{public_gallery_image_class(gallery_images.first)}",
                      data: { public_gallery_mobile_target: "primaryImage" },
                      fetchpriority: "high",
                      loading: "eager",
                      decoding: "async",
                      width: 960,
                      height: 720,
                      srcset: public_image_srcset(gallery_images.first, widths: [480, 800, 1200], aspect_ratio: 4.0 / 3, format: :webp),
                      sizes: "100vw" %>
                </a>

                <div class="public-development-show__gallery-thumbs hidden grid-cols-2 gap-2 lg:grid">
                  <% gallery_images.drop(1).first(4).each_with_index do |photo, index| %>
                    <a href="<%= public_image_url(photo) %>"
                       data-fancybox="property-gallery"
                       data-caption="<%= development_name %> - Foto <%= index + 2 %>"
                       data-public-gallery-mobile-src="<%= public_image_url(photo, resize_to_limit: [1200, 900], format: :webp) %>"
                       data-public-gallery-mobile-srcset="<%= public_image_srcset(photo, widths: [480, 800, 1200], aspect_ratio: 4.0 / 3, format: :webp) %>"
                       data-public-gallery-mobile-sizes="100vw"
                       data-public-gallery-mobile-class="<%= public_gallery_image_class(photo) %>"
                       data-public-gallery-mobile-style="<%= public_gallery_image_style(photo, primary: true) %>"
                       class="public-development-show__gallery-thumb relative block overflow-hidden bg-gray-100">
                      <%= image_tag public_image_url(photo, resize_to_fill: [720, 520], format: :webp),
                          alt: "#{development_name} - Foto #{index + 2}",
                          class: "h-full w-full object-cover transition-transform duration-700 hover:scale-105 #{public_gallery_image_class(photo)}",
                          loading: "lazy",
                          decoding: "async",
                          width: 520,
                          height: 360,
                          srcset: public_image_srcset(photo, widths: [360, 520, 720], aspect_ratio: 720.0 / 520, crop: true, format: :webp),
                          sizes: "24vw" %>
                    </a>
                  <% end %>
                </div>
              </div>

              <% gallery_images.drop(5).each_with_index do |photo, index| %>
                <a href="<%= public_image_url(photo) %>"
                   data-fancybox="property-gallery"
                   data-caption="<%= development_name %> - Foto <%= index + 6 %>"
                   data-public-gallery-mobile-src="<%= public_image_url(photo) %>"
                   data-public-gallery-mobile-sizes="100vw"
                   data-public-gallery-mobile-class="<%= public_gallery_image_class(photo) %>"
                   data-public-gallery-mobile-style="<%= public_gallery_image_style(photo, primary: true) %>"
                   class="hidden"></a>
              <% end %>
            </section>

            <button type="button" class="public-development-show__gallery-count" data-gallery-open>
              <i class="bi bi-images" aria-hidden="true"></i>
              Ver <%= gallery_images.size %> fotos
            </button>
          </div>
        <% end %>

        <!-- About Section -->
        <% description_content = @habitation.display_description %>
        <% if description_content.present? %>
          <section class="public-theme-development-about public-theme-development-about--default public-development-show__section public-development-show__about bg-white rounded-xl shadow-sm p-8 border border-blue-100">
            <h2 class="public-development-show__section-title text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <div class="w-1 h-8 bg-golden-one rounded"></div>
              <i class="bi bi-info-circle-fill text-blue-three"></i>
              Sobre o Empreendimento
            </h2>
            <% description_id = dom_id(@habitation, :public_development_description) %>
            <div class="public-collapsible-text public-development-show__prose rounded-lg bg-gradient-to-br from-blue-50 to-white border border-blue-100 p-5 prose prose-lg max-w-none text-gray-700 leading-relaxed"
                 data-controller="collapsible-text"
                 data-collapsible-text-collapsed-height-value="210">
              <div id="<%= description_id %>" class="public-collapsible-text__content" data-collapsible-text-target="content">
                <% if description_content.match?(/<[^>]+>/) %>
                  <%= sanitize(description_content, tags: %w[p br strong em b i ul ol li h3 h4 h5 blockquote a], attributes: %w[href target rel]) %>
                <% else %>
                  <%= simple_format(description_content) %>
                <% end %>
              </div>
              <button type="button"
                      class="public-collapsible-text__toggle"
                      data-collapsible-text-target="toggle"
                      data-action="collapsible-text#toggle"
                      aria-controls="<%= description_id %>"
                      hidden>
                <span data-collapsible-text-label>Ler mais</span>
                <i class="public-collapsible-text__icon bi bi-chevron-down" aria-hidden="true"></i>
              </button>
            </div>
          </section>
        <% end %>

        <!-- Features & Infrastructure -->
        <% property_features = @habitation.public_property_features_for_display %>
        <% leisure_features = @habitation.leisure_features_for_display %>
        
        <% if property_features.any? || leisure_features.any? %>
          <section class="public-theme-development-features public-theme-development-features--default public-development-show__section public-development-show__features bg-white rounded-xl shadow-sm p-8 border border-gray-100">
            <h2 class="public-development-show__section-title text-2xl font-semibold text-gray-900 mb-6 flex items-center gap-3">
              <div class="w-1 h-8 bg-golden-one rounded"></div>
              <i class="bi bi-patch-check-fill text-golden-one"></i>
              Características e Infraestrutura
            </h2>

            <% if property_features.any? %>
              <div class="mb-6">
                <h3 class="text-lg font-semibold text-blue-three mb-3 flex items-center gap-2">
                  <span class="inline-block w-8 h-px bg-blue-200"></span>
                  Destaque deste empreendimento
                </h3>
                <div class="public-development-show__chip-list flex flex-wrap gap-2">
                  <% property_features.each do |feature| %>
                    <div class="public-development-show__chip inline-flex items-center gap-2 text-gray-700 bg-white border border-gray-200 rounded-full px-3 py-1.5">
                      <i class="bi bi-building-check text-golden-one text-sm"></i>
                      <span class="text-sm leading-tight"><%= feature %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if leisure_features.any? %>
              <div>
                <h3 class="text-lg font-semibold text-blue-three mb-3 flex items-center gap-2">
                  <span class="inline-block w-8 h-px bg-blue-200"></span>
                  Destaque lazer
                </h3>
                <div class="public-development-show__chip-list flex flex-wrap gap-2">
                  <% leisure_features.each do |feature| %>
                    <div class="public-development-show__chip inline-flex items-center gap-2 text-gray-700 bg-[#f8fafc] border border-gray-200 rounded-full px-3 py-1.5">
                      <i class="bi bi-stars text-blue-three text-sm"></i>
                      <span class="text-sm leading-tight"><%= feature %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </section>
        <% end %>

        <!--Location Section -->
        <section class="public-theme-development-location public-theme-development-location--default public-development-show__section public-development-show__location bg-white rounded-xl shadow-sm p-8">
          <h2 class="public-development-show__section-title text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
            <div class="w-1 h-8 bg-golden-one rounded"></div>
            Localização
          </h2>
          
          <div class="space-y-6">
            <!-- Address -->
            <div class="public-development-show__address flex items-start gap-3 p-4 bg-blue-50 rounded-lg">
              <i class="bi bi-geo-alt-fill text-blue-three text-2xl mt-1"></i>
              <div>
                <p class="font-semibold text-gray-900">
                  <%= [@habitation.endereco, @habitation.numero].compact.join(', ') %>
                </p>
                <p class="text-gray-600">
                  <%= [@habitation.public_neighborhood, @habitation.cidade, @habitation.uf].compact.join(' - ') %>
                  <% if @habitation.cep.present? %>
                    - CEP: <%= @habitation.cep %>
                  <% end %>
                </p>
              </div>
            </div>

            <!-- Nearby -->
            <% surroundings = Array(@habitation.imediacoes).flatten.compact.map(&:to_s).map(&:strip).reject(&:blank?) %>
            <% if surroundings.present? %>
              <div>
                <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                  <i class="bi bi-pin-map text-golden-one"></i>
                  Imediações
                </h3>
                <p class="text-gray-600"><%= surroundings.join(", ") %></p>
              </div>
            <% end %>
          </div>
        </section>

        <% if development_faq_items.any? %>
          <section class="public-development-show__section public-development-show__faq bg-white rounded-xl shadow-sm p-8 border border-gray-100">
            <h2 class="public-development-show__section-title text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <div class="w-1 h-8 bg-golden-one rounded"></div>
              Perguntas frequentes sobre <%= development_name %>
            </h2>

            <div class="divide-y divide-gray-100">
              <% development_faq_items.each do |item| %>
                <div class="py-5 first:pt-0 last:pb-0">
                  <h3 class="text-lg font-semibold text-blue-three mb-2"><%= item[:question] %></h3>
                  <p class="text-gray-700 leading-relaxed"><%= item[:answer] %></p>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
    </div>
  </div>
</div>
