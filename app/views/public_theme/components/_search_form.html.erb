<%
  variant = local_assigns.fetch(:variant, "default")
  url = local_assigns.fetch(:url)
  property_types = Array(local_assigns[:property_types]).compact_blank
  location_options = Array(local_assigns[:location_options]).compact
  price_options = Array(local_assigns[:price_options]).compact
  transaction_default = local_assigns.fetch(:transaction_default, "venda")
  form_class = ["public-theme-search", "public-theme-search--#{variant}", local_assigns[:class_name]].compact.join(" ")
%>

<%= form_with url: url, method: :get, class: form_class, role: "search", local: true, autocomplete: "off" do %>
  <%= hidden_field_tag :transaction_type, transaction_default, data: { salute_luxury_theme_target: "transactionInput" } %>

  <div class="public-theme-search__field sl-field field">
    <label id="sl-lbl-tipo">Tipo</label>
    <div class="public-theme-search__combobox cbx" data-cbx>
      <%= hidden_field_tag "category[]", "" %>
      <div class="public-theme-search__trigger cbx-trigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="sl-lbl-tipo">
        <div class="cbx-field">
          <span class="public-theme-search__tags cbx-tags"></span>
          <input class="public-theme-search__input cbx-input" type="text" placeholder="Todos os tipos" aria-label="Tipo de imóvel" aria-autocomplete="list">
        </div>
        <svg class="cbx-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="public-theme-search__panel cbx-panel" role="listbox">
        <% property_types.each do |type| %>
          <div class="public-theme-search__option cbx-opt" role="option" data-value="<%= type %>" data-search="<%= type.to_s.parameterize(separator: " ") %>"><span class="cbx-lbl"><%= type %></span></div>
        <% end %>
        <div class="public-theme-search__empty cbx-empty" hidden>Nenhum tipo encontrado</div>
      </div>
    </div>
  </div>

  <div class="public-theme-search__field sl-field field">
    <label id="sl-lbl-loc">Localização</label>
    <div class="public-theme-search__combobox cbx" data-cbx>
      <%= hidden_field_tag "city[]", "" %>
      <div class="public-theme-search__trigger cbx-trigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="sl-lbl-loc">
        <div class="cbx-field">
          <span class="public-theme-search__tags cbx-tags"></span>
          <input class="public-theme-search__input cbx-input" type="text" placeholder="Cidade ou bairro" aria-label="Localização" aria-autocomplete="list">
        </div>
        <svg class="cbx-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="public-theme-search__panel cbx-panel" role="listbox">
        <% location_options.each do |label, value| %>
          <div class="public-theme-search__option cbx-opt" role="option" data-value="<%= value %>" data-search="<%= label.to_s.parameterize(separator: " ") %>"><span class="cbx-lbl"><%= label %></span></div>
        <% end %>
        <div class="public-theme-search__empty cbx-empty" hidden>Nenhum local encontrado</div>
      </div>
    </div>
  </div>

  <div class="public-theme-search__field sl-field field">
    <label id="sl-lbl-valor">Valores</label>
    <div class="public-theme-search__combobox cbx" data-cbx>
      <%= hidden_field_tag :price_range, "" %>
      <div class="public-theme-search__trigger cbx-trigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="sl-lbl-valor">
        <div class="cbx-field">
          <span class="public-theme-search__tags cbx-tags"></span>
          <input class="public-theme-search__input cbx-input" type="text" placeholder="Todos os valores" aria-label="Faixa de valor" aria-autocomplete="list">
        </div>
        <svg class="cbx-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="public-theme-search__panel cbx-panel" role="listbox" aria-label="Faixas de valor">
        <% price_options.drop(1).each do |label, value| %>
          <div class="public-theme-search__option cbx-opt" role="option" data-value="<%= value %>" data-search="<%= label.to_s.parameterize(separator: " ") %>"><span class="cbx-lbl"><%= label %></span></div>
        <% end %>
        <div class="public-theme-search__empty cbx-empty" hidden>Nenhuma faixa encontrada</div>
      </div>
    </div>
  </div>

  <button class="public-theme-search__submit sl-search__go go" type="submit">
    Buscar
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
  </button>
<% end %>
