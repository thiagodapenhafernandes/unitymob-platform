<%
  variant = local_assigns.fetch(:variant, "default")
  url = local_assigns.fetch(:url)
  property_types = Array(local_assigns[:property_types]).compact_blank
  # Aceita o formato de Habitation.public_location_options ({ label:, value: })
  # e pares [rótulo, valor].
  location_options = Array(local_assigns[:location_options]).compact.map do |option|
    option.is_a?(Hash) ? option.symbolize_keys.values_at(:label, :value) : Array(option).values_at(0, -1)
  end.reject { |_label, value| value.blank? }
  price_options = Array(local_assigns[:price_options]).compact
  transaction_default = local_assigns.fetch(:transaction_default, "venda")
  form_class = ["public-theme-search", "public-theme-search--#{variant}", local_assigns[:class_name]].compact.join(" ")
%>

<%= form_with url: url, method: :get, class: form_class, role: "search", local: true, autocomplete: "off" do %>
  <%= hidden_field_tag :transaction_type, transaction_default, data: { salute_luxury_theme_target: "transactionInput" } %>
  <%= hidden_field_tag :v, "2", id: nil %>

  <div class="public-theme-search__field sl-field field">
    <label id="sl-lbl-tipo">Tipo</label>
    <div class="public-theme-combobox" data-controller="combobox">
      <%= hidden_field_tag "category[]", "" %>
      <div class="public-theme-combobox__trigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="sl-lbl-tipo">
        <div class="public-theme-combobox__field">
          <span class="public-theme-combobox__tags"></span>
          <input class="public-theme-combobox__input" type="text" placeholder="Todos os tipos" aria-label="Tipo de imóvel" aria-autocomplete="list">
        </div>
        <i class="public-theme-combobox__caret bi bi-chevron-down" aria-hidden="true"></i>
      </div>
      <div class="public-theme-combobox__panel" role="listbox">
        <% property_types.each do |type| %>
          <div class="public-theme-combobox__option" role="option" data-value="<%= type %>" data-search="<%= type.to_s.parameterize(separator: " ") %>"><span class="public-theme-combobox__label"><%= type %></span></div>
        <% end %>
        <div class="public-theme-combobox__empty" hidden>Nenhum tipo encontrado</div>
      </div>
    </div>
  </div>

  <div class="public-theme-search__field sl-field field">
    <label id="sl-lbl-loc">Localização</label>
    <div class="public-theme-combobox" data-controller="combobox">
      <%= hidden_field_tag "city[]", "" %>
      <div class="public-theme-combobox__trigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="sl-lbl-loc">
        <div class="public-theme-combobox__field">
          <span class="public-theme-combobox__tags"></span>
          <input class="public-theme-combobox__input" type="text" placeholder="Cidade ou bairro" aria-label="Localização" aria-autocomplete="list">
        </div>
        <i class="public-theme-combobox__caret bi bi-chevron-down" aria-hidden="true"></i>
      </div>
      <div class="public-theme-combobox__panel" role="listbox">
        <% location_options.each do |label, value| %>
          <div class="public-theme-combobox__option" role="option" data-value="<%= value %>" data-search="<%= label.to_s.parameterize(separator: " ") %>"><span class="public-theme-combobox__label"><%= label %></span></div>
        <% end %>
        <div class="public-theme-combobox__empty" hidden>Nenhum local encontrado</div>
      </div>
    </div>
  </div>

  <div class="public-theme-search__field sl-field field">
    <label id="sl-lbl-valor">Valores</label>
    <div class="public-theme-combobox" data-controller="combobox">
      <%= hidden_field_tag :price_range, "" %>
      <div class="public-theme-combobox__trigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="sl-lbl-valor">
        <div class="public-theme-combobox__field">
          <span class="public-theme-combobox__tags"></span>
          <input class="public-theme-combobox__input" type="text" placeholder="Todos os valores" aria-label="Faixa de valor" aria-autocomplete="list">
        </div>
        <i class="public-theme-combobox__caret bi bi-chevron-down" aria-hidden="true"></i>
      </div>
      <div class="public-theme-combobox__panel" role="listbox" aria-label="Faixas de valor">
        <% price_options.drop(1).each do |label, value| %>
          <div class="public-theme-combobox__option" role="option" data-value="<%= value %>" data-search="<%= label.to_s.parameterize(separator: " ") %>"><span class="public-theme-combobox__label"><%= label %></span></div>
        <% end %>
        <div class="public-theme-combobox__empty" hidden>Nenhuma faixa encontrada</div>
      </div>
    </div>
  </div>

  <button class="public-theme-search__submit sl-search__go go" type="submit">
    Buscar
    <i class="public-theme-search__submit-icon bi bi-search" aria-hidden="true"></i>
  </button>
<% end %>
