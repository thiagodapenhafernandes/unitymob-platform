<%# Modal do simulador na página do imóvel — mesmo HTML em todos os temas
    (contrato public-theme-financing-modal__*). <dialog> nativo (foco e Esc do
    navegador) com entrada/saída animadas pelo controller financing-modal.
    Abre com o evento public-financing:open (botões financing-modal-trigger).
    Locals: variant, rate, property. %>
<% variant = local_assigns.fetch(:variant, "default") %>
<dialog id="simulador-financiamento-modal"
        class="public-theme-financing-modal public-theme-financing-modal--<%= variant %>"
        aria-label="Simulador de financiamento"
        data-controller="financing-modal"
        data-action="public-financing:open@window->financing-modal#open cancel->financing-modal#cancel click->financing-modal#backdrop">
  <div class="public-theme-financing-modal__panel">
    <button type="button" class="public-theme-financing-modal__close" data-action="financing-modal#close" aria-label="Fechar simulador">
      <%= public_icon("x-lg") %>
    </button>
    <%= render "public_theme/components/financing_simulator", variant: variant, rate: local_assigns.fetch(:rate),
          property: local_assigns.fetch(:property), class_name: "public-theme-financing-modal__simulator" %>
  </div>
</dialog>
