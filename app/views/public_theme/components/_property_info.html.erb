<%
  habitation = local_assigns.fetch(:habitation)
  images = Array(local_assigns[:images])
  public_map = local_assigns[:public_map]
  public_media_url = local_assigns[:public_media_url]
  feature_items = Array(local_assigns[:feature_items])
  info_class = ["public-theme-property-info", "public-theme-property-info--#{local_assigns.fetch(:variant, "default")}", local_assigns[:class_name]].compact.join(" ")
%>

<section class="<%= info_class %>">
  <%# O tema salute renderiza estas pílulas logo abaixo da galeria. %>
  <% if local_assigns.fetch(:show_media_actions, true) && (public_media_url.present? || public_map&.visible? || images.any?) %>
    <nav class="public-theme-property-info__media-actions sl-detail__media-actions" aria-label="Recursos do imóvel">
      <% if public_media_url.present? %>
        <%= link_to public_media_url, target: "_blank", rel: "noopener noreferrer" do %>
          <%= public_icon("play-circle") %>
          <span><%= habitation.tour_virtual.present? && public_media_url == habitation.tour_virtual ? "Tour 360" : "Vídeo" %></span>
        <% end %>
      <% end %>

      <% if public_map&.visible? %>
        <button type="button" data-action="click->public-property-map#showMap"><%= public_icon("map") %><span>Mapa</span></button>
      <% end %>

      <% if public_map&.street_view_enabled? %>
        <button type="button" data-action="click->public-property-map#showStreetView"><%= public_icon("person-standing") %><span>Rua</span></button>
      <% end %>

      <% if images.any? %>
        <button type="button" data-gallery-open><%= public_icon("images") %><span><%= images.size %> fotos</span></button>
      <% end %>
    </nav>
  <% end %>

  <% if feature_items.any? %>
    <div class="public-theme-property-info__features sl-detail__features">
      <% feature_items.each do |feature| %>
        <div>
          <%= public_icon(feature[:icon]) %>
          <span><%= feature[:label] %></span>
          <strong><%= feature[:value] %></strong>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "public_theme/components/property_amenities",
        habitation: habitation,
        development: local_assigns[:development],
        variant: local_assigns.fetch(:variant, "default") %>

  <h2>Descrição</h2>
  <% description_id = dom_id(habitation, :public_description) %>
  <div class="public-collapsible-text public-theme-property-info__description sl-detail__description"
       data-controller="collapsible-text"
       data-collapsible-text-collapsed-height-value="220">
    <div id="<%= description_id %>" class="public-collapsible-text__content" data-collapsible-text-target="content">
      <% description_content = habitation.display_description %>
      <% if description_content.present? %>
        <%= formatted_habitation_description(description_content) %>
      <% else %>
        <p>Sem descrição disponível.</p>
      <% end %>
    </div>
    <button type="button"
            class="public-collapsible-text__toggle"
            data-collapsible-text-target="toggle"
            data-action="collapsible-text#toggle"
            aria-controls="<%= description_id %>"
            aria-expanded="false"
            hidden>
      <span data-collapsible-text-label>Ler mais</span>
      <i class="public-collapsible-text__icon bi bi-chevron-down" aria-hidden="true"></i>
    </button>
  </div>

</section>
