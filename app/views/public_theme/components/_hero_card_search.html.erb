<%# Busca do hero "Cartão" (extraída do _hero_card para reuso: home e hero do corretor).
    Contrato: .public-theme-hero-card__panel com __tabs, __tab, __title, __lead, __filters, __grid,
    __field, __control, __chips, __chip, __submit e __footer — as mesmas classes do _hero_card.
    Locals: variant, form_url (default habitations_path), id_prefix (default "hero_card"),
    heading (default true; false omite título/subtítulo — ex.: o h1 já é o nome do corretor),
    ai_enabled (default true; false omite voz/IA — ex.: contexto do corretor, onde a
    busca por IA seria global e quebraria o escopo). %>
<%
  form_url = local_assigns.fetch(:form_url, habitations_path)
  id_prefix = local_assigns.fetch(:id_prefix, "hero_card")
  heading = local_assigns.fetch(:heading, true)
  ai_enabled = local_assigns.fetch(:ai_enabled, true)
  cta = @home_setting.hero_cta_text.presence || "Buscar imóveis"
  ai = ai_enabled && @home_setting.hero_ai_search_available?
  voice = ai && Ai::PropertySearch::PublicQuery.voice_available?(tenant: public_tenant)
  suggestions = @home_setting.hero_ai_suggestion_list
%>
<div class="public-theme-hero-card__panel"
     data-controller="hero-search"
     data-hero-search-ai-url-value="<%= public_ai_search_path %>"
     data-hero-search-voice-value="<%= voice %>"
     data-hero-search-sale-price-options-value="<%= json_escape(public_price_range_options("venda").to_json) %>"
     data-hero-search-rent-price-options-value="<%= json_escape(public_price_range_options("aluguel").to_json) %>">
  <div class="public-theme-hero-card__tabs" role="group" aria-label="Finalidade">
    <% if ai %>
      <button type="button" class="public-theme-hero-card__tab public-theme-hero-voice__toggle" data-hero-search-target="voiceToggle" data-action="click->hero-search#toggleVoice"
              aria-pressed="false" aria-label="<%= voice ? "Buscar por voz" : "Descrever o imóvel que procuro" %>"><i class="bi bi-<%= voice ? "mic" : "stars" %>" aria-hidden="true"></i> <%= voice ? "Voz" : "Descrever" %></button>
    <% end %>
    <% [["Comprar", "venda"], ["Alugar", "aluguel"]].each_with_index do |(label, value), index| %>
      <button type="button" class="public-theme-hero-card__tab" data-hero-search-target="tab" data-value="<%= value %>"
              data-action="click->hero-search#transaction" aria-pressed="<%= index.zero? %>"><%= label %></button>
    <% end %>
  </div>

  <% if heading %>
    <h1 class="public-theme-hero-card__title"><%= @home_setting.hero_title %></h1>
    <% if @home_setting.hero_subtitle.present? %><p class="public-theme-hero-card__lead"><%= @home_setting.hero_subtitle %></p><% end %>
  <% end %>

  <%= form_with url: form_url, method: :get, local: true, class: "public-theme-hero-card__filters", role: "search", autocomplete: "off",
                data: { hero_search_target: "filtersPanel", controller: "public-search-url", action: "submit->public-search-url#submit" } do %>
    <%= hidden_field_tag :transaction_type, "venda", id: "#{id_prefix}_transaction", data: { hero_search_target: "transaction" } %>
    <%= hidden_field_tag :v, "2", id: nil %>
    <div class="public-theme-hero-card__grid">
      <label class="public-theme-hero-card__field"><span class="sr-only">Localização</span>
        <i class="bi bi-geo-alt" aria-hidden="true"></i>
        <%= select_tag "city[]", options_for_select(hero_location_options), include_blank: "Qual a localização?", class: "public-theme-hero-card__control", id: "#{id_prefix}_location" %>
      </label>
      <label class="public-theme-hero-card__field"><span class="sr-only">Tipo de imóvel</span>
        <i class="bi bi-house-door" aria-hidden="true"></i>
        <%= select_tag "category[]", options_for_select(Array(@property_types)), include_blank: "Tipo do imóvel", class: "public-theme-hero-card__control", id: "#{id_prefix}_category" %>
      </label>
      <label class="public-theme-hero-card__field"><span class="sr-only">Dormitórios</span>
        <i class="bi bi-door-closed" aria-hidden="true"></i>
        <%= select_tag :min_bedrooms, options_for_select(hero_bedroom_options.drop(1)), include_blank: "Dormitórios", class: "public-theme-hero-card__control", id: "#{id_prefix}_bedrooms" %>
      </label>
      <label class="public-theme-hero-card__field"><span class="sr-only">Valor aproximado</span>
        <i class="bi bi-currency-dollar" aria-hidden="true"></i>
        <%= select_tag :price_range, options_for_select(public_price_range_options("venda").drop(1)), include_blank: "Valor aproximado", class: "public-theme-hero-card__control", id: "#{id_prefix}_price", data: { hero_search_target: "priceSelect" } %>
      </label>
    </div>

    <p class="public-theme-hero-card__label">Mais buscados</p>
    <div class="public-theme-hero-card__chips">
      <% HomeHeroHelper::HERO_QUICK_FILTERS.each do |value, label| %>
        <label class="public-theme-hero-card__chip-option">
          <%= check_box_tag "characteristics[]", value, false, id: "#{id_prefix}_chip_#{value}", class: "sr-only" %>
          <span class="public-theme-hero-card__chip"><%= label %></span>
        </label>
      <% end %>
    </div>

    <p class="public-theme-hero-card__label">Busca rápida</p>
    <label class="public-theme-hero-card__field public-theme-hero-card__field--text"><span class="sr-only">Nome ou código</span>
      <i class="bi bi-search" aria-hidden="true"></i>
      <%= search_field_tag :search, nil, placeholder: "Buscar por nome ou código", class: "public-theme-hero-card__control", id: "#{id_prefix}_search" %>
    </label>

    <button type="submit" class="public-theme-hero-card__submit"><i class="bi bi-search" aria-hidden="true"></i><span><%= cta %></span></button>
  <% end %>

  <% if ai %>
    <%= render "public_theme/components/hero_voice", variant: variant, class_name: "public-theme-hero-voice--in-card", voice: voice, suggestions: suggestions %>
  <% end %>

  <% if (summary = hero_listing_summary) %>
    <p class="public-theme-hero-card__footer"><%= summary %></p>
  <% end %>
</div>
