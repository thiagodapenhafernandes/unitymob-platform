<%# "Descubra imóveis e empreendimentos nestas cidades" — mesmo HTML em todos
    os temas (contrato public-theme-city-links__*). Grupos vêm de
    Habitation.public_city_link_groups (cidades e bairros com mais imóveis).
    Locals: groups, variant, class_name, title (nil quando a seção já tem
    cabeçalho próprio, como na home). %>
<%
  groups = Array(local_assigns[:groups])
  title = local_assigns.fetch(:title, "Descubra os melhores imóveis e empreendimentos nestas cidades")
  links_class = ["public-theme-city-links", "public-theme-city-links--#{local_assigns.fetch(:variant, "default")}", local_assigns[:class_name]].compact.join(" ")
%>

<% if groups.any? %>
  <nav class="<%= links_class %>" <%= title.present? ? 'aria-labelledby="imoveis-por-cidade-titulo"'.html_safe : 'aria-label="Imóveis por cidade"'.html_safe %>>
    <% if title.present? %>
      <h2 class="public-theme-city-links__title" id="imoveis-por-cidade-titulo"><%= title %></h2>
    <% end %>
    <div class="public-theme-city-links__grid">
      <% groups.each do |group| %>
        <div class="public-theme-city-links__city">
          <h3 class="public-theme-city-links__city-name"><%= public_icon("geo-alt", class_name: "public-theme-city-links__icon") %><%= group[:label] %></h3>
          <ul class="public-theme-city-links__list">
            <li><%= link_to "Imóveis à venda", habitations_path(city: [group[:value]], transaction_type: "venda", v: "2"), class: "public-theme-city-links__link" %></li>
            <li><%= link_to "Imóveis para alugar", habitations_path(city: [group[:value]], transaction_type: "aluguel", v: "2"), class: "public-theme-city-links__link" %></li>
            <li><%= link_to "Empreendimentos", empreendimentos_path(cidade: group[:value]), class: "public-theme-city-links__link" %></li>
          </ul>
          <% if group[:neighborhoods].present? %>
            <ul class="public-theme-city-links__list public-theme-city-links__list--neighborhoods">
              <% group[:neighborhoods].each do |neighborhood| %>
                <li><%= link_to "Imóveis em #{neighborhood[:label]}", habitations_path(city: [neighborhood[:value]], v: "2"), class: "public-theme-city-links__link" %></li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>
  </nav>
<% end %>
