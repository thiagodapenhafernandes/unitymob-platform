<%
  variant = local_assigns.fetch(:variant, "default")
  box_class = ["public-theme-development-contact", "public-theme-development-contact--#{variant}", local_assigns[:class_name]].compact.join(" ")
  phone = local_assigns[:phone].presence
%>

<aside class="<%= box_class %>">
  <h2 class="public-theme-development-contact__title"><%= local_assigns.fetch(:title, "Interessado?") %></h2>
  <% if local_assigns[:intro].present? %>
    <p class="public-theme-development-contact__intro"><%= local_assigns[:intro] %></p>
  <% end %>

  <div class="public-theme-development-contact__actions">
    <%# Mesmo gatilho dos cards: passa pelo lead_capture, então o empreendimento
        também gera lead em vez de mandar direto para o WhatsApp. %>
    <button type="button"
            class="public-theme-development-contact__action public-theme-development-contact__action--primary"
            data-action="click->lead-capture#open"
            data-property-id="<%= local_assigns[:property_id] %>"
            data-property-title="<%= local_assigns[:property_title] %>"
            data-property-code="<%= local_assigns[:property_code] %>"
            data-lead-origin="empreendimento"
            data-require-lead-form="true">
      <%= local_assigns.fetch(:whatsapp_label, "Falar no WhatsApp") %>
    </button>

    <% if phone.present? %>
      <%= link_to phone, "tel:#{phone.to_s.gsub(/\D/, '')}", class: "public-theme-development-contact__action" %>
    <% end %>

    <button type="button"
            class="public-theme-development-contact__action"
            data-action="click->lead-capture#open"
            data-property-id="<%= local_assigns[:property_id] %>"
            data-property-title="<%= local_assigns[:property_title] %>"
            data-property-code="<%= local_assigns[:property_code] %>"
            data-lead-origin="empreendimento_visita"
            data-require-lead-form="true">
      <%= local_assigns.fetch(:schedule_label, "Agendar visita") %>
    </button>
  </div>
</aside>
