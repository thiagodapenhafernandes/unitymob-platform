<%
  variant = local_assigns.fetch(:variant, "default")
  features = Array(local_assigns[:features]).compact_blank
  section_class = ["public-theme-development-features", "public-theme-development-features--#{variant}", local_assigns[:class_name]].compact.join(" ")
%>

<% if features.any? %>
  <section id="<%= local_assigns[:id] %>" class="<%= section_class %>">
    <h2 class="public-theme-development-section__title"><%= local_assigns.fetch(:title, "Características e infraestrutura") %></h2>
    <% if local_assigns[:subtitle].present? %>
      <p class="public-theme-development-features__subtitle"><%= local_assigns[:subtitle] %></p>
    <% end %>
    <ul class="public-theme-development-features__list">
      <% features.each do |feature| %>
        <li class="public-theme-development-features__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <%= feature %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
