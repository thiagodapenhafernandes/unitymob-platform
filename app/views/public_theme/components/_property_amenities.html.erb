<%# "O que você vai encontrar nesse imóvel / nesse empreendimento" — mesmo
    HTML em todos os temas (contrato public-theme-property-amenities__*).
    O lazer vem do empreendimento vinculado; sem vínculo, da infraestrutura
    cadastrada no próprio imóvel. Locals: habitation, development, variant. %>
<%
  habitation = local_assigns.fetch(:habitation)
  development = local_assigns[:development]
  property_features = habitation.public_property_features_for_display
  leisure_features = development&.leisure_features_for_display.presence || habitation.leisure_features_for_display
  place_word = [development&.categoria, habitation.categoria].join(" ").match?(/condom[ií]nio/i) ? "condomínio" : "empreendimento"
  groups = [
    ["O que você vai encontrar nesse imóvel", property_features, "house-check"],
    ["O que você vai encontrar nesse #{place_word}", leisure_features, "stars"]
  ].select { |_title, features, _icon| features.any? }
  amenities_class = ["public-theme-property-amenities", "public-theme-property-amenities--#{local_assigns.fetch(:variant, "default")}", local_assigns[:class_name]].compact.join(" ")
%>

<% if groups.any? %>
  <section class="<%= amenities_class %>">
    <% groups.each do |title, features, icon| %>
      <div class="public-theme-property-amenities__group">
        <h3 class="public-theme-property-amenities__title"><%= title %></h3>
        <ul class="public-theme-property-amenities__list">
          <% features.each do |feature| %>
            <li class="public-theme-property-amenities__item"><%= public_icon(icon, class_name: "public-theme-property-amenities__icon") %><%= feature %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
<% end %>
