<%
  variant = local_assigns.fetch(:variant, "default")
  options = Array(local_assigns[:options])
  default_value = local_assigns.fetch(:default_value, options.first && (options.first[:value] || options.first["value"]))
  switch_class = ["public-theme-transaction-switch", "public-theme-transaction-switch--#{variant}", local_assigns[:class_name]].compact.join(" ")
  button_class = ["public-theme-transaction-switch__button", local_assigns[:button_class]].compact.join(" ")
%>

<div class="<%= switch_class %>" role="group" aria-label="<%= local_assigns.fetch(:aria_label, "Finalidade") %>">
  <%# Busca por voz/descrição (opcional): primeiro botão, antes de Comprar. O controller hero-search troca o formulário por ele. %>
  <% if local_assigns[:voice_toggle] %>
    <button type="button"
            class="<%= button_class %> public-theme-hero-voice__toggle"
            data-hero-search-target="voiceToggle"
            data-action="click->hero-search#toggleVoice"
            aria-pressed="false"
            aria-label="<%= local_assigns[:voice_toggle][:aria_label] %>"><i class="bi bi-<%= local_assigns[:voice_toggle][:icon] %>" aria-hidden="true"></i> <%= local_assigns[:voice_toggle][:label] %></button>
  <% end %>
  <% options.each do |option| %>
    <%
      label = option[:label] || option["label"]
      value = option[:value] || option["value"]
      pressed = value == default_value
    %>
    <button type="button"
            class="<%= button_class %>"
            data-salute-luxury-theme-target="transactionButton"
            data-transaction-type="<%= value %>"
            data-action="<%= local_assigns[:action] %>"
            aria-pressed="<%= pressed ? "true" : "false" %>"><%= label %></button>
  <% end %>
</div>
