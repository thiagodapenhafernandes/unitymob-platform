<%# Cabeçalho de página interna — mesmo HTML em todos os temas (contrato
    public-theme-page-head__*); cada tema estiliza a variante.
    Locals: eyebrow, title, lead, variant, class_name %>
<header class="<%= ["public-theme-page-head", "public-theme-page-head--#{local_assigns.fetch(:variant, "default")}", local_assigns[:class_name]].compact.join(" ") %>">
  <% if local_assigns[:eyebrow].present? %>
    <span class="public-theme-page-head__eyebrow"><%= eyebrow %></span>
  <% end %>
  <h1 class="public-theme-page-head__title"><%= title %></h1>
  <span class="public-theme-page-head__rule" aria-hidden="true"></span>
  <% if local_assigns[:lead].present? %>
    <p class="public-theme-page-head__lead"><%= lead %></p>
  <% end %>
</header>
