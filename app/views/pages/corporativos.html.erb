<div class="public-theme-institutional-page public-theme-institutional-page--<%= theme_variant %>">
<!-- Imóveis Corporativos e Rurais - Modern Design -->

<!-- Hero Section -->
<%= render "public_theme/components/institutional_head", eyebrow: "Negócios", title: "Imóveis corporativos e rurais", lead: "Converse com a #{@public_identity.name} sobre a localização, a área e a estrutura necessárias para sua empresa ou projeto. Consulte a disponibilidade das propriedades e as condições de cada negociação." %>

<!-- Intro Section -->
<section class="py-16 public-theme-institutional__surface">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xl text-gray-700 leading-relaxed">
        Explore uma vasta gama de imóveis que atendem às necessidades tanto do ambiente corporativo quanto rural. 
        A <strong class="public-theme-institutional__heading"><%= @public_identity.name %></strong> oferece desde prédios e escritórios urbanos, ideais para empresas
        de diversos setores, até propriedades rurais para agricultura, pecuária ou lazer.
      </p>
    </div>
  </div>
</section>

<!-- Galpões Section -->
<section class="py-16 public-theme-institutional__muted">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right">
        <div class="public-theme-institutional__muted w-20 h-20 rounded-full flex items-center justify-center mb-6">
          <i class="bi bi-buildings text-5xl public-theme-institutional__accent"></i>
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold public-theme-institutional__heading mb-6">Galpões</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-6">
          Diversas opções de imóveis para empresas que buscam um local estratégico para sua operação. 
          Nossos galpões são projetados para atender às necessidades logísticas, industriais e comerciais, 
          com infraestrutura adequada para armazenamento, produção e distribuição.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Infraestrutura completa</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Localizações estratégicas</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Flexibilidade de área</span>
          </li>
        </ul>
        <a href="https://wa.me/<%= @public_identity.phone.to_s.gsub(/\D/, '') %>?text=<%= ERB::Util.url_encode('Olá, estou em busca de GALPÃO') %>" target="_blank" rel="noopener"
           class="inline-block px-8 py-4 public-theme-institutional__button public-theme-institutional__heading font-bold rounded-lg hover:bg-blue-three hover:text-white transition-all shadow-md hover:shadow-xl">
          <i class="bi bi-whatsapp mr-2"></i>
          Consultar Galpões
        </a>
      </div>
      <div data-aos="fade-left">
        <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800" 
             alt="Galpões Industriais" 
             class="w-full h-[400px] object-cover rounded-xl shadow-xl">
      </div>
    </div>
  </div>
</section>

<!-- Salas Comerciais Section -->
<section class="py-16 public-theme-institutional__surface">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right" class="order-2 lg:order-1">
        <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=800" 
             alt="Salas Comerciais" 
             class="w-full h-[400px] object-cover rounded-xl shadow-xl">
      </div>
      <div data-aos="fade-left" class="order-1 lg:order-2">
        <div class="public-theme-institutional__muted w-20 h-20 rounded-full flex items-center justify-center mb-6">
          <i class="bi bi-building text-5xl public-theme-institutional__accent"></i>
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold public-theme-institutional__heading mb-6">Salas Comerciais e Prédios Corporativos</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-6">
          Encontre o espaço ideal para seu escritório ou sede corporativa. Oferecemos imóveis modernos e 
          bem localizados, com infraestrutura completa e flexibilidade para adaptar-se às suas necessidades empresariais.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Localização privilegiada</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Infraestrutura moderna</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Flexibilidade de layout</span>
          </li>
        </ul>
        <a href="https://wa.me/<%= @public_identity.phone.to_s.gsub(/\D/, '') %>?text=<%= ERB::Util.url_encode('Olá, estou em busca de Sala Comercial') %>" target="_blank" rel="noopener"
           class="inline-block px-8 py-4 public-theme-institutional__button public-theme-institutional__heading font-bold rounded-lg hover:bg-blue-three hover:text-white transition-all shadow-md hover:shadow-xl">
          <i class="bi bi-whatsapp mr-2"></i>
          Consultar Salas Comerciais
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Terrenos Section -->
<section class="py-16 public-theme-institutional__muted">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right">
        <div class="public-theme-institutional__muted w-20 h-20 rounded-full flex items-center justify-center mb-6">
          <i class="bi bi-grid-3x3-gap text-5xl public-theme-institutional__accent"></i>
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold public-theme-institutional__heading mb-6">Terrenos para Loteamento e Multipropriedade</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-6">
          Descubra oportunidades únicas em terrenos prontos para loteamento e empreendimentos de multipropriedade. 
          Nossos terrenos são cuidadosamente selecionados para oferecer o melhor potencial de desenvolvimento 
          urbano ou rural.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Alto potencial de valorização</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Documentação regularizada</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Assessoria completa</span>
          </li>
        </ul>
        <a href="https://wa.me/<%= @public_identity.phone.to_s.gsub(/\D/, '') %>?text=<%= ERB::Util.url_encode('Olá, estou em busca de terreno para construir/lotear') %>" target="_blank" rel="noopener"
           class="inline-block px-8 py-4 public-theme-institutional__button public-theme-institutional__heading font-bold rounded-lg hover:bg-blue-three hover:text-white transition-all shadow-md hover:shadow-xl">
          <i class="bi bi-whatsapp mr-2"></i>
          Consultar Terrenos
        </a>
      </div>
      <div data-aos="fade-left">
        <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=800" 
             alt="Terrenos" 
             class="w-full h-[400px] object-cover rounded-xl shadow-xl">
      </div>
    </div>
  </div>
</section>

<!-- Fazendas Section -->
<section class="py-16 public-theme-institutional__surface">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right" class="order-2 lg:order-1">
        <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=800" 
             alt="Fazendas e Sítios" 
             class="w-full h-[400px] object-cover rounded-xl shadow-xl">
      </div>
      <div data-aos="fade-left" class="order-1 lg:order-2">
        <div class="public-theme-institutional__muted w-20 h-20 rounded-full flex items-center justify-center mb-6">
          <i class="bi bi-tree text-5xl public-theme-institutional__accent"></i>
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold public-theme-institutional__heading mb-6">Fazendas e Sítios</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-6">
          Propriedades rurais ideais para agricultura, pecuária, lazer ou investimento. 
          Oferecemos fazendas e sítios em diversas regiões, com diferentes tamanhos e características.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Diversas regiões disponíveis</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Variadas metragens</span>
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <i class="bi bi-check-circle-fill public-theme-institutional__accent"></i>
            <span>Suporte técnico</span>
          </li>
        </ul>
        <a href="https://wa.me/<%= @public_identity.phone.to_s.gsub(/\D/, '') %>?text=<%= ERB::Util.url_encode('Olá, tenho interesse em Fazendas e Sítios') %>" target="_blank" rel="noopener"
           class="inline-block px-8 py-4 public-theme-institutional__button public-theme-institutional__heading font-bold rounded-lg hover:bg-blue-three hover:text-white transition-all shadow-md hover:shadow-xl">
          <i class="bi bi-whatsapp mr-2"></i>
          Consultar Fazendas
        </a>
      </div>
    </div>
  </div>
</section>

<!-- CTA Final -->
<section class="py-16 public-theme-institutional__dark">
  <div class="container-custom text-center text-white">
    <h2 class="text-3xl lg:text-4xl font-bold mb-6" data-aos="fade-up">
      Encontre o Imóvel Corporativo Ideal
    </h2>
    <p class="text-xl mb-8 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
      Nossa equipe especializada está pronta para ajudá-lo a encontrar a solução perfeita
    </p>
    <div class="flex flex-wrap gap-4 justify-center" data-aos="fade-up" data-aos-delay="200">
      <%= link_to contato_path, class: "inline-block px-8 py-4 public-theme-institutional__button public-theme-institutional__heading font-bold rounded-lg hover:bg-white transition-all shadow-md hover:shadow-xl" do %>
        <i class="bi bi-envelope mr-2"></i>
        Entre em Contato
      <% end %>
      <a href="https://wa.me/<%= @public_identity.phone.to_s.gsub(/\D/, '') %>" target="_blank" rel="noopener" class="inline-block px-8 py-4 public-theme-institutional__surface public-theme-institutional__heading font-bold rounded-lg hover:bg-golden-one transition-all shadow-md hover:shadow-xl">
        <i class="bi bi-whatsapp mr-2"></i>
        WhatsApp
      </a>
    </div>
  </div>
</section>

</div>
