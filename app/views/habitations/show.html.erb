<% images = @habitation.public_image_sources %>
<% gallery_images = images %>
<% image_url = ->(photo) { public_image_url(photo) } %>
<% gallery_original_url = ->(photo) { image_url.call(photo) } %>
<% title = @habitation.display_title %>
<% address_parts = [@habitation.endereco, @habitation.public_neighborhood, @habitation.cidade].compact_blank %>
<% address_text = address_parts.join(" - ") %>
<% area_text = @habitation.public_area_m2 %>
<% has_sale_price = @habitation.valor_venda_cents.to_i.positive? %>
<% has_rent_price = @habitation.valor_locacao_cents.to_i.positive? %>
<% has_discount = @habitation.sale_discount? %>
<% has_rent_discount = @habitation.rent_discount? %>
<% public_media_url = public_property_media_url(@habitation) %>
<% map_coordinates = @public_map.center_coordinates if @public_map.visible? %>
<% street_view_coordinates = @public_map.street_view_coordinates if @public_map.street_view_enabled? %>
<% primary_image_source = gallery_images.first %>
<% primary_image_url = public_image_url(primary_image_source, resize_to_limit: [1200, 900], format: :webp) if primary_image_source %>
<% primary_image_srcset = public_image_srcset(primary_image_source, widths: [480, 800, 1200], aspect_ratio: 4.0 / 3, format: :webp) if primary_image_source %>

<% content_for :head do %>
  <%= json_ld_tag(real_estate_listing_schema(@habitation)) %>
  <%= json_ld_tag({
    "@context" => "https://schema.org", "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => "Início", "item" => root_url },
      { "@type" => "ListItem", "position" => 2, "name" => "Imóveis", "item" => habitations_url },
      { "@type" => "ListItem", "position" => 3, "name" => @habitation.codigo, "item" => @canonical_url }
    ]
  }) %>
  <% if primary_image_url.present? %>
    <link rel="preload"
          as="image"
          href="<%= primary_image_url %>"
          imagesrcset="<%= primary_image_srcset %>"
          imagesizes="(min-width: 1024px) 52vw, 100vw"
          fetchpriority="high">
  <% end %>
<% end %>

<%= theme_component(:detail_body,
      images: images, gallery_images: gallery_images,
      image_url: image_url, gallery_original_url: gallery_original_url,
      title: title, address_parts: address_parts, address_text: address_text,
      area_text: area_text, has_sale_price: has_sale_price,
      has_rent_price: has_rent_price, has_discount: has_discount,
      has_rent_discount: has_rent_discount, public_media_url: public_media_url,
      map_coordinates: map_coordinates,
      street_view_coordinates: street_view_coordinates,
      primary_image_source: primary_image_source,
      primary_image_url: primary_image_url,
      primary_image_srcset: primary_image_srcset) %>
