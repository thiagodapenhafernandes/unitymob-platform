<%
  development_name = @habitation.nome_empreendimento.presence || @habitation.display_title
  development_units = Array(@development_units)
  development_units_count = development_units.count
  development_location = [@habitation.public_neighborhood, @habitation.cidade].compact_blank.join(", ")
  development_full_location = [development_location, @habitation.uf].compact_blank.join(" - ")
  development_address = [@habitation.endereco, @habitation.numero].compact_blank.join(", ")
  development_full_address = [development_address, development_full_location].compact_blank.join(" - ")
  development_city_slug = @habitation.cidade.to_s.parameterize.presence
  development_neighborhood_slug = @habitation.public_neighborhood.to_s.parameterize.presence
  development_city_path = strategic_empreendimentos_path(development_city_slug) if development_city_slug.present? && Seo::StrategicLanding.development(development_city_slug).present?
  development_neighborhood_path = strategic_empreendimentos_path(development_neighborhood_slug) if development_neighborhood_slug.present? && Seo::StrategicLanding.development(development_neighborhood_slug).present?
  range_label = lambda do |values, suffix = nil|
    normalized = values.map(&:to_f).select(&:positive?).map(&:round).uniq.sort
    next if normalized.blank?

    label = normalized.one? ? normalized.first.to_s : "#{normalized.first} a #{normalized.last}"
    suffix.present? ? "#{label} #{suffix}" : label
  end
  area_label = range_label.call(development_units.filter_map(&:public_area_m2), "m²")
  suites_label = range_label.call(development_units.map(&:suites_qtd), "suítes")
  dorms_label = range_label.call(development_units.map(&:dormitorios_qtd), "dormitórios")
  vagas_label = range_label.call(development_units.map(&:vagas_qtd), "vagas")
  development_summary_metrics = [area_label, suites_label.presence || dorms_label, vagas_label].compact_blank
  development_summary = [
    "#{development_name} em #{development_full_location.presence || @habitation.cidade}.",
    (@habitation.constructor_name.present? ? "Empreendimento da #{@habitation.constructor_name}." : nil),
    (development_summary_metrics.any? ? "Unidades disponíveis com #{development_summary_metrics.to_sentence}." : nil),
    (development_units_count.positive? ? "#{development_units_count} #{development_units_count == 1 ? "unidade disponível" : "unidades disponíveis"} para consulta." : nil)
  ].compact_blank.join(" ")
  development_faq_items = []
  if development_full_address.present?
    development_faq_items << {
      question: "Onde fica o #{development_name}?",
      answer: "O #{development_name} fica em #{development_full_address}."
    }
  end
  if development_units_count.positive?
    development_faq_items << {
      question: "Há unidades disponíveis no #{development_name}?",
      answer: "Sim. A página lista #{development_units_count} #{development_units_count == 1 ? "unidade disponível" : "unidades disponíveis"} para consulta."
    }
  end
  if development_summary_metrics.any?
    development_faq_items << {
      question: "Quais configurações aparecem nas unidades do #{development_name}?",
      answer: "As unidades disponíveis apresentam #{development_summary_metrics.to_sentence}."
    }
  end
  if @habitation.constructor_name.present?
    development_faq_items << {
      question: "Quem é a construtora do #{development_name}?",
      answer: "A construtora informada para o #{development_name} é #{@habitation.constructor_name}."
    }
  end
  development_schema = {
    "@type" => "ApartmentComplex",
    "@id" => "#{@canonical_url.presence || empreendimento_details_url(@habitation)}#empreendimento",
    "name" => development_name,
    "url" => @canonical_url.presence || empreendimento_details_url(@habitation),
    "image" => @habitation.image_urls.presence,
    "address" => {
      "@type" => "PostalAddress",
      "streetAddress" => development_address.presence,
      "addressLocality" => @habitation.cidade.presence,
      "addressRegion" => @habitation.uf.presence,
      "postalCode" => @habitation.cep.presence,
      "addressCountry" => "BR"
    }.compact,
    "description" => @page_description.presence || @habitation.seo_description.presence || development_summary.presence,
    "numberOfAvailableAccommodationUnits" => (development_units_count if development_units_count.positive?),
    "aggregateRating" => public_rating_schema(@habitation),
    "amenityFeature" => (@habitation.public_property_features_for_display + @habitation.leisure_features_for_display).first(20).map do |feature|
      { "@type" => "LocationFeatureSpecification", "name" => feature }
    end.presence
  }.compact
  breadcrumb_schema = {
    "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => "Início", "item" => root_url },
      { "@type" => "ListItem", "position" => 2, "name" => "Empreendimentos", "item" => empreendimentos_url },
      { "@type" => "ListItem", "position" => 3, "name" => development_name, "item" => @canonical_url.presence || empreendimento_details_url(@habitation) }
    ]
  }
  faq_schema = if development_faq_items.any?
    {
      "@type" => "FAQPage",
      "mainEntity" => development_faq_items.map do |item|
        {
          "@type" => "Question",
          "name" => item[:question],
          "acceptedAnswer" => {
            "@type" => "Answer",
            "text" => item[:answer]
          }
        }
      end
    }
  end
%>
<%= json_ld_tag({ "@context" => "https://schema.org", "@graph" => [development_schema, breadcrumb_schema, faq_schema].compact }) %>

<%= theme_component(:development_body,
      development_name: development_name, development_units: development_units,
      development_units_count: development_units_count,
      development_location: development_location,
      development_full_location: development_full_location,
      development_address: development_address,
      development_full_address: development_full_address,
      development_city_slug: development_city_slug,
      development_neighborhood_slug: development_neighborhood_slug,
      development_city_path: development_city_path,
      development_neighborhood_path: development_neighborhood_path,
      range_label: range_label, area_label: area_label,
      suites_label: suites_label, dorms_label: dorms_label,
      vagas_label: vagas_label,
      development_summary_metrics: development_summary_metrics,
      development_summary: development_summary,
      development_faq_items: development_faq_items) %>
