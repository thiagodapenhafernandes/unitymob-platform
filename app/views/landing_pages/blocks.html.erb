<%# Página montada por blocos (construtor de páginas). Cada bloco é um componente com variante por tema
    (public_theme/blocks/_<tipo>). O H1 da página é de quem abre a página: a capa, a vitrine interativa ou o
    cabeçalho padrão — nunca dois. Em páginas de 2 ou 3 colunas, blocos consecutivos com largura de coluna formam
    uma linha em grade; os demais ocupam a linha inteira. Locals via ivars: @landing_page, @blocks, @showcases. %>
<%
  variant = theme_variant
  first = @blocks.first
  h1_owner = if first&.block_type == "cover" then :cover elsif first&.interactive_showcase? then :showcase else :page end
%>
<div class="public-landing-page public-landing-page--<%= variant %> public-header-offset mt-[72px]" data-controller="sidebar advanced-filters">
  <% if h1_owner == :page %>
    <div class="container-custom py-10">
      <%= render "public_theme/components/page_head", title: @landing_page.title, lead: @landing_page.description, variant: variant %>
    </div>
  <% end %>

  <% landing_page_groups(@blocks).each do |section, blocks| %>
    <% if section %>
      <%= tag.div(render("public_theme/blocks/section", block: section, blocks: blocks, page: @landing_page, variant: variant, showcases: @showcases), **landing_page_layout_attributes(section)) %>
    <% else %>
      <%= render "landing_pages/block_group", blocks: blocks, page: @landing_page, variant: variant, showcases: @showcases, h1_owner: h1_owner %>
    <% end %>
  <% end %>
</div>
