<% consent_chosen = %w[accepted rejected].include?(cookies[ApplicationController::LGPD_CONSENT_COOKIE]) %>
<div data-controller="lgpd-consent">
  <div class="public-theme-cookie-banner <%= "hidden" if consent_chosen %>"
       data-lgpd-consent-target="banner" role="region" aria-label="Consentimento de privacidade">
    <div class="public-theme-cookie-banner__panel">
      <div class="public-theme-cookie-banner__copy">
        <h2>Privacidade e cookies</h2>
        <p>Cookies essenciais mantêm o site funcionando. Aceite ou rejeite os opcionais de medição e publicidade.
          <%= link_to "Privacidade", privacy_policy_path %> · <%= link_to "Termos de Uso", terms_of_use_path %>
        </p>
      </div>
      <div class="public-theme-cookie-banner__actions">
        <button type="button" data-action="click->lgpd-consent#reject">Rejeitar opcionais</button>
        <button type="button" data-action="click->lgpd-consent#accept">Aceitar opcionais</button>
      </div>
    </div>
  </div>
</div>
