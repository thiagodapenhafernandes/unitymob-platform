<footer id="footer">
  <% footer_tenant = Current.tenant || (respond_to?(:public_tenant) ? public_tenant : Tenant.public_for) %>
  <% footer_identity = Tenants::PublicIdentity.new(footer_tenant) %>
  <% footer_layout = @layout_setting || LayoutSetting.instance(tenant: footer_tenant) %>
  <% footer_setting = @footer_setting || FooterSetting.instance(tenant: footer_tenant) %>
  <div class="footer-top">
    <div class="container">
      <div class="row">

        <div class="col-lg-3 col-md-6 footer-info">
          <% if footer_layout.logo.attached? %>
            <%= image_tag footer_layout.logo, alt: footer_identity.name, style: "height: 32px;" %>
          <% else %>
            <strong><%= footer_identity.name %></strong>
          <% end %>
          <br><br>
          <% footer_identity.locations.each do |location| %>
            <strong><%= location[:name] %></strong>
            <p><%= simple_format(location[:address]) %></p>
          <% end %>
          <% if footer_identity.phone.present? %>
            <p><strong>Tel:</strong> <%= footer_identity.phone %></p>
          <% end %>
          
          <div class="social-links mt-3">
            <a href="#" class="twitter"><i class="bi bi-tiktok"></i></a>
            <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
            <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
            <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

        <div class="col-lg-2 col-md-6 footer-links">
          <h4>Menu</h4>
          <ul>
            <li><i class="bi bi-chevron-right"></i> <a href="<%= root_path %>">Home</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Sobre nós</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="<%= habitations_path %>">Imóveis</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Trabalhe Conosco</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Contato</a></li>
          </ul>
        </div>

        <div class="col-lg-3 col-md-6 footer-links">
          <h4>Links Úteis</h4>
          <ul>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Frente Mar</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Quadra Mar</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Apartamento na planta</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Alto Padrão</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="#">Locação</a></li>
          </ul>
        </div>

        <div class="col-lg-4 col-md-6 footer-newsletter">
          <h4>Quem somos</h4>
          <p><%= footer_setting.about_text.presence || "Encontre oportunidades imobiliárias e fale com nossa equipe." %></p>
          <p>© <%= Time.current.year %></p>
          
          <h4>Inscreva-se na <%= footer_identity.name %></h4>
          <p>Receba as melhores oportunidades do mercado.</p>
          <form action="" method="post">
            <input type="email" name="email"><input type="submit" value="Inscreva-se">
          </form>
        </div>

      </div>
    </div>
  </div>

  <div class="container">
    <div class="copyright">
      &copy; Copyright <strong><span><%= footer_identity.name %></span></strong>. Todos os direitos reservados
    </div>
  </div>
</footer>
