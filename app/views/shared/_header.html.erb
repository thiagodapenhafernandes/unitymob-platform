<header id="header" class="fixed-top d-flex align-items-center">
  <% header_tenant = Current.tenant || (respond_to?(:public_tenant) ? public_tenant : Tenant.public_for) %>
  <% header_identity = Tenants::PublicIdentity.new(header_tenant) %>
  <% header_layout = @layout_setting || LayoutSetting.instance(tenant: header_tenant) %>
  <div class="container d-flex align-items-center justify-content-between">

    <div class="logo">
      <a href="<%= root_path %>">
        <% if header_layout.logo.attached? %>
          <%= image_tag header_layout.logo, alt: header_identity.name, class: "img-fluid" %>
        <% else %>
          <span><%= header_identity.name %></span>
        <% end %>
      </a>
    </div>

    <nav id="navbar" class="navbar">
      <ul>
        <li><a class="nav-link scrollto active" href="<%= root_path %>">Home</a></li>
        <li><a class="nav-link scrollto" href="#">Sobre nós</a></li>
        <li><a class="nav-link scrollto" href="<%= habitations_path %>">Imóveis</a></li>
        <li><a class="nav-link scrollto" href="#">Trabalhe Conosco</a></li>
        <li><a class="nav-link scrollto" href="#">Blog</a></li>
        <li><a class="nav-link scrollto" href="#">Contato</a></li>
      </ul>
      <i class="bi bi-list mobile-nav-toggle"></i>
    </nav>

  </div>
</header>
