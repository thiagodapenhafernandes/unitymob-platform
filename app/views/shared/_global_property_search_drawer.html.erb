<%
  drawer_property_types = @property_types.presence || public_filter_property_types
  drawer_location_options = @location_options.presence || public_filter_location_options
  drawer_selected_characteristics = Array(params[:characteristics]).reject(&:blank?)
  drawer_transaction_type = params[:transaction_type].presence || "venda"
  drawer_quick_filters = [
    ["frente_mar", "Frente Mar", "bi-water"],
    ["quadra_mar", "Quadra Mar", "bi-building"],
    ["vista_mar", "Vista Mar", "bi-eye"],
    ["mobiliado", "Mobiliado", "bi-house-heart"],
    ["carro_eletrico", "Ponto de recarga para veículo elétrico", "bi-ev-station"]
  ]
  drawer_highlight_filters = [
    ["opportunity", "Oportunidade (Valor Reduzido)"],
    ["lancamento", "Lançamento"],
    ["na_planta", "Na Planta"],
    ["pronto", "Pronto Para Morar"]
  ]
  drawer_feature_filters = [
    ["churrasqueira", "Churrasqueira"],
    ["cozinha_gourmet_churrasqueira", "Cozinha gourmet com churrasqueira"],
    ["sacada", "Sacada"],
    ["decorado", "Decorado"],
    ["closet", "Closet"],
    ["semi_mobiliado", "Semi Mobiliado"],
    ["lavabo", "Lavabo"],
    ["lavanderia", "Lavanderia"],
    ["dependencia_empregada", "Dependência de empregada"],
    ["hidromassagem", "Hidromassagem"],
    ["piscina", "Piscina"],
    ["sala_estar", "Sala de Estar"],
    ["sala_jantar", "Sala de Jantar"],
    ["sol_manha", "Sol da manhã"],
    ["sol_tarde", "Sol da tarde"],
    ["sol_dia_todo", "Sol o dia todo"],
    ["varanda", "Varanda"]
  ]
%>

<%# Locals opcionais (reuso fora do layout, ex.: página do corretor):
    form_url (default habitations_path), force_trigger (default false: mostra o
    FAB em todos os aparelhos ignorando o gate de visibilidade do home_setting). %>
<% drawer_form_url = local_assigns.fetch(:form_url, habitations_path) %>
<% drawer_force_trigger = local_assigns.fetch(:force_trigger, false) %>
<% drawer_visibility_class = drawer_force_trigger ? nil : @home_setting&.floating_search_filter_visibility_class %>

<%# Filtro global: FAB + drawer, iguais em estrutura para todos os temas
    (theme_component resolve a variante). Fica dentro do shell do tema. %>
<div class="public-global-search" data-controller="filter-drawer">
  <%# A visibilidade por aparelho vale só para o botão flutuante: o drawer abre também pelo "Filtro detalhado" do hero em Barra,
      em qualquer aparelho (com a classe no wrapper, o drawer sumia no desktop quando só o celular usa o botão flutuante). %>
  <% if drawer_force_trigger || @home_setting&.renders_floating_search_filter? %>
    <div class="<%= drawer_visibility_class %>"><%= theme_component(:filter_trigger) %></div>
  <% end %>

  <%= theme_component(:filter_panel,
        drawer_transaction_type: drawer_transaction_type,
        drawer_property_types: drawer_property_types,
        drawer_location_options: drawer_location_options,
        drawer_selected_characteristics: drawer_selected_characteristics,
        drawer_quick_filters: drawer_quick_filters,
        drawer_highlight_filters: drawer_highlight_filters,
        drawer_feature_filters: drawer_feature_filters,
        form_url: drawer_form_url) %>
</div>
