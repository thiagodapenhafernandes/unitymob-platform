<%
  drawer_property_types = @property_types.presence || public_filter_property_types
  drawer_location_options = @location_options.presence || public_filter_location_options
  drawer_selected_categories = Array(params[:category]).reject(&:blank?)
  drawer_selected_locations = Array(params[:city]).reject(&:blank?)
  drawer_selected_characteristics = Array(params[:characteristics]).reject(&:blank?)
  drawer_transaction_type = params[:transaction_type].presence || "venda"
  drawer_price_options = public_price_range_options(drawer_transaction_type)
  drawer_quick_filters = [
    ["frente_mar", "Frente Mar", "bi-water"],
    ["quadra_mar", "Quadra Mar", "bi-building"],
    ["vista_mar", "Vista Mar", "bi-eye"],
    ["mobiliado", "Mobiliado", "bi-house-heart"]
  ]
  drawer_highlight_filters = [
    ["opportunity", "Oportunidade (Valor Reduzido)"],
    ["lancamento", "Lançamento"],
    ["na_planta", "Na Planta"],
    ["pronto", "Pronto Para Morar"]
  ]
  drawer_feature_filters = [
    ["churrasqueira", "Churrasqueira"],
    ["cozinha_gourmet_churrasqueira", "Cozinha gourmet com churrasqueira"],
    ["sacada", "Sacada"],
    ["decorado", "Decorado"],
    ["closet", "Closet"],
    ["semi_mobiliado", "Semi Mobiliado"],
    ["lavabo", "Lavabo"],
    ["lavanderia", "Lavanderia"],
    ["dependencia_empregada", "Dependência de empregada"],
    ["hidromassagem", "Hidromassagem"],
    ["piscina", "Piscina"],
    ["sala_estar", "Sala de Estar"],
    ["sala_jantar", "Sala de Jantar"],
    ["sol_manha", "Sol da manhã"],
    ["sol_tarde", "Sol da tarde"],
    ["sol_dia_todo", "Sol o dia todo"],
    ["varanda", "Varanda"]
  ]
  drawer_quantity_filters = [
    [:min_bedrooms, "Dormitórios"],
    [:min_suites, "Suítes"],
    [:min_parking, "Vagas de Garagem"]
  ]
  drawer_quantity_options = [["1+", "1"], ["2+", "2"], ["3+", "3"], ["4+", "4"], ["Todos", ""]]
%>

<% drawer_visibility_class = @home_setting&.floating_search_filter_visibility_class %>

<div class="public-global-search <%= drawer_visibility_class %>"
     data-controller="global-search-drawer"
     data-global-search-drawer-open-class="is-open"
     data-global-search-drawer-closing-class="is-closing">
  <button type="button"
          class="public-global-search__button"
          data-global-search-drawer-target="button"
          data-action="click->global-search-drawer#open"
          aria-controls="public-global-search-drawer"
          aria-expanded="false">
    <i class="bi bi-sliders" aria-hidden="true"></i>
    <span>Filtrar imóveis</span>
  </button>

  <div class="public-global-search__overlay"
       data-global-search-drawer-target="overlay"
       data-action="click->global-search-drawer#close"
       aria-hidden="true"></div>

  <aside id="public-global-search-drawer"
         class="public-global-search__drawer"
         data-global-search-drawer-target="drawer"
         role="dialog"
         aria-modal="true"
         aria-hidden="true"
         aria-labelledby="public-global-search-title">
    <div class="public-global-search__panel">
      <header class="public-global-search__header">
        <div>
          <span>Busca global</span>
          <h2 id="public-global-search-title">Filtrar imóveis</h2>
        </div>
        <button type="button"
                class="public-global-search__close"
                data-action="click->global-search-drawer#close"
                aria-label="Fechar filtros">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </header>

      <%= form_with url: habitations_path,
                    method: :get,
                    class: "public-global-search__form",
                    data: {
                      controller: "public-search-url search-tabs",
                      action: "submit->public-search-url#submit",
                      search_tabs_sale_price_options_value: json_escape(public_price_range_options("venda").to_json),
                      search_tabs_rent_price_options_value: json_escape(public_price_range_options("aluguel").to_json)
                    } do |f| %>
        <input type="hidden"
               name="transaction_type"
               value="<%= drawer_transaction_type %>"
               data-search-tabs-target="input">

        <div class="public-global-search__field public-global-search__field--full public-global-search__field--autocomplete"
             data-controller="autocomplete"
             data-autocomplete-url-value="<%= autocomplete_habitations_path %>">
          <%= f.label :search, "Código, bairro ou empreendimento" %>
          <div class="public-global-search__input-icon">
            <i class="bi bi-search" aria-hidden="true"></i>
            <%= f.search_field :search,
                  value: params[:search],
                  placeholder: "Digite código, região ou nome",
                  autocomplete: "off",
                  data: {
                    autocomplete_target: "input",
                    action: "focus->autocomplete#focus input->autocomplete#search"
                  } %>
          </div>
          <div class="public-global-search__autocomplete hidden"
               data-autocomplete-target="results"></div>
        </div>

        <div class="public-global-search__segment" role="group" aria-label="Finalidade">
          <button type="button"
                  data-search-tabs-target="tab"
                  data-action="click->search-tabs#switch"
                  data-value="venda"
                  aria-pressed="<%= drawer_transaction_type != "aluguel" %>">
            Comprar
          </button>
          <button type="button"
                  data-search-tabs-target="tab"
                  data-action="click->search-tabs#switch"
                  data-value="aluguel"
                  aria-pressed="<%= drawer_transaction_type == "aluguel" %>">
            Alugar
          </button>
        </div>

        <div class="public-global-search__field public-global-search__field--full" data-controller="category-filter">
          <span class="public-global-search__label">Tipo de imóvel</span>
          <div class="public-global-search__dropdown">
            <button type="button"
                    data-category-filter-target="trigger"
                    data-action="click->category-filter#toggle"
                    aria-label="Selecionar tipo de imóvel">
              <i class="bi bi-building" aria-hidden="true"></i>
              <span data-category-filter-target="summary">Tipos de imóveis</span>
              <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="public-global-search__dropdown-panel hidden" data-category-filter-target="panel">
              <label>
                <input type="checkbox" data-category-filter-target="allCheckbox" data-action="change->category-filter#toggleAll">
                <span>Todos</span>
              </label>
              <% drawer_property_types.each do |type| %>
                <label>
                  <input type="checkbox"
                         value="<%= type %>"
                         data-category-filter-target="checkbox"
                         data-action="change->category-filter#sync"
                         <%= "checked" if drawer_selected_categories.include?(type) %>>
                  <span><%= type %></span>
                </label>
              <% end %>
            </div>
          </div>
          <div data-category-filter-target="hiddenContainer">
            <% drawer_selected_categories.each do |category| %>
              <%= hidden_field_tag "category[]", category %>
            <% end %>
          </div>
        </div>

        <div class="public-global-search__field public-global-search__field--full" data-controller="location-filter">
          <span class="public-global-search__label">Localização</span>
          <div class="public-global-search__dropdown">
            <button type="button"
                    data-location-filter-target="trigger"
                    data-action="click->location-filter#toggle"
                    aria-label="Selecionar localização">
              <i class="bi bi-geo-alt" aria-hidden="true"></i>
              <span data-location-filter-target="summary">Selecione bairros ou cidades</span>
              <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="public-global-search__dropdown-panel public-global-search__dropdown-panel--tall hidden" data-location-filter-target="panel">
              <div class="public-global-search__dropdown-tools">
                <span data-location-filter-target="count">0 selecionados</span>
                <button type="button" data-action="click->location-filter#clear">Limpar</button>
              </div>
              <input type="text"
                     class="public-global-search__dropdown-search"
                     aria-label="Filtrar bairros e cidades"
                     placeholder="Filtrar bairros/cidades"
                     data-location-filter-target="search"
                     data-action="input->location-filter#filter">
              <label>
                <input type="checkbox" data-location-filter-target="allCheckbox" data-action="change->location-filter#toggleAll">
                <span>Todos</span>
              </label>
              <% drawer_location_options.each do |option| %>
                <label data-location-filter-row="true">
                  <input type="checkbox"
                         value="<%= option[:value] %>"
                         data-label="<%= option[:label].to_s.downcase %>"
                         data-location-filter-target="checkbox"
                         data-action="change->location-filter#sync"
                         <%= "checked" if drawer_selected_locations.include?(option[:value]) %>>
                  <span><%= option[:label] %></span>
                </label>
              <% end %>
            </div>
          </div>
          <div data-location-filter-target="hiddenContainer">
            <% drawer_selected_locations.each do |city| %>
              <%= hidden_field_tag "city[]", city %>
            <% end %>
          </div>
        </div>

        <div class="public-global-search__grid">
          <div class="public-global-search__field public-global-search__field--full">
            <%= f.label :price_range, "Faixa de valor" %>
            <%= f.select :price_range,
                  options_for_select(drawer_price_options, params[:price_range]),
                  {},
                  data: { search_tabs_target: "priceSelect" } %>
          </div>

          <% drawer_quantity_filters.each do |field_name, label| %>
            <fieldset class="public-global-search__quantity">
              <legend><%= label %></legend>
              <div class="public-global-search__quantity-options">
                <% drawer_quantity_options.each do |option_label, option_value| %>
                  <label>
                    <%= radio_button_tag field_name,
                                         option_value,
                                         params[field_name].to_s == option_value.to_s,
                                         class: "public-global-search__quantity-input" %>
                    <span><%= option_label %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        </div>

        <fieldset class="public-global-search__chips">
          <legend>Buscas rápidas</legend>
          <% drawer_quick_filters.each do |value, label, icon| %>
            <label>
              <%= check_box_tag "characteristics[]", value, drawer_selected_characteristics.include?(value) %>
              <span>
                <i class="bi <%= icon %>" aria-hidden="true"></i>
                <%= label %>
              </span>
            </label>
          <% end %>
        </fieldset>

        <fieldset class="public-global-search__highlights">
          <legend>Destaques</legend>
          <% drawer_highlight_filters.each do |value, label| %>
            <label>
              <span><%= label %></span>
              <%= check_box_tag "characteristics[]",
                                value,
                                drawer_selected_characteristics.include?(value),
                                class: "public-global-search__highlight-input" %>
              <span class="public-global-search__switch" aria-hidden="true"></span>
            </label>
          <% end %>
        </fieldset>

        <fieldset class="public-global-search__features">
          <legend>Características</legend>
          <% drawer_feature_filters.each do |value, label| %>
            <label>
              <span><%= label %></span>
              <%= check_box_tag "characteristics[]",
                                value,
                                drawer_selected_characteristics.include?(value),
                                class: "public-global-search__feature-input" %>
              <span class="public-global-search__switch" aria-hidden="true"></span>
            </label>
          <% end %>
        </fieldset>

        <div class="public-global-search__actions">
          <%= link_to "Limpar", habitations_path, class: "public-global-search__clear" %>
          <button type="submit" class="public-global-search__submit">
            <i class="bi bi-search" aria-hidden="true"></i>
            Buscar imóveis
          </button>
        </div>
      <% end %>
    </div>
  </aside>
</div>
