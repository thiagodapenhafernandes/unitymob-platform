<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Unitymob Gateway</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f5f6f8; color: #1a1d24;
    }
    header {
      background: #12151c; color: #fff; padding: 16px 24px;
      display: flex; align-items: center; justify-content: space-between;
    }
    header h1 { font-size: 16px; margin: 0; font-weight: 600; letter-spacing: 0.02em; }
    header form { margin: 0; }
    header button {
      background: transparent; border: 1px solid #3a3f4b; color: #cdd2de;
      padding: 6px 12px; border-radius: 6px; font-size: 13px; cursor: pointer;
    }
    header button:hover { background: #1f232c; }
    main { max-width: 1080px; margin: 0 auto; padding: 32px 24px; }
    .card {
      background: #fff; border: 1px solid #e4e6ec; border-radius: 10px;
      padding: 24px; margin-bottom: 20px;
    }
    .center-card { max-width: 420px; margin: 80px auto; }
    h2 { font-size: 15px; margin: 0 0 16px; color: #4a4f5c; text-transform: uppercase; letter-spacing: 0.04em; }
    label { display: block; font-size: 13px; color: #4a4f5c; margin-bottom: 6px; }
    input[type=email], input[type=password], input[type=text] {
      width: 100%; padding: 10px 12px; border: 1px solid #d6d9e0; border-radius: 6px;
      font-size: 14px; margin-bottom: 16px;
    }
    button[type=submit] {
      width: 100%; padding: 10px 12px; background: #1a1d24; color: #fff;
      border: none; border-radius: 6px; font-size: 14px; cursor: pointer;
    }
    button[type=submit]:hover { background: #2a2f3b; }
    .error { background: #fdecec; color: #a4292b; padding: 10px 12px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
    .hint { font-size: 12px; color: #8a8f9c; margin-top: -8px; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #edeef2; vertical-align: top; }
    th { color: #6b7080; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.03em; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .badge--green { background: #e4f7e9; color: #1f7a3f; }
    .badge--red { background: #fdecec; color: #a4292b; }
    .badge--gray { background: #eef0f3; color: #6b7080; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: #4a4f5c; }
    .muted { color: #8a8f9c; }
    .empty { color: #8a8f9c; font-size: 13px; padding: 8px 0; }
  </style>
</head>
<body>
  <% if admin_authenticated? %>
    <header>
      <h1>Unitymob Gateway</h1>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
        <button type="submit">Sair</button>
      </form>
    </header>
  <% end %>
  <main>
    <%= yield %>
  </main>
</body>
</html>
