<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Unitymob Gateway</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f5f6f8; color: #1a1d24;
    }
    header {
      background: #12151c; color: #fff; padding: 16px 24px;
      display: flex; align-items: center; justify-content: space-between;
    }
    header h1 { font-size: 16px; margin: 0; font-weight: 600; letter-spacing: 0.02em; }
    header form { margin: 0; }
    header button {
      background: transparent; border: 1px solid #3a3f4b; color: #cdd2de;
      padding: 6px 12px; border-radius: 6px; font-size: 13px; cursor: pointer;
    }
    header button:hover { background: #1f232c; }
    main { max-width: 1280px; margin: 0 auto; padding: 32px 24px; }
    .card {
      background: #fff; border: 1px solid #e4e6ec; border-radius: 10px;
      padding: 24px; margin-bottom: 20px;
    }
    .card__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
    .center-card { max-width: 420px; margin: 80px auto; }
    h2 { font-size: 15px; margin: 0 0 16px; color: #4a4f5c; text-transform: uppercase; letter-spacing: 0.04em; }
    .card__header h2 { margin-bottom: 4px; }
    label { display: block; font-size: 13px; color: #4a4f5c; margin-bottom: 6px; }
    input[type=email], input[type=password], input[type=text], input[type=url], select {
      width: 100%; padding: 10px 12px; border: 1px solid #d6d9e0; border-radius: 6px;
      font-size: 14px; margin-bottom: 16px;
      background: #fff; color: #1a1d24;
    }
    input:focus-visible, select:focus-visible, button:focus-visible, a:focus-visible {
      outline: 3px solid #0b57d0; outline-offset: 2px;
    }
    button[type=submit], .link-button, .button-secondary {
      padding: 10px 12px; background: #1a1d24; color: #fff;
      border: none; border-radius: 6px; font-size: 14px; cursor: pointer;
      text-decoration: none; display: inline-flex; align-items: center; justify-content: center;
    }
    .center-card button[type=submit] { width: 100%; }
    button[type=submit]:hover, .link-button:hover, .button-secondary:hover { background: #2a2f3b; }
    .button-secondary { background: #fff; color: #1a1d24; border: 1px solid #d6d9e0; }
    .button-secondary:hover { color: #fff; border-color: #2a2f3b; }
    .filters, .route-form {
      display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; align-items: end;
      margin-bottom: 18px;
    }
    .filters > div { grid-column: span 3; }
    .filters > div:first-child { grid-column: span 5; }
    .filters button { grid-column: span 1; margin-bottom: 16px; min-height: 40px; }
    .route-form > div { grid-column: span 3; }
    .route-form button { grid-column: span 3; margin-bottom: 16px; min-height: 40px; }
    .notice { background: #eaf4ff; color: #17456f; padding: 10px 12px; border-radius: 6px; font-size: 13px; margin: 0 0 16px; }
    .error { background: #fdecec; color: #a4292b; padding: 10px 12px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
    .hint { font-size: 12px; color: #8a8f9c; margin-top: -8px; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #edeef2; vertical-align: top; }
    th { color: #6b7080; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.03em; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .badge--green { background: #e4f7e9; color: #1f7a3f; }
    .badge--red { background: #fdecec; color: #a4292b; }
    .badge--gray { background: #eef0f3; color: #6b7080; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: #4a4f5c; }
    .wrap { overflow-wrap: anywhere; }
    .muted { color: #8a8f9c; }
    .subtle { color: #8a8f9c; font-size: 13px; margin: 0 0 14px; }
    .empty { color: #8a8f9c; font-size: 13px; padding: 8px 0; }
    .pager { display: flex; align-items: center; gap: 12px; justify-content: flex-end; padding-top: 16px; font-size: 13px; }
    .pager a, .back-link { color: #17456f; text-decoration: none; font-weight: 600; }
    .pager a:hover, .back-link:hover { text-decoration: underline; }
    .details { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 0; }
    .details dt { color: #6b7080; font-size: 11px; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; margin-bottom: 6px; }
    .details dd { margin: 0; font-size: 13px; }
    dialog { width: min(960px, calc(100vw - 32px)); border: 0; border-radius: 10px; padding: 0; box-shadow: 0 24px 70px rgba(18, 21, 28, 0.22); }
    dialog::backdrop { background: rgba(18, 21, 28, 0.42); }
    .dialog-card { padding: 24px; }
    .dialog-actions { display: flex; gap: 10px; justify-content: flex-end; }
    .mirror-form { display: grid; grid-template-columns: 160px 1fr 120px 140px; gap: 12px; align-items: end; margin-top: 12px; }
    .mirror-form input[type=checkbox] { margin: 0 8px 16px 0; }
    @media (max-width: 900px) {
      main { padding: 20px 12px; }
      .card { padding: 16px; }
      .card__header { display: block; }
      .filters, .route-form, .details, .mirror-form { grid-template-columns: 1fr; }
      .filters > div, .filters > div:first-child, .filters button, .route-form > div, .route-form button { grid-column: auto; }
      table { display: block; overflow-x: auto; white-space: nowrap; }
      .wrap { white-space: normal; min-width: 220px; }
    }
  </style>
</head>
<body>
  <% if admin_authenticated? %>
    <header>
      <h1>Unitymob Gateway</h1>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
        <button type="submit">Sair</button>
      </form>
    </header>
  <% end %>
  <main>
    <%= yield %>
  </main>
</body>
</html>
