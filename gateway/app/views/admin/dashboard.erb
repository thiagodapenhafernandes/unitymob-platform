<% if params['message'].to_s != '' %>
  <p class="notice"><%= h(params['message']) %></p>
<% end %>

<section class="card">
  <div class="card__header">
    <div>
      <h2>Conexões estabelecidas (<%= @route_total %>)</h2>
      <p class="subtle">Ordenadas pelo evento mais recente. Abra uma conexão para ver entregas, falhas e tentativas.</p>
    </div>
  </div>

  <form class="filters" method="get" action="/admin">
    <div>
      <label for="q">Buscar</label>
      <input id="q" name="q" type="text" value="<%= h(params['q']) %>" placeholder="conta, destino, page_id, form_id, phone_number_id">
    </div>
    <div>
      <label for="provider">Canal</label>
      <select id="provider" name="provider">
        <option value="">Todos</option>
        <option value="whatsapp" <%= 'selected' if params['provider'] == 'whatsapp' %>>WhatsApp</option>
        <option value="meta" <%= 'selected' if params['provider'] == 'meta' %>>Meta Lead Ads</option>
      </select>
    </div>
    <div>
      <label for="active_filter">Estado</label>
      <select id="active_filter" name="active">
        <option value="">Todos</option>
        <option value="true" <%= 'selected' if params['active'] == 'true' %>>Ativas</option>
        <option value="false" <%= 'selected' if params['active'] == 'false' %>>Inativas</option>
      </select>
    </div>
    <button type="submit">Filtrar</button>
  </form>

  <% if @routes.empty? %>
    <p class="empty">Nenhuma conexão encontrada.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Conta</th>
          <th>Origem</th>
          <th>Destino</th>
          <th>Saúde</th>
          <th>Último evento</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @routes.each do |route| %>
          <% last = last_event_for(route) %>
          <% failed = failed_count_24h(route) %>
          <tr>
            <td>
              <strong><%= h(route.tenant_name.presence || route.client_key) %></strong><br>
              <span class="muted"><%= h(route.client_key) %></span>
            </td>
            <td class="mono"><%= h(incoming_label(route)) %></td>
            <td class="mono wrap"><%= h(route.target_url) %></td>
            <td>
              <% if !route.active? %>
                <span class="badge badge--gray">inativa</span>
              <% elsif failed > 0 %>
                <span class="badge badge--red"><%= failed %> falha(s) 24h</span>
              <% else %>
                <span class="badge badge--green">ok</span>
              <% end %>
            </td>
            <td>
              <% if last %>
                <strong><%= h(last.status) %></strong><br>
                <span class="muted"><%= last.received_at&.strftime('%d/%m %H:%M') %></span>
              <% else %>
                <span class="muted">sem eventos</span>
              <% end %>
            </td>
            <td><a class="link-button" href="/admin/routes/<%= route.id %>">Eventos</a></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <nav class="pager" aria-label="Paginação">
      <% if current_page > 1 %>
        <a href="/admin?<%= Rack::Utils.build_query(params.merge('page' => current_page - 1)) %>">Anterior</a>
      <% end %>
      <span>Página <%= current_page %></span>
      <% if next_page?(@routes) %>
        <a href="/admin?<%= Rack::Utils.build_query(params.merge('page' => current_page + 1)) %>">Próxima</a>
      <% end %>
    </nav>
  <% end %>
</section>

<section class="card">
  <h2>Cadastrar conexão manual</h2>
  <p class="subtle">Use para testes controlados, por exemplo apontando para um túnel em <span class="mono">https://dev.unitymob.com.br/webhooks/meta</span>. Se o segredo ficar em branco, o gateway gera um segredo novo para assinar os encaminhamentos.</p>
  <% if @route_error %>
    <p class="error"><%= h(@route_error) %></p>
  <% end %>
  <form class="route-form" method="post" action="/admin/routes">
    <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
    <div>
      <label for="route_provider">Canal</label>
      <select id="route_provider" name="route_provider" required>
        <option value="meta" <%= 'selected' if @route_form['route_provider'].to_s != 'whatsapp' %>>Meta Lead Ads</option>
        <option value="whatsapp" <%= 'selected' if @route_form['route_provider'] == 'whatsapp' %>>WhatsApp</option>
      </select>
    </div>
    <div>
      <label for="client_key">Chave da conta</label>
      <input id="client_key" name="client_key" type="text" required value="<%= h(@route_form['client_key']) %>">
    </div>
    <div>
      <label for="tenant_name">Nome da conta</label>
      <input id="tenant_name" name="tenant_name" type="text" value="<%= h(@route_form['tenant_name']) %>">
    </div>
    <div>
      <label for="target_url">Destino</label>
      <input id="target_url" name="target_url" type="url" required value="<%= h(@route_form['target_url']) %>" placeholder="https://dev.unitymob.com.br/webhooks/meta">
    </div>
    <div>
      <label for="page_id">page_id</label>
      <input id="page_id" name="page_id" type="text" value="<%= h(@route_form['page_id']) %>">
    </div>
    <div>
      <label for="form_id">form_id</label>
      <input id="form_id" name="form_id" type="text" value="<%= h(@route_form['form_id']) %>">
    </div>
    <div>
      <label for="phone_number_id">phone_number_id</label>
      <input id="phone_number_id" name="phone_number_id" type="text" value="<%= h(@route_form['phone_number_id']) %>">
    </div>
    <div>
      <label for="waba_id">waba_id</label>
      <input id="waba_id" name="waba_id" type="text" value="<%= h(@route_form['waba_id']) %>">
    </div>
    <div>
      <label for="forwarding_secret">Segredo de encaminhamento</label>
      <input id="forwarding_secret" name="forwarding_secret" type="password" autocomplete="new-password">
    </div>
    <div>
      <label for="route_active">Estado</label>
      <select id="route_active" name="active">
        <option value="true">Ativa</option>
        <option value="false" <%= 'selected' if @route_form['active'] == 'false' %>>Inativa</option>
      </select>
    </div>
    <button type="submit">Salvar conexão</button>
  </form>
</section>
