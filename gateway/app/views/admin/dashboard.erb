<div class="card">
  <h2>Contas roteadas (<%= @routes.size %>)</h2>
  <% if @routes.empty? %>
    <p class="empty">Nenhuma rota cadastrada ainda.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Conta</th>
          <th>Origem (Meta)</th>
          <th>Destino</th>
          <th>Status</th>
          <th>Último evento</th>
        </tr>
      </thead>
      <tbody>
        <% @routes.each do |route| %>
          <% last = last_event_for(route) %>
          <% failed = failed_count_24h(route) %>
          <tr>
            <td>
              <strong><%= route.tenant_name.presence || route.client_key %></strong><br>
              <span class="muted"><%= route.provider %></span>
            </td>
            <td class="mono"><%= incoming_label(route) %></td>
            <td class="mono"><%= route.target_url %></td>
            <td>
              <% if !route.active? %>
                <span class="badge badge--gray">inativa</span>
              <% elsif failed > 0 %>
                <span class="badge badge--red"><%= failed %> falha(s) 24h</span>
              <% else %>
                <span class="badge badge--green">ok</span>
              <% end %>
            </td>
            <td>
              <% if last %>
                <%= last.status %> · <%= last.received_at&.strftime('%d/%m %H:%M') %>
              <% else %>
                <span class="muted">sem eventos</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<div class="card">
  <h2>Eventos sem rota (últimos 20)</h2>
  <% if @unrouted.empty? %>
    <p class="empty">Nenhum evento sem rota recentemente.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Recebido em</th>
          <th>Provider</th>
          <th>Tipo</th>
          <th>Identificador</th>
        </tr>
      </thead>
      <tbody>
        <% @unrouted.each do |event| %>
          <tr>
            <td><%= event.received_at&.strftime('%d/%m %H:%M') %></td>
            <td><%= event.provider %></td>
            <td><%= event.event_type %></td>
            <td class="mono"><%= event.phone_number_id.presence || event.page_id %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
