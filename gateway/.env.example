RACK_ENV=development
DATABASE_URL=postgres://localhost/unitymob_whatsapp_gateway_development
META_WEBHOOK_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me
INTERNAL_API_TOKEN=change-me
# Chave por CRM emitida pelo Grupo OLX na homologação.
# GRUPOZAP_SECRET_KEY=<chave-emitida-pelo-grupo-olx>

# Discovery V2: separar das credenciais dos webhooks. Não preencher com segredos reais no repositório.
# DISCOVERY_INSTANCES={"salute":{"token":"<32+ caracteres>","origin":"https://<origem-do-crm>","tenant_ids":["<id-real>"]}}
# DISCOVERY_SECRET=<segredo aleatório de pelo menos 32 caracteres>
# DISCOVERY_MAIL_FROM=<remetente-validado>
# RESEND_API_KEY=<chave-privada-com-permissao-de-envio>

# Painel administrativo (/admin): login + código de confirmação por e-mail.
# SESSION_SECRET=<segredo aleatório de pelo menos 64 caracteres>
# GATEWAY_ADMIN_SECRET=<segredo aleatório de pelo menos 32 caracteres, dedicado aos desafios de login>
# GATEWAY_ADMIN_EMAIL=contato@unitymob.com.br
# GATEWAY_ADMIN_PASSWORD_DIGEST=<gerado com: PASSWORD=... bundle exec rake admin:hash_password>
# GATEWAY_ADMIN_MAIL_FROM=<remetente-validado, opcional; usa DISCOVERY_MAIL_FROM se ausente>

# TikTok Marketing API callback authentication (same 64-char hex secret on Rails).
# Generate with SecureRandom.hex(32); never commit a real value.
TIKTOK_WEBHOOK_TOKEN=
