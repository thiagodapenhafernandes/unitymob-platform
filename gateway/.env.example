RACK_ENV=development
DATABASE_URL=postgres://localhost/unitymob_whatsapp_gateway_development
META_WEBHOOK_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me
INTERNAL_API_TOKEN=change-me

# Discovery V2: separar das credenciais dos webhooks. Não preencher com segredos reais no repositório.
# DISCOVERY_INSTANCES={"salute":{"token":"<32+ caracteres>","origin":"https://<origem-do-crm>","tenant_ids":["<id-real>"]}}
# DISCOVERY_SECRET=<segredo aleatório de pelo menos 32 caracteres>
# DISCOVERY_MAIL_FROM=<remetente-validado>
# RESEND_API_KEY=<chave-privada-com-permissao-de-envio>
