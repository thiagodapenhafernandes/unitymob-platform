--- conexao.original
+++ conexao.candidate
@@ -61,0 +62,18 @@
+  location = /admin/meta_connection {
+    access_log /var/log/nginx/access.log unitymob_oauth_safe;
+    error_log /dev/null crit;
+    limit_req zone=unitymob_api burst=80 nodelay;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header Upgrade $http_upgrade;
+    proxy_set_header Connection $conexao_upstream_connection;
+    proxy_buffer_size 32k;
+    proxy_buffers 8 32k;
+    proxy_busy_buffers_size 64k;
+    proxy_redirect off;
+    proxy_pass http://conexaobc_puma;
+  }
+
