# frozen_string_literal: true

require_relative "config/environment"
require "active_record/tasks/database_tasks"
require "time"

ActiveRecord::Tasks::DatabaseTasks.database_configuration = Gateway::Database.configurations
ActiveRecord::Tasks::DatabaseTasks.db_dir = File.expand_path("db", __dir__)
ActiveRecord::Tasks::DatabaseTasks.migrations_paths = [File.expand_path("db/migrate", __dir__)]
ActiveRecord::Tasks::DatabaseTasks.root = __dir__
ActiveRecord::Tasks::DatabaseTasks.env = Gateway.env

namespace :db do
  desc "Create the gateway database"
  task :create do
    ActiveRecord::Tasks::DatabaseTasks.create_current
  end

  desc "Drop the gateway database"
  task :drop do
    ActiveRecord::Tasks::DatabaseTasks.drop_current
  end

  desc "Migrate the gateway database"
  task :migrate do
    connection_pool = ActiveRecord::Tasks::DatabaseTasks.migration_connection_pool
    ActiveRecord::MigrationContext
      .new(
        ActiveRecord::Tasks::DatabaseTasks.migrations_paths,
        ActiveRecord::SchemaMigration.new(connection_pool),
        ActiveRecord::InternalMetadata.new(connection_pool)
      )
      .migrate
  end

  desc "Show migration status"
  task :migrate_status do
    ActiveRecord::Tasks::DatabaseTasks.migrate_status
  end
end

namespace :webhooks do
  desc "List recent webhook events. Filters: STATUS, PROVIDER, PAGE_ID, FORM_ID, PHONE_NUMBER_ID, LIMIT"
  task :events do
    limit = [[ENV.fetch("LIMIT", 50).to_i, 1].max, 200].min
    scope = WebhookEvent.order(received_at: :desc, id: :desc)
    scope = scope.where(provider: ENV["PROVIDER"].to_s) if ENV["PROVIDER"].to_s.strip != ""
    scope = scope.where(status: ENV["STATUS"].to_s) if ENV["STATUS"].to_s.strip != ""
    scope = scope.where(page_id: ENV["PAGE_ID"].to_s) if ENV["PAGE_ID"].to_s.strip != ""
    scope = scope.where(form_id: ENV["FORM_ID"].to_s) if ENV["FORM_ID"].to_s.strip != ""
    scope = scope.where(phone_number_id: ENV["PHONE_NUMBER_ID"].to_s) if ENV["PHONE_NUMBER_ID"].to_s.strip != ""

    puts "id\tprovider\tstatus\ttype\texternal_id\tpage_id\tform_id\tphone_number_id\troute_id\tattempts\treceived_at\tlast_error"
    scope.limit(limit).each do |event|
      puts [
        event.id,
        event.provider,
        event.status,
        event.event_type,
        event.external_id,
        event.page_id,
        event.form_id,
        event.phone_number_id,
        event.webhook_route_id,
        event.attempts,
        event.received_at&.iso8601,
        event.last_error.to_s.gsub(/\s+/, " ")[0, 160]
      ].join("\t")
    end
  end

  desc "Retry failed webhook forwards"
  task :retry_failed do
    result = Gateway::RetryFailedEvents.call(
      limit: ENV.fetch("LIMIT", Gateway::RetryFailedEvents::DEFAULT_LIMIT),
      max_attempts: ENV.fetch("MAX_ATTEMPTS", Gateway::RetryFailedEvents::DEFAULT_MAX_ATTEMPTS)
    )

    puts "retried=#{result.retried} forwarded=#{result.forwarded} failed=#{result.failed}"
  end
end

task default: "db:migrate"
