[Unit]
Description=Unitymob Central PostgreSQL backup to private storage
After=network-online.target postgresql.service
[Service]
Type=oneshot
User=unitymob
WorkingDirectory=/home/unitymob/central/current/central
Environment=RAILS_ENV=production
EnvironmentFile=/home/unitymob/central/shared/central/.env
ExecStart=/usr/local/rvm/wrappers/ruby-3.2.3/bundle exec ruby ops/backup.rb
NoNewPrivileges=true
PrivateTmp=true
