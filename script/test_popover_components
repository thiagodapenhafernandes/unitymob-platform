#!/usr/bin/env python3
"""Serve the real Stimulus contract checks at http://127.0.0.1:8766.
Run from the repository with RVM 3.2.3 installed; no app server or database needed.
"""
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
GEM = Path(subprocess.check_output(["rvm", "3.2.3", "do", "bundle", "show", "stimulus-rails"], cwd=ROOT, text=True).strip())


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/":
            path = ROOT / "spec/javascript/popover_components.html"
        elif self.path == "/stimulus.js":
            path = GEM / "app/assets/javascripts/stimulus.js"
        elif self.path.startswith("/controllers/") and "/" not in self.path[len("/controllers/"):]:
            path = ROOT / "app/javascript/controllers" / (self.path.rsplit("/", 1)[1] + ".js")
        else:
            self.send_error(404)
            return
        if not path.is_file():
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8" if path.suffix == ".html" else "text/javascript; charset=utf-8")
        self.end_headers()
        self.wfile.write(path.read_bytes())


print("Popover checks: http://127.0.0.1:8766", flush=True)
HTTPServer(("127.0.0.1", 8766), Handler).serve_forever()
