#!/usr/bin/env bash
set -euo pipefail

EXPECTED_REVISION="${1:-$(git rev-parse HEAD)}"
ITERATIONS="${ITERATIONS:-6}"
INTERVAL="${INTERVAL:-60}"
SINCE_MINUTES="${SINCE_MINUTES:-20}"
CHECK_LOG_MARKERS="${CHECK_LOG_MARKERS:-0}"

check_url() {
  local label="$1"
  local url="$2"
  local code

  code="$(curl -k -sS -o /dev/null -w "%{http_code}" "$url" || true)"
  if [[ "$code" == "200" ]]; then
    printf "ok   %-18s %s\n" "$label" "$url"
    return 0
  fi

  printf "FAIL %-18s %s HTTP %s\n" "$label" "$url" "${code:-000}"
  return 1
}

check_stage() {
  local stage="$1"
  local ssh_target="$2"
  local deploy_to="$3"
  local puma_service="$4"
  local solid_queue_service="$5"
  shift 5

  local failed=0
  printf "\n== %s ==\n" "$stage"

  for url in "$@"; do
    check_url "$stage" "$url" || failed=1
  done

  ssh "$ssh_target" bash -s -- "$deploy_to" "$puma_service" "$solid_queue_service" "$EXPECTED_REVISION" "$SINCE_MINUTES" "$CHECK_LOG_MARKERS" <<'REMOTE' || failed=1
set -euo pipefail

deploy_to="$1"
puma_service="$2"
solid_queue_service="$3"
expected_revision="$4"
since_minutes="$5"
check_log_markers="$6"
log_pattern='RestClient|CarrierWave|Fog::|Dalli|PublicImageResolver|LoadError|ActionView::Template::Error|Sprockets::Rails::Helper::AssetNotFound|HTTParty::Error|HTTP 5[0-9]{2}'

cd "$deploy_to/current"

actual_revision="$(cat .mina_git_revision 2>/dev/null || true)"
if [[ "$actual_revision" == "$expected_revision"* ]]; then
  printf "ok   revision           %s\n" "$actual_revision"
else
  printf "FAIL revision           expected %s got %s\n" "$expected_revision" "${actual_revision:-missing}"
fi

for service in "$puma_service" "$solid_queue_service"; do
  state="$(systemctl is-active "$service" 2>/dev/null || true)"
  if [[ "$state" == "active" ]]; then
    printf "ok   service            %s active\n" "$service"
  else
    printf "FAIL service            %s %s\n" "$service" "${state:-unknown}"
  fi
done

if [[ "$check_log_markers" != "1" ]]; then
  printf "skip production.log     set CHECK_LOG_MARKERS=1 for raw log marker scan\n"
elif [[ -f log/production.log ]]; then
  matches="$(tail -n 1200 log/production.log | grep -Ei "$log_pattern" | tail -n 20 || true)"
  if [[ -z "$matches" ]]; then
    printf "ok   production.log     no regression markers in recent tail\n"
  else
    printf "WARN production.log     possible regression markers:\n%s\n" "$matches"
  fi
else
  printf "WARN production.log     missing\n"
fi

runner_code='cutoff = ENV.fetch("SINCE_MINUTES").to_i.minutes.ago; if !defined?(ErrorEvent) || !ErrorEvent.storage_ready?; puts "WARN error_events unavailable"; exit; end; scope = ErrorEvent.unresolved.where("last_seen_at >= ?", cutoff).where.not(exception_class: ["ActionController::RoutingError"]); fresh = scope.where("first_seen_at >= ?", cutoff).order(last_seen_at: :desc).limit(10).pluck(:first_seen_at, :last_seen_at, :severity, :source, :exception_class, :occurrences_count, :message); recurring = scope.where("first_seen_at < ?", cutoff).order(last_seen_at: :desc).limit(10).pluck(:first_seen_at, :last_seen_at, :severity, :source, :exception_class, :occurrences_count, :message); puts(fresh.empty? ? "ok   error_events       no new unresolved errors in window" : "WARN error_events       new unresolved errors"); fresh.each { |first_seen_at, last_seen_at, severity, source, exception_class, occurrences_count, message| puts "WARN new_error_event    first=#{first_seen_at&.iso8601} last=#{last_seen_at&.iso8601} #{severity} #{source} #{exception_class} x#{occurrences_count}: #{message.to_s[0, 180]}" }; if recurring.any?; puts "INFO error_events       recurring unresolved events touched in window"; recurring.each { |first_seen_at, last_seen_at, severity, source, exception_class, occurrences_count, message| puts "INFO old_error_event    first=#{first_seen_at&.iso8601} last=#{last_seen_at&.iso8601} #{severity} #{source} #{exception_class} x#{occurrences_count}: #{message.to_s[0, 180]}" }; end'
SINCE_MINUTES="$since_minutes" /usr/local/rvm/bin/rvm-shell 3.2.3@default -c "cd '$deploy_to/current' && RAILS_ENV=production bundle exec rails runner '$runner_code'" || printf "WARN error_events       rails runner failed\n"
REMOTE

  return "$failed"
}

run_once() {
  local failed=0
  printf "\n[%s] expected revision %s, window %s min\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$EXPECTED_REVISION" "$SINCE_MINUTES"

  check_stage \
    "saluteimoveis" \
    "salute@143.110.138.67" \
    "/home/salute/deploy" \
    "puma_salute_imoveis_v3_production" \
    "solid_queue_salute_imoveis_v3_production" \
    "https://143.110.138.67/up" \
    "https://143.110.138.67/healthz" || failed=1

  check_stage \
    "conexaoimobiliaria" \
    "conexao@app.conexaobc.com" \
    "/home/conexao/deploy" \
    "puma_conexao_imobiliaria_production" \
    "solid_queue_conexao_imobiliaria_production" \
    "https://app.conexaobc.com/up" \
    "https://app.conexaobc.com/healthz" \
    "https://conexaobc.com/up" \
    "https://conexaobc.com/healthz" || failed=1

  return "$failed"
}

overall_failed=0
for ((i = 1; i <= ITERATIONS; i++)); do
  printf "\n--- post-deploy monitor %s/%s ---\n" "$i" "$ITERATIONS"
  run_once || overall_failed=1

  if (( i < ITERATIONS )); then
    sleep "$INTERVAL"
  fi
done

exit "$overall_failed"
